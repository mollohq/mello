#!/bin/sh
# Pre-push: delegate to the shared fast gate so the hook, the local script and
# pr-checks.yml cannot drift apart.
# Install: git config core.hooksPath .githooks

if ! command -v cargo >/dev/null 2>&1; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ ! -x "$REPO_ROOT/scripts/check.sh" ]; then
    echo "scripts/check.sh missing or not executable; skipping pre-push checks"
    exit 0
fi

echo "━━━ pre-push checks ━━━"
if ! "$REPO_ROOT/scripts/check.sh"; then
    echo ""
    echo "Push rejected. Fix the above, or use --no-verify if you know why."
    exit 1
fi
