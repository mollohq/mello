{
  "name": "signup_smoke",
  "steps": [
    {
      "action": "discover_crews"
    },
    {
      "action": "expect_event",
      "event": "DiscoverCrewsLoaded",
      "timeout_ms": 30000
    },
    {
      "action": "finalize_onboarding",
      "crew_name": "Canary Smoke ${MELLO_SMOKE_ID}",
      "display_name": "Smoke Test"
    },
    {
      "action": "expect_event",
      "event": "OnboardingReady",
      "timeout_ms": 45000
    },
    {
      "action": "delete_crew"
    },
    {
      "action": "expect_event",
      "event": "CrewDeleted",
      "timeout_ms": 30000
    },
    {
      "action": "delete_account"
    },
    {
      "action": "expect_event",
      "event": "AccountDeleted",
      "timeout_ms": 30000
    }
  ]
}
