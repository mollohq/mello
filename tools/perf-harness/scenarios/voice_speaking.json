{
  "name": "voice-speaking",
  "steps": [
    { "action": "login", "email": "${PERF_TEST_EMAIL}", "password": "${PERF_TEST_PASSWORD}" },
    { "action": "expect_event", "event": "LoggedIn", "timeout_ms": 20000 },
    { "action": "select_crew", "crew_id": "${PERF_TEST_CREW_ID}" },
    { "action": "join_voice", "channel_id": "${PERF_TEST_CHANNEL_ID}" },
    { "action": "expect_event", "event": "VoiceJoined", "timeout_ms": 20000 },
    { "action": "set_mute", "muted": false },
    {
      "action": "inject_wav",
      "path": "${PERF_TEST_WAV}",
      "loop_source": true
    },
    { "action": "sample", "duration_s": 45 },
    { "action": "stop_inject" },
    { "action": "leave_voice" }
  ]
}
