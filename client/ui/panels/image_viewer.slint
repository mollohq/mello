import { Theme } from "../theme.slint";
import { CutShape, CutButtonShape, CutMask } from "../components/cut.slint";
import { ViewerImageData } from "../types.slint";

/// The chat image viewer: one image big over the whole window, the other
/// images of the message as thumbnails to switch between, Save, Copy and
/// Close. Left and Right move, Escape closes, a click on the wash closes.
export component ChatImageViewer inherits Rectangle {
    in property <[ViewerImageData]> images: [];
    in-out property <int> index: 0;
    in property <string> sender: "";
    callback close();
    callback save(/* url */ string);
    callback copy(/* url */ string);
    /// The shown index changed; the client fetches the full image for it.
    callback shown(/* index */ int);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    property <bool> many: images.length > 1;
    property <ViewerImageData> current: index >= 0 && index < images.length ? images[index] : { url: "" };

    function go(delta: int) {
        if !many { return; }
        root.index = (root.index + delta + images.length).mod(images.length);
        root.shown(root.index);
    }

    TouchArea {
        // a11y: none (backdrop: a click outside the card closes the viewer)
        clicked => { root.close(); }
    }

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            if event.text == Key.LeftArrow { root.go(-1); return accept; }
            if event.text == Key.RightArrow { root.go(1); return accept; }
            reject
        }
    }

    // A modal card at 70% of the window, like every other modal: the cut,
    // the keyline, the surface. The scrim behind makes the buttons read.
    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width * 0.7;
        height: parent.height * 0.7;
        background: transparent;

        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            fill: Theme.graphic-light;
        }
        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            inset: Theme.keyline;
            fill: Theme.surface;
        }

        TouchArea {
            // a11y: none (input blocker: stops clicks reaching the backdrop)
        }

    VerticalLayout {
        padding: 24px;
        spacing: 14px;

        // The image, with a chevron each side when there are several.
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            if many: Rectangle {
                width: 44px;
                background: transparent;
                CutButtonShape {
                    width: parent.width; height: 44px;
                    y: (parent.height - 44px) / 2;
                    n: 8px;
                    fill: prev-touch.has-hover ? Theme.graphic-med : Theme.surface-hover;
                }
                Image {
                    source: @image-url("../icons/chevron-left.svg");
                    width: 18px; height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.text-primary;
                }
                prev-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Previous image";
                    mouse-cursor: pointer;
                    y: (parent.height - 44px) / 2;
                    height: 44px;
                    clicked => { root.go(-1); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                if root.current.has-image: Image {
                    source: root.current.image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
                if !root.current.has-image: Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: root.current.failed ? "Image not available" : "Loading image…";
                    font-size: Theme.font-md;
                    color: Theme.text-tertiary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
                TouchArea {
                    // a11y: none (keeps a click on the image from closing the viewer)
                }
            }

            if many: Rectangle {
                width: 44px;
                background: transparent;
                CutButtonShape {
                    width: parent.width; height: 44px;
                    y: (parent.height - 44px) / 2;
                    n: 8px;
                    fill: next-touch.has-hover ? Theme.graphic-med : Theme.surface-hover;
                }
                Image {
                    source: @image-url("../icons/chevron-right.svg");
                    width: 18px; height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.text-primary;
                }
                next-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Next image";
                    mouse-cursor: pointer;
                    y: (parent.height - 44px) / 2;
                    height: 44px;
                    clicked => { root.go(1); }
                }
            }
        }

        // Every image of the message, the shown one outlined.
        if many: HorizontalLayout {
            height: 64px;
            spacing: 8px;
            alignment: center;
            for img[i] in root.images: Rectangle {
                width: 64px;
                clip: true;
                background: Theme.bg-app;
                if img.has-image: Image {
                    source: img.image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    opacity: i == root.index ? 1 : 0.6;
                }
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-width: i == root.index ? 2px : 0px;
                    border-color: Theme.action;
                    background: transparent;
                }
                CutMask {
                    x: parent.width - self.width; y: 0;
                    width: 8px; height: 8px; n: 8px;
                    corner: "tr";
                    fill: Theme.surface;
                }
                TouchArea {
                    accessible-role: button;
                    accessible-label: "Image " + (i + 1);
                    mouse-cursor: pointer;
                    clicked => { root.index = i; root.shown(i); }
                }
            }
        }

        // Who, which, how big.
        HorizontalLayout {
            height: 20px;
            spacing: 12px;
            Text {
                font-family: Theme.font-display;
                font-weight: Theme.weight-display;
                text: root.sender;
                font-size: Theme.font-md;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if many: Text {
                font-family: Theme.font-display;
                font-weight: Theme.weight-display;
                text: (root.index + 1) + " / " + root.images.length;
                font-size: Theme.font-md;
                color: Theme.text-secondary;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Text {
                font-family: Theme.font-label;
                font-weight: Theme.weight-label;
                letter-spacing: Theme.track-label;
                text: root.current.label;
                font-size: Theme.font-xs;
                color: Theme.text-secondary;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }

        HorizontalLayout {
            height: 36px;
            spacing: 8px;

            for action[i] in ["Save", "Copy"]: Rectangle {
                width: 96px;
                background: transparent;
                CutButtonShape {
                    width: parent.width;
                    height: parent.height;
                    n: 8px;
                    fill: action-touch.has-hover ? Theme.graphic-med : Theme.surface-hover;
                }
                action-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: action + " image";
                    mouse-cursor: pointer;
                    clicked => {
                        if action == "Save" { root.save(root.current.url); }
                        else { root.copy(root.current.url); }
                    }
                }
                Text {
                    font-family: Theme.font-label;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-label;
                    text: action == "Save" ? "SAVE" : "COPY";
                    font-size: Theme.font-xs;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // The one white button on this surface.
            Rectangle {
                width: 100px;
                background: transparent;
                CutButtonShape {
                    width: parent.width;
                    height: parent.height;
                    n: 8px;
                    fill: close-touch.has-hover ? Theme.action-press : Theme.action;
                }
                close-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Close image";
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }
                Text {
                    font-family: Theme.font-label;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-label;
                    text: "CLOSE";
                    font-size: Theme.font-xs;
                    color: Theme.on-action;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
    }
    }
}

/// Three images, the second shown, before its pixels arrive.
export component Preview inherits ChatImageViewer {
    width: 1200px;
    height: 800px;
    sender: "k0ji";
    index: 1;
    images: [
        { url: "a", width: 1600, height: 1000, label: "1600×1000 · 1.2 MB" },
        { url: "b", width: 800, height: 1200, label: "800×1200 · 640 KB" },
        { url: "c", width: 1200, height: 1200, label: "1200×1200 · 900 KB", failed: true },
    ];
}
