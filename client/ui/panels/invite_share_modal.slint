import { Theme, MelloTextInput } from "../theme.slint";
import { CutShape, CutButtonShape } from "../components/cut.slint";

export component InviteShareModal inherits Rectangle {
    in property <string> invite-url: "";
    in-out property <bool> copied: false;

    callback copy-link();
    callback close-requested();

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    revert-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            copied = false;
            self.running = false;
        }
    }

    bg-touch := TouchArea {
        clicked => { close-requested(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 380px;
        height: inner.preferred-height + 40px;
        background: transparent;

        // A modal panel is a card, so it carries the cut and a keyline.
        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            fill: Theme.graphic-light;
        }
        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            inset: Theme.keyline;
            fill: Theme.surface;
        }

        card-touch := TouchArea {}

        inner := VerticalLayout {
            padding: 24px;
            spacing: 14px;

            Text {
                font-family: Theme.font-display;
                text: "Invite people";
                font-size: Theme.font-xl;
                font-weight: Theme.weight-display-bold;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }

            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: "Share this link to invite anyone to your crew:";
                font-size: Theme.font-sm;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                height: 40px;
                background: Theme.bg-app;

                MelloTextInput {
                    text: invite-url;
                    font-family: Theme.font-mono;
                    font-size: 12px;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    read-only: true;
                    single-line: true;
                }
            }

            Rectangle {
                height: 40px;

                Rectangle {
                    width: 140px;
                    height: 40px;
                    x: (parent.width - self.width) / 2;
                    background: transparent;

                    // Copying is an action, not a commit: it changes nothing
                    // on the server, so it stays white.
                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        fill: copied ? Theme.accent-green
                            : (copy-touch.has-hover ? Theme.action-press : Theme.action);
                    }

                    Text {
                        font-family: Theme.font-display;
                        text: copied ? "Copied!" : "Copy link";
                        font-size: Theme.font-md;
                        font-weight: Theme.weight-display;
                        color: Theme.on-action;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    copy-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            copy-link();
                            revert-timer.running = false;
                            revert-timer.running = true;
                        }
                    }
                }
            }
        }
    }
}

// Headless preview:
//   slint-viewer --screenshot out.png --component Preview \
//     client/ui/panels/invite_share_modal.slint
export component Preview inherits Rectangle {
    width: 900px;
    height: 600px;
    background: Theme.bg-app;

    InviteShareModal {
        width: parent.width;
        height: parent.height;
        invite-url: "m3llo.io/join/ALPHA-992-K";
    }
}
