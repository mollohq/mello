import { Theme, MelloTextInput } from "../theme.slint";
import { CutShape, CutButtonShape, CutMask } from "../components/cut.slint";
import { UserAvatar } from "../components/avatar.slint";
import { CrewEmojiUi } from "../components/crew_emoji.slint";
import { ChatFocus, ChatMessageData, ChatLinkData, ChatImageData, AttachmentData, GifItemData, EmojiItemData, EmojiRowData, EmojiCategoryData, MentionMemberData } from "../types.slint";
import { ListView } from "std-widgets.slint";

component LinkPill inherits Rectangle {
    in property <string> url;
    in property <string> label;
    callback clicked(/* url */ string);

    property <length> pill-max-width: 260px;
    max-width: pill-max-width;
    background: transparent;

    // A link is a button, so it cuts top-left and bottom-right and carries a
    // keyline. No radius: radii are for dots, discs and pips.
    CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: 6px;
        fill: Theme.graphic-light;
    }
    CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: 6px;
        inset: Theme.keyline;
        fill: pill-touch.has-hover ? Theme.graphic-med : Theme.surface-hover;
    }

    pill-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        mouse-cursor: pointer;
        clicked => { root.clicked(root.url); }
    }

    pill-layout := HorizontalLayout {
        max-width: root.pill-max-width;
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 5px;
        alignment: center;

        Image {
            source: @image-url("../icons/external-link.svg");
            width: 10px;
            height: 10px;
            colorize: Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }

        Text {
            font-family: Theme.font-body;
            text: root.label;
            font-size: Theme.font-xs;
            font-weight: 500;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0;
        }
    }
}


// PopupWindow lives in a component (not in `for`) so it can anchor to the ⋮ button.
component MessageMoreMenu inherits Rectangle {
    in property <length> size: 16px;
    in property <bool> active: false;
    in property <bool> open-above: false;
    in property <bool> is-own-message: false;
    out property <bool> pointer-hover: more-touch.has-hover;

    callback toggled();
    callback edit-requested();
    callback delete-requested();
    callback copy-requested();

    width: size;
    height: size;
    border-radius: 4px;
    background: more-touch.has-hover ? Theme.bg-tertiary : Theme.surface;

    more-touch := TouchArea {
        accessible-role: button;
        accessible-label: "More actions";
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    Image {
        source: @image-url("../icons/more.svg");
        width: size * 0.65;
        height: size * 0.65;
        colorize: Theme.text-secondary;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // A pointer click by element position misses inside a PopupWindow, so
    // each item also takes the default accessibility action. Each request
    // clears `active`, which closes the menu.
    menu-popup := PopupWindow {
        x: 0px;
        y: open-above ? -menu-box.height - 8px : parent.height + 4px;
        width: 120px;

        menu-box := Rectangle {
            background: Theme.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.graphic-light;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000030;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                if is-own-message: Rectangle {
                    height: 28px;
                    background: menu-edit-touch.has-hover ? Theme.bg-tertiary : transparent;
                    border-radius: 4px;

                    Text {
                        font-weight: Theme.weight-sentence;
                        font-family: Theme.font-body;
                        text: "Edit";
                        font-size: Theme.font-sm;
                        color: Theme.text-secondary;
                        x: 8px;
                        vertical-alignment: center;
                    }

                    menu-edit-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Edit";
                        accessible-action-default => { root.edit-requested(); }
                        clicked => { root.edit-requested(); }
                    }
                }

                if is-own-message: Rectangle {
                    height: 28px;
                    background: menu-del-touch.has-hover ? Theme.bg-tertiary : transparent;
                    border-radius: 4px;

                    Text {
                        font-weight: Theme.weight-sentence;
                        font-family: Theme.font-body;
                        text: "Delete";
                        font-size: Theme.font-sm;
                        color: Theme.live;
                        x: 8px;
                        vertical-alignment: center;
                    }

                    menu-del-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Delete";
                        accessible-action-default => { root.delete-requested(); }
                        clicked => { root.delete-requested(); }
                    }
                }

                Rectangle {
                    height: 28px;
                    background: menu-copy-touch.has-hover ? Theme.bg-tertiary : transparent;
                    border-radius: 4px;

                    Text {
                        font-weight: Theme.weight-sentence;
                        font-family: Theme.font-body;
                        text: "Copy text";
                        font-size: Theme.font-sm;
                        color: Theme.text-secondary;
                        x: 8px;
                        vertical-alignment: center;
                    }

                    menu-copy-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Copy text";
                        accessible-action-default => { root.copy-requested(); }
                        clicked => { root.copy-requested(); }
                    }
                }
            }
        }
    }

    changed active => {
        if active {
            menu-popup.show();
        } else {
            menu-popup.close();
        }
    }
}

component PillButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    // An icon button: the label is what a screen reader and the driver read.
    // The open one is white on the dim fill, with the button's cut corners.
    height: 28px;
    width: 32px;
    background: transparent;

    if active || touch.has-hover: CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: 5px;
        fill: active ? Theme.action-dim : Theme.surface-hover;
    }

    touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        source: icon;
        width: 16px;
        height: 16px;
        colorize: active || touch.has-hover ? Theme.accent : Theme.text-tertiary;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component ChatClipCard inherits Rectangle {
    in property <string> sender-name;
    in property <string> clip-duration: "0:30";
    callback play-clicked();

    height: 72px;
    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        corner: "br";
        inset: Theme.keyline;
        fill: clip-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    }

    HorizontalLayout {
        spacing: 10px;
        padding: 10px;

        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 4px;
            background: Theme.wave-bg;

            HorizontalLayout {
                alignment: center;
                spacing: 1px;
                padding-left: 8px;
                padding-right: 8px;

                for h in [0.4, 0.8, 0.5, 0.9, 0.3, 0.7, 0.6, 0.9, 0.4]: Rectangle {
                    width: 2px;
                    height: 24px * h;
                    border-radius: 1px;
                    background: Theme.clip-amber;
                    opacity: 0.6 + h * 0.4;
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: #00000066;

                Image {
                    source: @image-url("../icons/play.svg");
                    width: 10px;
                    height: 10px;
                    colorize: white;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 4px;

                Image {
                    source: @image-url("../icons/scissors.svg");
                    colorize: Theme.clip-amber;
                    width: 12px;
                    height: 12px;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    font-family: Theme.font-body;
                    text: sender-name + " clipped that";
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.text-primary;
                    overflow: elide;
                }
            }

            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: "Voice · " + clip-duration + " · Play";
                font-size: 11px;
                color: Theme.text-secondary;
            }
        }
    }

    clip-touch := TouchArea {
        accessible-role: button;
        accessible-label: "Play clip";
        mouse-cursor: pointer;
        clicked => { play-clicked(); }
    }
}

component GifPopover inherits Rectangle {
    in property <[GifItemData]> gifs: [];
    /// One sentence on why there are no tiles. Empty when the request worked.
    in property <string> error: "";
    in property <bool> show: false;
    callback search(/* query */ string);
    callback gif-selected(/* gif_id */ string, /* url */ string, /* preview_url */ string, /* width */ int, /* height */ int);
    callback close();

    visible: show;
    height: 360px;
    background: transparent;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        fill: Theme.graphic-light;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        inset: Theme.keyline;
        fill: Theme.surface;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        Rectangle {
            height: 32px;
            background: Theme.bg-app;
            border-width: 1px;
            border-color: Theme.graphic-light;

            gif-search := MelloTextInput {
                accessible-label: "Search GIFs";
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                font-size: Theme.font-md;
                color: Theme.text-primary;
                vertical-alignment: center;

                edited => {
                    root.search(gif-search.text);
                }
            }

            if gif-search.text == "": Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                x: 10px;
                text: "Search GIFs";
                font-size: Theme.font-md;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
        }

        if root.error != "": VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 12px;
            padding-left: 24px;
            padding-right: 24px;

            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: root.error;
                font-size: Theme.font-md;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: center;

                // Retry is an action, so the button is graphite, not white:
                // one white button per surface, and the search field has focus.
                Rectangle {
                    width: 110px;
                    height: 32px;
                    background: transparent;

                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: 8px;
                        fill: gif-retry.has-hover ? Theme.graphic-med : Theme.surface-hover;
                    }

                    gif-retry := TouchArea {
                        accessible-role: button;
                        accessible-label: "Try again";
                        mouse-cursor: pointer;
                        clicked => { root.search(gif-search.text); }
                    }

                    Text {
                        font-family: Theme.font-label;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        text: "TRY AGAIN";
                        font-size: Theme.font-xs;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
        }

        if root.error == "": Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 4px;

                for row-start[row-idx] in [0, 3, 6, 9, 12, 15, 18]: HorizontalLayout {
                    spacing: 4px;

                    for col in [0, 1, 2]: Rectangle {
                        property <int> gif-index: row-start + col;
                        property <bool> in-range: gif-index < gifs.length;
                        visible: in-range;
                        horizontal-stretch: 1;
                        height: in-range ? self.width * 0.75 : 0;
                        clip: true;
                        background: in-range && !gifs[gif-index].has-preview ? Theme.bg-app : transparent;

                        if in-range && gifs[gif-index].has-preview: Image {
                            source: gifs[gif-index].preview;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }

                        if in-range: Rectangle {
                            background: gif-cell-touch.has-hover ? Theme.action-dim : transparent;

                            gif-cell-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: "GIF";
                                clicked => {
                                    if gif-index < gifs.length {
                                        root.gif-selected(
                                            gifs[gif-index].gif-id,
                                            gifs[gif-index].url,
                                            gifs[gif-index].preview-url,
                                            gifs[gif-index].width,
                                            gifs[gif-index].height,
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: "Powered by GIPHY";
            font-size: Theme.font-xs;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            height: 16px;
        }
    }
}

export component ChatPanel inherits Rectangle {
    in property <[ChatMessageData]> messages: [];
    in property <int> messages-this-week: 0;
    in property <string> user-name: "";
    in property <string> user-id: "";
    in property <bool> loading-history: false;
    in property <bool> has-more-history: false;

    // GIF popover
    in property <[GifItemData]> gif-results: [];
    in property <string> gif-error: "";

    // Image attachments and the viewer
    in property <[AttachmentData]> attachments: [];
    /// The message whose action bar is open. A click on a message opens its
    /// bar; a click on the same message or Escape closes it.
    in-out property <string> actions-message-id: "";
    callback attach-clicked();
    callback attachment-removed(/* id */ string);
    callback paste-image() -> bool;
    callback image-clicked(/* url */ string, /* sender */ string);
    callback image-save(/* url */ string);
    callback image-copy(/* url */ string);

    /// A pick in the picker: a reaction when a message asked for one, else
    /// text in the field. The picker closes either way.
    function pick-emoji(emoji: string) {
        root.emoji-picked(emoji);
        root.emoji-popover-open = false;
        if root.emoji-target-message != "" {
            root.react(root.emoji-target-message, emoji);
            root.emoji-target-message = "";
            return;
        }
        chat-input.text += emoji;
        root.chat-input-changed(chat-input.text);
        chat-input.focus();
    }

    /// Open the picker to choose a reaction for `message-id`.
    function pick-reaction-for(message-id: string) {
        root.emoji-target-message = message-id;
        root.emoji-popover-open = true;
        root.emoji-pill-clicked();
    }

    /// Enter and the send button. Text, or ready chips, or both.
    function submit-message() {
        if root.chat-input-text == "" && root.attachments.length == 0 {
            return;
        }
        if root.edit-mode {
            if root.chat-input-text == "" {
                return;
            }
            root.edit-message(root.edit-message-id, root.chat-input-text);
            root.edit-mode = false;
            root.edit-message-id = "";
        } else if root.reply-mode {
            root.message-submitted-with-reply(root.chat-input-text, root.reply-to-id);
            root.reply-mode = false;
            root.reply-to-id = "";
            root.reply-to-name = "";
        } else {
            root.message-submitted(root.chat-input-text);
        }
        root.chat-input-text = "";
        root.composer-multiline = false;
        root.composer-line-count = 1;
    }
    in-out property <bool> gif-popover-open: false;

    // Reply mode state
    in-out property <bool> reply-mode: false;
    in-out property <string> reply-to-id: "";
    in-out property <string> reply-to-name: "";

    // Edit mode state
    in-out property <bool> edit-mode: false;
    in-out property <string> edit-message-id: "";

    // New messages pill state
    in-out property <bool> has-new-messages: false;
    in-out property <bool> scroll-to-bottom-request: false;
    // Frames each scroll timer has applied its target on (see the timers).
    property <int> bottom-ticks: 0;
    property <int> unread-ticks: 0;
    property <int> history-ticks: 0;
    /// Open the feed with the unread rule near the top, not at the bottom.
    in-out property <bool> scroll-to-unread-request: false;
    /// Where the unread rule sits in the rows, reported by the rule's row.
    in-out property <length> unread-row-y: 0px;
    in property <int> history-prepended-rows: 0;
    in property <[MentionMemberData]> mention-members: [];
    in property <[MentionMemberData]> mention-suggestions: [];
    in property <[EmojiRowData]> emoji-rows: [];
    in property <[EmojiItemData]> recent-emoji: [];
    in property <[EmojiCategoryData]> emoji-categories: [];
    in-out property <int> emoji-category: 0;
    /// A message id while the picker is choosing a reaction for it.
    in-out property <string> emoji-target-message: "";
    callback react(/* message_id */ string, /* emoji */ string);
    callback emoji-search(/* query */ string);
    callback emoji-category-selected(/* index */ int);
    callback emoji-picked(/* emoji */ string);

    in-out property <bool> emoji-popover-open: false;
    in-out property <string> more-menu-message-id: "";
    in-out property <string> delete-confirm-message-id: "";

    callback message-submitted(/* text */ string);
    callback chat-viewport-changed(/* at_bottom */ bool);
    callback scroll-to-bottom-done();
    callback link-clicked(/* url */ string);
    callback copy-message-text(/* text */ string);
    callback mention-selected(/* user_id */ string, /* display_name */ string);
    callback chat-input-changed(/* text */ string);
    callback history-prepended-done();
    in-out property <string> chat-input-text: "";
    in-out property <int> composer-line-count: 1;
    in-out property <bool> composer-multiline: false;
    in-out property <bool> pending-newline: false;
    callback message-submitted-with-reply(/* text */ string, /* reply_to */ string);
    callback request-history();
    callback gif-pill-clicked();
    callback gif-search(/* query */ string);
    callback gif-selected(/* gif_id */ string, /* url */ string, /* preview_url */ string, /* width */ int, /* height */ int);
    callback gif-hovered(/* url */ string);
    callback emoji-pill-clicked();
    callback edit-message(/* message_id */ string, /* new_body */ string);
    callback delete-message(/* message_id */ string);
    callback reply-to-message(/* message_id */ string, /* sender_name */ string);

    background: Theme.surface;
    border-width: 0px;
    border-radius: 0px;

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding: 0px;
        spacing: 0px;

        // --- Header (matches crew_feed.slint on Theme.bg-app) ---
        Rectangle {
            width: parent.width;
            height: 48px;
            background: Theme.bg-app;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                padding-left: 12px;
                padding-right: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    height: parent.height;
                    horizontal-stretch: 1;
                    alignment: start;

                    Text {
                        font-family: Theme.font-display;
                        text: "Crew chat";
                        font-size: 15px;
                        font-weight: Theme.weight-display;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }

                    if root.messages-this-week > 0: Rectangle {
                        width: msg-badge-text.preferred-width + 20px;
                        height: 22px;
                        border-radius: 11px;
                        background: Theme.card-border;
                        y: (parent.height - self.height) / 2;

                        msg-badge-text := Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: root.messages-this-week == 1
                                ? "1 message this week"
                                : root.messages-this-week + " messages this week";
                            font-size: 11px;
                            color: Theme.text-sub;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.card-border;
        }

        // Header strip = bg-app (crew feed); messages + composer = surface.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0px;

        // --- Chat feed container (for overlay pill) ---
        Rectangle {
            vertical-stretch: 1;

        feed := Flickable {
            // `feed` id is referenced by the rows + the scroll/history timers.
            // A plain Flickable over the loaded window of messages (at most a
            // few hundred rows, see ChatScrollState::WINDOW). Every row has its
            // real height, so content-height is exact: scroll-to-bottom lands
            // on the last message and a history prepend keeps the anchor row
            // still. A virtualized ListView estimates content-height from the
            // rows on screen, and that estimate sent the view to the same row
            // every time.
            width: parent.width;
            height: parent.height;

            property <bool> at-bottom: self.content-height <= self.height
                || (-self.content-y + self.height) >= (self.content-height - 32px);
            // How far from the top the user is: content-y is 0 at the top and
            // goes negative as they scroll down.
            property <bool> at-top: self.content-y >= -8px;
            property <bool> was-at-top: false;
            // Content height captured when older history is requested, so the prepend
            // nudge below can keep the anchor message exactly in place.
            property <length> saved-content-height;
            property <length> saved-content-y;

            changed content-y => {
                root.chat-viewport-changed(self.at-bottom);
                if self.at-top && !self.was-at-top && root.has-more-history && !root.loading-history {
                    self.saved-content-height = self.content-height;
                    self.saved-content-y = self.content-y;
                    root.request-history();
                }
                self.was-at-top = self.at-top;
                if root.more-menu-message-id != "" {
                    root.more-menu-message-id = "";
                }
            }

            // The only child of a Flickable: its preferred height is the
            // content-height, which is why no estimate is involved.
            rows := VerticalLayout {
                width: feed.width;
                // The layout is sized to the feed when the rows are shorter
                // than it. `end` keeps every row at its own height and
                // gathers them at the bottom (spec §4.3, message gravity);
                // without it the rows stretch to fill the empty space.
                alignment: end;

            for msg[idx] in messages: VerticalLayout {
                    width: feed.width;
                    padding-top: msg.is-unread-divider ? 8px : (msg.is-group-start && idx > 0 ? 16px : 2px);

                    // Day separator: a graphite rule with the day in the label
                    // register. Red is for unread; a date is not a state.
                    if msg.day-label != "" && !msg.is-unread-divider: HorizontalLayout {
                        width: parent.width;
                        height: 22px;
                        spacing: 10px;
                        padding-left: 4px;
                        padding-right: 4px;
                        padding-bottom: 6px;

                        Rectangle {
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 1px;
                                width: parent.width;
                                y: (parent.height - self.height) / 2;
                                background: Theme.graphic-light;
                            }
                        }

                        Text {
                            font-family: Theme.font-label;
                            font-weight: Theme.weight-label;
                            letter-spacing: Theme.track-label;
                            text: msg.day-label;
                            font-size: Theme.font-xs;
                            color: Theme.text-secondary;
                            horizontal-stretch: 0;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 1px;
                                width: parent.width;
                                y: (parent.height - self.height) / 2;
                                background: Theme.graphic-light;
                            }
                        }
                    }
                    padding-bottom: idx == messages.length - 1 ? 24px : 0px;

                    // The rule's row reports its place, so the unread timer
                    // can open the feed there.
                    init => { if msg.is-unread-divider { root.unread-row-y = self.y; } }
                    changed y => { if msg.is-unread-divider { root.unread-row-y = self.y; } }

                    // Unread divider — stretch wrappers for lines; inner rect centers 1px rule (y ignored on HL children)
                    if msg.is-unread-divider: HorizontalLayout {
                        width: parent.width;
                        height: 20px;
                        spacing: 8px;
                        padding-left: 4px;
                        padding-right: 4px;
                        padding-bottom: 8px;

                        Rectangle {
                            horizontal-stretch: 1;

                            Rectangle {
                                height: 1px;
                                width: parent.width;
                                y: (parent.height - self.height) / 2;
                                background: Theme.live;
                                opacity: 0.5;
                            }
                        }

                        Text {
                            font-family: Theme.font-display;
                            text: "New messages";
                            font-size: Theme.font-xs;
                            font-weight: Theme.weight-display;
                            color: Theme.accent;
                            horizontal-stretch: 0;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;

                            Rectangle {
                                height: 1px;
                                width: parent.width;
                                y: (parent.height - self.height) / 2;
                                background: Theme.live;
                                opacity: 0.5;
                            }
                        }
                    }

                    // System message
                    if msg.is-system && !msg.is-unread-divider: HorizontalLayout {
                        padding-left: 36px;
                        padding-right: 4px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: msg.text;
                            font-size: Theme.font-sm;
                            color: Theme.text-tertiary;
                            font-italic: true;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // Group start header — full feed width; spacer pushes timestamp right (no alignment:)
                    if !msg.is-system && !msg.is-unread-divider && msg.is-group-start: HorizontalLayout {
                        width: parent.width;
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 8px;

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            horizontal-stretch: 0;

                            UserAvatar {
                                initials: msg.sender-initials;
                                avatar: msg.sender-avatar;
                                has-avatar: msg.has-sender-avatar;
                                // A chat author is not in a coloured list,
                                // so the fallback stays graphite.
                                muted: true;
                                size: 28px;
                                bg-color: Theme.surface;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            font-family: Theme.font-display;
                            text: msg.sender-name;
                            font-size: Theme.font-md;
                            font-weight: Theme.weight-display;
                            color: msg.sender-name == root.user-name ? Theme.accent : Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        if msg.display-time != "": Text {
                            letter-spacing: Theme.track-label;
                            font-weight: Theme.weight-label;
                            text: msg.display-time;
                            font-family: Theme.font-label;
                            font-size: Theme.font-xs;
                            color: Theme.text-tertiary;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                    }

                    // Message row: left gutter (hover actions) + text/reply (media is below)
                    if !msg.is-system && !msg.is-unread-divider
                        && (msg.text != "" || msg.reply-to-id != "" || msg.is-deleted || msg.is-gif || msg.is-clip || msg.is-image): HorizontalLayout {
                        spacing: 8px;
                        width: feed.width;
                        padding-left: 4px;
                        padding-right: 4px;
                        // No `alignment: start`: it would drop the stretch, the
                        // content would be as wide as its text, and the action
                        // bar would sit over the words instead of at the right.
                        property <length> actions-y: 0px;
                        // A click, not a hover: hover was easy to miss and
                        // the bar was gone before the pointer reached it.
                        property <bool> body-hovered: root.actions-message-id == msg.message-id
                            || root.more-menu-message-id == msg.message-id;

                        // Gutter column: keeps the body under the name, next to the avatar.
                        Rectangle {
                            width: 28px;
                        }

                        // Message content
                        Rectangle {
                            horizontal-stretch: 1;
                            background: msg.mentions-self ? (Theme.action-dim) : transparent;
                            border-radius: Theme.radius-sm;




                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;

                            // Reply quote block
                            if msg.reply-to-id != "": HorizontalLayout {
                                spacing: 0px;

                                Rectangle {
                                    width: 3px;
                                    background: Theme.graphic-med;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.bg-tertiary;
                                    border-radius: 4px;

                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 2px;

                                        Text {
                                            font-family: Theme.font-display;
                                            text: "Replying to " + msg.reply-to-name;
                                            font-size: Theme.font-xs;
                                            font-weight: Theme.weight-display;
                                            color: Theme.accent;
                                        }

                                        Text {
                                            font-weight: Theme.weight-sentence;
                                            font-family: Theme.font-body;
                                            text: msg.reply-preview-text;
                                            font-size: Theme.font-xs;
                                            color: Theme.text-tertiary;
                                            wrap: word-wrap;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            // Body text (shown for text messages, or GIF + text)
                            if msg.text != "" && !msg.is-deleted: HorizontalLayout {
                                spacing: 6px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 6px;

                                    // A message of crew emoji only: the images, big.
                                    if msg.crew-emoji.length > 0: HorizontalLayout {
                                        accessible-role: text;
                                        accessible-label: msg.text;
                                        spacing: 6px;
                                        alignment: start;
                                        for img in msg.crew-emoji: Image {
                                            source: img;
                                            width: 48px;
                                            height: 48px;
                                            image-fit: cover;
                                        }
                                    }
                                    if msg.crew-emoji.length == 0: StyledText {
                                        // A StyledText gets no accessible text of its own, as a
                                        // Text does. Without these, a screen reader and the e2e
                                        // driver cannot read the message.
                                        accessible-role: text;
                                        accessible-label: msg.text;
                                        text: msg.display-styled;
                                        default-color: Theme.text-secondary;
                                        // Three emoji or fewer and nothing else: big, as in
                                        // every chat app. A 13px emoji is a smudge.
                                        default-font-size: msg.is-emoji-only ? Theme.font-xxl : Theme.font-md;
                                        horizontal-stretch: 1;
                                    }


                                }

                                if msg.is-edited: Text {
                                    font-weight: Theme.weight-sentence;
                                    font-family: Theme.font-body;
                                    text: "(edited)";
                                    font-size: Theme.font-xs;
                                    color: Theme.text-tertiary;
                                    vertical-alignment: bottom;
                                }
                            }

                            if msg.is-deleted: Text {
                                font-weight: Theme.weight-sentence;
                                font-family: Theme.font-body;
                                text: "[message deleted]";
                                font-size: Theme.font-md;
                                color: Theme.text-tertiary;
                                font-italic: true;
                                wrap: word-wrap;
                            }
                            }

                            // Above the text, so a click anywhere on the message opens the
                            // bar. StyledText takes presses itself, so a target under it
                            // never fires. The link pills sit in their own row below.
                            body-hover := TouchArea {
                                accessible-role: button;
                                accessible-label: "Message actions";
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.actions-message-id =
                                        root.actions-message-id == msg.message-id ? "" : msg.message-id;
                                    root.more-menu-message-id = "";
                                }
                            }

                            if root.more-menu-message-id != "": TouchArea {
                                // a11y: none (click-away: a click outside closes the open message menu)
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.more-menu-message-id = ""; }
                            }

                            // The action bar: React, Reply, More, at the top right of the
                            // message, over the header line, as in every chat app. Drawn
                            // after the text so it takes the pointer first.
                            actions-bar := Rectangle {
                                x: parent.width - self.width - 4px;
                                y: -18px;
                                width: 104px;
                                height: 32px;
                                // Gone, not transparent: an invisible bar takes no clicks.
                                visible: body-hovered;
                                background: transparent;

                                CutButtonShape {
                                    width: parent.width;
                                    height: parent.height;
                                    n: 6px;
                                    fill: Theme.graphic-light;
                                }
                                CutButtonShape {
                                    width: parent.width;
                                    height: parent.height;
                                    n: 6px;
                                    inset: Theme.keyline;
                                    fill: Theme.surface-hover;
                                }

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 4px;
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: react-touch.has-hover ? Theme.bg-tertiary : Theme.surface;

                                        Image {
                                            source: @image-url("../icons/smile.svg");
                                            width: 16px;
                                            height: 16px;
                                            colorize: Theme.text-primary;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        react-touch := TouchArea {
                                            accessible-role: button;
                                            accessible-label: "React";
                                            enabled: body-hovered;
                                            accessible-enabled: body-hovered;
                                            mouse-cursor: pointer;
                                            clicked => { root.pick-reaction-for(msg.message-id); }
                                        }
                                    }

                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 4px;
                                        background: reply-touch.has-hover ? Theme.bg-tertiary : Theme.surface;

                                        Image {
                                            source: @image-url("../icons/reply.svg");
                                            width: 16px;
                                            height: 16px;
                                            colorize: Theme.text-primary;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        reply-touch := TouchArea {
                                            accessible-role: button;
                                            accessible-label: "Reply";
                                            enabled: body-hovered;
                                            accessible-enabled: body-hovered;
                                            clicked => {
                                                root.reply-mode = true;
                                                root.reply-to-id = msg.message-id;
                                                root.reply-to-name = msg.sender-name;
                                            }
                                        }
                                    }

                                    more-menu := MessageMoreMenu {
                                        size: 28px;
                                        active: root.more-menu-message-id == msg.message-id;
                                        open-above: feed.at-bottom && idx >= messages.length - 2;
                                        is-own-message: msg.sender-id == root.user-id;
                                        toggled => {
                                            root.more-menu-message-id =
                                                root.more-menu-message-id == msg.message-id ? "" : msg.message-id;
                                        }
                                        edit-requested => {
                                            root.edit-mode = true;
                                            root.edit-message-id = msg.message-id;
                                            chat-input.text = msg.text;
                                            chat-input.focus();
                                            root.more-menu-message-id = "";
                                        }
                                        delete-requested => {
                                            root.delete-confirm-message-id = msg.message-id;
                                            root.more-menu-message-id = "";
                                        }
                                        copy-requested => {
                                            root.copy-message-text(msg.text);
                                            root.more-menu-message-id = "";
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Media row: full content width under avatar column (not double-guttered)
                    if !msg.is-system && !msg.is-unread-divider && (msg.is-gif || msg.is-clip || msg.is-image): HorizontalLayout {
                        width: feed.width;
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 8px;
                        alignment: start;
                        property <length> media-col-w: feed.width - 44px;

                        Rectangle {
                            width: 28px;
                        }

                        VerticalLayout {
                            width: media-col-w;
                            spacing: 4px;

                            // Images: one under the other, each at most 300px wide,
                            // one cut corner like every card. Click opens the viewer.
                            if msg.is-image: VerticalLayout {
                                spacing: 4px;
                                for img[img-idx] in msg.images: Rectangle {
                                    property <float> aspect: img.height > 0 ? img.width / img.height : 1.33;
                                    property <length> media-w: min(300px, media-col-w);
                                    width: media-w;
                                    height: max(60px, media-w / aspect);
                                    clip: true;
                                    background: img.has-image ? transparent : Theme.bg-app;

                                    if img.has-image: Image {
                                        source: img.image;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: cover;
                                    }

                                    if !img.has-image: Text {
                                        font-weight: Theme.weight-sentence;
                                        font-family: Theme.font-body;
                                        text: img.failed ? "Image not available" : "Loading image…";
                                        font-size: Theme.font-xs;
                                        color: Theme.text-tertiary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }

                                    // The size tag, bottom right, in a black wash over content.
                                    if img.has-image && img.bytes-label != "": Rectangle {
                                        x: parent.width - self.width - 8px;
                                        y: parent.height - self.height - 8px;
                                        width: size-tag.preferred-width + 14px;
                                        height: 20px;
                                        background: #000000B8;
                                        size-tag := Text {
                                            font-family: Theme.font-body;
                                            font-weight: Theme.weight-sentence;
                                            text: img.bytes-label;
                                            font-size: Theme.font-xs;
                                            color: Theme.text-secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }

                                    CutMask {
                                        x: parent.width - self.width;
                                        y: 0;
                                        width: 12px;
                                        height: 12px;
                                        n: 12px;
                                        corner: "tr";
                                        fill: Theme.surface;
                                    }

                                    image-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: "Open image";
                                        enabled: img.has-image;
                                        accessible-enabled: img.has-image;
                                        mouse-cursor: img.has-image ? pointer : default;
                                        clicked => { root.image-clicked(img.url, msg.sender-name); }
                                    }
                                }
                            }

                            if msg.is-clip: ChatClipCard {
                                sender-name: msg.sender-name;
                                clip-duration: msg.clip-duration;
                                width: media-col-w;
                            }

                            if msg.is-gif: Rectangle {
                                property <float> aspect: msg.gif-height > 0 ? msg.gif-width / msg.gif-height : 1.33;
                                property <length> media-w: min(300px, media-col-w);
                                width: media-w;
                                height: media-w / aspect;
                                border-radius: Theme.radius-sm;
                                clip: true;
                                background: msg.has-gif-image ? transparent : Theme.bg-app;

                                if msg.has-gif-image: Image {
                                    source: msg.gif-image;
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: cover;
                                }

                                if !msg.has-gif-image: Text {
                                    font-weight: Theme.weight-sentence;
                                    font-family: Theme.font-body;
                                    text: msg.gif-failed ? "GIF not available" : "Loading GIF…";
                                    font-size: Theme.font-xs;
                                    color: Theme.text-tertiary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                gif-touch := TouchArea {
                                    // a11y: none (hover detector: previews the GIF)
                                    mouse-cursor: pointer;
                                    moved => {
                                        root.gif-hovered(msg.gif-url);
                                    }
                                }
                            }
                        }
                    }

                    // Link pills, under the text in their own row, so the click
                    // target above the text never covers them.
                    if !msg.is-system && !msg.is-unread-divider && msg.links.length > 0: HorizontalLayout {
                        padding-left: 40px;
                        padding-right: 4px;
                        padding-top: 4px;
                        spacing: 6px;
                        alignment: start;

                        for link[idx] in msg.links: LinkPill {
                            url: msg.links[idx].url;
                            label: msg.links[idx].label;
                            clicked(url) => { root.link-clicked(url); }
                        }
                    }

                    // Reactions: emoji and count, the user's own with the white
                    // outline, and a plus that opens the picker for one more.
                    if !msg.is-system && !msg.is-unread-divider && msg.reactions.length > 0: HorizontalLayout {
                        padding-left: 40px;
                        padding-right: 4px;
                        padding-top: 4px;
                        spacing: 6px;
                        alignment: start;

                        for r[ri] in msg.reactions: Rectangle {
                            width: reaction-label.preferred-width + 20px;
                            height: 22px;
                            background: transparent;
                            CutButtonShape {
                                width: parent.width;
                                height: parent.height;
                                n: 4px;
                                fill: r.mine ? Theme.action-line : (reaction-touch.has-hover ? Theme.graphic-med : Theme.surface-hover);
                            }
                            if r.mine: CutButtonShape {
                                width: parent.width;
                                height: parent.height;
                                n: 4px;
                                inset: Theme.keyline;
                                fill: reaction-touch.has-hover ? Theme.graphic-med : Theme.surface;
                            }
                            reaction-label := HorizontalLayout {
                                spacing: 5px;
                                alignment: center;
                                padding-left: 6px;
                                padding-right: 8px;
                                if r.has-image: Image {
                                    source: r.image;
                                    width: 16px;
                                    height: 16px;
                                    image-fit: cover;
                                }
                                if !r.has-image: Text {
                                    text: r.emoji;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    font-family: Theme.font-display;
                                    font-weight: Theme.weight-display;
                                    text: r.count;
                                    font-size: Theme.font-sm;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                            reaction-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: "React " + r.emoji;
                                mouse-cursor: pointer;
                                clicked => { root.react(msg.message-id, r.emoji); }
                            }
                        }

                        Rectangle {
                            width: 24px;
                            height: 22px;
                            background: transparent;
                            CutButtonShape {
                                width: parent.width;
                                height: parent.height;
                                n: 4px;
                                fill: add-reaction-touch.has-hover ? Theme.graphic-med : Theme.surface-hover;
                            }
                            Image {
                                source: @image-url("../icons/plus.svg");
                                width: 10px;
                                height: 10px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Theme.text-secondary;
                            }
                            add-reaction-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: "Add reaction";
                                mouse-cursor: pointer;
                                clicked => { root.pick-reaction-for(msg.message-id); }
                            }
                        }
                    }
                }
            } // close rows
        }

        // Loading-older-history indicator (overlay)
        if root.loading-history: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 32px;
            background: Theme.surface;

            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: "Loading...";
                font-size: Theme.font-sm;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Empty state (overlay, centered)
        if messages.length == 0 && !root.loading-history: Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: "No messages yet";
            font-size: Theme.font-md;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // --- "New messages" floating pill ---
        if root.has-new-messages: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 8px;
            width: 140px;
            height: 28px;
            background: transparent;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000040;

            // Unread is a state, so the pill is red, not white.
            CutButtonShape {
                width: parent.width;
                height: parent.height;
                n: 8px;
                fill: Theme.live;
            }

            new-msg-touch := TouchArea {
                accessible-role: button;
                accessible-label: "New messages";
                clicked => {
                    root.scroll-to-bottom-request = true;
                }
            }

            HorizontalLayout {
                spacing: 5px;
                alignment: center;
                cross-axis-alignment: center;

                Text {
                    font-family: Theme.font-display;
                    text: "New messages";
                    font-size: Theme.font-sm;
                    font-weight: Theme.weight-display;
                    color: Theme.on-live;
                    vertical-alignment: center;
                }
                Image {
                    source: @image-url("../icons/chevron-down.svg");
                    width: 11px;
                    height: 11px;
                    colorize: Theme.on-live;
                }
            }
        }

        // The three scroll timers each apply their target on three frames,
        // because a row the model just got is laid out on the next frame,
        // and a target read before that is one row short.
        scroll-timer := Timer {
            interval: 16ms;
            running: root.scroll-to-bottom-request;
            triggered => {
                feed.content-y = -max(0px, feed.content-height - feed.height);
                root.bottom-ticks += 1;
                if root.bottom-ticks >= 3 {
                    root.bottom-ticks = 0;
                    root.scroll-to-bottom-request = false;
                    root.has-new-messages = false;
                    root.scroll-to-bottom-done();
                }
            }
        }

        unread-timer := Timer {
            interval: 16ms;
            running: root.scroll-to-unread-request;
            triggered => {
                // The rule a little below the top edge, never past the end.
                feed.content-y = -max(0px, min(root.unread-row-y - 24px, feed.content-height - feed.height));
                root.unread-ticks += 1;
                if root.unread-ticks >= 3 {
                    root.unread-ticks = 0;
                    root.scroll-to-unread-request = false;
                }
            }
        }

        history-timer := Timer {
            interval: 16ms;
            running: root.history-prepended-rows > 0;
            triggered => {
                // Keep the anchor message in place. content-y is 0 at the top
                // and negative further down, so new content above the anchor
                // moves it down by the exact growth, and the viewport follows.
                // From the saved values each time, so three applications are one.
                feed.content-y = feed.saved-content-y - (feed.content-height - feed.saved-content-height);
                root.history-ticks += 1;
                if root.history-ticks >= 3 {
                    root.history-ticks = 0;
                    root.history-prepended-done();
                }
            }
        }
        } // close feed container Rectangle

        Rectangle {
            height: 1px;
            background: Theme.graphic-light;
        }

        // --- Composer block (inset padding; panel shell is edge-to-edge) ---
        VerticalLayout {
            spacing: 4px;
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 8px;

        // --- Reply bar ---
        if root.reply-mode: HorizontalLayout {
            height: 28px;
            spacing: 8px;
            padding-left: 12px;
            padding-right: 8px;

            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: "Replying to " + root.reply-to-name;
                font-size: Theme.font-sm;
                color: Theme.accent;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: close-reply-touch.has-hover ? Theme.bg-tertiary : transparent;
                y: (parent.height - self.height) / 2;

                Image {
                    source: @image-url("../icons/x.svg");
                    width: 12px;
                    height: 12px;
                    colorize: Theme.text-tertiary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                close-reply-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Cancel reply";
                    clicked => {
                        root.reply-mode = false;
                        root.reply-to-id = "";
                        root.reply-to-name = "";
                    }
                }
            }
        }

        // --- Edit bar ---
        if root.edit-mode: HorizontalLayout {
            height: 28px;
            spacing: 8px;
            padding-left: 12px;
            padding-right: 8px;

            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: "Editing message";
                font-size: Theme.font-sm;
                color: Theme.accent;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: close-edit-touch.has-hover ? Theme.bg-tertiary : transparent;
                y: (parent.height - self.height) / 2;

                Image {
                    source: @image-url("../icons/x.svg");
                    width: 12px;
                    height: 12px;
                    colorize: Theme.text-tertiary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                close-edit-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Cancel edit";
                    clicked => {
                        root.edit-mode = false;
                        root.edit-message-id = "";
                        chat-input.text = "";
                    }
                }
            }
        }

        // --- Delete confirmation ---
        if root.delete-confirm-message-id != "": Rectangle {
            height: 36px;
            background: Theme.bg-tertiary;
            border-radius: Theme.radius-sm;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: "Delete this message?";
                    font-size: Theme.font-sm;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 56px;
                    height: 24px;
                    border-radius: 4px;
                    background: del-cancel-touch.has-hover ? Theme.graphic-light : transparent;

                    Text {
                        font-weight: Theme.weight-sentence;
                        font-family: Theme.font-body;
                        text: "Cancel";
                        font-size: Theme.font-xs;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    del-cancel-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Cancel";
                        clicked => { root.delete-confirm-message-id = ""; }
                    }
                }

                Rectangle {
                    width: 56px;
                    height: 24px;
                    border-radius: 4px;
                    background: del-ok-touch.has-hover ? Theme.live : Theme.live;

                    Text {
                        font-family: Theme.font-display;
                        text: "Delete";
                        font-size: Theme.font-xs;
                        font-weight: Theme.weight-display;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    del-ok-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Delete";
                        clicked => {
                            root.delete-message(root.delete-confirm-message-id);
                            root.delete-confirm-message-id = "";
                        }
                    }
                }
            }
        }

        // --- @mention autocomplete (suggestions from Rust) ---
        if root.mention-suggestions.length > 0: Rectangle {
            height: min(120px, root.mention-suggestions.length * 32px + 8px);
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.graphic-light;
            border-radius: Theme.r-inner;
            clip: true;

            Flickable {
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    padding: 4px;
                    for m in root.mention-suggestions: Rectangle {
                        height: 30px;
                        background: mention-row-touch.has-hover ? Theme.bg-tertiary : transparent;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;

                            Text {
                                letter-spacing: Theme.track-label;
                                text: m.initials;
                                font-size: 10px;
                                font-family: Theme.font-label;
                                font-weight: 600;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }

                            Text {
                                font-weight: Theme.weight-sentence;
                                font-family: Theme.font-body;
                                text: m.display-name;
                                font-size: Theme.font-sm;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        mention-row-touch := TouchArea {
                            accessible-role: button;
                            accessible-label: m.display-name;
                            clicked => {
                                root.mention-selected(m.user-id, m.display-name);
                            }
                        }
                    }
                }
            }
        }

        // --- Emoji popover ---
        if root.emoji-popover-open: Rectangle {
            height: 320px;
            background: transparent;

            CutShape {
                width: parent.width;
                height: parent.height;
                n: Theme.notch-sm;
                fill: Theme.graphic-light;
            }
            CutShape {
                width: parent.width;
                height: parent.height;
                n: Theme.notch-sm;
                inset: Theme.keyline;
                fill: Theme.surface;
            }

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                // Search, with focus on open.
                Rectangle {
                    height: 32px;
                    background: Theme.bg-app;
                    border-width: 1px;
                    border-color: emoji-search-input.has-focus ? Theme.graphic-med : Theme.graphic-light;

                    emoji-search-input := MelloTextInput {
                        accessible-label: "Search emoji";
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        font-size: Theme.font-md;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        edited => { root.emoji-search(self.text); }
                        init => { self.focus(); }
                        // Escape closes the picker from the search field too.
                        key-pressed(event) => {
                            if event.text == Key.Escape {
                                root.emoji-popover-open = false;
                                root.emoji-target-message = "";
                                chat-input.focus();
                                return accept;
                            }
                            reject
                        }
                    }

                    if emoji-search-input.text == "": Text {
                        font-weight: Theme.weight-sentence;
                        font-family: Theme.font-body;
                        x: 10px;
                        text: "Search emoji";
                        font-size: Theme.font-md;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }
                }

                // The crew's own emoji first (crew quests gift 3), then a "+"
                // for each free slot. Only while not searching.
                if emoji-search-input.text == "" && (CrewEmojiUi.emoji.length > 0 || (CrewEmojiUi.enabled && CrewEmojiUi.free > 0)): VerticalLayout {
                    spacing: 2px;
                    Text {
                        font-family: Theme.font-label;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        text: CrewEmojiUi.crew-name.to-uppercase();
                        font-size: 9px;
                        color: Theme.text-tertiary;
                        height: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    crew-row := HorizontalLayout {
                        spacing: 2px;
                        height: 36px;
                        alignment: start;
                        for e[ei] in CrewEmojiUi.emoji: Rectangle {
                            width: (crew-row.width - 16px) / 9;
                            background: crew-touch.has-hover ? Theme.bg-tertiary : transparent;
                            if e.has-image: Image {
                                source: e.image;
                                width: 26px;
                                height: 26px;
                                image-fit: cover;
                            }
                            if !e.has-image: Text {
                                text: ":" + e.name + ":";
                                font-family: Theme.font-body;
                                font-size: 9px;
                                color: Theme.text-tertiary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                                overflow: elide;
                            }
                            crew-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: ":" + e.name + ":";
                                clicked => { root.pick-emoji(":" + e.name + ":"); }
                            }
                        }
                        for i in (CrewEmojiUi.enabled ? CrewEmojiUi.free : 0): Rectangle {
                            width: (crew-row.width - 16px) / 9;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-width: 1px;
                                border-color: add-touch.has-hover ? Theme.graphic-med : Theme.graphic-light;
                                Text {
                                    text: "+";
                                    font-family: Theme.font-display;
                                    font-size: 16px;
                                    color: Theme.text-dim;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                            add-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: "Add emoji";
                                clicked => {
                                    root.emoji-popover-open = false;
                                    CrewEmojiUi.add-requested();
                                }
                            }
                        }
                    }
                }

                // Recent: one row, newest first. Only while not searching.
                if root.recent-emoji.length > 0 && emoji-search-input.text == "": VerticalLayout {
                    spacing: 2px;
                    Text {
                        font-family: Theme.font-label;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        text: "RECENT";
                        font-size: 9px;
                        color: Theme.text-tertiary;
                        height: 14px;
                        vertical-alignment: center;
                    }
                    recent-row := HorizontalLayout {
                        spacing: 2px;
                        height: 36px;
                        alignment: start;
                        for r[ri] in root.recent-emoji: Rectangle {
                            // Nine cells share the width; a short row keeps the size.
                            width: (recent-row.width - 16px) / 9;
                            background: recent-touch.has-hover ? Theme.bg-tertiary : transparent;
                            Text {
                                text: r.emoji;
                                font-size: 24px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                            recent-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: r.name;
                                clicked => { root.pick-emoji(r.emoji); }
                            }
                        }
                    }
                }

                // The grid: the active category, or the search hits. Nine
                // cells share the width, 24px glyphs. A ListView is right
                // here: every row is the same height, so no estimate lies.
                emoji-grid := ListView {
                    vertical-stretch: 1;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                    for row[row-idx] in root.emoji-rows: HorizontalLayout {
                        height: 38px;
                        width: emoji-grid.visible-width;
                        spacing: 2px;
                        padding-bottom: 2px;
                        alignment: start;

                        for cell[ci] in row.cells: Rectangle {
                            // Nine cells share the width; a short last row keeps the size.
                            width: (emoji-grid.visible-width - 16px) / 9;
                            background: emoji-cell-touch.has-hover ? Theme.bg-tertiary : transparent;

                            // No font-family: Oxanium and Barlow carry no emoji.
                            Text {
                                text: cell.emoji;
                                font-size: 24px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }

                            emoji-cell-touch := TouchArea {
                                accessible-role: button;
                                accessible-label: cell.name;
                                clicked => { root.pick-emoji(cell.emoji); }
                            }
                        }
                    }
                }

                if root.emoji-rows.length == 0 && emoji-search-input.text != "": Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: "No emoji called that";
                    font-size: Theme.font-md;
                    color: Theme.text-tertiary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    height: 60px;
                }

                // Category tabs along the bottom. The active one is white underlined.
                Rectangle {
                    height: 1px;
                    background: Theme.graphic-light;
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 2px;
                    for cat[ci] in root.emoji-categories: Rectangle {
                        horizontal-stretch: 1;
                        property <bool> on: ci == root.emoji-category && emoji-search-input.text == "";
                        Text {
                            text: cat.icon;
                            font-size: 16px;
                            opacity: on || tab-touch.has-hover ? 1 : 0.5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height - 2px;
                        }
                        Rectangle {
                            x: 0;
                            y: parent.height - self.height;
                            width: parent.width;
                            height: 2px;
                            background: on ? Theme.action : transparent;
                        }
                        tab-touch := TouchArea {
                            accessible-role: tab;
                            accessible-label: cat.name;
                            clicked => {
                                emoji-search-input.text = "";
                                root.emoji-category-selected(ci);
                            }
                        }
                    }
                }
            }
        }

        // --- GIF popover ---
        if root.gif-popover-open: GifPopover {
            show: root.gif-popover-open;
            gifs: root.gif-results;
            error: root.gif-error;
            search(query) => { root.gif-search(query); }
            gif-selected(gif-id, url, preview-url, w, h) => {
                root.gif-selected(gif-id, url, preview-url, w, h);
                root.gif-popover-open = false;
            }
            close => { root.gif-popover-open = false; }
        }

        // --- Pending image chips ---
        if root.attachments.length > 0: HorizontalLayout {
            height: 72px;
            spacing: 8px;
            padding-left: 4px;
            padding-top: 4px;
            padding-bottom: 4px;
            alignment: start;

            for a[a-idx] in root.attachments: Rectangle {
                width: 64px;
                height: 64px;
                clip: true;
                background: Theme.bg-app;

                if a.has-thumb: Image {
                    source: a.thumb;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                    opacity: a.state == "ready" ? 1 : 0.45;
                }

                // The word under the thumbnail: size, step, or the reason.
                Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: 16px;
                    background: #000000B8;
                    Text {
                        font-family: Theme.font-body;
                        font-weight: Theme.weight-sentence;
                        text: a.label;
                        font-size: 9px;
                        color: a.state == "failed" ? Theme.live : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width - 4px;
                        height: parent.height;
                        overflow: elide;
                    }
                }

                CutMask {
                    x: parent.width - self.width;
                    y: 0;
                    width: 8px;
                    height: 8px;
                    n: 8px;
                    corner: "tr";
                    fill: Theme.surface;
                }

                // Remove, top right.
                Rectangle {
                    x: parent.width - self.width - 3px;
                    y: 3px;
                    width: 16px;
                    height: 16px;
                    background: #000000CC;
                    Image {
                        source: @image-url("../icons/x.svg");
                        width: 9px;
                        height: 9px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: Theme.text-primary;
                    }
                    TouchArea {
                        accessible-role: button;
                        accessible-label: "Remove image";
                        mouse-cursor: pointer;
                        clicked => { root.attachment-removed(a.id); }
                    }
                }
            }
        }

        // --- Action pills row ---
        HorizontalLayout {
            height: 28px;
            spacing: 4px;
            padding-left: 0px;

            PillButton {
                icon: @image-url("../icons/paperclip.svg");
                label: "Attach";
                clicked => { root.attach-clicked(); }
            }

            PillButton {
                icon: @image-url("../icons/gif.svg");
                label: "GIF";
                active: root.gif-popover-open;
                clicked => {
                    root.gif-popover-open = !root.gif-popover-open;
                    if root.gif-popover-open {
                        root.gif-pill-clicked();
                    }
                }
            }

            PillButton {
                icon: @image-url("../icons/smile.svg");
                label: "Emoji";
                active: root.emoji-popover-open;
                clicked => {
                    root.emoji-target-message = "";
                    root.emoji-popover-open = !root.emoji-popover-open;
                    if root.emoji-popover-open {
                        root.emoji-pill-clicked();
                    }
                }
            }
        }

        // --- Chat input (compact single-line; multiline only after Shift+Enter) ---
        Rectangle {
            property <length> box-height: root.composer-multiline
                ? min(120px, 32px + root.composer-line-count * 20px)
                : 40px;
            height: box-height;

            background: Theme.bg-app;
            border-width: 1px;
            border-color: Theme.graphic-light;

            newline-timer := Timer {
                interval: 0ms;
                running: root.pending-newline;
                triggered => {
                    root.pending-newline = false;
                    root.chat-input-text += "\n";
                    chat-input.set-selection-offsets(
                        root.chat-input-text.character-count,
                        root.chat-input-text.character-count,
                    );
                }
            }

            chat-input := MelloTextInput {
                accessible-label: "Message crewmates";
                changed has-focus => { ChatFocus.input-focused = self.has-focus; }
                text <=> root.chat-input-text;
                x: 18px;
                y: 0;
                width: parent.width - 36px - 34px;
                height: parent.height;
                font-size: Theme.font-md;
                color: Theme.text-primary;
                single-line: !root.composer-multiline;
                wrap: root.composer-multiline ? word-wrap : no-wrap;
                vertical-alignment: root.composer-multiline ? top : center;
                edited => { root.chat-input-changed(self.text); }

                key-pressed(event) => {
                    if event.text == Key.Escape && root.actions-message-id != "" {
                        root.actions-message-id = "";
                        return accept;
                    }
                    if event.text == Key.Escape && (root.emoji-popover-open || root.gif-popover-open) {
                        root.emoji-popover-open = false;
                        root.emoji-target-message = "";
                        root.gif-popover-open = false;
                        return accept;
                    }
                    // Cmd/Ctrl+V with an image on the clipboard: a chip, not text.
                    if (event.modifiers.meta || event.modifiers.control) && event.text == "v" {
                        if root.paste-image() {
                            return accept;
                        }
                        return reject;
                    }
                    if event.text == Key.Return {
                        if event.modifiers.shift {
                            if !root.composer-multiline {
                                root.composer-multiline = true;
                            }
                            root.pending-newline = true;
                            accept
                        } else {
                            root.submit-message();
                            accept
                        }
                    } else {
                        reject
                    }
                }
            }

            if root.chat-input-text == "" && !root.edit-mode: Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                x: 18px;
                y: root.composer-multiline ? 10px : (parent.height - self.height) / 2;
                color: Theme.text-tertiary;
                font-size: Theme.font-md;
                text: "Message crewmates...";
            }

            // Send: red when there is something to send (it commits), graphite
            // when the field is empty. Bottom right, so it stays put as the
            // field grows.
            send-btn := Rectangle {
                property <bool> armed: root.chat-input-text != "" || root.attachments.length > 0;
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                width: 28px;
                height: 28px;
                background: transparent;

                CutButtonShape {
                    width: parent.width;
                    height: parent.height;
                    n: 6px;
                    fill: send-btn.armed ? Theme.live : Theme.surface-hover;
                }
                Image {
                    source: @image-url("../icons/arrow-up.svg");
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: send-btn.armed ? Theme.on-live : Theme.text-tertiary;
                }
                TouchArea {
                    accessible-role: button;
                    accessible-label: "Send";
                    enabled: send-btn.armed;
                    accessible-enabled: send-btn.armed;
                    mouse-cursor: send-btn.armed ? pointer : default;
                    clicked => { root.submit-message(); }
                }
            }
        }
        } // composer block
            } // chat-body VerticalLayout
        } // chat-body Rectangle
    }

    // Full-height left edge (crew panel style); on top so bg-app header does not cover it.
    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Theme.graphic-light;
    }
}

// --- Slint Live Preview (open this file → Preview component) ---
export component Preview inherits ChatPanel {
    width: 400px;
    height: 820px;
    user-name: "bobdev";
    user-id: "u1";
    messages-this-week: 12;
    actions-message-id: "p4";
    has-new-messages: true;
    mention-members: [
        { user-id: "u2", display-name: "oweboweob", initials: "OW" },
        { user-id: "u3", display-name: "k0ji", initials: "K0" },
    ];
    messages: [
        // Grouped messages (continuation)
        {
            message-id: "p1", sender-id: "u2", sender-name: "oweboweob",
            sender-initials: "OW", text: "hey crew, stream at 8?",
            display-text: "hey crew, stream at 8?",
            display-styled: @markdown("hey crew, stream at 8?"),
            timestamp: "May 19, 8:02 PM", display-time: "Yesterday",
            is-group-start: true, day-label: "Yesterday",
        },
        {
            message-id: "p2", sender-id: "u2", sender-name: "oweboweob",
            sender-initials: "OW", text: "bring snacks",
            display-text: "bring snacks",
            display-styled: @markdown("bring snacks"),
            timestamp: "May 19, 8:03 PM", display-time: "",
            is-group-start: false, is-continuation: true,
        },
        // Markdown + link
        {
            message-id: "p3", sender-id: "u1", sender-name: "bobdev",
            reactions: [ { emoji: "😂", count: 2, mine: false }, { emoji: "💀", count: 1, mine: true } ],
            sender-initials: "B0", text: "Check **bold**, *italic*, and https://slint.dev",
            display-text: "Check **bold**, *italic*, and",
            display-styled: @markdown("Check **bold**, *italic*, and"),
            links: [{ url: "https://slint.dev/releases/1.16", label: "slint.dev/releases/1.16" }],
            timestamp: "May 19, 8:05 PM", display-time: "8:05 PM",
            is-group-start: true,
        },
