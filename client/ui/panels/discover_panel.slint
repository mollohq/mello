import { Theme, MelloTextInput } from "../theme.slint";
import { CutShape, CutButtonShape, CutMask } from "../components/cut.slint";
import { UserAvatar } from "../components/avatar.slint";
import { DiscoverCrewData } from "../types.slint";

component DiscoverCrewCard inherits Rectangle {
    in property <string> crew-id;
    in property <string> crew-name;
    in property <string> crew-initials;
    in property <string> crew-description;
    in property <int> member-count;
    in property <int> online-count;
    in property <bool> hero: false;
    in property <image> crew-avatar;
    in property <bool> has-avatar: false;
    callback join-clicked(string);

    background: transparent;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        fill: hero ? (card-touch.has-hover ? #FFFFFF4D : #FFFFFF26)
                   : (card-touch.has-hover ? Theme.graphic-med : Theme.graphic-light);
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        inset: Theme.keyline;
        fill: hero ? (card-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg)
                   : (card-touch.has-hover ? Theme.surface-hover : Theme.surface);
    }

    card-touch := TouchArea {
        mouse-cursor: pointer;
    }

    VerticalLayout {
        padding: hero ? 32px : 24px;
        spacing: 0px;
        alignment: space-between;

        // --- Top section ---
        VerticalLayout {
            spacing: 0px;

            // Card header: icon + name/stats
            HorizontalLayout {
                spacing: 16px;
                height: hero ? 56px : 48px;

                Rectangle {
                    width: hero ? 56px : 48px;
                    height: hero ? 56px : 48px;
                    background: transparent;

                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: hero ? 13px : 11px;
                        fill: hero ? Theme.raised : Theme.graphic-light;
                    }
                    if !root.has-avatar: CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: hero ? 13px : 11px;
                        inset: Theme.keyline;
                        fill: hero ? Theme.action-dim : Theme.bg-app;
                    }

                    if has-avatar: Rectangle {
                        width: parent.width;
                        height: parent.height;
                        clip: true;

                        Image {
                            source: crew-avatar;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                        CutMask {
                            width: parent.width;
                            height: parent.height;
                            n: hero ? 13px : 11px;
                            corner: "tl";
                            fill: root.hero ? Theme.card-bg : Theme.surface;
                        }
                        CutMask {
                            width: parent.width;
                            height: parent.height;
                            n: hero ? 13px : 11px;
                            corner: "br";
                            fill: root.hero ? Theme.card-bg : Theme.surface;
                        }
                    }

                    if !has-avatar: Text {
                        text: crew-initials;
                        font-family: Theme.font-display;
                        font-weight: Theme.weight-display-bold;
                        font-size: hero ? 18px : 15px;
                        color: Theme.text-secondary;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            font-family: Theme.font-body;
                            text: crew-name;
                            font-weight: hero ? 600 : 500;
                            font-size: hero ? 20px : 16px;
                            color: Theme.text-primary;
                            overflow: elide;
                        }

                        if hero && online-count > 0: Rectangle {
                            width: hero-pill-text.preferred-width + 28px;
                            height: 22px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #FFFFFF4D;
                            background: Theme.action-dim;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;

                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.confirm;
                                }

                                hero-pill-text := Text {
                                    letter-spacing: Theme.track-label;
                                    font-weight: Theme.weight-label;
                                    text: "LIVE";
                                    font-family: Theme.font-label;
                                    font-size: 10px;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        font-weight: Theme.weight-label;
                        text: member-count < 10 ? "0" + member-count + " Members" : member-count + " Members";
                        font-family: Theme.font-label;
                        font-size: 11px;
                        letter-spacing: 0.5px;
                        color: Theme.text-tertiary;
                    }
                }
            }

            Rectangle {
                height: hero ? 20px : 14px;
            }

            // Description
            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: crew-description;
                font-size: hero ? 15px : 13px;
                color: Theme.text-secondary;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        // --- Footer ---
        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 16px;
            }

            Rectangle {
                height: 1px;
                background: hero ? #FFFFFF26 : Theme.graphic-light;
            }

            Rectangle {
                height: 14px;
            }

            HorizontalLayout {
                height: 32px;
                spacing: 8px;

                // Online indicator
                HorizontalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;
                    alignment: start;

                    Rectangle {
                        width: online-count >= 2 ? 40px : 24px;
                        height: 24px;

                        UserAvatar {
                            x: 0px;
                            y: 0px;
                            size: 24px;
                            muted: true;
                            bg-color: root.hero ? Theme.card-bg : Theme.surface;
                        }

                        if online-count >= 2: UserAvatar {
                            x: 16px;
                            y: 0px;
                            size: 24px;
                            muted: true;
                            ring: 2px;
                            ring-color: root.hero ? Theme.card-bg : Theme.surface;
                            bg-color: root.hero ? Theme.card-bg : Theme.surface;
                        }
                    }

                    Text {
                        letter-spacing: Theme.track-label;
                        font-weight: Theme.weight-label;
                        text: online-count > 0 ? "+" + online-count + " active" : "No one online";
                        font-family: Theme.font-label;
                        font-size: 11px;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }
                }

                // Join button
                Rectangle {
                    width: join-text.preferred-width + 32px;
                    height: 32px;
                    background: transparent;

                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        fill: join-touch.has-hover ? Theme.confirm-press : Theme.confirm;
                    }

                    join-text := Text {
                        letter-spacing: Theme.track-label;
                        text: hero ? "Join Crew" : "Join";
                        font-family: Theme.font-label;
                        font-size: 12px;
                        font-weight: Theme.weight-label;
                        color: Theme.on-confirm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    join-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            join-clicked(crew-id);
                        }
                    }
                }
            }
        }
    }
}

export component DiscoverPanel inherits Rectangle {
    in property <[DiscoverCrewData]> crews: [];
    in property <[int]> bento-set-bases: [];
    /// The crew the user was in when they opened discover. Empty means
    /// there is nowhere to go back to, so the control is not drawn.
    in property <string> back-to: "";
    callback join-crew(string);
    callback join-invite(string);
    callback back-requested();
    callback load-more();

    background: transparent;

    VerticalLayout {
        spacing: 0px;

        // Discover is a detour, not a destination, so the way out is the
        // first thing on the screen. `back-requested` existed and was wired
        // in main.slint; nothing ever emitted it.
        if root.back-to != "": Rectangle {
            height: 56px;
            background: transparent;
            vertical-stretch: 0;

            Rectangle {
                x: 20px;
                y: (parent.height - self.height) / 2;
                width: back-row.preferred-width + 28px;
                height: 34px;
                background: transparent;

                CutButtonShape {
                    width: parent.width;
                    height: parent.height;
                    n: Theme.cut;
                    fill: back-ta.has-hover ? Theme.action-line : Theme.graphic-light;
                }
                CutButtonShape {
                    width: parent.width;
                    height: parent.height;
                    n: Theme.cut;
                    inset: Theme.keyline;
                    fill: back-ta.has-hover ? Theme.surface-hover : Theme.surface;
                }

                back-row := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../icons/arrow-right.svg");
                        width: 13px;
                        height: 13px;
                        colorize: back-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                        transform-rotation: 180deg;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: "BACK TO " + root.back-to;
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: back-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                back-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.back-requested(); }
                }
            }
        }

    Flickable {
        vertical-stretch: 1;
        flicked => {
            if (-self.viewport-y + self.height) > (self.viewport-height - 400px) {
                root.load-more();
            }
        }

        VerticalLayout {
            width: root.width;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 48px;
            spacing: 0px;

            // --- Invite hero section ---
            Rectangle {
                background: transparent;

                CutShape {
                    width: parent.width;
                    height: parent.height;
                    n: Theme.notch;
                    fill: Theme.graphic-light;
                }
                CutShape {
                    width: parent.width;
                    height: parent.height;
                    n: Theme.notch;
                    inset: Theme.keyline;
                    fill: Theme.surface;
                }

                VerticalLayout {
                    padding: 48px;
                    spacing: 0px;
                    alignment: center;

                    Text {
                        text: "PRIVATE ENTRY";
                        font-family: Theme.font-label;
                        font-size: Theme.font-xs;
                        font-weight: 600;
                        letter-spacing: 1.5px;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 12px;
                    }

                    Text {
                        font-family: Theme.font-body;
                        text: "Join a Private Crew";
                        font-size: Theme.font-xxl;
                        font-weight: 500;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 8px;
                    }

                    Text {
                        font-weight: Theme.weight-sentence;
                        font-family: Theme.font-body;
                        text: "Enter an invite code to join a crew directly.";
                        font-size: Theme.font-lg;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 32px;
                    }

                    Rectangle {
                        height: 52px;

                        HorizontalLayout {
                            x: (parent.width - 520px) / 2;
                            y: 0px;
                            width: 520px;
                            height: 52px;
                            spacing: 12px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.bg-app;
                                border-width: 1px;
                                border-color: invite-input.has-focus ? Theme.accent : Theme.graphic-light;

                                invite-input := MelloTextInput {
                                    x: 20px;
                                    width: parent.width - 40px;
                                    height: parent.height;
                                    font-family: Theme.font-mono;
                                    font-size: 15px;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    accepted => {
                                        if invite-input.text != "" {
                                            join-invite(invite-input.text);
                                            invite-input.text = "";
                                        }
                                    }
                                }

                                if invite-input.text == "": Text {
                                    letter-spacing: Theme.track-label;
                                    font-weight: Theme.weight-label;
                                    x: 20px;
                                    color: Theme.text-tertiary;
                                    font-family: Theme.font-label;
                                    font-size: 15px;
                                    vertical-alignment: center;
                                    text: "e.g. ALPHA-992-K";
                                }
                            }

                            Rectangle {
                                width: join-btn-label.preferred-width + 56px;
                                height: 48px;
                                background: transparent;

                                CutButtonShape {
                                    width: parent.width;
                                    height: parent.height;
                                    n: Theme.cut;
                                    fill: invite-btn-ta.has-hover ? Theme.confirm-press : Theme.confirm;
                                }

                                invite-btn-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if invite-input.text != "" {
                                            join-invite(invite-input.text);
                                            invite-input.text = "";
                                        }
                                    }
                                }

                                join-btn-label := Text {
                                    font-family: Theme.font-display;
                                    text: "Join Crew";
                                    font-weight: Theme.weight-display;
                                    font-size: Theme.font-lg;
                                    color: Theme.on-confirm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 32px;
            }

            Text {
                text: "FEATURED CREWS";
                font-family: Theme.font-label;
                font-size: Theme.font-xs;
                font-weight: 600;
                letter-spacing: 1.5px;
                color: Theme.text-tertiary;
            }

            Rectangle {
                height: 16px;
            }

            // --- Bento grid (repeating 7-item sets) ---
            VerticalLayout {
                spacing: 16px;

                for base in root.bento-set-bases: VerticalLayout {
                    spacing: 16px;

                    // Row A: [hero 2x] [normal 1x]
                    if crews.length > base: HorizontalLayout {
                        height: 280px;
                        spacing: 16px;

                        DiscoverCrewCard {
                            horizontal-stretch: 2;
                            hero: true;
                            crew-id: crews.length > base ? crews[base].id : "";
                            crew-name: crews.length > base ? crews[base].name : "";
                            crew-initials: crews.length > base ? crews[base].initials : "";
                            crew-description: crews.length > base ? crews[base].description : "";
                            member-count: crews.length > base ? crews[base].member-count : 0;
                            online-count: crews.length > base ? crews[base].online-count : 0;
                            crew-avatar: crews.length > base ? crews[base].avatar : @image-url("");
                            has-avatar: crews.length > base ? crews[base].has-avatar : false;
                            join-clicked(id) => { root.join-crew(id); }
                        }

                        DiscoverCrewCard {
                            horizontal-stretch: 1;
                            crew-id: crews.length > base + 1 ? crews[base + 1].id : "";
                            crew-name: crews.length > base + 1 ? crews[base + 1].name : "";
                            crew-initials: crews.length > base + 1 ? crews[base + 1].initials : "";
                            crew-description: crews.length > base + 1 ? crews[base + 1].description : "";
                            member-count: crews.length > base + 1 ? crews[base + 1].member-count : 0;
                            online-count: crews.length > base + 1 ? crews[base + 1].online-count : 0;
                            crew-avatar: crews.length > base + 1 ? crews[base + 1].avatar : @image-url("");
                            has-avatar: crews.length > base + 1 ? crews[base + 1].has-avatar : false;
                            visible: crews.length > base + 1;
                            join-clicked(id) => { root.join-crew(id); }
                        }
                    }

                    // Row B: [normal 1x] [normal 1x] [normal 1x]
                    if crews.length > base + 2: HorizontalLayout {
                        height: 220px;
                        spacing: 16px;

                        DiscoverCrewCard {
                            horizontal-stretch: 1;
                            crew-id: crews[base + 2].id;
                            crew-name: crews[base + 2].name;
                            crew-initials: crews[base + 2].initials;
                            crew-description: crews[base + 2].description;
                            member-count: crews[base + 2].member-count;
                            online-count: crews[base + 2].online-count;
                            crew-avatar: crews[base + 2].avatar;
                            has-avatar: crews[base + 2].has-avatar;
                            join-clicked(id) => { root.join-crew(id); }
                        }

                        DiscoverCrewCard {
                            horizontal-stretch: 1;
                            crew-id: crews.length > base + 3 ? crews[base + 3].id : "";
                            crew-name: crews.length > base + 3 ? crews[base + 3].name : "";
                            crew-initials: crews.length > base + 3 ? crews[base + 3].initials : "";
                            crew-description: crews.length > base + 3 ? crews[base + 3].description : "";
                            member-count: crews.length > base + 3 ? crews[base + 3].member-count : 0;
                            online-count: crews.length > base + 3 ? crews[base + 3].online-count : 0;
                            crew-avatar: crews.length > base + 3 ? crews[base + 3].avatar : @image-url("");
                            has-avatar: crews.length > base + 3 ? crews[base + 3].has-avatar : false;
                            visible: crews.length > base + 3;
                            join-clicked(id) => { root.join-crew(id); }
                        }

                        DiscoverCrewCard {
                            horizontal-stretch: 1;
                            crew-id: crews.length > base + 4 ? crews[base + 4].id : "";
                            crew-name: crews.length > base + 4 ? crews[base + 4].name : "";
                            crew-initials: crews.length > base + 4 ? crews[base + 4].initials : "";
                            crew-description: crews.length > base + 4 ? crews[base + 4].description : "";
                            member-count: crews.length > base + 4 ? crews[base + 4].member-count : 0;
                            online-count: crews.length > base + 4 ? crews[base + 4].online-count : 0;
                            crew-avatar: crews.length > base + 4 ? crews[base + 4].avatar : @image-url("");
                            has-avatar: crews.length > base + 4 ? crews[base + 4].has-avatar : false;
                            visible: crews.length > base + 4;
                            join-clicked(id) => { root.join-crew(id); }
                        }
                    }

                    // Row C: [normal 1x] [hero 2x]
                    if crews.length > base + 5: HorizontalLayout {
                        height: 280px;
                        spacing: 16px;

                        DiscoverCrewCard {
                            horizontal-stretch: 1;
                            crew-id: crews[base + 5].id;
                            crew-name: crews[base + 5].name;
                            crew-initials: crews[base + 5].initials;
                            crew-description: crews[base + 5].description;
                            member-count: crews[base + 5].member-count;
                            online-count: crews[base + 5].online-count;
                            crew-avatar: crews[base + 5].avatar;
                            has-avatar: crews[base + 5].has-avatar;
                            join-clicked(id) => { root.join-crew(id); }
                        }

                        DiscoverCrewCard {
                            horizontal-stretch: 2;
                            hero: true;
                            crew-id: crews.length > base + 6 ? crews[base + 6].id : "";
                            crew-name: crews.length > base + 6 ? crews[base + 6].name : "";
                            crew-initials: crews.length > base + 6 ? crews[base + 6].initials : "";
                            crew-description: crews.length > base + 6 ? crews[base + 6].description : "";
                            member-count: crews.length > base + 6 ? crews[base + 6].member-count : 0;
                            online-count: crews.length > base + 6 ? crews[base + 6].online-count : 0;
                            crew-avatar: crews.length > base + 6 ? crews[base + 6].avatar : @image-url("");
                            has-avatar: crews.length > base + 6 ? crews[base + 6].has-avatar : false;
                            visible: crews.length > base + 6;
                            join-clicked(id) => { root.join-crew(id); }
                        }
                    }
                }
            }
        }
    }
    }
}

// Headless preview:
//   slint-viewer --screenshot out.png --component Preview \
//     client/ui/panels/discover_panel.slint
export component Preview inherits Rectangle {
    width: 1100px;
    height: 900px;
    background: Theme.bg-app;

    DiscoverPanel {
        width: parent.width;
        height: parent.height;
        back-to: "M3LLO CREW";
        bento-set-bases: [0];
        crews: [
            { id: "1", name: "Night Stones", initials: "NI", description: "Late-night CS2 and too much Valorant.",
              member-count: 24, max-members: 50, online-count: 6, open: true },
            { id: "2", name: "Deep Space", initials: "DS", description: "Apex, OW2 and the occasional CoD night.",
              member-count: 12, max-members: 30, online-count: 2, open: true },
            { id: "3", name: "Quiet Squad", initials: "QS", description: "No mic, no problem.",
              member-count: 8, max-members: 20, online-count: 0, open: true },
            { id: "4", name: "Neon Syndicate", initials: "NS", description: "Ranked grinders only.",
              member-count: 41, max-members: 50, online-count: 11, open: true },
            { id: "5", name: "Butthole Surfers", initials: "BS", description: "It is what it says.",
              member-count: 5, max-members: 25, online-count: 1, open: true },
            { id: "6", name: "Devs", initials: "DE", description: "We ship on Fridays.",
              member-count: 23, max-members: 40, online-count: 3, open: true },
            { id: "7", name: "Music", initials: "MU", description: "Production, sample swaps, listening parties.",
              member-count: 15, max-members: 40, online-count: 4, open: true },
        ];
    }
}
