import { Theme } from "../theme.slint";
import { YouStripData } from "../types.slint";
import { GameIcon } from "../components/game_icon.slint";
import { CutShape } from "../components/cut.slint";

component FormPip inherits Rectangle {
    in property <string> letter;

    width: 17px;
    height: 17px;
    border-radius: 3px;
    background: letter == "W" ? Theme.action
              : letter == "L" ? Theme.live-bg
              : Theme.raised;

    Text {
        text: letter;
        font-family: Theme.font-label;
        font-size: 9px;
        font-weight: Theme.weight-label;
        color: letter == "W" ? Theme.on-action
             : letter == "L" ? Theme.live
             : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StatCell inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    in property <color> value-color: Theme.text-primary;

    alignment: center;
    spacing: 2px;

    Text {
        text: value;
        font-family: Theme.font-display;
        font-size: 17px;
        font-weight: Theme.weight-display;
        letter-spacing: -0.2px;
        color: value-color;
        horizontal-alignment: center;
    }

    Text {
        text: label;
        font-family: Theme.font-label;
        font-size: 8.5px;
        font-weight: Theme.weight-label;
        letter-spacing: Theme.track-label;
        color: Theme.text-secondary;
        horizontal-alignment: center;
    }
}

// Personal stats card pinned to the top of the crew feed. Only the viewer sees
// it. Hidden (zero height) until the viewer has tracked game stats.
// Tapping it opens the full per-game stats profile (spec 19 A2).
export component YouStrip inherits Rectangle {
    in property <YouStripData> data;

    callback clicked();

    height: data.has-stats ? 92px : 0px;
    visible: data.has-stats;
    background: transparent;

    Rectangle {
        x: 16px;
        y: 8px;
        width: parent.width - 32px;
        height: 76px;
        background: transparent;
        border-width: 0px;

        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            corner: "tr";
            fill: strip-ta.has-hover ? Theme.graphic-med : Theme.card-border;
        }
        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            corner: "tr";
            inset: Theme.keyline;
            fill: strip-ta.has-hover ? Theme.card-bg-hover : Theme.card-bg;
        }

        strip-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }

        HorizontalLayout {
            padding: 14px;
            spacing: 14px;

            // Game icon, badge fallback (vertically centered via the layout).
            VerticalLayout {
                alignment: center;
                GameIcon {
                    game-id: data.game-id;
                    short-name: data.short-name;
                    badge-color: data.game-color;
                    size: 40px;
                }
            }

            // Game name + recent form.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;

                Text {
                    text: "YOUR STATS";
                    font-family: Theme.font-label;
                    font-size: 8.5px;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-kicker;
                    color: Theme.text-secondary;
                }

                Text {
                    text: data.game-name;
                    font-family: Theme.font-display;
                    font-size: 14px;
                    font-weight: Theme.weight-display;
                    letter-spacing: -0.1px;
                    color: Theme.text-primary;
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for pip in data.recent-form: FormPip {
                        letter: pip;
                    }
                }
            }

            // Headline stats.
            HorizontalLayout {
                spacing: 20px;

                StatCell {
                    value: data.streak-text;
                    label: "streak";
                    value-color: data.streak-positive ? Theme.text-primary : Theme.live;
                }

                StatCell {
                    value: data.win-rate-text;
                    label: "win rate";
                }

                StatCell {
                    value: data.record-text;
                    label: "record";
                    value-color: Theme.text-secondary;
                }
            }

            // Tap affordance → full stats profile.
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 14px;
                    height: 14px;
                    Image {
                        source: @image-url("../icons/chevron-down.svg");
                        width: 14px;
                        height: 14px;
                        rotation-angle: -90deg;
                        colorize: strip-ta.has-hover ? Theme.text-secondary : Theme.text-tertiary;
                    }
                }
            }
        }
    }
}

// Slint live-preview harness with mock data (win streak + loss skid variants).
export component Preview inherits Rectangle {
    width: 680px;
    height: 210px;
    background: #111114;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        YouStrip {
            data: {
                has-stats: true,
                game-id: "counter-strike-2",
                game-name: "Counter-Strike 2",
                short-name: "CS2",
                game-color: #DE9B35,
                streak-text: "W4",
                streak-positive: true,
                record-text: "12W 5L",
                win-rate-text: "62%",
                recent-form: ["W", "W", "L", "W", "D", "W"],
            };
        }

        YouStrip {
            data: {
                has-stats: true,
                game-id: "valorant",
                game-name: "Valorant",
                short-name: "VAL",
                game-color: #FF4655,
                streak-text: "L3",
                streak-positive: false,
                record-text: "8W 11L",
                win-rate-text: "42%",
                recent-form: ["L", "W", "L", "L", "D", "L"],
            };
        }
    }
}
