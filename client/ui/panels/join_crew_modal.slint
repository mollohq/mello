import { Theme } from "../theme.slint";
import { CutShape, CutButtonShape } from "../components/cut.slint";
import { UserAvatar } from "../components/avatar.slint";
import { InvitePersonData } from "../types.slint";

export component JoinCrewModal inherits Rectangle {
    in property <string> crew-name: "";
    /// Two letters for the crew tile. The full name does not fit the box.
    in property <string> crew-initials: "";
    in property <string> crew-id: "";
    in property <string> highlight: "";
    in property <string> avatar-seed: "";
    /// 0 when the resolve answer has no count: the sub line then omits it.
    in property <int> member-count: 0;
    /// Who made the invite. An empty name means no inviter: no inviter line.
    in property <InvitePersonData> inviter;
    /// Why the invite could not be loaded. Replaces the crew card.
    in property <string> error: "";
    in property <bool> loading: false;
    /// A join request is in flight.
    in property <bool> joining: false;
    /// Why the last join failed. Shown on the crew card, above the button.
    in property <string> join-error: "";

    callback join-requested();
    callback dismiss-requested();

    property <string> members-text: member-count <= 0 ? ""
        : member-count == 1 ? "1 member" : member-count + " members";
    /// "4 members · 7h hangout · 3 clips"
    property <string> sub-line: members-text
        + (members-text != "" && highlight != "" ? " · " : "")
        + highlight;

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    // Close on background click
    bg-touch := TouchArea {
        // a11y: none (backdrop: a click outside the dialog closes it)
        clicked => { dismiss-requested(); }
    }

    // Center card
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 360px;
        height: content.preferred-height + 64px;
        background: transparent;

        // A modal panel is a card, so it carries the cut and a keyline.
        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            fill: Theme.graphic-light;
        }
        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            inset: Theme.keyline;
            fill: Theme.surface;
        }

        card-touch := TouchArea {
            // a11y: none (input blocker: stops clicks reaching the backdrop)
        }

        content := VerticalLayout {
            padding: 32px;
            spacing: 16px;
            alignment: center;

            if loading: VerticalLayout {
                spacing: 16px;
                alignment: center;

                // Skeleton avatar
                Rectangle {
                    width: 96px;
                    height: 96px;
                    border-radius: 20px;
                    background: Theme.skel-element;
                    x: (parent.width - self.width) / 2;
                }
                // Skeleton name
                Rectangle {
                    width: 160px;
                    height: 24px;
                    border-radius: 4px;
                    background: Theme.skel-element;
                    x: (parent.width - self.width) / 2;
                }
                // Skeleton counts
                Rectangle {
                    width: 120px;
                    height: 16px;
                    border-radius: 4px;
                    background: Theme.skel-element;
                    x: (parent.width - self.width) / 2;
                }
            }

            if !loading && error != "": VerticalLayout {
                spacing: 20px;
                alignment: center;

                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: error;
                    font-size: Theme.font-lg;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 44px;
                    width: 160px;
                    x: (parent.width - self.width) / 2;
                    background: transparent;

                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        fill: dismiss-touch.has-hover ? Theme.graphic-med : Theme.graphic-light;
                    }

                    Text {
                        font-family: Theme.font-display;
                        text: "Dismiss";
                        font-size: Theme.font-md;
                        font-weight: Theme.weight-display;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    dismiss-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Dismiss";
                        mouse-cursor: pointer;
                        clicked => { dismiss-requested(); }
                    }
                }
            }

            if !loading && error == "": VerticalLayout {
                spacing: 16px;
                alignment: center;

                // The inviter is a person, so an octagon.
                if root.inviter.name != "": HorizontalLayout {
                    // 24px to the crew tile, as in the design.
                    padding-bottom: 8px;
                    spacing: 8px;
                    alignment: center;
                    cross-axis-alignment: center;

                    UserAvatar {
                        size: 22px;
                        initials: root.inviter.initials;
                        color-index: root.inviter.color-index;
                        bg-color: Theme.surface;
                    }

                    inviter-text := Text {
                        font-family: Theme.font-body;
                        text: root.inviter.name + " invited you";
                        font-size: Theme.font-lg;
                        font-weight: Theme.weight-sentence;
                        color: Theme.text-secondary;
                        overflow: elide;
                    }
                }

                // Avatar placeholder (circle with initials from seed)
                Rectangle {
                    width: 96px;
                    height: 96px;
                    x: (parent.width - self.width) / 2;
                    background: transparent;

                    // A crew is a thing, so it wears the two-corner tile.
                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: 21px;
                        fill: Theme.raised;
                    }

                    Text {
                        font-family: Theme.font-display;
                        text: crew-initials != "" ? crew-initials : "?";
                        font-size: 30px;
                        font-weight: Theme.weight-display-bold;
                        color: Theme.text-secondary;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Crew name
                Text {
                    font-family: Theme.font-display;
                    text: crew-name;
                    font-size: Theme.font-xxl;
                    font-weight: Theme.weight-display-bold;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                if root.sub-line != "": sub-line-text := Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: root.sub-line;
                    font-size: Theme.font-md;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }

                // Same treatment as the error line in riot_link_modal.slint.
                if join-error != "": join-error-text := Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: join-error;
                    font-size: Theme.font-md;
                    color: Theme.live;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                // Spacer
                Rectangle { height: 8px; }

                // Join button
                Rectangle {
                    height: 48px;
                    width: 200px;
                    x: (parent.width - self.width) / 2;
                    background: transparent;

                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        fill: join-touch.has-hover || joining ? Theme.confirm-press : Theme.confirm;
                    }

                    Text {
                        font-family: Theme.font-display;
                        text: joining ? "Joining…" : "Join crew";
                        font-size: Theme.font-lg;
                        font-weight: Theme.weight-display;
                        color: Theme.on-confirm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    join-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Join crew";
                        enabled: !joining;
                        mouse-cursor: joining ? default : pointer;
                        clicked => { join-requested(); }
                    }
                }

                // Not now link
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: "Not now";
                    font-size: Theme.font-md;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;

                    not-now-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Not now";
                        mouse-cursor: pointer;
                        clicked => { dismiss-requested(); }
                    }
                }
            }
        }
    }
}

// Headless preview:
//   slint-viewer --screenshot out.png --component Preview \
//     client/ui/panels/join_crew_modal.slint
export component Preview inherits Rectangle {
    width: 900px;
    height: 640px;
    background: Theme.bg-app;

    JoinCrewModal {
        width: parent.width;
        height: parent.height;
        crew-name: "Night Stones";
        crew-initials: "NI";
        crew-id: "c1";
        highlight: "7h hangout · 3 clips";
        member-count: 4;
        inviter: { name: "alice", initials: "AL", color-index: 1 };
        join-error: "Could not join the crew. Try again.";
    }
}
