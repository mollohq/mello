import { Theme } from "../theme.slint";
import { CutShape, CutButtonShape } from "../components/cut.slint";

export component JoinCrewModal inherits Rectangle {
    in property <string> crew-name: "";
    /// Two letters for the crew tile. The full name does not fit the box.
    in property <string> crew-initials: "";
    in property <string> crew-id: "";
    in property <string> highlight: "";
    in property <string> avatar-seed: "";
    in property <string> error: "";
    in property <bool> loading: false;

    callback join-requested();
    callback dismiss-requested();

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    // Close on background click
    bg-touch := TouchArea {
        clicked => { dismiss-requested(); }
    }

    // Center card
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 360px;
        height: content.preferred-height + 64px;
        background: transparent;

        // A modal panel is a card, so it carries the cut and a keyline.
        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            fill: Theme.graphic-light;
        }
        CutShape {
            width: parent.width;
            height: parent.height;
            n: Theme.notch;
            inset: Theme.keyline;
            fill: Theme.surface;
        }

        card-touch := TouchArea {}

        content := VerticalLayout {
            padding: 32px;
            spacing: 16px;
            alignment: center;

            if loading: VerticalLayout {
                spacing: 16px;
                alignment: center;

                // Skeleton avatar
                Rectangle {
                    width: 96px;
                    height: 96px;
                    border-radius: 20px;
                    background: Theme.skel-element;
                    x: (parent.width - self.width) / 2;
                }
                // Skeleton name
                Rectangle {
                    width: 160px;
                    height: 24px;
                    border-radius: 4px;
                    background: Theme.skel-element;
                    x: (parent.width - self.width) / 2;
                }
                // Skeleton counts
                Rectangle {
                    width: 120px;
                    height: 16px;
                    border-radius: 4px;
                    background: Theme.skel-element;
                    x: (parent.width - self.width) / 2;
                }
            }

            if !loading && error != "": VerticalLayout {
                spacing: 20px;
                alignment: center;

                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: "This invite link is no longer valid.";
                    font-size: Theme.font-lg;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 44px;
                    width: 160px;
                    x: (parent.width - self.width) / 2;
                    background: transparent;

                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        fill: dismiss-touch.has-hover ? Theme.graphic-med : Theme.graphic-light;
                    }

                    Text {
                        font-family: Theme.font-display;
                        text: "Dismiss";
                        font-size: Theme.font-md;
                        font-weight: Theme.weight-display;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    dismiss-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { dismiss-requested(); }
                    }
                }
            }

            if !loading && error == "": VerticalLayout {
                spacing: 16px;
                alignment: center;

                // Avatar placeholder (circle with initials from seed)
                Rectangle {
                    width: 96px;
                    height: 96px;
                    x: (parent.width - self.width) / 2;
                    background: transparent;

                    // A crew is a thing, so it wears the two-corner tile.
                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: 21px;
                        fill: Theme.raised;
                    }

                    Text {
                        font-family: Theme.font-display;
                        text: crew-initials != "" ? crew-initials : "?";
                        font-size: 30px;
                        font-weight: Theme.weight-display-bold;
                        color: Theme.text-secondary;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Crew name
                Text {
                    font-family: Theme.font-display;
                    text: crew-name;
                    font-size: Theme.font-xxl;
                    font-weight: Theme.weight-display-bold;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                if highlight != "": Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: highlight;
                    font-size: Theme.font-md;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }

                // Spacer
                Rectangle { height: 8px; }

                // Join button
                Rectangle {
                    height: 48px;
                    width: 200px;
                    x: (parent.width - self.width) / 2;
                    background: transparent;

                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        fill: join-touch.has-hover ? Theme.confirm-press : Theme.confirm;
                    }

                    Text {
                        font-family: Theme.font-display;
                        text: "Join crew";
                        font-size: Theme.font-lg;
                        font-weight: Theme.weight-display;
                        color: Theme.on-confirm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    join-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { join-requested(); }
                    }
                }

                // Not now link
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: "Not now";
                    font-size: Theme.font-md;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;

                    not-now-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { dismiss-requested(); }
                    }
                }
            }
        }
    }
}

// Headless preview:
//   slint-viewer --screenshot out.png --component Preview \
//     client/ui/panels/join_crew_modal.slint
export component Preview inherits Rectangle {
    width: 900px;
    height: 640px;
    background: Theme.bg-app;

    JoinCrewModal {
        width: parent.width;
        height: parent.height;
        crew-name: "Night Stones";
        crew-initials: "NI";
        crew-id: "c1";
    }
}
