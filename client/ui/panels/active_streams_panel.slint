import { Theme } from "../theme.slint";
import { CutShape, CutButtonShape, CutMask } from "../components/cut.slint";
import { UserAvatar } from "../components/avatar.slint";
import { SmallToggle } from "../components/small_toggle.slint";
import { MemberVolumeSlider } from "member_volume_popover.slint";
import { StreamCardData, VideoRect, StreamCardUi, StreamStatsData } from "../types.slint";
import { StreamTag, PlayButton, FootageWash, MediaChip } from "../components/stream_hero.slint";
import { GameIcon } from "../components/game_icon.slint";

/// The size of the stream card while the viewer watches. The picture is
/// 16:9 at the card's width inside the keylines, with no black bars; the
/// stats strip (when shown) and the footer go under it. The panel and the
/// feed read the height here, so both use one formula.
export global StreamCardSize {
    out property <length> footer: 72px;
    out property <length> stats: 40px;
    out property <length> grid-row: 300px;
    out property <length> grid-gap: 12px;

    /// The height of the watched card at this width.
    public pure function card-height(width: length) -> length {
        return Theme.keyline + (width - 2 * Theme.keyline) * 9 / 16
            + (StreamCardUi.stats-shown ? StreamCardSize.stats : 0px)
            + StreamCardSize.footer;
    }

    /// The row height of the two-column grid at this panel width while the
    /// viewer watches: the watched card must fit its row.
    public pure function watch-row(width: length) -> length {
        return max(StreamCardSize.grid-row,
            StreamCardSize.card-height((width - StreamCardSize.grid-gap) / 2));
    }

    /// The height of the panel at this width while the viewer watches: one
    /// card, or the grid of `count` cards.
    public pure function watch-height(width: length, count: int) -> length {
        return count <= 1 ? StreamCardSize.card-height(width)
            : floor((count + 1) / 2) * StreamCardSize.watch-row(width)
                + (floor((count + 1) / 2) - 1) * StreamCardSize.grid-gap;
    }
}

component StreamIconButton inherits Rectangle {
    in property <image> icon;
    /// Accessible label: what the button does, for screen readers and the e2e driver.
    in property <string> label;
    /// Stage 9: the popover this button opens is open (the design system's
    /// toggle-on state: a white keyline, a white icon).
    in property <bool> on: false;
    callback clicked();

    width: 32px;
    height: 32px;
    background: transparent;

    if root.on: CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: 7px;
        fill: Theme.action-line;
    }
    if root.on: CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: 7px;
        inset: Theme.keyline;
        fill: Theme.surface;
    }
    if !root.on && btn-hover.has-hover: CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: 7px;
        fill: Theme.graphic-light;
    }
    if !root.on && btn-hover.has-hover: CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: 7px;
        inset: Theme.keyline;
        fill: Theme.surface-hover;
    }

    Image {
        source: icon;
        colorize: root.on ? Theme.text-primary : Theme.text-secondary;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    btn-hover := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Stage 9: one value of the stats strip: a kicker and a value.
component StreamStatCell inherits VerticalLayout {
    in property <string> kicker;
    in property <string> value;

    horizontal-stretch: 1;
    alignment: center;
    spacing: 2px;

    Text {
        text: root.kicker;
        font-family: Theme.font-label;
        font-size: 9px;
        font-weight: Theme.weight-label;
        letter-spacing: Theme.track-label;
        color: Theme.text-secondary;
        overflow: elide;
    }

    Text {
        text: root.value;
        font-family: Theme.font-label;
        font-size: 11px;
        font-weight: Theme.weight-label;
        color: Theme.text-primary;
        overflow: elide;
    }
}

/// The streamer and the game: the octagon, the name, and under it the
/// game's icon tile and name (mockup frame C, placement B of 2026-11-06).
/// Without a catalogue game, what the host called the stream. On the
/// bottom wash of a picture the name stands alone; in the card's footer
/// the state tag (with the count) and the format chip stand beside it.
component StreamerLine inherits HorizontalLayout {
    in property <StreamCardData> card;
    /// The footer's state tag ("LIVE", "YOU ARE LIVE", "STARTING", ...).
    /// Empty: no tag.
    in property <string> tag: "";
    /// Red: live, or the link is down right now.
    in property <bool> tag-live: false;
    /// How many watch, on the tag. Empty: no count.
    in property <string> tag-count: "";
    /// The picture's format ("720p60"). Empty: no chip.
    in property <string> format: "";
    /// Added to the game line after a middot ("12 watching"): a narrow
    /// footer has no room for the count on the tag.
    in property <string> game-suffix: "";

    property <string> game-text: root.card.game-name != "" ? root.card.game-name : root.card.subtitle;

    spacing: 12px;
    cross-axis-alignment: center;

    Rectangle {
        width: 40px;
        height: 40px;
        UserAvatar {
            bg-color: #000000;
            initials: root.card.avatar-initials;
            avatar: root.card.avatar;
            has-avatar: root.card.has-avatar;
            color-index: root.card.avatar-color-index;
            size: 40px;
        }
    }
    VerticalLayout {
        // The column takes the width it is given: a narrow footer elides
        // the game line instead of widening the column past the clip.
        min-width: 0px;
        alignment: center;
        spacing: 5px;
        HorizontalLayout {
            spacing: 10px;
            // Items keep their width and the room is left at the end;
            // a spacer would cost one more gap in a narrow footer.
            alignment: start;
            cross-axis-alignment: center;
            Text {
                text: root.card.streamer-name;
                font-family: Theme.font-display;
                font-weight: Theme.weight-display;
                font-size: 17px;
                color: Theme.text-primary;
                overflow: elide;
                // The name keeps 96 px before it elides.
                min-width: min(self.preferred-width, 96px);
            }
            if root.tag != "": StreamTag {
                label: root.tag;
                live: root.tag-live;
                count: root.tag-count;
                count-label: "WATCHING";
            }
            if root.format != "": MediaChip {
                Text {
                    text: root.format;
                    font-family: Theme.font-label;
                    font-weight: Theme.weight-label;
                    font-size: 9px;
                    letter-spacing: 1.4px;
                    color: #A2A2A8;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;
            if root.card.game-name != "": Rectangle {
                width: 18px;
                height: 18px;
                GameIcon {
                    size: 18px;
                    short-name: root.card.game-monogram;
                    runtime-icon: root.card.game-icon;
                    has-runtime-icon: root.card.has-game-icon;
                    bg-color: #000000;
                    badge-color: Theme.raised;
                }
            }
            // The game name elides; the count after it stays whole
            // ("Counter-Str… · 12 watching").
            HorizontalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 0px;
                if root.game-text != "": Text {
                    text: root.game-text;
                    font-family: Theme.font-body;
                    font-weight: Theme.weight-sentence;
                    font-size: 13px;
                    color: #C9C9CF;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                if root.game-suffix != "": Text {
                    text: root.game-text == "" ? root.game-suffix : " · " + root.game-suffix;
                    font-family: Theme.font-body;
                    font-weight: Theme.weight-sentence;
                    font-size: 13px;
                    color: #C9C9CF;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    width: self.preferred-width;
                }
            }
        }
    }
}

/// One stream of the strips card (mockup frames D and G): its picture, the
/// play ring, the streamer and the game on the bottom wash.
component StreamStrip inherits Rectangle {
    in property <StreamCardData> card;
    in property <length> ring: 56px;
    callback watch-clicked();

    clip: true;
    background: Theme.raised;

    if root.card.picture-kind != "": Image {
        width: parent.width;
        height: parent.height;
        source: root.card.picture;
        image-fit: cover;
    }
    if root.card.picture-kind == "": Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(135deg, #2A2140 0%, Theme.card-bg-inset 100%);
        Text {
            text: root.card.game-monogram;
            font-family: Theme.font-display;
            font-weight: Theme.weight-display-bold;
            font-size: parent.height * 0.42;
            color: #FFFFFF12;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    FootageWash { width: parent.width; height: parent.height; }

    PlayButton {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.44 - self.height / 2;
        size: root.ring;
        hover: strip-touch.has-hover;
    }

    StreamerLine {
        x: 18px;
        y: parent.height - self.height - 16px;
        width: self.preferred-width;
        height: self.preferred-height;
        card: root.card;
    }

    strip-touch := TouchArea {
        accessible-role: button;
        accessible-label: "Watch " + root.card.streamer-name;
        mouse-cursor: pointer;
        clicked => { root.watch-clicked(); }
    }
}

/// Two or three streams you have not joined share one card: strips, one
/// above the other, and one tag that says how many stream.
component LiveStripsCard inherits Rectangle {
    in property <[StreamCardData]> cards;
    callback watch-stream-clicked(string, string, int, int);

    background: transparent;

    CutShape {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "br"; inset: Theme.keyline;
        fill: #000000;
    }
    VerticalLayout {
        padding: Theme.keyline;
        spacing: 2px;
        for c in root.cards: StreamStrip {
            card: c;
            ring: root.cards.length > 2 ? 48px : 56px;
            watch-clicked => {
                root.watch-stream-clicked(c.host-id, c.session-id, c.stream-width, c.stream-height);
            }
        }
    }
    CutMask {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "br";
        fill: Theme.bg-app;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: Theme.card-border;
        stroke-width: 1px;
        commands: "M \{self.width / 1px} \{(self.height - Theme.notch) / 1px} L \{(self.width - Theme.notch) / 1px} \{self.height / 1px}";
    }
    StreamTag {
        x: 18px;
        y: 14px;
        label: "LIVE";
        live: true;
        count: root.cards.length;
        count-label: "STREAMING";
    }
}

component StreamCard inherits Rectangle {
    in property <StreamCardData> card;
    in property <bool> is-watching: false;
    in property <bool> is-hosting: false;
    in property <string> active-streamer-id: "";
    in property <image> stream-frame;
    in property <float> stream-ui-render-fps: 0.0;
    in property <length> media-height: 186px;
    in property <float> viewport-abs-y: 0;
    in property <float> viewport-height: 0;
    /// Viewer pause UX: the watched host tabbed out. Shows a pause card
    /// over the (detached) video area instead of a frozen frame.
    in property <bool> stream-paused: false;
    /// Why the stream paused ("minimized", "waiting", "failed", "unknown").
    /// Selects the pause card copy; a game that is still loading is not
    /// "paused".
    in property <string> stream-paused-reason: "";


    callback watch-stream-clicked(string, string, int, int);
    callback stop-stream-clicked();
    callback stop-watching-clicked();

    // Stage 6 (streaming-quality): the card's session state. A notice card
    // ("ended", "failed") says for a few seconds why a stream stopped.
    property <bool> is-notice: card.state == "ended" || card.state == "failed";
    property <bool> starting: card.state == "starting" || root.viewer-starting;
    property <bool> reconnecting: card.state == "reconnecting";
    property <bool> selected-card: !is-notice && ((is-watching && card.host-id == active-streamer-id) || (is-hosting && !card.can-watch));
    /// Pause card copy, by why the stream paused. One place: a minimized
    /// game, one still loading, and one no method can see are three
    /// different sentences.
    property <string> pause-title:
        stream-paused-reason == "waiting" ? card.streamer-name + " is getting the game ready" :
        stream-paused-reason == "failed" ? card.streamer-name + "'s game isn't visible" :
        card.streamer-name + " paused the stream";
    property <string> pause-subtitle:
        stream-paused-reason == "waiting" ? "Video starts when the game draws its first frame" :
        stream-paused-reason == "failed" ? "The stream resumes when capture finds the game" :
        "Video resumes when they're back in game";
    property <bool> show-live-frame: selected-card && is-watching && card.can-watch;
    property <bool> show-hosting-state: selected-card && is-hosting && !card.can-watch;
    property <bool> show-watch-cta: card.can-watch && !show-live-frame && !root.viewer-starting;
    property <bool> show-paused: show-live-frame && stream-paused;
    // --- stage 9 (streaming-quality): the card's buttons, labels, stats ---
    /// The watch of this card was clicked and no frame shows yet.
    property <bool> viewer-starting: !is-notice && card.can-watch
        && card.host-id == active-streamer-id && StreamCardUi.viewer-starting;
    property <bool> show-stats: show-live-frame && StreamCardUi.stats-shown;
    property <length> stats-height: StreamCardSize.stats;
    /// This card is the expanded view's (main.slint), not one in the feed.
    in property <bool> expanded-view: false;
    /// The watched stream plays in the pop-out window: the card says so.
    property <bool> popped: show-live-frame && StreamCardUi.popped-out;
    /// Only one card drives the video layer's geometry: the expanded view's
    /// while it shows, the feed's otherwise, none while popped out.
    property <bool> track-geometry: !root.popped
        && (root.expanded-view || !StreamCardUi.expanded);
    /// The feed's watched card under the expanded view: hidden, so it has
    /// no controls (they would answer for the expanded card).
    property <bool> under-expanded-view: !root.expanded-view && StreamCardUi.expanded
        && show-live-frame;
    /// The host's card and a watched card open different settings.
    property <string> settings-popover: show-hosting-state ? "host-settings" : "settings";
    property <bool> show-count: !is-notice && card.viewer-count > 0;
    /// The footer's state tag: the state words, else LIVE (YOU ARE LIVE on
    /// your own stream). The count rides the tag of a live stream.
    property <string> tag-label: root.reconnecting ? "RECONNECTING"
        : root.starting ? "STARTING"
        : card.state == "failed" ? "NOT LIVE"
        : card.state == "ended" ? "ENDED"
        : "LIVE";
    /// Red is state: live, or the link is down right now.
    property <bool> tag-live: !root.is-notice && !root.starting;
    property <bool> count-shown: !root.is-notice && !root.starting && !root.reconnecting
        && root.show-count;
    /// A card in the two-column grid (under 480 px) has no room for the
    /// count on the tag or for the format chip: the count goes to the game
    /// line ("Counter-Strike 2 · 12 watching").
    property <bool> narrow-footer: root.width < 480px;
    property <string> tag-count: root.count-shown && !root.narrow-footer ? root.card.viewer-count : "";
    // --- end stage 9 ---
    // --- the picture (mockup next-gen-feed frames C and D) ---
    /// The card before you watch and the hosted card draw the last picture
    /// of the stream, or the game's hero art, under black washes. Chrome
    /// over footage is black, not the graphite ramp.
    property <bool> picture-card: !show-live-frame && !is-notice;
    property <bool> has-picture: picture-card && root.card.picture-kind != "";
    /// Somebody is live and you have not joined: the picture fills the
    /// whole card, the play ring is the action, and there is no footer.
    property <bool> cta-card: show-watch-cta;
    /// The height of the picture. While you watch it is 16:9 at the
    /// card's width inside the keylines (the expanded view keeps the height
    /// it is given); before, the card's own media height.
    property <length> media-h: root.cta-card ? root.height
        : root.show-live-frame && !root.expanded-view ? (root.width - 2 * Theme.keyline) * 9 / 16
        : root.show-live-frame ? root.media-height - Theme.keyline - (root.show-stats ? root.stats-height : 0px)
        : root.media-height;
    /// The panel sizes a watched card from these: the card shows the live
    /// picture, and its height at its width (StreamCardSize).
    out property <bool> live-frame: root.show-live-frame;
    out property <length> live-height: StreamCardSize.card-height(root.width);

    background: transparent;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        spacing: 0px;

        // While you watch, the picture sits inside the card's keylines.
        Rectangle {
            height: root.media-h + (root.show-live-frame ? Theme.keyline : 0px);

            media-rect := Rectangle {
                x: root.show-live-frame ? Theme.keyline : 0px;
                y: root.show-live-frame ? Theme.keyline : 0px;
                width: parent.width - (root.show-live-frame ? 2 * Theme.keyline : 0px);
                height: root.media-h;
                // Black under the live picture (chrome under footage is black);
                // graphite, not blue, before. Nothing but game footage carries
                // colour.
                background: root.show-live-frame ? #000000
                    : @linear-gradient(135deg, Theme.card-bg 0%, Theme.card-bg-inset 100%);
                clip: true;

                // The last picture of the stream, or the game's hero art, keeps
                // its colour. Without either, the tint and the game's monogram.
                if root.has-picture: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.card.picture;
                    image-fit: cover;
                }
                if root.picture-card && !root.has-picture && root.card.game-monogram != "": Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: @linear-gradient(135deg, #2A2140 0%, Theme.card-bg-inset 100%);
                    Text {
                        text: root.card.game-monogram;
                        font-family: Theme.font-display;
                        font-weight: Theme.weight-display-bold;
                        font-size: parent.height * 0.42;
                        color: #FFFFFF12;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
                if root.picture-card: FootageWash { width: parent.width; height: parent.height; }

                if show-live-frame: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: transparent;

                    if !show-paused: Image {
                        source: root.stream-frame;
                        width: parent.width;
                        height: parent.height;
                        image-fit: contain;
                    }

                    // Reconnecting: the last frame stays under a black wash (the
                    // design system's wash over footage). On Windows the video
                    // layer draws the same wash (DCompPresenter).
                    if root.reconnecting && !show-paused: Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: #00000066;
                    }

                    // Stage 9: the video layer shows nothing before the first
                    // frame, so this text under it shows then.
                    if !show-paused && !root.popped && root.viewer-starting: VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "STARTING";
                            font-family: Theme.font-label;
                            font-size: 14px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Connecting to " + root.card.streamer-name + "'s stream";
                            font-family: Theme.font-body;
                            font-weight: Theme.weight-sentence;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }
                    }

                    // Stage 9: the stream plays in its own window; the video
                    // layer is there, so the card says so and brings it back.
                    if !show-paused && root.popped: VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "PLAYING IN A WINDOW";
                            font-family: Theme.font-label;
                            font-size: 14px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.card.streamer-name + "'s stream is in its own window";
                            font-family: Theme.font-body;
                            font-weight: Theme.weight-sentence;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            height: 34px;

                            Rectangle {
                                width: back-label.preferred-width + 28px;
                                height: parent.height;
                                x: (parent.width - self.width) / 2;
                                background: transparent;

                                CutButtonShape {
                                    width: parent.width;
                                    height: parent.height;
                                    n: Theme.cut;
                                    fill: back-ta.has-hover ? Theme.action-press : Theme.action;
                                }

                                back-label := Text {
                                    text: "Show it here";
                                    font-family: Theme.font-label;
                                    font-size: 11px;
                                    font-weight: Theme.weight-label;
                                    letter-spacing: Theme.track-label;
                                    color: Theme.on-action;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                back-ta := TouchArea {
                                    accessible-role: button;
                                    accessible-label: "Show it here";
                                    mouse-cursor: pointer;
                                    clicked => {
                                        StreamCardUi.popout-requested(false);
                                    }
                                }
                            }
                        }
                    }

                    // Pause UX: opaque cover over the stale frame (and over the
                    // detached DComp layer on Windows) with the host's name.
                    if show-paused: Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: Theme.bg-app;

                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;

                            Rectangle {
                                width: parent.width;
                                height: 26px;
                                background: transparent;

                                Image {
                                    source: @image-url("../icons/pause.svg");
                                    width: 26px;
                                    height: 26px;
                                    colorize: Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                }
                            }

                            Text {
                                text: root.pause-title;
                                font-family: Theme.font-label;
                                font-size: 13px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.pause-subtitle;
                                font-family: Theme.font-body;
                                font-size: 12px;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Stage 9: one card at a time drives the video layer.
                    if root.track-geometry: geo-tracker := Rectangle {
                        width: 0;
                        height: 0;
                        property <float> track-x: media-rect.absolute-position.x / 1px;
                        property <float> track-y: media-rect.absolute-position.y / 1px;
                        property <float> track-w: media-rect.width / 1px;
                        property <float> track-h: media-rect.height / 1px;

                        function notify() {
                            VideoRect.geometry-changed(
                                self.track-x, self.track-y,
                                self.track-w, self.track-h,
                                root.viewport-abs-y, root.viewport-height,
                            );
                        }

                        init => { self.notify(); }
                        changed track-x => { self.notify(); }
                        changed track-y => { self.notify(); }
                        changed track-w => { self.notify(); }
                        changed track-h => { self.notify(); }
                    }
                }

                if !show-live-frame: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: transparent;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        if !show-watch-cta: Text {
                            text: root.is-notice ? root.card.title
                                : root.viewer-starting ? "STARTING"
                                : !show-hosting-state ? root.card.streamer-name + " IS LIVE"
                                : root.starting ? "STARTING"
                                : root.reconnecting ? "RECONNECTING"
                                : "YOU ARE LIVE";
                            font-family: Theme.font-label;
                            font-size: 14px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                            // Red is state: the link is down right now.
                            color: show-hosting-state && root.reconnecting ? Theme.live : Theme.text-primary;
                            horizontal-alignment: center;
                        }

                        // The running hosted card has its game or display in
                        // the footer's game line: no line here.
                        if !show-watch-cta && !(show-hosting-state && !root.starting && !root.reconnecting): Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: root.viewer-starting ? "Connecting to " + root.card.streamer-name + "'s stream"
                                : show-hosting-state && root.starting ? "Connecting to the stream server"
                                : show-hosting-state && root.reconnecting ? "Viewers see your last frame"
                                : root.card.subtitle;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }

                        if show-hosting-state: Rectangle {
                            width: parent.width;
                            height: 38px;

                            Rectangle {
                                width: stop-text.preferred-width + 40px;
                                height: parent.height;
                                x: (parent.width - self.width) / 2;
                                background: transparent;

                                // Ending the stream commits, so it is red. It was
                                // a white fill with a white label: a blank pill.
                                CutButtonShape {
                                    width: parent.width;
                                    height: parent.height;
                                    n: Theme.cut;
                                    fill: stop-hover.has-hover ? Theme.confirm-press : Theme.confirm;
                                }

                                stop-text := Text {
                                    text: "END STREAM";
                                    font-family: Theme.font-label;
                                    font-size: 12px;
                                    font-weight: Theme.weight-label;
                                    letter-spacing: Theme.track-label;
                                    color: Theme.on-confirm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                stop-hover := TouchArea {
                                    accessible-role: button;
                                    accessible-label: "END STREAM";
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.stop-stream-clicked();
                                    }
                                }
                            }
                        }
                    }
                }

                // Somebody is live and you have not joined (mockup frame C): the
                // play ring in the centre, the streamer and the game on the
                // bottom wash, the LIVE tag and the count on the top one. A
                // click anywhere on the card starts the watch.
                if root.cta-card: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: transparent;

                    PlayButton {
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.44 - self.height / 2;
                        size: 56px;
                        hover: watch-click.has-hover;
                    }

                    StreamerLine {
                        x: 18px;
                        y: parent.height - self.height - 16px;
                        width: self.preferred-width;
                        height: self.preferred-height;
                        card: root.card;
                    }

                    StreamTag {
                        x: 18px;
                        y: 14px;
                        label: "LIVE";
                        live: true;
                        count: root.show-count ? root.card.viewer-count : "";
                        count-label: "WATCHING";
                    }

                    watch-click := TouchArea {
                        accessible-role: button;
                        accessible-label: "Watch " + root.card.streamer-name;
                        mouse-cursor: pointer;
                        clicked => {
                            root.watch-stream-clicked(
                                root.card.host-id,
                                root.card.session-id,
                                root.card.stream-width,
                                root.card.stream-height,
                            );
                        }
                    }
                }

                // Stage 9: a double-click on the picture expands it, or back.
                if show-live-frame && !show-paused && !root.popped: TouchArea {
                    // a11y: none (a double-click shortcut; the Expand button is the control)
                    double-clicked => {
                        StreamCardUi.popover = "";
                        StreamCardUi.expand-requested(!StreamCardUi.expanded);
                    }
                }
            }
        }

        // Stage 9: the viewer's stats, under the picture (the video layer
        // covers anything Slint draws over the picture).
        if root.show-stats: Rectangle {
            height: root.stats-height;

            Rectangle {
                x: Theme.keyline;
                width: parent.width - 2 * Theme.keyline;
                height: parent.height;
                // Black, as the picture and the footer.
                background: #000000;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.card-border;
                }

                HorizontalLayout {
                    padding-left: 15px;
                    padding-right: 11px;
                    spacing: 8px;

                    StreamStatCell { kicker: "DELAY"; value: StreamCardUi.stats.target-delay; }
                    StreamStatCell { kicker: "JITTER"; value: StreamCardUi.stats.jitter; }
                    StreamStatCell { kicker: "DECODE"; value: StreamCardUi.stats.decode; }
                    StreamStatCell { kicker: "LATE"; value: StreamCardUi.stats.frames-late; }
                    StreamStatCell { kicker: "AUDIO"; value: StreamCardUi.stats.audio-delay; }
                    StreamStatCell { kicker: "A/V"; value: StreamCardUi.stats.av-offset; }
                }
            }
        }

        if !root.cta-card: Rectangle {
            height: StreamCardSize.footer;
            background: transparent;

            // The footer is the bottom of the card, so it carries the cut.
            // Black: chrome under footage is black, not graphite.
            CutShape {
                width: parent.width;
                height: parent.height;
                n: Theme.notch;
                corner: "br";
                inset: Theme.keyline;
                fill: #000000;
            }
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.card-border;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 12px;

                // The streamer, the state tag with the count, the format,
                // and under the name the game. A card in the two-column
                // grid is too narrow for all of it: the count moves to the
                // game line, the format chip drops, the name elides, and the
                // line clips before it reaches the buttons.
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;

                    StreamerLine {
                        width: parent.width;
                        height: parent.height;
                        card: root.card;
                        tag: root.tag-label;
                        tag-live: root.tag-live;
                        tag-count: root.tag-count;
                        game-suffix: root.count-shown && root.narrow-footer
                            ? root.card.viewer-count + " watching" : "";
                        format: show-live-frame && !root.narrow-footer ? StreamCardUi.format-label : "";
                    }
                }

                // Right column — icons on top, leave button below. A notice
                // card has no controls.
                if !root.is-notice && !root.under-expanded-view: Rectangle {
                    horizontal-stretch: 0;
                    width: ctrl-row.preferred-width;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        ctrl-row := HorizontalLayout {
                            spacing: 4px;

                            // Stage 9: each button does what it says. The
                            // popovers open under the button, outside the
                            // picture (the video layer covers Slint there).
                            if show-live-frame: StreamIconButton {
                                icon: StreamCardUi.muted || StreamCardUi.volume == 0
                                    ? @image-url("../icons/volume-x.svg")
                                    : @image-url("../icons/volume.svg");
                                label: "Stream volume";
                                on: StreamCardUi.popover == "volume";
                                clicked => {
                                    StreamCardUi.anchor-right = self.absolute-position.x + self.width;
                                    StreamCardUi.anchor-bottom = self.absolute-position.y + self.height;
                                    StreamCardUi.anchor-card-right = root.absolute-position.x + root.width;
                                    StreamCardUi.popover = StreamCardUi.popover == "volume" ? "" : "volume";
                                }
                            }

                            if show-live-frame || show-hosting-state: StreamIconButton {
                                icon: @image-url("../icons/settings.svg");
                                label: "Stream settings";
                                on: StreamCardUi.popover == root.settings-popover;
                                clicked => {
                                    StreamCardUi.anchor-right = self.absolute-position.x + self.width;
                                    StreamCardUi.anchor-bottom = self.absolute-position.y + self.height;
                                    StreamCardUi.anchor-card-right = root.absolute-position.x + root.width;
                                    StreamCardUi.popover = StreamCardUi.popover == root.settings-popover
                                        ? "" : root.settings-popover;
                                }
                            }

                            // Expand over the feed area, or back. From the
                            // pop-out it brings the stream back first.
                            if show-live-frame && !show-paused: StreamIconButton {
                                icon: StreamCardUi.expanded
                                    ? @image-url("../icons/minimize.svg")
                                    : @image-url("../icons/maximize.svg");
                                label: StreamCardUi.expanded ? "Exit expanded view" : "Expand";
                                on: StreamCardUi.expanded;
                                clicked => {
                                    StreamCardUi.popover = "";
                                    StreamCardUi.expand-requested(!StreamCardUi.expanded);
                                }
                            }

                            // The stream in its own window, or back.
                            if show-live-frame && !show-paused: StreamIconButton {
                                icon: @image-url("../icons/external-link.svg");
                                label: StreamCardUi.popped-out ? "Close the stream window" : "Pop out";
                                on: StreamCardUi.popped-out;
                                clicked => {
                                    StreamCardUi.popover = "";
                                    StreamCardUi.popout-requested(!StreamCardUi.popped-out);
                                }
                            }
                        }

                        if show-live-frame: Rectangle {
                            height: 26px;
                            background: transparent;

                            CutButtonShape {
                                width: parent.width;
                                height: parent.height;
                                n: 6px;
                                fill: leave-hover.has-hover ? Theme.live : Theme.live-bg;
                            }

                            leave-label := Text {
                                text: "Leave";
                                font-family: Theme.font-label;
                                font-size: 11px;
                                font-weight: Theme.weight-label;
                                letter-spacing: Theme.track-label;
                                color: leave-hover.has-hover ? Theme.on-live : Theme.live;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            leave-hover := TouchArea {
                                accessible-role: button;
                                accessible-label: "Leave";
                                mouse-cursor: pointer;
                                clicked => {
                                    root.stop-watching-clicked();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // The picture of the cta card reaches the cut corner: paint the corner
    // back and draw its keyline, as the two-stream hero does.
    if root.cta-card: CutMask {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "br";
        fill: Theme.bg-app;
    }
    if root.cta-card: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: Theme.card-border;
        stroke-width: 1px;
        commands: "M \{self.width / 1px} \{(self.height - Theme.notch) / 1px} L \{(self.width - Theme.notch) / 1px} \{self.height / 1px}";
    }
}

export component ActiveStreamsPanel inherits Rectangle {
    in property <[StreamCardData]> cards: [];
    in property <bool> is-watching: false;
    in property <bool> is-hosting: false;
    in property <string> active-streamer-id: "";
    in property <image> stream-frame;
    in property <float> stream-ui-render-fps: 0.0;
    in property <float> viewport-abs-y: 0;
    in property <float> viewport-height: 0;
    /// Viewer pause UX, forwarded to the selected card.
    in property <bool> stream-paused: false;
    in property <string> stream-paused-reason: "";

    callback watch-stream-clicked(string, string, int, int);
    callback stop-stream-clicked();
    callback stop-watching-clicked();

    out property <int> row-count: cards.length <= 1 ? 1 : (cards.length + 1) / 2;
    /// The height the panel needs at its width while the viewer watches:
    /// the watched card's picture is 16:9 at the card's width
    /// (StreamCardSize). The feed gives the stage at least this height.
    out property <length> watch-height: StreamCardSize.watch-height(root.width, root.cards.length);

    // A watched card takes its own height and sits at the top of the panel.
    if cards.length == 1: StreamCard {
        y: 0;
        width: parent.width;
        height: self.live-frame ? self.live-height : root.height;
        media-height: root.height - StreamCardSize.footer;
        card: cards[0];
        is-watching: root.is-watching;
        is-hosting: root.is-hosting;
        active-streamer-id: root.active-streamer-id;
        stream-frame: root.stream-frame;
        stream-ui-render-fps: root.stream-ui-render-fps;
        stream-paused: root.stream-paused;
        stream-paused-reason: root.stream-paused-reason;
        viewport-abs-y: root.viewport-abs-y;
        viewport-height: root.viewport-height;
        watch-stream-clicked(host-id, session-id, w, h) => {
            root.watch-stream-clicked(host-id, session-id, w, h);
        }
        stop-stream-clicked => {
            root.stop-stream-clicked();
        }
        stop-watching-clicked => {
            root.stop-watching-clicked();
        }
    }

    // Two or three streams and you have joined none: one card of strips
    // (mockup frames D and G). Rust sets the switch from the cards.
    if cards.length > 1 && StreamCardUi.strips-layout: LiveStripsCard {
        width: parent.width;
        height: root.height;
        cards: root.cards;
        watch-stream-clicked(host-id, session-id, w, h) => {
            root.watch-stream-clicked(host-id, session-id, w, h);
        }
    }

    if cards.length > 1 && !StreamCardUi.strips-layout: VerticalLayout {
        spacing: 12px;

        for row-start in [0, 2, 4, 6]: HorizontalLayout {
            visible: row-start < cards.length;
            spacing: 12px;
            height: root.is-watching ? StreamCardSize.watch-row(root.width) : StreamCardSize.grid-row;

            for col in [0, 1]: Rectangle {
                property <int> card-index: row-start + col;
                property <bool> in-range: card-index < root.cards.length;
                visible: in-range;
                horizontal-stretch: 1;
                height: parent.height;

                if in-range: StreamCard {
                    y: 0;
                    width: parent.width;
                    height: self.live-frame ? self.live-height : parent.height;
                    media-height: 228px;
                    card: root.cards[card-index];
                    is-watching: root.is-watching;
                    is-hosting: root.is-hosting;
                    viewport-abs-y: root.viewport-abs-y;
                    viewport-height: root.viewport-height;
                    active-streamer-id: root.active-streamer-id;
                    stream-frame: root.stream-frame;
                    stream-ui-render-fps: root.stream-ui-render-fps;
                    stream-paused: root.stream-paused;
                    stream-paused-reason: root.stream-paused-reason;
                    watch-stream-clicked(host-id, session-id, w, h) => {
                        root.watch-stream-clicked(host-id, session-id, w, h);
                    }
                    stop-stream-clicked => {
                        root.stop-stream-clicked();
                    }
                    stop-watching-clicked => {
                        root.stop-watching-clicked();
                    }
                }
            }
        }
    }
}

// ============================================================
//  Stage 9 (streaming-quality): the popovers of the card's buttons.
//
//  Built like the member volume popover (member_volume_popover.slint): one
//  cut corner, graphite keyline, surface fill, a kicker in the label face.
//  Controlled: they never write a value, they call back; Rust stores the
//  value and gives it back through StreamCardUi.
//
//  main.slint shows them on the window, under the button that opened them:
//  the card's footer is under the picture, so they do not cover it. The
//  video layer composites above Slint, so a popover over the picture would
//  not show.
// ============================================================

/// The game-audio volume of the watched stream, for this user only.
export component StreamVolumePopover inherits Rectangle {
    in property <string> name;
    in property <int> volume: 100;
    in property <bool> muted: false;
    callback volume-changed(int);
    callback mute-changed(bool);
    // Escape. The owner also closes the popover on a click outside it.
    callback close-requested();

    property <bool> boosted: root.volume > 100 && !root.muted;

    width: 232px;
    height: body.preferred-height;
    background: transparent;

    // Take the focus, so that Escape closes the popover at once.
    init => {
        keys.focus();
    }

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        fill: Theme.graphic-med;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        inset: Theme.keyline;
        fill: Theme.surface;
    }

    // Swallow clicks so the backdrop does not close the popover.
    TouchArea {
        // a11y: none (input blocker: stops clicks reaching the backdrop)
    }

    // The slider rejects Escape, so the key comes up to this scope.
    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }

        body := VerticalLayout {
            spacing: 0px;

            // Whose stream.
            VerticalLayout {
                padding: 12px;
                padding-left: 14px;
                padding-right: 18px;
                spacing: 1px;

                Text {
                    text: root.name;
                    font-family: Theme.font-display;
                    font-size: 13px;
                    font-weight: Theme.weight-display;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                Text {
                    text: "Only you hear this change.";
                    font-family: Theme.font-body;
                    font-weight: Theme.weight-sentence;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
            }

            Rectangle { height: 1px; background: Theme.graphic-light; }

            // How loud.
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 10px;
                spacing: 6px;

                HorizontalLayout {
                    Text {
                        text: "STREAM VOLUME";
                        font-family: Theme.font-label;
                        font-size: 9.5px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-kicker;
                        color: Theme.text-tertiary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    // The value, live while you drag. Same chip as the
                    // member volume popover.
                    Rectangle {
                        width: pct-text.preferred-width + 12px;
                        height: 20px;
                        background: root.muted ? transparent : Theme.accent-bg;

                        pct-text := Text {
                            text: root.muted ? "MUTED" : root.volume + "%";
                            font-family: Theme.font-label;
                            font-size: 11px;
                            font-weight: Theme.weight-label;
                            letter-spacing: Theme.track-label;
                            color: root.muted ? Theme.text-tertiary : Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                MemberVolumeSlider {
                    label: "Stream volume for " + root.name;
                    value: root.volume;
                    enabled: !root.muted;
                    changed(v) => { root.volume-changed(v); }
                }

                // Scale. 100 % is under the detent.
                Rectangle {
                    height: 12px;

                    Text {
                        x: 0px;
                        text: "0%";
                        font-family: Theme.font-label;
                        font-size: 9px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: Theme.text-tertiary;
                    }
                    Text {
                        x: (parent.width - self.width) / 2;
                        text: "100%";
                        font-family: Theme.font-label;
                        font-size: 9px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: root.volume == 100 ? Theme.text-secondary : Theme.text-tertiary;
                    }
                    Text {
                        x: parent.width - self.width;
                        text: "200%";
                        font-family: Theme.font-label;
                        font-size: 9px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: Theme.text-tertiary;
                    }
                }

                // libmello applies the gain before the limiter of the voice
                // mix, so loud game audio above 100 % can clip.
                if root.boosted: Text {
                    text: "Above 100% loud game audio can distort.";
                    font-family: Theme.font-body;
                    font-weight: Theme.weight-sentence;
                    font-size: 11px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 1px; background: Theme.graphic-light; }

            // Mute for you.
            Rectangle {
                height: 40px;
                background: mute-ta.has-hover ? Theme.surface-hover : transparent;

                mute-ta := TouchArea {
                    // a11y: none (a larger click target; the switch is the control)
                    clicked => { root.mute-changed(!root.muted); }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    cross-axis-alignment: center;

                    Text {
                        text: "Mute";
                        font-family: Theme.font-display;
                        font-size: 13px;
                        font-weight: Theme.weight-display;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    SmallToggle {
                        label: "Mute the stream";
                        checked: root.muted;
                        self-toggle: false;
                        toggled(v) => { root.mute-changed(v); }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.graphic-light; }

            // Reset. It is dim when the volume is 100 %. It does not change
            // the mute.
            reset-row := Rectangle {
                property <bool> can-reset: root.volume != 100;
                height: 30px;
                background: (self.can-reset && reset-ta.has-hover) ? Theme.surface-hover : transparent;

                Text {
                    x: 14px;
                    height: parent.height;
                    text: "RESET TO 100%";
                    font-family: Theme.font-label;
                    font-size: 9.5px;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-label;
                    color: !reset-row.can-reset ? Theme.text-tertiary
                        : reset-ta.has-hover ? Theme.text-primary
                        : Theme.text-secondary;
                    vertical-alignment: center;
                }

                reset-ta := TouchArea {
                    accessible-role: button;
                    accessible-label: "Reset stream volume to 100%";
                    enabled: reset-row.can-reset;
                    accessible-enabled: reset-row.can-reset;
                    mouse-cursor: reset-row.can-reset ? pointer : default;
                    clicked => { root.volume-changed(100); }
                }
            }
        }
    }
}

component StreamPopoverValue inherits HorizontalLayout {
    in property <string> kicker;
    in property <string> value;

    Text {
        text: root.kicker;
        font-family: Theme.font-label;
        font-size: 9.5px;
        font-weight: Theme.weight-label;
        letter-spacing: Theme.track-kicker;
        color: Theme.text-tertiary;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }

    Text {
        text: root.value == "" ? "-" : root.value;
        font-family: Theme.font-label;
        font-size: 11px;
        font-weight: Theme.weight-label;
        letter-spacing: Theme.track-label;
        color: Theme.text-primary;
        vertical-alignment: center;
    }
}

/// The card's settings. A viewer turns the stats strip on and off; the host
/// sees the quality of the stream and what it sends.
export component StreamSettingsPopover inherits Rectangle {
    in property <bool> hosting: false;
    in property <bool> stats-shown: false;
    in property <string> host-quality: "";
    in property <string> host-sending: "";
    callback stats-toggled(bool);
    callback close-requested();

    width: 232px;
    height: body.preferred-height;
    background: transparent;

    init => {
        keys.focus();
    }

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        fill: Theme.graphic-med;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch-sm;
        inset: Theme.keyline;
        fill: Theme.surface;
    }

    TouchArea {
        // a11y: none (input blocker: stops clicks reaching the backdrop)
    }

    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }

        body := VerticalLayout {
            spacing: 0px;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 10px;

                Text {
                    text: root.hosting ? "YOUR STREAM" : "STREAM";
                    font-family: Theme.font-label;
                    font-size: 9.5px;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-kicker;
                    color: Theme.text-tertiary;
                }
            }

            Rectangle { height: 1px; background: Theme.graphic-light; }

            // The viewer: the stats strip on the card.
            if !root.hosting: Rectangle {
                height: 52px;
                background: stats-ta.has-hover ? Theme.surface-hover : transparent;

                stats-ta := TouchArea {
                    // a11y: none (a larger click target; the switch is the control)
                    clicked => { root.stats-toggled(!root.stats-shown); }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: "Stats";
                            font-family: Theme.font-display;
                            font-size: 13px;
                            font-weight: Theme.weight-display;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: "Delay, jitter and sync on the card";
                            font-family: Theme.font-body;
                            font-weight: Theme.weight-sentence;
                            font-size: 11px;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }
                    }

                    SmallToggle {
                        label: "Show stream stats";
                        checked: root.stats-shown;
                        self-toggle: false;
                        toggled(v) => { root.stats-toggled(v); }
                    }
                }
            }

            // The host: the quality the stream started with, and what it
            // sends now.
            if root.hosting: VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                StreamPopoverValue { kicker: "QUALITY"; value: root.host-quality; }
                StreamPopoverValue { kicker: "SENDING"; value: root.host-sending; }
            }
        }
    }
}

// ============================================================
//  Stage 9 (streaming-quality): the expanded view.
//
//  The watched card over the whole feed area (main.slint places it over
//  CrewFeed): the sidebar, the chat and the control bar stay. Its footer
//  keeps the buttons; Expand turns into "Exit expanded view", and Escape
//  returns too. The DComp video layer follows this card's geometry while it
//  shows (the feed's card stops tracking), so the stream plays on.
// ============================================================
export component ExpandedStreamCard inherits Rectangle {
    in property <bool> is-watching: false;
    in property <string> active-streamer-id: "";
    in property <image> stream-frame;
    in property <bool> stream-paused: false;
    in property <string> stream-paused-reason: "";
    callback stop-watching-clicked();

    background: Theme.bg-app;

    init => {
        keys.focus();
    }

    // The feed under it is hidden: no click reaches it.
    TouchArea {
        // a11y: none (input blocker: the feed under the expanded view)
        clicked => { keys.focus(); }
    }

    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                StreamCardUi.expand-requested(false);
                return accept;
            }
            reject
        }

        StreamCard {
            x: 20px;
            y: 16px;
            width: parent.width - 40px;
            height: parent.height - 32px;
            media-height: self.height - 72px;
            card: StreamCardUi.watched-card;
            expanded-view: true;
            is-watching: root.is-watching;
            active-streamer-id: root.active-streamer-id;
            stream-frame: root.stream-frame;
            stream-paused: root.stream-paused;
            stream-paused-reason: root.stream-paused-reason;
            viewport-abs-y: self.absolute-position.y / 1px;
            viewport-height: self.height / 1px;
            stop-watching-clicked => {
                root.stop-watching-clicked();
            }
        }
    }
}

// Headless preview:
//   slint-viewer --screenshot out.png --component PreviewHosting \
//     client/ui/panels/active_streams_panel.slint
component StreamsPreview inherits Rectangle {
    in property <bool> hosting: false;
    in property <bool> watching: false;
    in property <bool> can-watch: false;
    in property <string> state: "";
    in property <string> title: "";
    in property <string> subtitle: "Display 1 (Primary)";
    // Stage 9: the card's controls.
    in property <int> viewers: 3;
    in property <string> format: "";
    in property <bool> stats: false;
    in property <bool> starting-watch: false;
    in property <bool> popped-out: false;
    in property <bool> muted: false;
    in property <string> popover: "";
    // The picture and the game of the stream (mockup frames C and D).
    in property <image> picture;
    in property <string> picture-kind: "";
    in property <string> game: "";
    in property <string> monogram: "";
    in property <image> game-icon;
    in property <bool> has-game-icon: false;
    /// The live picture while you watch.
    in property <image> frame;

    width: 820px;
    // A watched card takes the height of its 16:9 picture.
    height: root.watching ? panel.watch-height + 40px : 470px;
    /// The top of the card's footer, for the popover previews.
    out property <length> footer-top: 20px + panel.height - StreamCardSize.footer;
    background: Theme.bg-app;

    init => {
        StreamCardUi.format-label = root.format;
        StreamCardUi.stats-shown = root.stats;
        StreamCardUi.viewer-starting = root.starting-watch;
        StreamCardUi.popped-out = root.popped-out;
        StreamCardUi.muted = root.muted;
        StreamCardUi.popover = root.popover;
        StreamCardUi.stats = {
            target-delay: "118 ms", jitter: "6 ms", decode: "2.1 ms",
            frames-late: "0", audio-delay: "142 ms", av-offset: "+8 ms",
        };
        StreamCardUi.host-quality = "HIGH · 1080p30";
        StreamCardUi.host-sending = "6.2 Mbps";
        StreamCardUi.strips-layout = false;
    }

    panel := ActiveStreamsPanel {
        x: 20px;
        y: 20px;
        width: parent.width - 40px;
        height: parent.height - 40px;
        is-hosting: root.hosting;
        is-watching: root.watching;
        active-streamer-id: "h1";
        stream-frame: root.frame;
        cards: [
            {
                host-id: "h1", session-id: "s1",
                streamer-name: "b0bben",
                subtitle: root.subtitle,
                avatar-initials: "b0", avatar-color-index: 0,
                viewer-count: root.viewers, stream-width: 1920, stream-height: 1080,
                can-watch: root.can-watch,
                state: root.state,
                title: root.title,
                picture: root.picture,
                picture-kind: root.picture-kind,
                game-name: root.game,
                game-monogram: root.monogram,
                game-icon: root.game-icon,
                has-game-icon: root.has-game-icon,
            },
        ];
    }
}

/// The footer states with the stream's picture and its game: the footer
