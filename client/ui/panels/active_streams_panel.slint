component GamePreview inherits StreamsPreview {
    frame: @image-url("../previews/fixtures/stream-sample-1.png");
    picture: @image-url("../previews/fixtures/stream-sample-1.png");
    picture-kind: "frame";
    game: "Counter-Strike 2";
    monogram: "CS";
    game-icon: @image-url("../previews/fixtures/capsule-sample-1.png");
    has-game-icon: true;
}

