import { Theme } from "../theme.slint";
import { GameStatsCardData } from "../types.slint";
import { GameIcon } from "../components/game_icon.slint";

component FormPip inherits Rectangle {
    in property <string> letter;

    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: letter == "W" ? #1e3a2a : letter == "L" ? #3a1e1e : #2a2a30;

    Text {
        text: letter;
        font-size: 10px;
        font-weight: 700;
        color: letter == "W" ? #4ade80 : letter == "L" ? #f87171 : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StatCell inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    in property <color> value-color: Theme.text-primary;

    alignment: center;
    spacing: 2px;

    Text {
        text: value;
        font-size: 18px;
        font-weight: 700;
        color: value-color;
        horizontal-alignment: center;
    }

    Text {
        text: label;
        font-size: 10px;
        color: Theme.text-secondary;
        horizontal-alignment: center;
    }
}

component GameStatsCard inherits Rectangle {
    in property <GameStatsCardData> card;

    background: Theme.bg-app;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.graphic-light;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Header: icon + name + last played
        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                GameIcon {
                    game-id: card.game-id;
                    short-name: card.short-name;
                    badge-color: card.game-color;
                    size: 40px;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: card.game-name;
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                if card.last-played-text != "": Text {
                    text: "last played " + card.last-played-text;
                    font-size: 11px;
                    color: Theme.text-tertiary;
                }
            }

            // Headline stats.
            HorizontalLayout {
                spacing: 24px;

                StatCell {
                    value: card.streak-text;
                    label: "streak";
                    value-color: card.streak-positive ? #4ade80 : #f87171;
                }

                StatCell {
                    value: card.win-rate-text;
                    label: "win rate";
                }

                StatCell {
                    value: card.record-text;
                    label: "record";
                    value-color: Theme.text-secondary;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.graphic-light; }

        // Recent form + longest streaks.
        HorizontalLayout {
            spacing: 12px;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                horizontal-stretch: 1;
                for pip in card.recent-form: FormPip {
                    letter: pip;
                }
            }

            if card.best-streak-text != "": Text {
                text: card.best-streak-text;
                font-family: Theme.font-mono;
                font-size: 11px;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
        }
    }
}

// Deep personal stats view (spec 19 A2): per-game cards with streak,
// record, win rate, recent form, and longest streaks. Opened from the
// You strip atop the crew feed; viewer-only data.
export component StatsProfileModal inherits Rectangle {
    in property <[GameStatsCardData]> games: [];

    callback dismiss-requested();

    width: 100%;
    height: 100%;
    background: #000000AA;

    TouchArea {
        clicked => { dismiss-requested(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 560px;
        height: min(root.height - 80px, content.preferred-height + 64px);
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.graphic-light;
        clip: true;

        // Block clicks from reaching backdrop
        TouchArea {}

        Flickable {
            width: parent.width;
            height: parent.height;
            viewport-height: content.preferred-height + 64px;

            content := VerticalLayout {
                padding: 32px;
                spacing: 16px;

                HorizontalLayout {
                    Text {
                        text: "Your game stats";
                        font-size: Theme.font-xxl;
                        font-weight: 700;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: close-ta.has-hover ? Theme.surface-hover : transparent;

                        Text {
                            text: "✕";
                            font-size: 14px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { dismiss-requested(); }
                        }
                    }
                }

                Text {
                    text: "Per-game record from your tracked sessions. Only you can see this.";
                    font-size: Theme.font-md;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                for card in games: GameStatsCard {
                    card: card;
                }

                if games.length == 0: Rectangle {
                    height: 120px;
                    border-radius: 12px;
                    background: Theme.bg-app;
                    border-width: 1px;
                    border-color: Theme.graphic-light;

                    Text {
                        text: "No tracked games yet.\nPlay a session of a supported game and your stats will show up here.";
                        font-size: Theme.font-md;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

