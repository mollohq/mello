import { Theme, MelloTextInput } from "../theme.slint";
import { UserAvatar } from "../components/avatar.slint";
import { CutButtonShape } from "../components/cut.slint";
import { VoiceChannelData, VoiceChannelMember } from "../types.slint";

// ── Collapsed voice channel row (compact single-line) ──
component VoiceChannelRow inherits Rectangle {
    in property <string> channel-name;
    in property <string> status-text: "0 Members";
    in property <bool> show-join: false;

    callback clicked();
    callback join-clicked();

    background: touch.has-hover ? Theme.hover-overlay : transparent;

    // Row-level touch BEFORE layout so the join button renders on top
    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 8px;

        Image {
            source: @image-url("../icons/mic.svg");
            width: 14px;
            height: 14px;
            colorize: Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }

        Text {
            letter-spacing: Theme.track-label;
            text: channel-name;
            font-family: Theme.font-label;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }

        Text {
            letter-spacing: Theme.track-label;
            font-weight: Theme.weight-label;
            text: status-text;
            font-family: Theme.font-label;
            font-size: 10px;
            color: Theme.text-tertiary;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        if show-join: Rectangle {
            width: join-label.preferred-width + 20px;
            height: 22px;
            background: transparent;
            vertical-stretch: 0;

            // Joining is something you press, so it is white. The green in
            // this panel was never about speaking.
            CutButtonShape {
                width: parent.width;
                height: parent.height;
                n: 5px;
                fill: join-touch.has-hover ? Theme.action : Theme.action-line;
            }
            if !join-touch.has-hover: CutButtonShape {
                width: parent.width;
                height: parent.height;
                n: 5px;
                inset: Theme.keyline;
                fill: Theme.surface;
            }

            join-label := Text {
                text: "Join";
                font-family: Theme.font-label;
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: join-touch.has-hover ? Theme.on-action : Theme.text-primary;
                letter-spacing: Theme.track-label;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            join-touch := TouchArea {
                clicked => { root.join-clicked(); }
            }
        }

        Image {
            source: @image-url("../icons/chevron-down.svg");
            width: 12px;
            height: 12px;
            colorize: Theme.text-tertiary;
        }
    }
}

// ── Expanded voice channel with participant avatars ──
component VoiceChannelExpanded inherits Rectangle {
    in property <string> channel-name;
    in property <[VoiceChannelMember]> members: [];
    in property <bool> show-join: false;
    in property <bool> is-active: false;

    callback clicked();
    callback join-clicked();

    background: Theme.bg-app;

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 14px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 0px;

        // ── Top row: channel meta + badge ──
        Rectangle {
            height: 20px;

            HorizontalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 8px;

                    Image {
                        source: @image-url("../icons/mic.svg");
                        width: 14px;
                        height: 14px;
                        colorize: Theme.text-primary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        letter-spacing: Theme.track-label;
                        text: channel-name;
                        font-family: Theme.font-label;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }

                    Text {
                        font-weight: Theme.weight-display;
                        font-family: Theme.font-display;
                        text: "·";
                        font-size: 14px;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    Text {
                        font-weight: Theme.weight-label;
                        text: members.length > 0 ? "Active Session" : "Empty";
                        font-family: Theme.font-label;
                        font-size: 10px;
                        color: Theme.text-tertiary;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if members.length > 0: HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        font-weight: Theme.weight-label;
                        text: "ACTIVE SESSION";
                        font-family: Theme.font-label;
                        font-size: Theme.font-xs;
                        color: Theme.text-tertiary;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 5px;
                        height: 5px;
                        border-radius: 2.5px;
                        background: Theme.accent;
                    }
                }

                Image {
                    source: @image-url("../icons/chevron-down.svg");
                    width: 12px;
                    height: 12px;
                    colorize: Theme.text-tertiary;
                    transform-rotation: 180deg;
                }
            }

            header-touch := TouchArea {
                clicked => { root.clicked(); }
            }
        }

        Rectangle { height: 12px; }

        // ── Participant avatars ──
        HorizontalLayout {
            spacing: 20px;
            alignment: start;

            // "+ Join" avatar tile (first position)
            if show-join: VerticalLayout {
                alignment: center;
                spacing: 8px;

                Rectangle {
                    width: 48px;
                    height: 48px;
                    background: transparent;

                    // The tile sits in a row of people, so it takes their
                    // silhouette without pretending to be one.
                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: 11px;
                        fill: join-tile-touch.has-hover ? Theme.action-line : Theme.graphic-light;
                    }
                    CutButtonShape {
                        width: parent.width;
                        height: parent.height;
                        n: 11px;
                        inset: Theme.keyline;
                        fill: join-tile-touch.has-hover ? Theme.surface-hover : Theme.bg-app;
                    }

                    Text {
                        letter-spacing: Theme.track-label;
                        text: "+";
                        font-size: 20px;
                        font-family: Theme.font-label;
                        font-weight: Theme.weight-label;
                        color: join-tile-touch.has-hover ? Theme.text-primary : Theme.text-tertiary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    join-tile-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.join-clicked(); }
                    }
                }

                // Spacer matching voice indicator height
                Rectangle { height: 6px; }

                Text {
                    letter-spacing: Theme.track-label;
                    text: "Join";
                    font-family: Theme.font-label;
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    color: join-tile-touch.has-hover ? Theme.text-primary : Theme.text-tertiary;
                    horizontal-alignment: center;
                }
            }

            for member in members: VerticalLayout {
                alignment: center;
                spacing: 8px;

                UserAvatar {
                    initials: member.initials;
                    avatar: member.avatar;
                    has-avatar: member.has-avatar;
                    muted: true;
                    size: 48px;
                    bg-color: Theme.bg-app;
                }

                // Voice indicator bars. They widen when the person talks;
                // the colour stays neutral because green marks speaking on
                // the name and nowhere else.
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    height: 6px;

                    Rectangle {
                        width: 3px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: member.speaking ? Theme.text-secondary : Theme.graphic-light;
                    }
                    Rectangle {
                        width: member.speaking ? 20px : 10px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: member.speaking ? Theme.text-secondary : Theme.graphic-light;
                    }
                    Rectangle {
                        width: 3px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: member.speaking ? Theme.text-secondary : Theme.graphic-light;
                    }
                }

                Text {
                    letter-spacing: Theme.track-label;
                    text: member.name;
                    font-family: Theme.font-label;
                    font-size: 10px;
                    font-weight: member.speaking ? 500 : 400;
                    color: member.speaking ? Theme.speaking : Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }

            // Empty state when no members and already in channel
            if members.length == 0 && !show-join: Text {
                letter-spacing: Theme.track-label;
                font-weight: Theme.weight-label;
                text: "No one here yet";
                font-family: Theme.font-label;
                font-size: 11px;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
        }
    }
}

// ── Exported accordion container ──
export component VoiceChannelView inherits Rectangle {
    in property <[VoiceChannelData]> voice-channels: [];
    in property <bool> mic-permission-granted: true;
    in property <bool> can-manage-channels: false;

    callback join-voice-channel(/* channel_id */ string);
    callback toggle-channel(/* channel_id */ string);
    callback create-channel(/* name */ string);

    property <bool> creating: false;

    vertical-stretch: 0;
    background: Theme.surface;
    border-radius: Theme.r-outer;
    border-width: 1px;
    border-color: Theme.graphic-light;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        for channel[idx] in voice-channels: VerticalLayout {
            spacing: 0px;

            // Separator between channels (not before first)
            if idx > 0: Rectangle { height: 1px; background: Theme.graphic-light; }

            if channel.expanded: VoiceChannelExpanded {
                channel-name: channel.name;
                members: channel.members;
                show-join: !channel.active && root.mic-permission-granted;
                is-active: channel.active;
                clicked => { root.toggle-channel(channel.id); }
                join-clicked => { root.join-voice-channel(channel.id); }
            }

            if !channel.expanded: VoiceChannelRow {
                channel-name: channel.name;
                status-text: channel.active
                    ? "Connected"
                    : (channel.member-count > 0
                        ? "\{channel.member-count} Active"
                        : "0 Members");
                show-join: !channel.active && root.mic-permission-granted;
                clicked => { root.toggle-channel(channel.id); }
                join-clicked => { root.join-voice-channel(channel.id); }
            }
        }

        if root.can-manage-channels: VerticalLayout {
            spacing: 0px;

            // Separator before create row
            if voice-channels.length > 0: Rectangle { height: 1px; background: Theme.graphic-light; }

            // Inline create channel
            if !creating: Rectangle {
                height: 36px;

                add-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.creating = true; }
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        letter-spacing: Theme.track-label;
                        font-weight: Theme.weight-label;
                        text: "+";
                        font-size: 14px;
                        font-family: Theme.font-label;
                        color: add-touch.has-hover ? Theme.text-primary : Theme.text-tertiary;
                        vertical-alignment: center;
                    }
                    Text {
                        letter-spacing: Theme.track-label;
                        font-weight: Theme.weight-label;
                        text: "New channel";
                        font-family: Theme.font-label;
                        font-size: 11px;
                        color: add-touch.has-hover ? Theme.text-primary : Theme.text-tertiary;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                }
            }

            if creating: Rectangle {
                height: 40px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;

                    Image {
                        source: @image-url("../icons/mic.svg");
                        width: 14px;
                        height: 14px;
                        colorize: Theme.text-secondary;
                        y: (parent.height - self.height) / 2;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-app;

                        // Click anywhere on this row to focus the input
                        TouchArea {
                            clicked => { channel-input.focus(); }
                        }

                        channel-input := MelloTextInput {
                            font-family: Theme.font-mono;
                            font-size: 12px;
                            color: Theme.text-primary;
                            horizontal-alignment: left;
                            vertical-alignment: center;

                            accepted => {
                                if self.text != "" {
                                    root.create-channel(self.text);
                                }
                                self.text = "";
                                root.creating = false;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Headless preview:
//   slint-viewer --screenshot out.png --component Preview \
//     client/ui/panels/voice_channel_view.slint
export component Preview inherits Rectangle {
    width: 620px;
    height: 520px;
    background: Theme.bg-app;

    VoiceChannelView {
        x: 20px;
        y: 20px;
        width: parent.width - 40px;
        height: parent.height - 40px;
        can-manage-channels: true;
        voice-channels: [
            {
                id: "c1", name: "General", member-count: 3, is-default: true,
                expanded: true, active: true,
                members: [
                    { id: "m1", name: "ostkatt", initials: "os", speaking: true },
                    { id: "m2", name: "b0bben", initials: "b0", speaking: false },
                    { id: "m3", name: "FaiL", initials: "Fa", speaking: false },
                ],
            },
            { id: "c2", name: "Ranked grind", member-count: 0, is-default: false },
            { id: "c3", name: "Movie night", member-count: 0, is-default: false },
        ];
    }
}
