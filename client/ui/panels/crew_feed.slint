import { Theme } from "../theme.slint";
import { CutShape, CutMask, CutButton, CutButtonShape, OctShape, OctMask } from "../components/cut.slint";
import { UserAvatar, AvatarOverflow } from "../components/avatar.slint";
import { FeedCardData, H2hPerson, HeroStreamData, JoinedRowData, RecentGameTile, StreamCardData, YouStripData } from "../types.slint";
import { ActiveStreamsPanel } from "./active_streams_panel.slint";
import { SessionPreviewCard } from "./session_preview_card.slint";
import { TwoStreamHero } from "../components/stream_hero.slint";
import { SkeletonTrio, SkeletonCell } from "../components/skeleton_trio.slint";
import { Head2headCardWide, Head2headCell, H2hCellSize, VersusHero, InviteCard, TitleChip, H2hHue } from "../components/head2head.slint";
import { YouStrip } from "./you_strip.slint";
import { GameIcon } from "../components/game_icon.slint";
import { GameArt } from "../components/game_art.slint";



// Play/pause ring for clip cards. Declared as a component so both hero and
// standard cards share geometry, hover fill, and click forwarding.
component ClipPlayRing inherits Rectangle {
    in property <bool> small: false;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    /// Red for an unread clip, grey otherwise (frame C): red is state.
    in property <color> tone: Theme.clip-amber;

    // Clicks on the ring must reach card-level play toggle: without this
    // forward the ring's own TouchArea would swallow the event silently.
    callback ring-clicked();

    width: small ? 24px : 44px;
    height: small ? 24px : 44px;
    border-radius: self.width / 2;
    border-width: 1.5px;
    border-color: root.tone;
    background: ring-hover.has-hover ? Theme.live-bg : transparent;
    animate background { duration: 150ms; easing: ease-out; }

    if !is-playing || is-paused: Image {
        source: @image-url("../icons/play.svg");
        colorize: root.tone;
        width: small ? 8px : 14px;
        height: small ? 8px : 14px;
        opacity: 1.0;
        animate opacity { duration: 150ms; easing: ease-out; }
        x: small ? 9px : 16px;
        y: (parent.height - self.height) / 2;
    }

    if is-playing && !is-paused: Image {
        source: @image-url("../icons/pause.svg");
        colorize: root.tone;
        width: small ? 7px : 12px;
        height: small ? 7px : 12px;
        opacity: 1.0;
        animate opacity { duration: 150ms; easing: ease-out; }
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ring-hover := TouchArea {
        accessible-role: button;
        accessible-label: root.is-playing && !root.is-paused ? "Pause" : "Play";
        mouse-cursor: pointer;
        clicked => { root.ring-clicked(); }
    }
}

component DotWaveform inherits Rectangle {
    in property <[float]> peaks: [];
    in property <float> progress: 0.0;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    in property <int> rows: 15;
    /// The lit dots. Red on the hero, grey on a read clip cell (frame C).
    in property <color> tone: Theme.clip-amber;
    in property <length> dot-size: 3px;
    in property <length> row-pitch: 5px;
    in property <int> duration-ms: 30000;
    callback seek-ms(int);
    callback play-at-ms(int);

    property <int> cols: 64;
    property <bool> use-placeholder: peaks.length == 0;
    property <bool> scrubbing: touch.pressed;
    property <bool> hovering: touch.has-hover && !scrubbing;
    property <float> col-pitch-f: self.width / 1px / cols;
    property <int> scrub-col: Math.min(cols - 1, Math.max(0, Math.floor((touch.mouse-x / 1px) / col-pitch-f)));
    property <float> scrub-progress: scrub-col / (cols - 1);
    property <float> display-progress: scrubbing ? scrub-progress : progress;
    property <int> play-col: Math.min(cols - 1, Math.max(0, Math.round(display-progress * (cols - 1))));
    property <bool> show-two-tone: is-playing || is-paused || scrubbing;
    property <int> hover-col: Math.min(cols - 1, Math.max(0, Math.floor((touch.mouse-x / 1px) / col-pitch-f)));
    property <int> press-mode: 0;
    property <length> hairline-x: Math.floor(play-col * col-pitch-f + col-pitch-f / 2) * 1px;
    // Absolute ms for the released scrub position. Duration comes from the
    // component's duration-ms input (card metadata while idle, real duration
    // during playback) — NOT from the global clip-duration-ms, which is
    // zeroed on playback finish and would collapse every idle seek to 0ms.
    property <int> release-pos-ms: Math.round(root.scrub-col / (root.cols - 1) * root.duration-ms);
    property <length> ghost-x: Math.floor(hover-col * col-pitch-f + col-pitch-f / 2) * 1px;
    property <int> chip-col: scrubbing ? scrub-col : hover-col;
    property <length> chip-x: Math.min(self.width - 8px, Math.max(8px, Math.floor(chip-col * col-pitch-f + col-pitch-f / 2) * 1px));
    property <int> chip-ms: Math.round(chip-col / (cols - 1) * duration-ms);
    property <int> chip-secs: Math.max(0, chip-ms / 1000);
    property <int> chip-min-part: Math.floor(chip-secs / 60);
    property <int> chip-sec-part: Math.mod(chip-secs, 60);
    property <string> chip-sec-text: chip-sec-part < 10 ? "0" + chip-sec-part : chip-sec-part;
    property <string> chip-time: chip-min-part + ":" + chip-sec-text;

    property <[float]> placeholder-peaks: [
        0.02, 0.03, 0.01, 0.04, 0.02, 0.03, 0.01, 0.02,
        0.55, 0.72, 0.88, 0.95, 0.82, 0.76, 0.91, 0.68, 0.74, 0.85, 0.62, 0.58,
        0.04, 0.06, 0.03, 0.05, 0.02, 0.04,
        0.78, 0.92, 0.86, 0.71, 0.88, 0.94, 0.79, 0.83, 0.67, 0.75, 0.90, 0.84,
        0.03, 0.05, 0.02, 0.06,
        0.52, 0.61, 0.48,
        0.02, 0.04, 0.03,
        0.65, 0.80, 0.93, 0.87, 0.76, 0.91, 0.85, 0.70, 0.88, 0.96, 0.82,
        0.04, 0.03, 0.06,
        0.58, 0.71
    ];

    background: Theme.card-bg-inset;
    border-radius: 4px;
    clip: true;

    for col[c] in cols: Rectangle {
        property <float> peak-val: root.use-placeholder ? root.placeholder-peaks[c] : peaks[c];
        property <int> lit-count: 1 + Math.round(peak-val * (root.rows - 1));
        property <float> col-pitch-f: parent.width / 1px / root.cols;
        property <length> col-x: Math.min(
            Math.floor(c * col-pitch-f + (col-pitch-f - root.dot-size / 1px) / 2) * 1px,
            parent.width - root.dot-size);
        property <bool> col-remaining: root.show-two-tone && c >= root.play-col;
        property <bool> is-snap-col: root.show-two-tone && c == root.play-col;

        for row[r] in lit-count: Rectangle {
            property <int> row-from-base: lit-count - 1 - r;
            property <bool> silent-col: lit-count == 1;
            property <float> rest-opacity: silent-col && row-from-base == 0
                ? 0.25
                : 0.9 - (row-from-base / (root.rows - 1)) * 0.45;
            property <float> dot-opacity: root.use-placeholder
                ? 0.3 * rest-opacity
                : (col-remaining ? 0.45 : (is-snap-col ? 1.0 : rest-opacity));

            width: root.dot-size;
            height: root.dot-size;
            x: col-x;
            y: Math.floor((parent.height / 1px) - (root.row-pitch / 1px) - (root.dot-size / 1px) - row-from-base * (root.row-pitch / 1px)) * 1px;
            background: is-snap-col ? white : (col-remaining ? Theme.text-dim : root.tone);
            opacity: dot-opacity;
            animate opacity { duration: 120ms; easing: ease-out; }
            animate background { duration: 120ms; easing: ease-out; }
        }
    }

  // Ghost hairline (hover preview at rest / paused)
    if hovering && !scrubbing && (!is-playing || is-paused): Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height;
        clip: true;

        Rectangle {
            x: ghost-x;
            width: 1px;
            height: parent.height;
            background: white;
            opacity: 0.3;
        }
    }

  // Playhead hairline
    if show-two-tone: Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height;
        clip: true;

        playhead-hairline := Rectangle {
            x: hairline-x;
            width: 1px;
            height: parent.height;
            background: white;
            opacity: 1.0;
            animate x {
                duration: scrubbing ? 0ms : (is-playing && !is-paused ? 80ms : 0ms);
                easing: linear;
            }
            states [
                breathing when is-paused && !scrubbing: {
                    opacity: 0.35;
                    in {
                        animate opacity {
                            duration: 700ms;
                            easing: ease-in-out;
                            iteration-count: -1;
                            direction: alternate;
                        }
                    }
                }
            ]
        }
    }

  // Hover / scrub time chip
    if scrubbing || (hovering && !is-playing && !is-paused): Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height;
        clip: true;

        chip-bg := Rectangle {
            x: chip-x - (chip-text.preferred-width + 10px) / 2;
            y: 2px;
            width: chip-text.preferred-width + 10px;
            height: chip-text.preferred-height + 4px;
            border-radius: 3px;
            background: #000000CC;

            chip-text := Text {
                letter-spacing: Theme.track-label;
                font-weight: Theme.weight-label;
                text: chip-time;
                font-family: Theme.font-label;
                font-size: 10px;
                color: Theme.clip-amber;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        accessible-role: slider;
        accessible-label: "Clip position";
        mouse-cursor: crosshair;

        changed pressed => {
            if (self.pressed) {
                root.press-mode = root.is-playing && !root.is-paused ? 1 : (root.is-paused ? 2 : 0);
            } else {
                // Mode 0 (idle): play-at-ms plays then seeks — a bare seek
                // here would target the previously loaded clip.
                if (root.press-mode != 0) {
                    root.seek-ms(root.release-pos-ms);
                }
                if (root.press-mode == 0) {
                    root.play-at-ms(root.release-pos-ms);
                }
            }
        }

        clicked => { /* scrub release handles seek; block card-face toggle */ }
    }
}

component NewBadge inherits Rectangle {
    width: new-text.preferred-width + 12px;
    height: 16px;
    border-radius: 4px;
    background: Theme.live;

    new-text := Text {
        font-family: Theme.font-display;
        text: "NEW";
        font-size: 9px;
        font-weight: Theme.weight-display-bold;
        color: Theme.on-live;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Hero clip card (2x wide)
component HeroClipCard inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    in property <float> progress: 0.0;
    in property <string> position-text: "";
    in property <string> duration-text: "";
    in property <int> clip-duration-ms: 0;
    callback play-clicked(string);
    callback seek-ms(int);

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: card.is-new ? Theme.clip-amber :
                  is-playing ? Theme.clip-amber :
                  card-hover.has-hover ? Theme.graphic-med : Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: card-hover.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    }


    // Declared BEFORE the content so embedded touch areas (waveform scrub,
    // play ring) sit on top and receive their own pointer events — a full-card
    // touch declared after the content would swallow every click.
    card-hover := TouchArea {
        accessible-role: button;
        accessible-label: card.title != "" ? card.title : card.actor-name + " clipped that";
        mouse-cursor: pointer;
        clicked => { play-clicked(card.clip-path); }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;

        // Header: micro-label + timecode
        Rectangle {
            height: 16px;
            vertical-stretch: 0;

            HorizontalLayout {
                spacing: 0px;

                if card.is-new: NewBadge {
                    horizontal-stretch: 0;
                }
                if card.is-new: Rectangle { width: 6px; horizontal-stretch: 0; }

                if !is-playing: HorizontalLayout {
                    spacing: 5px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: HorizontalLayout forces y:0 on children —
                    // center via the cross axis instead of per-child y.
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../icons/scissors.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: "VOICE CLIP";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.clip-amber;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                if is-playing: HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: y is silently forced to 0 in layouts — use
                    // the cross axis to center the icon with its label.
                    cross-axis-alignment: center;

                    if !is-paused: Image {
                        source: @image-url("../icons/speaker.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    if is-paused: Image {
                        source: @image-url("../icons/pause.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: is-paused ? "PAUSED" : "PLAYING";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.clip-amber;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    letter-spacing: Theme.track-label;
                    font-weight: Theme.weight-label;
                    text: is-playing ? position-text + " / " + duration-text : card.duration;
                    font-family: Theme.font-label;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

        }

        // Wave row: play ring + dot-matrix band (absorbs vertical slack)
        Rectangle {
            vertical-stretch: 1;
            min-height: 78px;

            DotWaveform {
                x: play-ring.width + 12px;
                width: parent.width - play-ring.width - 12px;
                height: parent.height;
                peaks: card.waveform;
                progress: root.progress;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                rows: 15;
                dot-size: 3px;
                row-pitch: 5px;
                duration-ms: root.is-playing ? root.clip-duration-ms : card.duration-ms;
                seek-ms(m) => { root.seek-ms(m); }
                play-at-ms(m) => {
                    root.play-clicked(card.clip-path);
                    root.seek-ms(m);
                }
            }

            // x must be explicit: Slint horizontally centers children
            // narrower than their parent by default (CLAUDE.md fill-bar rule).
            play-ring := ClipPlayRing {
                x: 0;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                y: (parent.height - self.height) / 2;
                ring-clicked => { root.play-clicked(card.clip-path); }
            }
        }

        // Card body pinned below the wave band
        VerticalLayout {
            spacing: 6px;
            vertical-stretch: 0;

            Text {
                font-family: Theme.font-display;
                text: card.title != "" ? card.title : card.actor-name + " clipped that";
                font-size: 14px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
            }

            HorizontalLayout {
                spacing: 8px;
                height: 20px;

                if card.participant-count > 0: HorizontalLayout {
                    spacing: 4px;
                    width: self.preferred-width;

                    UserAvatar { initials: card.actor-initials; color-index: 0; }
                    if card.participant-count > 1: UserAvatar { initials: ""; color-index: 1; }
                    if card.participant-count > 2: UserAvatar { initials: ""; color-index: 2; }
                }

                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.timestamp;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                }

                if card.game-name != "": Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: "·";
                    font-size: 11px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                if card.game-name != "": Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.game-name;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Standard clip card (1x)
component ClipCard inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    in property <float> progress: 0.0;
    in property <string> position-text: "";
    in property <string> duration-text: "";
    in property <int> clip-duration-ms: 0;
    callback play-clicked(string);
    callback seek-ms(int);

    // Red is state. An unread clip wears it, a read one is grey (frame C).
    property <color> tone: card.is-new ? Theme.clip-amber : Theme.text-sub;

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        fill: card.is-new ? Theme.clip-amber :
                  is-playing ? Theme.clip-amber :
                  clip-hover.has-hover ? Theme.graphic-med : Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        inset: Theme.keyline;
        fill: clip-hover.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    }


    // Same ordering rule as HeroClipCard: content touches must win.
    clip-hover := TouchArea {
        accessible-role: button;
        accessible-label: card.title != "" ? card.title : card.actor-name + " clipped that";
        mouse-cursor: pointer;
        clicked => { play-clicked(card.clip-path); }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 12px;
        spacing: 8px;

        // Header
        Rectangle {
            height: 16px;
            vertical-stretch: 0;

            HorizontalLayout {
                if card.is-new: NewBadge {
                    horizontal-stretch: 0;
                }
                if card.is-new: Rectangle { width: 6px; horizontal-stretch: 0; }

                if !is-playing: HorizontalLayout {
                    spacing: 5px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: HorizontalLayout forces y:0 on children —
                    // center via the cross axis instead of per-child y.
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../icons/scissors.svg");
                        colorize: root.tone;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: "VOICE CLIP";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: root.tone;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                if is-playing: HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: y is silently forced to 0 in layouts — use
                    // the cross axis to center the icon with its label.
                    cross-axis-alignment: center;

                    if !is-paused: Image {
                        source: @image-url("../icons/speaker.svg");
                        colorize: root.tone;
                        width: 10px;
                        height: 10px;
                    }

                    if is-paused: Image {
                        source: @image-url("../icons/pause.svg");
                        colorize: root.tone;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: is-paused ? "PAUSED" : "PLAYING";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: root.tone;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    letter-spacing: Theme.track-label;
                    font-weight: Theme.weight-label;
                    text: is-playing ? position-text + " / " + duration-text : card.duration;
                    font-family: Theme.font-label;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

        }

        // Wave band with corner play ring (absorbs vertical slack)
        Rectangle {
            vertical-stretch: 1;
            min-height: 38px;

            DotWaveform {
                width: parent.width;
                height: parent.height;
                peaks: card.waveform;
                progress: root.progress;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                tone: root.tone;
                rows: 9;
                dot-size: 2px;
                row-pitch: 4px;
                duration-ms: root.is-playing ? root.clip-duration-ms : card.duration-ms;
                seek-ms(m) => { root.seek-ms(m); }
                play-at-ms(m) => {
                    root.play-clicked(card.clip-path);
                    root.seek-ms(m);
                }
            }

            ClipPlayRing {
                small: true;
                tone: root.tone;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                x: parent.width - self.width - 4px;
                y: 4px;
                ring-clicked => { root.play-clicked(card.clip-path); }
            }
        }

        // Body pinned at the bottom — title + meta, no dead gap
        VerticalLayout {
            spacing: 4px;
            vertical-stretch: 0;

            Text {
                font-family: Theme.font-display;
                text: card.title != "" ? card.title : card.actor-name + " clipped that";
                font-size: 13px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
                overflow: elide;
            }

            // Who was in the clip, as octagons and a count (frame C).
            if card.participant-count > 0: HorizontalLayout {
                height: 20px;
                spacing: 8px;
                cross-axis-alignment: center;
                HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    UserAvatar { initials: card.part0-initials; avatar: card.part0-avatar; has-avatar: card.part0-has-avatar; color-index: 1; size: 20px; }
                    if card.participant-count > 1: UserAvatar { initials: card.part1-initials; avatar: card.part1-avatar; has-avatar: card.part1-has-avatar; color-index: 0; size: 20px; }
                    if card.participant-count > 2: UserAvatar { initials: card.part2-initials; avatar: card.part2-avatar; has-avatar: card.part2-has-avatar; color-index: 2; size: 20px; }
                }
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.participant-count + " participants";
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                }
            }

            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.timestamp + (card.game-name != "" ? " · " + card.game-name : "");
                font-size: 11px;
                color: Theme.text-sub;
            }
        }
    }
}

/// The recap that is open full screen. A card sets it, main.slint draws it.
/// A global, so the card does not pass a callback up through every feed slot.
export global RecapView {
    in-out property <bool> open: false;
    in-out property <FeedCardData> card;
}

// Weekly recap card
component RecapCard inherits Rectangle {
    in property <FeedCardData> card;
    /// Rows of Belts moved the card shows. The full-screen recap shows all.
    property <int> max-belt-rows: 3;
    /// Members of Belts held the card shows: as many as fit the width, each
    /// one an octagon and a count. The full-screen recap shows all.
    property <int> max-held: Math.min(5, Math.max(1, Math.floor((root.width - 28px) / 56px)));
    /// With belts the card has no room for everything. The belts are the news
    /// of the week, so the MVP row and the games list go to the full-screen
    /// recap, which shows both. A recap with no belts keeps all of them.
    property <bool> has-belts: card.belts-moved.length > 0 || card.belts-held.length > 0;

    clip: true;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }


    VerticalLayout {
        padding: 14px;
        padding-top: 16px;
        spacing: 0px;
        // Top-pack: each section uses its natural height and any slack collects
        // at the bottom, instead of stretching the MVP row away from its header.
        alignment: start;

        // Label left, when the recap came out at the right (frames D and F).
        HorizontalLayout {
            height: 16px;
            spacing: 8px;
            Text {
                font-family: Theme.font-label;
                text: "WEEKLY RECAP";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: Theme.text-dim;
                letter-spacing: Theme.track-label;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.age-label;
                font-size: 11px;
                color: Theme.text-dim;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 4px; }

        // "Week 4" once the server counts the crew's weeks. Until then the
        // card says what it is.
        Text {
            font-family: Theme.font-display;
            text: card.recap-week != "" ? card.recap-week : "This week";
            font-size: 28px;
            font-weight: Theme.weight-display-bold;
            letter-spacing: -0.84px;
            color: Theme.text-primary;
        }

        Rectangle { height: 8px; }

        Rectangle { height: 1px; background: Theme.card-border; }

        Rectangle { height: 8px; }

        // The numbers of the week, two by two (mockup .rc-nums).
        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: card.title; font-family: Theme.font-display; font-weight: Theme.weight-display-bold; font-size: 24px; letter-spacing: -0.5px; color: Theme.text-primary; }
                    Text { text: "HANGOUT"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 9px; letter-spacing: 1.8px; color: Theme.text-dim; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: card.subtitle != "" ? card.subtitle : "0"; font-family: Theme.font-display; font-weight: Theme.weight-display-bold; font-size: 24px; letter-spacing: -0.5px; color: Theme.text-primary; }
                    Text { text: "CLIPS"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 9px; letter-spacing: 1.8px; color: Theme.text-dim; }
                }
            }

            if card.duration != "" || card.game-name != "": HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    if card.duration != "": Text { text: card.duration; font-family: Theme.font-display; font-weight: Theme.weight-display-bold; font-size: 24px; letter-spacing: -0.5px; color: Theme.text-primary; }
                    if card.duration != "": Text { text: "LONGEST"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 9px; letter-spacing: 1.8px; color: Theme.text-dim; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    if card.game-name != "": HorizontalLayout {
                        height: 29px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        GameArt {
                            game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index;
                            icon: card.game-icon; has-icon: card.game-has-icon;
                            capsule: card.game-capsule; has-capsule: card.game-has-capsule;
                            size: 29px; art-width: 52px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: card.game-name;
                            font-family: Theme.font-display;
                            font-weight: Theme.weight-display;
                            font-size: 12px;
                            color: Theme.text-primary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    if card.game-name != "": Text { text: "TOP GAME"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 9px; letter-spacing: 1.8px; color: Theme.text-dim; }
                }
            }
        }

        Rectangle { height: 10px; }

        // MVP section with avatars
        if card.mvp-count > 0 && !root.has-belts: Rectangle {

            VerticalLayout {
                spacing: 0px;

                Rectangle { height: 1px; background: Theme.card-border; }
                Rectangle { height: 8px; }

                Text {
                    font-family: Theme.font-label;
                    text: "MVP";
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    color: Theme.skel-text;
                    letter-spacing: Theme.track-label;
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 4px;

                    if card.mvp-count >= 1: HorizontalLayout {
                        spacing: 8px;
                        height: 22px;

                        UserAvatar { initials: card.mvp0-initials; color-index: 0; avatar: card.mvp0-avatar; has-avatar: card.mvp0-has-avatar; }
                        Text {
                            font-family: Theme.font-body;
                            text: card.mvp0-name;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: card.mvp0-stat;
                            font-size: 11px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }

                    // Single MVP keeps the recap card compact (spec 19 polish);
                    // mvp1/mvp2 data still arrives but is intentionally not shown.
                }
            }
        }

        // Belts moved (head2head): one row for each title that changed hands.
        // The previous holder is dimmed, the new holder wears the hue.
        if card.belts-moved.length > 0: Rectangle {
            VerticalLayout {
                spacing: 0px;

                Rectangle { height: 1px; background: Theme.card-border; }
                Rectangle { height: 8px; }

                HorizontalLayout {
                    height: 16px;
                    Text {
                        font-family: Theme.font-label;
                        text: "BELTS MOVED";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.text-dim;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        font-weight: Theme.weight-sentence;
                        font-family: Theme.font-body;
                        text: "Head2head";
                        font-size: 11px;
                        color: Theme.text-dim;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 0px;
                    // A row past the limit has no height. The 6px gap sits
                    // inside the row, so a hidden row leaves no gap either.
                    for b[i] in card.belts-moved: Rectangle {
                      height: i < root.max-belt-rows ? 42px : 0px;
                      clip: true;
                      HorizontalLayout {
                        spacing: 6px;
                        padding-bottom: 6px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 28px;
                            opacity: 0.4;
                            UserAvatar { size: 28px; initials: b.prev-initials; color-index: b.prev-hue; avatar: b.prev-avatar; has-avatar: b.prev-has-avatar; }
                        }
                        UserAvatar { size: 28px; initials: b.holder-initials; color-index: b.holder-hue; avatar: b.holder-avatar; has-avatar: b.holder-has-avatar; }
                        TitleChip {
                            horizontal-stretch: 1;
                            compact: true;
                            hue: H2hHue.of(b.holder-hue);
                            icon: b.icon; title: b.title; value: b.value; unit: b.unit;
                        }
                      }
                    }
                }
                Rectangle { height: 10px; }
            }
        }

        // Belts held: who holds how many titles right now, most first.
        if card.belts-held.length > 0: Rectangle {
            VerticalLayout {
                spacing: 0px;

                Rectangle { height: 1px; background: Theme.card-border; }
                Rectangle { height: 8px; }

                HorizontalLayout {
                    height: 16px;
                    Text {
                        font-family: Theme.font-label;
                        text: "BELTS HELD";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.text-dim;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        font-weight: Theme.weight-sentence;
                        font-family: Theme.font-body;
                        text: "Now";
                        font-size: 11px;
                        color: Theme.text-dim;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 6px; }

                // One column for each member, an octagon over the count over
                // "BELTS" (mockup .held). As many as fit, five at most.
                HorizontalLayout {
                    spacing: 0px;
                    for h[i] in card.belts-held: Rectangle {
                        horizontal-stretch: i < root.max-held ? 1 : 0;
                        max-width: i < root.max-held ? 10000px : 0px;
                        min-width: 0px;
                        clip: true;
                        VerticalLayout {
                            alignment: start;
                            spacing: 3px;
                            HorizontalLayout {
                                alignment: center;
                                UserAvatar { size: 28px; initials: h.initials; color-index: h.hue; avatar: h.avatar; has-avatar: h.has-avatar; }
                            }
                            Text {
                                text: h.count;
                                font-family: Theme.font-display;
                                font-size: 22px;
                                font-weight: Theme.weight-display-bold;
                                color: Theme.text-value;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "BELTS";
                                font-family: Theme.font-label;
                                font-weight: Theme.weight-label;
                                font-size: 8px;
                                letter-spacing: 1.6px;
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                Rectangle { height: 10px; }
            }
        }

        // This week in games (spec 19)
        if (card.leaderboard.length > 0 || card.awards.length > 0) && !root.has-belts: Rectangle {
            VerticalLayout {
                spacing: 0px;

                Rectangle { height: 1px; background: Theme.card-border; }
                Rectangle { height: 8px; }

                Text {
                    font-family: Theme.font-label;
                    text: "THIS WEEK IN GAMES";
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    color: Theme.skel-text;
                    letter-spacing: Theme.track-label;
                }

                if card.games-summary != "": Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.games-summary;
                    font-size: 11px;
                    color: Theme.text-sub;
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 4px;
                    for row in card.leaderboard: HorizontalLayout {
                        spacing: 8px;
                        height: 22px;
                        UserAvatar { initials: row.initials; color-index: row.color-index; avatar: row.avatar; has-avatar: row.has-avatar; }
                        Text {
                            font-family: Theme.font-body;
                            text: row.name;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: row.record;
                            font-size: 11px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }
                }

                if card.awards.length > 0: Rectangle { height: 8px; }

                VerticalLayout {
                    spacing: 4px;
                    for a in card.awards: HorizontalLayout {
                        spacing: 8px;
                        height: 18px;
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: a.title;
                            font-size: 11px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-family: Theme.font-body;
                            text: a.name;
                            font-size: 11px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: a.detail;
                            font-size: 10px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    TouchArea {
        accessible-role: button;
        accessible-label: "Open weekly recap";
        mouse-cursor: pointer;
        clicked => {
            RecapView.card = root.card;
            RecapView.open = true;
        }
    }
}

// Session card
// Voice/stream session card, redesigned per designs/feed/
// session-cards-redesign.html (Option B: game/channel-first). Typed header,
// real avatars, humanized duration, peak stat — a card must answer "who did
// what, for how long" at a glance.
component SessionCard inherits Rectangle {
    in property <FeedCardData> card;

    property <bool> is-stream: card.session-kind == "stream";
    property <color> kind-color: is-stream ? Theme.accent : Theme.id-blue;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }


    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        // Typed header: colored dot + STREAM / VOICE.
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 6px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: kind-color;
                    y: (parent.height - self.height) / 2;
                }
            }
            Text {
                font-family: Theme.font-label;
                text: is-stream ? "STREAM" : card.session-kind == "voice" ? "VOICE" : "SESSION";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: kind-color;
                letter-spacing: Theme.track-label;
            }
        }

        // ── STREAM: game art leads, streamer avatar badged on its corner ──
        if is-stream: HorizontalLayout {
            spacing: 10px;
            height: 44px;

            Rectangle {
                width: 40px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    y: (parent.height - self.height) / 2;

                    GameArt { game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index; icon: card.game-icon; has-icon: card.game-has-icon; capsule: card.game-capsule; has-capsule: card.game-has-capsule; size: 40px; }
                    if card.actor-has-avatar || card.actor-initials != "": UserAvatar {
                        initials: card.actor-initials;
                        avatar: card.actor-avatar;
                        has-avatar: card.actor-has-avatar;
                        x: parent.width - self.width + 4px;
                        y: parent.height - self.height + 4px;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    font-family: Theme.font-display;
                    text: card.game-name != "" ? card.game-name : card.title;
                    font-size: 13px;
                    font-weight: Theme.weight-display;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.actor-name != "" ? "by " + card.actor-name
                            + (card.duration-human != "" ? " · " + card.duration-human : "")
                        : card.duration-human;
                    font-size: 11px;
                    color: Theme.text-sub;
                    overflow: elide;
                }
            }
        }

        if is-stream && card.peak-count > 0: Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: "\{card.peak-count} watched at peak";
            font-size: 11px;
            color: Theme.text-sub;
        }

        // ── VOICE: the people are the content, so they get the space ──
        // Channel + meta as a compact heading, then a large avatar cluster
        // that fills the card instead of an empty stretch gap.
        if !is-stream: VerticalLayout {
            spacing: 2px;
            Text {
                font-family: Theme.font-display;
                text: card.channel-name != "" ? card.channel-name : card.title;
                font-size: 13px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.duration-human
                    + (card.peak-count > 0 ? " · \{card.peak-count} in call" : "");
                font-size: 11px;
                color: Theme.text-sub;
                overflow: elide;
            }
        }

        if !is-stream: Rectangle { height: 6px; }

        if !is-stream && card.participant-count > 0: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            height: 40px;

            UserAvatar {
                initials: card.part0-initials;
                avatar: card.part0-avatar;
                has-avatar: card.part0-has-avatar;
                color-index: 0;
                size: 40px;
            }
            if card.participant-count > 1: UserAvatar {
                initials: card.part1-initials;
                avatar: card.part1-avatar;
                has-avatar: card.part1-has-avatar;
                color-index: 1;
                size: 40px;
            }
            if card.participant-count > 2: UserAvatar {
                initials: card.part2-initials;
                avatar: card.part2-avatar;
                has-avatar: card.part2-has-avatar;
                color-index: 2;
                size: 40px;
            }
            // Overflow chip: the roster is wider than the three avatar slots.
            if card.participant-count > 3: AvatarOverflow {
                count: card.participant-count - 3;
                size: 40px;
            }
        }

        if !is-stream && card.participants-line != "": Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: card.participants-line;
            font-size: 11px;
            color: Theme.text-sub;
            overflow: elide;
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: card.timestamp + (card.subtitle != "" ? " · " + card.subtitle : "");
            font-size: 11px;
            color: Theme.skel-text;
        }
    }
}

// Telemetry-backed W/L block for notable game sessions (spec 19 B2).
component GameSessionRecordPanel inherits VerticalLayout {
    in property <FeedCardData> card;
    in property <color> record-color;

    spacing: 0px;

    // Headline record. A win reads white and a loss reads red, the same
    // rule the you-strip pips follow. Colouring the whole record by the
    // streak painted the wins red on any session that ended down.
    HorizontalLayout {
        alignment: start;
        spacing: 0px;

        Text {
            font-family: Theme.font-display;
            text: card.game-wins + "W";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-primary;
        }
        Text {
            font-family: Theme.font-display;
            text: "–";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-tertiary;
        }
        Text {
            font-family: Theme.font-display;
            text: card.game-losses + "L";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.live;
        }
        if card.game-draws > 0: Text {
            font-family: Theme.font-display;
            text: "–";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-tertiary;
        }
        if card.game-draws > 0: Text {
            font-family: Theme.font-display;
            text: card.game-draws + "D";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-secondary;
        }
    }
    Text {
        font-weight: Theme.weight-sentence;
        font-family: Theme.font-body;
        text: "this session";
        font-size: 11px;
        color: Theme.text-sub;
    }

    Rectangle { height: 12px; }
    Rectangle { height: 1px; background: Theme.card-border; }
    Rectangle { height: 10px; }

    // Stat tiles: streak · win rate · matches
    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                font-family: Theme.font-display;
                text: card.game-streak-text;
                font-size: 16px;
                font-weight: Theme.weight-display-bold;
                color: card.game-streak-positive ? Theme.text-primary : Theme.live;
            }
            Text { font-weight: Theme.weight-sentence; font-family: Theme.font-body; text: "streak"; font-size: 10px; color: Theme.text-sub; }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                font-family: Theme.font-display;
                text: card.game-winrate;
                font-size: 16px;
                font-weight: Theme.weight-display-bold;
                color: Theme.text-primary;
            }
            Text { font-weight: Theme.weight-sentence; font-family: Theme.font-body; text: "win rate"; font-size: 10px; color: Theme.text-sub; }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                font-family: Theme.font-display;
                text: "\{card.game-matches}";
                font-size: 16px;
                font-weight: Theme.weight-display-bold;
                color: Theme.text-primary;
            }
            Text { font-weight: Theme.weight-sentence; font-family: Theme.font-body; text: "matches"; font-size: 10px; color: Theme.text-sub; }
        }
    }
}

// Zero-telemetry session: icon + "X played Y" + duration, no empty stat slots.
component GameSessionCompactBody inherits VerticalLayout {
    in property <FeedCardData> card;
    in property <color> game-accent;
    in property <bool> quiet: false;

    spacing: quiet ? 6px : 8px;
    alignment: start;

    HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;

        GameArt { game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index; icon: card.game-icon; has-icon: card.game-has-icon; capsule: card.game-capsule; has-capsule: card.game-has-capsule; size: quiet ? 32px : 36px; }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: start;

            Text {
                font-family: Theme.font-display;
                text: card.title != "" ? card.title : card.game-name;
                font-size: quiet ? 12px : 13px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
                overflow: elide;
            }
            if card.duration-human != "": Text {
                font-family: Theme.font-display;
                text: card.duration-human;
                font-size: quiet ? 16px : 20px;
                font-weight: Theme.weight-display-bold;
                color: Theme.text-primary;
            }
        }
    }

    if card.participant-count > 1: HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;
        height: 20px;

        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            horizontal-stretch: 0;
            UserAvatar {
                initials: card.part0-initials != "" ? card.part0-initials : card.actor-initials;
                avatar: card.part0-has-avatar ? card.part0-avatar : card.actor-avatar;
                has-avatar: card.part0-has-avatar || card.actor-has-avatar;
                color-index: 0;
                size: 20px;
            }
            if card.participant-count > 1: UserAvatar {
                initials: card.part1-initials;
                avatar: card.part1-avatar;
                has-avatar: card.part1-has-avatar;
                color-index: 1;
                size: 20px;
            }
            if card.participant-count > 2: UserAvatar {
                initials: card.part2-initials;
                avatar: card.part2-avatar;
                has-avatar: card.part2-has-avatar;
                color-index: 2;
                size: 20px;
            }
        }

        if card.participants-line != "": Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: card.participants-line;
            font-size: 11px;
            color: Theme.text-sub;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    Rectangle { vertical-stretch: 1; }

    Text {
        font-weight: Theme.weight-sentence;
        font-family: Theme.font-body;
        text: card.timestamp;
        font-size: 11px;
        color: Theme.skel-text;
    }
}

// Rich game-session card for notable sessions (spec 19 B2); compact T0 variant
// when the session has no W/L record (GAME-SURFACING C1).
component GameSessionCard inherits Rectangle {
    in property <FeedCardData> card;

    property <bool> has-record: card.game-matches > 0;
    property <bool> is-quiet: card.role == "quiet" || card.size == "sm";
    property <color> game-accent: card.game-has-color ? card.game-color : Theme.accent;
    property <color> record-color: card.game-streak-positive ? Theme.text-primary : Theme.live;

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }


    if !has-record: VerticalLayout {
        padding: is-quiet ? 10px : 12px;
        spacing: 0px;
        alignment: start;

        GameSessionCompactBody {
            card: root.card;
            game-accent: root.game-accent;
            quiet: is-quiet;
        }
    }

    if has-record: VerticalLayout {
        padding: 14px;
        spacing: 0px;

        // Header: game badge + name + actor / time
        HorizontalLayout {
            spacing: 10px;
            height: 40px;

            VerticalLayout {
                alignment: center;
                GameArt { game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index; icon: card.game-icon; has-icon: card.game-has-icon; capsule: card.game-capsule; has-capsule: card.game-has-capsule; size: 40px; }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    font-family: Theme.font-display;
                    text: card.game-name != "" ? card.game-name : "Game session";
                    font-size: 14px;
                    font-weight: Theme.weight-display;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    // The time only (mockup frames B to F). Who played is the footer.
                    text: card.timestamp;
                    font-size: 11px;
                    color: Theme.text-sub;
                    overflow: elide;
                }
            }

            // Server-verified result (Riot post-match API) — spec 18 §9.
            if card.game-verified: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: verified-label.preferred-width + 12px;
                    height: 18px;
                    border-radius: 4px;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.graphic-med;
                    verified-label := Text {
                        text: "VERIFIED";
                        font-family: Theme.font-label;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { height: 14px; }

        GameSessionRecordPanel {
            card: root.card;
            record-color: record-color;
        }

        Rectangle { vertical-stretch: 1; }

        // Footer: the octagons of who played, "Bob, solo" when one person did,
        // and the duration at the right (mockup frames B to F).
        HorizontalLayout {
            height: 20px;
            spacing: 6px;
            cross-axis-alignment: center;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                horizontal-stretch: 0;
                cross-axis-alignment: center;
                UserAvatar {
                    initials: card.part0-initials != "" ? card.part0-initials : card.actor-initials;
                    avatar: card.part0-has-avatar ? card.part0-avatar : card.actor-avatar;
                    has-avatar: card.part0-has-avatar || card.actor-has-avatar;
                    color-index: 0;
                    size: 20px;
                }
                if card.participant-count > 1: UserAvatar {
                    initials: card.part1-initials;
                    avatar: card.part1-avatar;
                    has-avatar: card.part1-has-avatar;
                    color-index: 1;
                    size: 20px;
                }
                if card.participant-count > 2: UserAvatar {
                    initials: card.part2-initials;
                    avatar: card.part2-avatar;
                    has-avatar: card.part2-has-avatar;
                    color-index: 2;
                    size: 20px;
                }
            }

            if card.participant-count <= 1 && card.actor-name != "": Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.actor-name + ", solo";
                font-size: 11px;
                color: Theme.text-sub;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if card.participant-count > 1 || card.actor-name == "": Rectangle { horizontal-stretch: 1; }

            if card.duration-human != "": Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.duration-human;
                font-size: 11px;
                color: Theme.skel-text;
            }
        }
    }
}

// Recent games card (mockup frame A). One row per game: the art, the name in
// Oxanium with the hours under it, and "TRACKED" at the right when the game
// sensor knows the game. Art ladder: the runtime icon, the local Steam header,
// then a two-letter monogram in the game's hue. The art slot is 76 px wide, the
// shape of a Steam header (460 by 215), two corners cut.
component RecentGameTileCell inherits Rectangle {
    in property <RecentGameTile> tile;
    // TRACKED stands at the far right of a roomy row (frame B). In a narrow
    // row it moves to the hours line so the name keeps the whole row.
    property <bool> tracked-right: tile.tracked && root.width >= 300px;

    height: 36px;
    background: transparent;

    HorizontalLayout {
        spacing: 12px;
        cross-axis-alignment: center;

        GameArt {
            game-id: tile.game-id;
            monogram: tile.monogram;
            hue-index: tile.hue-index;
            icon: tile.game-icon;
            has-icon: tile.has-icon;
            capsule: tile.capsule;
            has-capsule: tile.has-capsule;
            size: 36px;
            art-width: 76px;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                font-family: Theme.font-display;
                font-weight: Theme.weight-display;
                text: tile.game-name;
                font-size: 13px;
                color: Theme.text-value;
                overflow: elide;
            }
            // TRACKED sits on the hours line, so the name has the whole row.
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if tile.hours != "": Text {
                    font-family: Theme.font-label;
                    font-weight: Theme.weight-label;
                    text: tile.hours.to-uppercase();
                    font-size: 9px;
                    letter-spacing: Theme.track-label;
                    color: Theme.text-dim;
                    overflow: elide;
                }
                if tile.tracked && !root.tracked-right: Text {
                    text: "TRACKED";
                    font-family: Theme.font-label;
                    font-weight: Theme.weight-label;
                    font-size: 9px;
                    letter-spacing: Theme.track-label;
                    color: Theme.text-value;
                }
            }
        }

        if root.tracked-right: Text {
            text: "TRACKED";
            font-family: Theme.font-label;
            font-weight: Theme.weight-label;
            font-size: 9px;
            letter-spacing: Theme.track-label;
            color: Theme.text-value;
            vertical-alignment: center;
        }
    }
}

// One poster of the recent games grid (mockup frame B2, .mrg): header art in
// the 460 by 215 shape with two corners cut, the game name in Oxanium under
// it, and the owners as small octagons under the name.
component RecentGamePoster inherits Rectangle {
    in property <RecentGameTile> tile;

    background: transparent;

    VerticalLayout {
        alignment: start;
        spacing: 0px;

        GameArt {
            game-id: tile.game-id;
            monogram: tile.monogram;
            hue-index: tile.hue-index;
            icon: tile.game-icon;
            has-icon: tile.has-icon;
            capsule: tile.capsule;
            has-capsule: tile.has-capsule;
            size: 36px;
            art-width: root.width;
            art-height: root.width * 215 / 460;
        }
        Text {
            font-family: Theme.font-display;
            font-weight: Theme.weight-display;
            text: tile.game-name;
            font-size: 12px;
            color: Theme.text-value;
            overflow: elide;
        }
        // Owners: the members who have it. Space above the name and the pips.
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            padding-top: 6px;
            for o in tile.owners: UserAvatar {
                initials: o.initials;
                avatar: o.avatar;
                has-avatar: o.has-avatar;
                color-index: o.hue-index;
                size: 16px;
            }
        }
        // When it was last played (frames C and D).
        if tile.when != "": Text {
            font-family: Theme.font-label;
            font-weight: Theme.weight-label;
            text: tile.when.to-uppercase();
            font-size: 9px;
            letter-spacing: Theme.track-label;
            color: Theme.text-dim;
            overflow: elide;
        }
    }
}

component RecentGamesCard inherits Rectangle {
    in property <FeedCardData> card;

    /// Poster grid when two or more members own games and the slot has two
    /// columns. A one-column slot, or a crew of one, keeps the list.
    property <bool> grid: root.card.recent-pc-count >= 2 && root.width >= 420px;
    property <int> grid-max: 5;
    property <length> grid-gap: 12px;
    // Three to five posters share the row: a week with fewer games gets larger
    // posters, not a gap (frame C).
    property <int> grid-n: Math.max(3, Math.min(card.recent-games.length, root.grid-max));
    property <length> poster-width: (root.width - 32px - (root.grid-n - 1) * root.grid-gap) / root.grid-n;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "tr";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "tr";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        padding: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: root.grid ? 10px : 12px;
        alignment: start;

        // Label left, note right: "From this PC", "From 2 PCs", or the week's
        // sessions line.
        HorizontalLayout {
            height: 16px;
            spacing: 8px;
            Text {
                font-family: Theme.font-label;
                text: "RECENT GAMES";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: Theme.text-dim;
                letter-spacing: Theme.track-label;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.subtitle;
                font-size: 11px;
                color: Theme.text-dim;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if !root.grid: VerticalLayout {
            spacing: 12px;
            for tile[i] in card.recent-games: RecentGameTileCell {
                visible: i < 3;
                height: i < 3 ? 36px : 0px;
                tile: tile;
            }
        }

        // Five posters in one row, newest played first. The server sorts.
        if root.grid: HorizontalLayout {
            alignment: start;
            spacing: root.grid-gap;
            for tile[i] in card.recent-games: RecentGamePoster {
                visible: i < root.grid-max;
                width: i < root.grid-max ? root.poster-width : 0px;
                tile: tile;
            }
        }
    }
}


// The player octagons of a live card, with "+N" past the last one.
component LivePlayers inherits HorizontalLayout {
    in property <FeedCardData> card;

    height: 20px;
    spacing: 4px;
    alignment: start;
    for p in card.live.players: UserAvatar {
        initials: p.initials;
        avatar: p.avatar;
        has-avatar: p.has-avatar;
        color-index: p.hue-index;
        size: 20px;
    }
    if card.live.more-players > 0: AvatarOverflow {
        count: card.live.more-players;
        size: 20px;
    }
}

component LiveSessionName inherits Text {
    in property <FeedCardData> card;

    text: card.game-name;
    font-family: Theme.font-display;
    font-size: 13px;
    font-weight: Theme.weight-display;
    color: Theme.text-primary;
    overflow: elide;
}

component LiveSinceText inherits Text {
    in property <FeedCardData> card;

    text: card.live.since-text;
    font-weight: Theme.weight-sentence;
    font-family: Theme.font-body;
    font-size: 12px;
    color: Theme.text-sub;
}

// The red dot of a live card. Red is only this.
component LivePip inherits Rectangle {
    width: 6px;
    Rectangle {
        width: 6px;
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: Theme.live;
    }
}

// Live session card: a game in progress (mockup cold-start frames 5 and 8).
// The shape of the session card: the fixed game tile at the left, then the
// name, the player octagons and "since N min". Red is only the pip of the
// label. With poster art in the wide slot the art fills the card instead.
component LiveSessionCard inherits Rectangle {
    in property <FeedCardData> card;

    // The wide slot is only given to a card with poster art. Without it the
    // card is a cell, whatever the width.
    property <bool> poster-mode: card.live.has-poster && root.width > 420px;

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    // Wide card with poster: the local Steam art keeps its colour. Chrome
    // sits on black washes, as on the stream hero card (mockup next-gen-feed,
    // stage D): the label on the top wash, the game and the players on the
    // bottom one.
    if root.poster-mode: Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;

        Image {
            source: root.card.live.poster;
            width: parent.width;
            height: parent.height;
            image-fit: cover;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(180deg,
                #00000099 0%, #00000000 26%, #00000000 40%, #000000E6 100%);
        }
        CutMask { width: parent.width; height: parent.height; n: Theme.notch; corner: "br"; fill: Theme.bg-app; }

        VerticalLayout {
            padding: 14px;
            spacing: 4px;

            HorizontalLayout {
                height: 16px;
                spacing: 6px;
                LivePip { }
                Text {
                    horizontal-stretch: 1;
                    text: "NOW PLAYING";
                    font-family: Theme.font-label;
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-label;
                    color: Theme.on-media;
                    vertical-alignment: center;
                }
            }

            Rectangle { vertical-stretch: 1; }

            LiveSessionName {
                card: root.card;
                font-size: 20px;
                color: Theme.on-media;
            }
            HorizontalLayout {
                spacing: 10px;
                height: 20px;
                LivePlayers { card: root.card; horizontal-stretch: 0; }
                Text {
                    horizontal-stretch: 1;
                    text: root.card.live.since-text;
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    font-size: 12px;
                    color: Theme.on-media;
                    vertical-alignment: center;
                }
            }
        }
    }

    if !root.poster-mode: VerticalLayout {
        padding: 14px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            height: 16px;
            spacing: 6px;
            LivePip { }
            Text {
                horizontal-stretch: 1;
                text: "NOW PLAYING";
                font-family: Theme.font-label;
                font-size: 10px;
                font-weight: Theme.weight-label;
                letter-spacing: Theme.track-label;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            height: 58px;

            Rectangle {
                width: 40px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    y: 0px;
                    GameArt { game-id: root.card.game-id; monogram: root.card.game-monogram; hue-index: root.card.game-hue-index; icon: root.card.game-icon; has-icon: root.card.game-has-icon; capsule: root.card.game-capsule; has-capsule: root.card.game-has-capsule; size: 40px; }
                }
            }

            VerticalLayout {
                alignment: start;
                spacing: 2px;
                horizontal-stretch: 1;
                LiveSessionName { card: root.card; }
                LivePlayers { card: root.card; }
                LiveSinceText { card: root.card; }
            }
        }

    }
}

// Catch-up card
component CatchupCard inherits Rectangle {
    in property <FeedCardData> card;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }


    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            font-family: Theme.font-label;
            text: "CATCH-UP";
            font-size: 10px;
            font-weight: Theme.weight-label;
            color: Theme.accent-green;
            letter-spacing: Theme.track-label;
        }

        Text {
            font-weight: Theme.weight-display;
            font-family: Theme.font-display;
            text: card.title;
            font-size: 13px;
            color: Theme.text-value;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: card.timestamp;
            font-size: 11px;
            color: Theme.skel-text;
        }
    }
}

// The invite line under the skeleton trio (CLIPS 8). One line of copy and the
// one filled button, red because it commits.
component FeedInviteLine inherits Rectangle {
    callback invite-clicked();
    callback hide-clicked();

    height: 40px;
    background: transparent;

    HorizontalLayout {
        spacing: 14px;
        cross-axis-alignment: center;

        Text {
            horizontal-stretch: 1;
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: "Invite your crew. Everything here comes alive when your friends join.";
            font-size: 13px;
            color: Theme.text-sub;
            overflow: elide;
            vertical-alignment: center;
        }

        CutButton {
            horizontal-stretch: 0;
            width: 150px;
            height: 36px;
            fill-color: invite-touch.has-hover ? Theme.confirm-press : Theme.live;

            Text {
                font-family: Theme.font-display;
                text: "Share invite link";
                font-size: 12px;
                font-weight: Theme.weight-display;
                color: Theme.on-live;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            invite-touch := TouchArea {
                accessible-role: button;
                accessible-label: "Share invite link";
                mouse-cursor: pointer;
                clicked => { root.invite-clicked(); }
            }
        }

        Rectangle {
            horizontal-stretch: 0;
            width: hide-text.preferred-width + 8px;

            hide-text := Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: "Hide";
                font-size: 11px;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }

            TouchArea {
                accessible-role: button;
                accessible-label: "Hide invite";
                mouse-cursor: pointer;
                clicked => { root.hide-clicked(); }
            }
        }
    }
}

// m3llo+ upsell card pinned at the end of the memory band. Server emits a
// "locked" entry; copy and visual stay client-side.
component LockedCard inherits Rectangle {

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "tr";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "tr";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 20px;

        Text {
            font-family: Theme.font-display;
            text: "Unlock your crew's full story";
            font-size: 14px;
            font-weight: Theme.weight-display;
            color: Theme.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: "Keep every clip and recap forever with m3llo+.";
            font-size: 11px;
            color: Theme.text-sub;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Dispatcher: renders the correct card based on card-type
component FeedSlot inherits Rectangle {
    // A card that outgrows its slot must be cut off at the slot edge, not
    // painted over the gap below it. This is `overflow: hidden` in the mockup.
    clip: true;

    in property <FeedCardData> card;
    in property <string> playing-path: "";
    in property <float> clip-progress: 0.0;
    in property <bool> clip-paused: false;
    in property <float> clip-anim-tick: 0.0;
    in property <string> clip-position-text: "";
    in property <string> clip-duration-text: "";
    in property <int> clip-duration-ms: 0;
    /// The slot is one column, not the wide slot: the side column beside a
    /// live stream, or the cell beside a live session. A wide head2head card
    /// does not fit there.
    in property <bool> side-column: false;
    callback play-clicked(string);
    callback seek-clip-ms(int);
    callback session-seen(string);
    callback session-preview-request-frame(/* session_id */ string, /* index */ int);
    /// The red invite button of a head2head or invite card.
    callback invite-clicked();

    // Real cards
    if card.card-type == "clip" && card.is-hero: HeroClipCard {
        width: parent.width; height: parent.height; card: root.card;
        is-playing: root.card.clip-path != "" && root.card.clip-path == root.playing-path;
        is-paused: root.clip-paused && root.card.clip-path != ""
            && root.card.clip-path == root.playing-path;
        progress: root.clip-progress;
        position-text: root.clip-position-text;
        duration-text: root.clip-duration-text;
        clip-duration-ms: root.clip-duration-ms;
        play-clicked(id) => { root.play-clicked(id); }
        seek-ms(m) => { root.seek-clip-ms(m); }
    }
    if card.card-type == "clip" && !card.is-hero: ClipCard {
        width: parent.width; height: parent.height; card: root.card;
        is-playing: root.card.clip-path != "" && root.card.clip-path == root.playing-path;
        is-paused: root.clip-paused && root.card.clip-path != ""
            && root.card.clip-path == root.playing-path;
        progress: root.clip-progress;
        position-text: root.clip-position-text;
        duration-text: root.clip-duration-text;
        clip-duration-ms: root.clip-duration-ms;
        play-clicked(id) => { root.play-clicked(id); }
        seek-ms(m) => { root.seek-clip-ms(m); }
    }
    if card.card-type == "recap": RecapCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    if card.card-type == "session-preview": SessionPreviewCard {
        width: parent.width; height: parent.height;
        session-id: card.id;
        snapshot-urls: card.snapshot-urls;
        title: card.title;
        game-name: card.game-name;
        streamer-username: card.actor-name;
        streamer-initials: card.actor-initials;
        streamer-hue-index: card.actor-hue-index;
        duration-min: card.duration-min;
        peak-viewers: card.participant-count;
        clip-count: card.clip-count;
        time-since-ended: card.timestamp;
        is-hero: card.is-hero;
        was-seen: card.was-seen;
        snapshot-loading: card.snapshot-loading;
        snapshot-poster: card.snapshot-poster;
        snapshot-poster-ready: card.snapshot-poster-ready;
        snapshot-error: card.snapshot-error;
        snapshot-playback-frame: card.snapshot-playback-frame;
        snapshot-playback-index: card.snapshot-playback-index;
        snapshot-playback-revision: card.snapshot-playback-revision;
        session-seen(id) => { root.session-seen(id); }
        session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
    }
    if card.card-type == "session": SessionCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    if card.card-type == "game-session": GameSessionCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    if card.card-type == "recent-games": RecentGamesCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    if card.card-type == "live-session": LiveSessionCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    if card.card-type == "catchup": CatchupCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    if card.card-type == "locked": LockedCard {
        width: parent.width; height: parent.height;
    }
    // Head2head: the variant is the placement rule, see client/src/head2head.rs.
    if card.card-type == "head2head" && card.head2head.variant == "wide" && !root.side-column: Head2headCardWide {
        width: parent.width; height: parent.height;
        member-name: card.head2head.left-name;
        member-initials: card.head2head.left-initials;
        member-avatar: card.head2head.left-avatar;
        member-has-avatar: card.head2head.left-has-avatar;
        hue-index: card.head2head.left-hue-index;
        open-seats: card.head2head.open-seats;
        titles: card.head2head.chips;
        invite-clicked => { root.invite-clicked(); }
    }
    // A live stream holds the hero and sends the first two cards to the side
    // column. A crew of one has no pair to show, so the wide card gives way
    // to the cell: its seats as "+N", the invite beside them.
    if card.card-type == "head2head" && card.head2head.variant == "wide" && root.side-column: Head2headCell {
        width: parent.width; height: parent.height;
        viewer-name: card.head2head.left-name;
        pairs: [];
        open-seats: card.head2head.open-seats;
        invite-clicked => { root.invite-clicked(); }
    }
    if card.card-type == "head2head" && card.head2head.variant == "versus": VersusHero {
        width: parent.width; height: parent.height;
        left-name: card.head2head.left-name;
        left-initials: card.head2head.left-initials;
        left-avatar: card.head2head.left-avatar;
        left-has-avatar: card.head2head.left-has-avatar;
        left-hue-index: card.head2head.left-hue-index;
        right-name: card.head2head.right-name;
        right-initials: card.head2head.right-initials;
        right-avatar: card.head2head.right-avatar;
        right-has-avatar: card.head2head.right-has-avatar;
        right-hue-index: card.head2head.right-hue-index;
        left-score: card.head2head.left-score;
        right-score: card.head2head.right-score;
        titles: card.head2head.chips;
        open-seats: card.head2head.open-seats;
        invite-clicked => { root.invite-clicked(); }
    }
    if card.card-type == "head2head" && (card.head2head.variant == "cell" || card.head2head.variant == "cell-full"): Head2headCell {
        width: parent.width; height: parent.height;
        viewer-name: card.head2head.left-name;
        pairs: card.head2head.pairs;
        more-pairs: card.head2head.more-pairs;
        open-seats: card.head2head.open-seats;
        invite-clicked => { root.invite-clicked(); }
    }
    if card.card-type == "invite": InviteCard {
        width: parent.width; height: parent.height;
        members: card.head2head.members;
        more-members: card.head2head.more-members;
        invite-clicked => { root.invite-clicked(); }
    }
}

// The joined line (mockup frame B2, .qrow): a person icon, "Jonas joined,
// invited by b0bben" in Barlow 300, and the time at the right in Barlow 600,
// uppercase and tracked. A plain row, not a card, and not a control.
component FeedJoinedRow inherits Rectangle {
    in property <string> line;
    in property <string> when;

    height: 32px;
    background: transparent;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 10px;
        alignment: stretch;

        Rectangle {
            width: 20px;
            Image {
                source: @image-url("../icons/user.svg");
                colorize: Theme.text-dim;
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.line;
            font-family: Theme.font-body;
            font-weight: Theme.weight-sentence;
            font-size: 13px;
            color: Theme.text-body;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.when.to-uppercase();
            font-family: Theme.font-label;
            font-weight: Theme.weight-label;
            font-size: 9.5px;
            letter-spacing: Theme.track-label;
            color: Theme.text-tertiary;
            vertical-alignment: center;
        }
    }
}

export component CrewFeed inherits Rectangle {
    in property <[FeedCardData]> cards: [];
    /// Members who joined in the last 24 hours, newest first, at most three.
    in property <[JoinedRowData]> joined-rows: [];
    in property <[FeedCardData]> memory-cards: [];
    in property <[StreamCardData]> stream-cards: [];
    /// Two members stream now: they share the wide hero (frame D). The client
    /// holds one remote streamer today, so the data path for a second one is a
    /// later phase. Nothing fills this yet.
    in property <[HeroStreamData]> hero-streams: [];
    in property <YouStripData> you-strip;
    in property <bool> is-cold-start: true;
    /// Skeleton trio switches (CLIPS 8). The client turns a cell off when its
    /// real card exists, so the cells never sit in a card slot or the hero.
    in property <bool> skeleton-stream: false;
    in property <bool> skeleton-voice-clip: false;
    in property <bool> skeleton-recap: false;
    /// The invite line under the trio.
    in property <bool> invite-line: false;
    in property <bool> feed-has-more: false;
    in property <string> crew-name: "";
    in property <int> clip-count: 0;
    in property <bool> is-hosting: false;
    in property <bool> is-watching: false;
    in property <string> active-streamer-id: "";
    in property <image> stream-frame;
    in property <float> stream-ui-render-fps: 0.0;
    /// Viewer pause UX, forwarded to the stream panel.
    in property <bool> stream-paused: false;
    in property <string> stream-paused-reason: "";

    in property <string> clip-playing-path: "";
    in property <float> clip-progress: 0.0;
    in property <bool> clip-paused: false;
    in property <float> clip-anim-tick: 0.0;
    in property <string> clip-position-text: "";
    in property <string> clip-duration-text: "";
    in property <int> clip-duration-ms: 0;

    callback card-clicked(string);
    callback invite-clicked();
    callback hide-invite-clicked();
    callback pause-clip();
    callback resume-clip();
    callback seek-clip-ms(int);
    callback watch-stream-clicked(string, string, int, int);
    callback hero-stream-clicked(/* host_id */ string);
    callback stop-stream-clicked();
    callback stop-watching-clicked();
    callback session-seen(string);
    callback session-preview-request-frame(/* session_id */ string, /* index */ int);
    callback feed-show-more-clicked();
    callback you-strip-clicked();

    // A recap with content holds the whole side column beside the two-stream
    // hero, so it is the only card there (frame D). Mirrors `side_cards` in
    // `feed_grid.rs`.
    property <bool> two-streams: hero-streams.length == 2 && cards.length > 0;
    property <bool> two-streams-recap: two-streams && cards[0].card-type == "recap"
        && (cards[0].leaderboard.length > 0 || cards[0].awards.length > 0
            || cards[0].belts-moved.length > 0 || cards[0].belts-held.length > 0);
    property <int> stream-side-consumed: stream-cards.length == 1 && cards.length > 0
        ? Math.min(2, cards.length)
        : two-streams-recap ? 1
        : two-streams ? Math.min(2, cards.length) : 0;
    property <int> feed-start-index: stream-side-consumed;
    property <bool> hero-is-clip: cards.length > feed-start-index
        && cards[feed-start-index].card-type == "clip"
        && cards[feed-start-index].is-hero;
    // Head2head leads the feed in one of three ways (plans/next-gen-feed.md
    // section 3). A versus card takes the hero slot: one full-width row, like
    // a hero clip. A wide card takes two columns of the first row. A cell or
    // the invite card is a plain one-column card: no hero, no wide slot.
    property <string> lead-h2h: cards.length > feed-start-index
        && cards[feed-start-index].card-type == "head2head"
        ? cards[feed-start-index].head2head.variant : "";
    property <bool> hero-is-full-row: hero-is-clip || lead-h2h == "versus";
    // The first session of a crew of one stands left of the wide head2head
    // card (frame B): one cell, then two columns. Mirrors `Lead::CellWide`.
    property <bool> lead-is-cell-wide: cards.length > feed-start-index + 1
        && cards[feed-start-index].card-type == "game-session"
        && cards[feed-start-index + 1].card-type == "head2head"
        && cards[feed-start-index + 1].head2head.variant == "wide";
    property <bool> lead-is-live: cards.length > feed-start-index
        && cards[feed-start-index].card-type == "live-session"
        && cards[feed-start-index].live.has-poster;
    // A live session takes the wide slot as well as the wide head2head card.
    property <bool> lead-is-wide: lead-h2h == "wide" || lead-is-live;
    // After a live stream or the two-stream hero the grid is plain rows: a
    // card there is a cell, not a second hero (frame D). Mirrors
    // `Layout::lead` in `feed_grid.rs`.
    property <bool> lead-is-plain: lead-h2h == "cell" || lead-h2h == "cell-full"
        || (cards.length > feed-start-index && cards[feed-start-index].card-type == "invite")
        || (feed-start-index > 0 && cards.length > feed-start-index
            && lead-h2h == "" && !lead-is-live && !hero-is-clip && !lead-is-cell-wide
            && !cards[feed-start-index].is-hero);
    // The recap carries a header, a stat block, an MVP and the games table.
    // It does not fit one row. The design gives it column 3 across both rows,
    // so it takes the side column alone and row 1 holds two cards, not three.
    property <bool> side-is-recap: cards.length > feed-start-index + 1
        && cards[feed-start-index + 1].card-type == "recap"
        && (cards[feed-start-index + 1].leaderboard.length > 0
            || cards[feed-start-index + 1].awards.length > 0
            || cards[feed-start-index + 1].belts-moved.length > 0
            || cards[feed-start-index + 1].belts-held.length > 0);
    property <int> row1-consumed: cards.length <= feed-start-index ? 0
        : lead-is-plain ? 0
        : lead-is-wide || lead-is-cell-wide ? Math.min(2, cards.length - feed-start-index)
        : hero-is-full-row ? 1
        : side-is-recap ? Math.min(2, cards.length - feed-start-index)
        : Math.min(3, cards.length - feed-start-index);
    property <int> row2-base: feed-start-index + row1-consumed;
    // The recent games poster grid leads row 2: it takes two columns, so the
    // row holds two cards and every row after it moves up by one card. Mirrors
    // `feed_grid.rs` (`Layout::r2_wide`).
    property <bool> r2-grid: cards.length > row2-base
        && cards[row2-base].card-type == "recent-games"
        && cards[row2-base].recent-pc-count >= 2;
    property <int> row3-base: row2-base + (r2-grid ? 2 : 3);
    // Row 2 is the last row and has free cells: the stream and voice clip
    // skeletons fill them at the card height, and the recap skeleton takes the
    // slim row under it (frame B). A full last row leaves the trio as one row.
    property <int> row2-count: cards.length <= row2-base ? 0
        : Math.min(r2-grid ? 2 : 3, cards.length - row2-base);
    property <int> row2-free: (r2-grid ? 2 : 3) - row2-count;
    property <bool> skel-fill: !r2-grid && row2-count >= 1 && row2-free >= 1
        && cards.length <= row3-base;
    property <bool> fill-stream: skel-fill && skeleton-stream;
    property <int> voice-slot: skeleton-stream ? 1 : 0;
    property <bool> fill-voice: skel-fill && skeleton-voice-clip && voice-slot < row2-free;

    background: transparent;

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            height: 48px;
            background: transparent;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    horizontal-stretch: 1;
                    alignment: start;

                    Text {
                        font-family: Theme.font-display;
                        text: "Crew feed";
                        font-size: 15px;
                        font-weight: Theme.weight-display;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }

                    if clip-count > 0: Rectangle {
                        width: badge-text.preferred-width + 20px;
                        height: 22px;
                        border-radius: 11px;
                        background: Theme.card-border;
                        y: (parent.height - self.height) / 2;

                        badge-text := Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: clip-count + " clips this week";
                            font-size: 11px;
                            color: Theme.text-sub;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

            }
        }

        Rectangle {
            height: 1px;
            background: Theme.card-border;
        }

        // Pinned personal stats (only the viewer sees it); hidden until tracked.
        YouStrip {
            data: root.you-strip;
            clicked => { root.you-strip-clicked(); }
        }

        // Scrollable feed area
        feed-flick := Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;

                // The joined line: one slim row for each member who joined in
                // the last 24 hours, above the first card (frame B2).
                for j in root.joined-rows: FeedJoinedRow {
                    line: j.line;
                    when: j.when;
                }

                // Stream cards live in the feed flow, directly under the header.
                if (stream-cards.length == 1 || root.two-streams) && cards.length > 0: HorizontalLayout {
                    height: Theme.feed-row * 2 + 12px;
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 2;
                        height: parent.height;

                        if root.two-streams && stream-cards.length != 1: TwoStreamHero {
                            width: parent.width;
                            height: parent.height;
                            streams: root.hero-streams;
                            watch-clicked(host-id) => { root.hero-stream-clicked(host-id); }
                        }

                        if stream-cards.length == 1: ActiveStreamsPanel {
                            width: parent.width;
                            height: parent.height;
                            cards: root.stream-cards;
                            is-hosting: root.is-hosting;
                            is-watching: root.is-watching;
                            active-streamer-id: root.active-streamer-id;
                            stream-frame: root.stream-frame;
                            stream-ui-render-fps: root.stream-ui-render-fps;
                            stream-paused: root.stream-paused;
                            stream-paused-reason: root.stream-paused-reason;
                            viewport-abs-y: feed-flick.absolute-position.y / 1px;
                            viewport-height: feed-flick.height / 1px;
                            watch-stream-clicked(host-id, session-id, w, h) => {
                                root.watch-stream-clicked(host-id, session-id, w, h);
                            }
                            stop-stream-clicked => {
                                root.stop-stream-clicked();
                            }
                            stop-watching-clicked => {
                                root.stop-watching-clicked();
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        height: parent.height;
                        spacing: 12px;

                        if cards.length > 0: FeedSlot {
                            height: root.two-streams-recap ? parent.height : Theme.feed-row;
                            side-column: true;
                            card: cards[0];
                            playing-path: root.clip-playing-path;
                            clip-progress: root.clip-progress;
                            clip-paused: root.clip-paused;
                            clip-anim-tick: root.clip-anim-tick;
                            clip-position-text: root.clip-position-text;
                            clip-duration-text: root.clip-duration-text;
                            clip-duration-ms: root.clip-duration-ms;
                            play-clicked(id) => { root.card-clicked(id); }
                            seek-clip-ms(m) => { root.seek-clip-ms(m); }
                            session-seen(id) => { root.session-seen(id); }
                            session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                            invite-clicked => { root.invite-clicked(); }
                        }

                        if cards.length > 1 && !root.two-streams-recap: FeedSlot {
                            height: Theme.feed-row;
                            side-column: true;
                            card: cards[1];
                            playing-path: root.clip-playing-path;
                            clip-progress: root.clip-progress;
                            clip-paused: root.clip-paused;
                            clip-anim-tick: root.clip-anim-tick;
                            clip-position-text: root.clip-position-text;
                            clip-duration-text: root.clip-duration-text;
                            clip-duration-ms: root.clip-duration-ms;
                            play-clicked(id) => { root.card-clicked(id); }
                            seek-clip-ms(m) => { root.seek-clip-ms(m); }
                            session-seen(id) => { root.session-seen(id); }
                            session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                            invite-clicked => { root.invite-clicked(); }
                        }
                    }
                }

                if stream-cards.length == 1 && cards.length == 0: ActiveStreamsPanel {
                    horizontal-stretch: 1;
                    height: 420px;
                    cards: root.stream-cards;
                    is-hosting: root.is-hosting;
                    is-watching: root.is-watching;
                    active-streamer-id: root.active-streamer-id;
                    stream-frame: root.stream-frame;
                    stream-ui-render-fps: root.stream-ui-render-fps;
                    stream-paused: root.stream-paused;
                    stream-paused-reason: root.stream-paused-reason;
                    viewport-abs-y: feed-flick.absolute-position.y / 1px;
                    viewport-height: feed-flick.height / 1px;
                    watch-stream-clicked(host-id, session-id, w, h) => {
                        root.watch-stream-clicked(host-id, session-id, w, h);
                    }
                    stop-stream-clicked => {
                        root.stop-stream-clicked();
                    }
                    stop-watching-clicked => {
                        root.stop-watching-clicked();
                    }
                }

                if stream-cards.length > 1: streams-grid := ActiveStreamsPanel {
                    horizontal-stretch: 1;
                    height: min(640px, self.panel-height);
                    cards: root.stream-cards;
                    is-hosting: root.is-hosting;
                    is-watching: root.is-watching;
                    active-streamer-id: root.active-streamer-id;
                    stream-frame: root.stream-frame;
                    stream-ui-render-fps: root.stream-ui-render-fps;
                    stream-paused: root.stream-paused;
                    stream-paused-reason: root.stream-paused-reason;
                    viewport-abs-y: feed-flick.absolute-position.y / 1px;
                    viewport-height: feed-flick.height / 1px;
                    watch-stream-clicked(host-id, session-id, w, h) => {
                        root.watch-stream-clicked(host-id, session-id, w, h);
                    }
                    stop-stream-clicked => {
                        root.stop-stream-clicked();
                    }
                    stop-watching-clicked => {
                        root.stop-watching-clicked();
                    }
                }

                // Row 1: full-width hero clip OR 2:1 hero + stacked side column
                if hero-is-full-row && cards.length > root.feed-start-index: FeedSlot {
                    // The versus card is 250 px tall (mockup B2), a hero clip one row.
                    height: root.lead-h2h == "versus" ? 250px : Theme.feed-row;
                    card: cards[root.feed-start-index];
                    playing-path: root.clip-playing-path;
                    clip-progress: root.clip-progress;
                    clip-paused: root.clip-paused;
                    clip-anim-tick: root.clip-anim-tick;
                    clip-position-text: root.clip-position-text;
                    clip-duration-text: root.clip-duration-text;
                    clip-duration-ms: root.clip-duration-ms;
                    play-clicked(id) => { root.card-clicked(id); }
                    seek-clip-ms(m) => { root.seek-clip-ms(m); }
                    session-seen(id) => { root.session-seen(id); }
                    session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                    invite-clicked => { root.invite-clicked(); }
                }

                // A session and the wide head2head card of a crew of one (frame B):
                // the session is the cell, the head2head card takes two columns.
                if lead-is-cell-wide: HorizontalLayout {
                    height: Theme.feed-row;
                    spacing: 12px;

                    FeedSlot {
                        horizontal-stretch: 1;
                        card: cards[root.feed-start-index];
                    }
                    FeedSlot {
                        horizontal-stretch: 2;
                        card: cards[root.feed-start-index + 1];
                        invite-clicked => { root.invite-clicked(); }
                    }
                }

                // Wide head2head (crew of one): two columns, then the next card.
                if lead-is-wide && cards.length > root.feed-start-index: HorizontalLayout {
                    height: Theme.feed-row;
                    spacing: 12px;

                    FeedSlot {
                        horizontal-stretch: 2;
                        card: cards[root.feed-start-index];
                        invite-clicked => { root.invite-clicked(); }
                    }

                    if cards.length > root.feed-start-index + 1: FeedSlot {
                        horizontal-stretch: 1;
                        // One column: a wide head2head card gives way to the cell.
                        side-column: true;
                        card: cards[root.feed-start-index + 1];
                        playing-path: root.clip-playing-path;
                        clip-progress: root.clip-progress;
                        clip-paused: root.clip-paused;
                        clip-anim-tick: root.clip-anim-tick;
                        clip-position-text: root.clip-position-text;
                        clip-duration-text: root.clip-duration-text;
                        clip-duration-ms: root.clip-duration-ms;
                        play-clicked(id) => { root.card-clicked(id); }
                        seek-clip-ms(m) => { root.seek-clip-ms(m); }
                        session-seen(id) => { root.session-seen(id); }
                        session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                        invite-clicked => { root.invite-clicked(); }
                    }
                    if cards.length <= root.feed-start-index + 1: Rectangle { horizontal-stretch: 1; }
                }

                if !hero-is-full-row && !lead-is-wide && !lead-is-cell-wide && !lead-is-plain && cards.length > root.feed-start-index: HorizontalLayout {
                    height: Theme.feed-row * 2 + 12px;
                    spacing: 12px;

                    FeedSlot {
                        horizontal-stretch: 2;
                        card: cards[root.feed-start-index];
                        playing-path: root.clip-playing-path;
                        clip-progress: root.clip-progress;
                        clip-paused: root.clip-paused;
                        clip-anim-tick: root.clip-anim-tick;
                        clip-position-text: root.clip-position-text;
                        clip-duration-text: root.clip-duration-text;
                        clip-duration-ms: root.clip-duration-ms;
                        play-clicked(id) => { root.card-clicked(id); }
                        seek-clip-ms(m) => { root.seek-clip-ms(m); }
                        session-seen(id) => { root.session-seen(id); }
                        session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                        invite-clicked => { root.invite-clicked(); }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        height: parent.height;
                        spacing: 12px;

                        // A recap holds the whole column; anything else is one row.
                        if cards.length > root.feed-start-index + 1: FeedSlot {
                            height: root.side-is-recap ? parent.height : Theme.feed-row;
                            card: cards[root.feed-start-index + 1];
                            playing-path: root.clip-playing-path;
                            clip-progress: root.clip-progress;
                            clip-paused: root.clip-paused;
                            clip-anim-tick: root.clip-anim-tick;
                            clip-position-text: root.clip-position-text;
                            clip-duration-text: root.clip-duration-text;
                            clip-duration-ms: root.clip-duration-ms;
                            play-clicked(id) => { root.card-clicked(id); }
                            seek-clip-ms(m) => { root.seek-clip-ms(m); }
                            session-seen(id) => { root.session-seen(id); }
                            session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                            invite-clicked => { root.invite-clicked(); }
                        }

                        if !root.side-is-recap && cards.length > root.feed-start-index + 2: FeedSlot {
                            height: Theme.feed-row;
                            card: cards[root.feed-start-index + 2];
                            playing-path: root.clip-playing-path;
                            clip-progress: root.clip-progress;
                            clip-paused: root.clip-paused;
                            clip-anim-tick: root.clip-anim-tick;
                            clip-position-text: root.clip-position-text;
                            clip-duration-text: root.clip-duration-text;
                            clip-duration-ms: root.clip-duration-ms;
                            play-clicked(id) => { root.card-clicked(id); }
                            seek-clip-ms(m) => { root.seek-clip-ms(m); }
                            session-seen(id) => { root.session-seen(id); }
                            session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                            invite-clicked => { root.invite-clicked(); }
                        }
                    }
                }

                // Row 2: Three 1x cards. The four-row head2head cell grows the
                // row when its rows do not fit the grid height.
                if cards.length > root.row2-base: HorizontalLayout {
                    height: cards[root.row2-base].card-type == "head2head" && cards[root.row2-base].head2head.variant == "cell-full"
                        && cards[root.row2-base].head2head.pairs.length >= 4
                        ? max(Theme.feed-row, H2hCellSize.height(cards[root.row2-base].head2head.pairs.length, cards[root.row2-base].head2head.more-pairs))
                        : Theme.feed-row;
                    spacing: 12px;

                    for rel-idx in (root.r2-grid ? [0, 1] : [0, 1, 2]): Rectangle {
                        property <int> card-idx: root.row2-base + rel-idx;
                        // The free cell, counted from the first one after the cards.
                        property <int> free-idx: rel-idx - root.row2-count;
                        horizontal-stretch: root.r2-grid && rel-idx == 0 ? 2 : 1;

                        FeedSlot {
                            width: parent.width;
                            height: parent.height;
                            visible: cards.length > card-idx;
                            card: cards.length > card-idx ? cards[card-idx] : { card-type: "" };
                            playing-path: root.clip-playing-path;
                            clip-progress: root.clip-progress;
                            clip-paused: root.clip-paused;
                            clip-anim-tick: root.clip-anim-tick;
                            clip-position-text: root.clip-position-text;
                            clip-duration-text: root.clip-duration-text;
                            clip-duration-ms: root.clip-duration-ms;
                            play-clicked(id) => { root.card-clicked(id); }
                            seek-clip-ms(m) => { root.seek-clip-ms(m); }
                            session-seen(id) => { root.session-seen(id); }
                            session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                            invite-clicked => { root.invite-clicked(); }
                        }

                        // The stream and voice clip skeletons fill the free cells of the
                        // last row (frame B). They keep the card height.
                        if root.fill-stream && free-idx == 0: SkeletonCell {
                            width: parent.width; height: parent.height;
                            icon: @image-url("../icons/skel-stream.svg");
                            line: "Your streams land here";
                            corner: "tr";
                        }
                        if root.fill-voice && free-idx == root.voice-slot: SkeletonCell {
                            width: parent.width; height: parent.height;
                            icon: @image-url("../icons/skel-voice.svg");
                            line: "Voice clips land here";
                            corner: "br";
                        }
                    }
                }

                // Row 3: card (1x) + wide card (2x)
                if cards.length > root.row3-base: HorizontalLayout {
                    height: Theme.feed-row;
                    spacing: 12px;

                    FeedSlot {
                        horizontal-stretch: 1;
                        card: cards[root.row3-base];
                        playing-path: root.clip-playing-path;
                        clip-progress: root.clip-progress;
                        clip-paused: root.clip-paused;
                        clip-anim-tick: root.clip-anim-tick;
                        clip-position-text: root.clip-position-text;
                        clip-duration-text: root.clip-duration-text;
                        clip-duration-ms: root.clip-duration-ms;
                        play-clicked(id) => { root.card-clicked(id); }
                        seek-clip-ms(m) => { root.seek-clip-ms(m); }
                        session-seen(id) => { root.session-seen(id); }
                        session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                        invite-clicked => { root.invite-clicked(); }
                    }

                    if cards.length > root.row3-base + 1: FeedSlot {
                        horizontal-stretch: 2;
                        card: cards[root.row3-base + 1];
                        playing-path: root.clip-playing-path;
                        clip-progress: root.clip-progress;
                        clip-paused: root.clip-paused;
                        clip-anim-tick: root.clip-anim-tick;
                        clip-position-text: root.clip-position-text;
                        clip-duration-text: root.clip-duration-text;
                        clip-duration-ms: root.clip-duration-ms;
                        play-clicked(id) => { root.card-clicked(id); }
                        seek-clip-ms(m) => { root.seek-clip-ms(m); }
                        session-seen(id) => { root.session-seen(id); }
                        session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                        invite-clicked => { root.invite-clicked(); }
                    }
                }

                // Row 4+ for extra cards (cold start has 9 slots)
                if cards.length > root.row3-base + 2: HorizontalLayout {
                    height: Theme.feed-row;
                    spacing: 12px;

                    for rel-idx in [0, 1, 2]: FeedSlot {
                        property <int> card-idx: root.row3-base + 2 + rel-idx;
                        visible: cards.length > card-idx;
                        horizontal-stretch: 1;
                        card: cards.length > card-idx ? cards[card-idx] : { card-type: "" };
                        playing-path: root.clip-playing-path;
                        clip-progress: root.clip-progress;
                        clip-paused: root.clip-paused;
                        clip-anim-tick: root.clip-anim-tick;
                        clip-position-text: root.clip-position-text;
                        clip-duration-text: root.clip-duration-text;
                        clip-duration-ms: root.clip-duration-ms;
                        play-clicked(id) => { root.card-clicked(id); }
                        seek-clip-ms(m) => { root.seek-clip-ms(m); }
                        session-seen(id) => { root.session-seen(id); }
                        session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                        invite-clicked => { root.invite-clicked(); }
                    }
                }

                // Skeleton trio: after the real cards, never in the hero slot.
                if (root.skeleton-stream && !root.fill-stream) || (root.skeleton-voice-clip && !root.fill-voice) || root.skeleton-recap: SkeletonTrio {
                    show-stream: root.skeleton-stream && !root.fill-stream;
                    show-voice-clip: root.skeleton-voice-clip && !root.fill-voice;
                    show-recap: root.skeleton-recap;
                }

                if root.invite-line && (root.skeleton-stream || root.skeleton-voice-clip || root.skeleton-recap): FeedInviteLine {
                    invite-clicked => { root.invite-clicked(); }
                    hide-clicked => { root.hide-invite-clicked(); }
                }

                // Memory band: the durable spine (recaps + clips, then the
                // m3llo+ locked card). Always present so a quiet current week
                // never reads as empty. Server-curated, newest first.
                if memory-cards.length > 0: VerticalLayout {
                    spacing: 12px;

                    Text {
                        font-family: Theme.font-display;
                        text: "Crew history";
                        font-size: 13px;
                        font-weight: Theme.weight-display;
                        color: Theme.text-sub;
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.card-border;
                    }

                    for r in Math.ceil(memory-cards.length / 3.0): HorizontalLayout {
                        height: Theme.feed-row;
                        spacing: 12px;

                        for c in 3: FeedSlot {
                            property <int> mem-idx: r * 3 + c;
                            visible: mem-idx < memory-cards.length;
                            horizontal-stretch: 1;
                            card: mem-idx < memory-cards.length ? memory-cards[mem-idx] : { card-type: "" };
                            playing-path: root.clip-playing-path;
                            clip-progress: root.clip-progress;
                            clip-paused: root.clip-paused;
                            clip-anim-tick: root.clip-anim-tick;
                            clip-position-text: root.clip-position-text;
                            clip-duration-text: root.clip-duration-text;
                            clip-duration-ms: root.clip-duration-ms;
                            play-clicked(id) => { root.card-clicked(id); }
                            seek-clip-ms(m) => { root.seek-clip-ms(m); }
                            session-seen(id) => { root.session-seen(id); }
                            session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                            invite-clicked => { root.invite-clicked(); }
                        }
                    }
                }

                if root.feed-has-more && !root.is-cold-start: HorizontalLayout {
                    height: 44px;
                    alignment: center;

                    Rectangle {
                        width: show-more-label.preferred-width + 32px;
                        height: 36px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: show-more-touch.has-hover ? Theme.graphic-med : Theme.card-border;
                        background: show-more-touch.has-hover ? Theme.card-bg-hover : Theme.card-bg;

                        show-more-label := Text {
                            font-family: Theme.font-display;
                            text: "Show more";
                            font-size: 13px;
                            font-weight: Theme.weight-display;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        show-more-touch := TouchArea {
                            accessible-role: button;
                            accessible-label: "Show more";
                            mouse-cursor: pointer;
                            clicked => { root.feed-show-more-clicked(); }
                        }
                    }
                }

                Rectangle { height: 20px; }
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════
// Previews for Slint live preview / IDE extension
// ═══════════════════════════════════════════════════════════════

// Normal feed with real data
export component Preview inherits Rectangle {
    width: 760px;
    height: 920px;
    background: Theme.bg-app;
    // Preview controls:
    // - stream-count: 0..3 (clamped)
    // - preview-watching: show selected watching state on the first stream card
    in-out property <int> stream-count: 0;
    in-out property <bool> preview-watching: false;
    in-out property <bool> preview-hosting: false;
    property <int> preview-stream-count: max(0, min(stream-count, 3));
    property <string> preview-active-streamer-id: !preview-hosting && preview-watching && preview-stream-count > 0 ? "alice-id" : "";
    property <[StreamCardData]> preview-stream-cards-1: [
