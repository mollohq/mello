                        { name: "Jonas", initials: "J", hue-index: 1 },
                        { name: "Sara", initials: "S", hue-index: 2 },
                        { name: "Max", initials: "M", hue-index: 3 },
                        { name: "Leo", initials: "L", hue-index: 4 },
                    ],
                },
            },
            {
                id: "gs", card-type: "game-session", is-hero: false, is-skeleton: false,
                title: "Counter-Strike 2", game-name: "Counter-Strike 2",
                game-short-name: "CS2", game-has-color: true, game-color: #5B7FA8,
                game-record: "2W–3L", game-wins: 2, game-losses: 3,
                game-streak-text: "L2", game-streak-positive: false,
                game-winrate: "40%", game-matches: 5,
                duration-human: "2h 05m", timestamp: "5h ago",
                actor-name: "Bob", actor-initials: "B",
            },
        ];
    }
}

// A live stream holds the hero while the crew is one person. The wide card
// does not fit the side column, so the cell stands in, with the four seats as
// "+2" beside the invite. The wide card keeps the wide slot when no stream is
// live (PreviewFeedNewCrew).
export component PreviewFeedLiveStreamSolo inherits Rectangle {
    width: 760px;
    height: 560px;
    background: Theme.bg-app;

    CrewFeed {
        width: parent.width;
        height: parent.height;
        is-cold-start: false;
        stream-cards: [
            {
                host-id: "alice-id",
                session-id: "stream-session-1",
                streamer-name: "alice",
                subtitle: "Live now",
                avatar: @image-url("../icons/user.svg"),
                has-avatar: false,
                avatar-initials: "AL",
                avatar-color-index: 1,
                viewer-count: 3,
                stream-width: 1920,
                stream-height: 1080,
                can-watch: true,
            },
        ];
        cards: [
            {
                id: "h2h", card-type: "head2head", role: "standard", size: "lg",
                head2head: {
                    variant: "wide", member-count: 1, open-seats: 4,
                    left-name: "b0bben", left-initials: "B0", left-hue-index: 0,
                    chips: [
                        { id: "the_carry", icon: @image-url("../icons/h2h-carry.svg"), title: "The Carry", value: "4,167", unit: "h", hue-index: 0 },
                    ],
                },
            },
            {
                id: "rg", card-type: "recent-games", is-hero: false, is-skeleton: false,
                title: "RECENT GAMES", subtitle: "",
                recent-games: [
                    { game-id: "cs2", game-name: "Counter-Strike 2", monogram: "CS", hue-index: 4, hours: "4,167 H" },
                ],
            },
        ];
    }
}

// A game in progress (mockup cold-start frames 5 and 8): the live card holds the
