    property <[StreamCardData]> preview-stream-cards: preview-stream-count == 0
        ? []
        : preview-hosting
            ? (preview-stream-count == 1
                ? root.preview-host-stream-cards-1
                : preview-stream-count == 2
                    ? root.preview-host-stream-cards-2
                    : root.preview-host-stream-cards-3)
            : (preview-stream-count == 1
                ? root.preview-stream-cards-1
                : preview-stream-count == 2
                    ? root.preview-stream-cards-2
                    : root.preview-stream-cards-3);

    CrewFeed {
        width: parent.width;
