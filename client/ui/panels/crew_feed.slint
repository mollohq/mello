            stream-width: 1920,
            stream-height: 1080,
            can-watch: false,
        },
        {
            host-id: "fail-id",
            session-id: "stream-session-2",
            streamer-name: "FaiL",
            subtitle: "Valorant",
            avatar: @image-url("../icons/user.svg"),
            has-avatar: false,
            avatar-initials: "Fa",
            avatar-color-index: 3,
            viewer-count: 853,
            stream-width: 1920,
            stream-height: 1080,
            can-watch: true,
        },
    ];
    property <[StreamCardData]> preview-host-stream-cards-3: [
        {
            host-id: "alice-id",
            session-id: "stream-session-1",
            streamer-name: "alice",
            subtitle: "Counter-Strike 2",
            avatar: @image-url("../icons/user.svg"),
            has-avatar: false,
            avatar-initials: "AL",
            avatar-color-index: 1,
            viewer-count: 1242,
            stream-width: 1920,
            stream-height: 1080,
            can-watch: false,
        },
        {
            host-id: "fail-id",
            session-id: "stream-session-2",
            streamer-name: "FaiL",
            subtitle: "Valorant",
            avatar: @image-url("../icons/user.svg"),
            has-avatar: false,
            avatar-initials: "Fa",
            avatar-color-index: 3,
            viewer-count: 853,
            stream-width: 1920,
            stream-height: 1080,
            can-watch: true,
        },
        {
            host-id: "bobben-id",
            session-id: "stream-session-3",
            streamer-name: "b0bben",
            subtitle: "League of Legends",
            avatar: @image-url("../icons/user.svg"),
            has-avatar: false,
            avatar-initials: "b0",
            avatar-color-index: 2,
            viewer-count: 420,
            stream-width: 1920,
            stream-height: 1080,
            can-watch: true,
        },
    ];
    property <[StreamCardData]> preview-stream-cards: preview-stream-count == 0
        ? []
        : preview-hosting
            ? (preview-stream-count == 1
                ? root.preview-host-stream-cards-1
                : preview-stream-count == 2
                    ? root.preview-host-stream-cards-2
                    : root.preview-host-stream-cards-3)
            : (preview-stream-count == 1
                ? root.preview-stream-cards-1
                : preview-stream-count == 2
                    ? root.preview-stream-cards-2
                    : root.preview-stream-cards-3);

    CrewFeed {
        width: parent.width;
        height: parent.height;
        stream-cards: root.preview-stream-cards;
        is-hosting: root.preview-hosting;
        is-watching: root.preview-watching;
        active-streamer-id: root.preview-active-streamer-id;
        clip-count: 12;
        is-cold-start: false;
        cards: [
            {
                id: "4", card-type: "session-preview", is-hero: true, is-skeleton: false,
                title: "alice streamed Cursor - The best way to code with AI",
                subtitle: "",
