/// Frame D with the moved belts and the weekly recap sealed.
export component PreviewFeedSealed inherits PreviewFeedFiveMembers {
    sealed: true;
}

/// The centre view of the Carry at 1400 ms on a fixed clock: just after the
/// flip, the burst in the hue of Jonas, the value counting up.
export component PreviewRevealFrame inherits Rectangle {
    width: 1200px;
    height: 1290px;
    background: Theme.bg-app;

    feed := PreviewFeedSealed {
        width: parent.width;
        height: parent.height;
    }

    init => {
        Clock.manual = true;
        Clock.manual-now = 1400ms;
        SealedUi.belt = feed.carry;
        SealedUi.active-key = feed.carry.key;
        SealedUi.active-slot = "pair-";
        SealedUi.from = { x: 666px, y: 1090px, w: 108px, h: 46px };
        SealedUi.t0 = 0ms;
        SealedUi.closing = false;
        SealedUi.active-kind = "belt";
    }
}

