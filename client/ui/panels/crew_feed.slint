        },
    ];
    property <[StreamCardData]> preview-host-stream-cards-2: [
        {
            host-id: "alice-id",
            session-id: "stream-session-1",
            streamer-name: "alice",
            subtitle: "Counter-Strike 2",
            avatar: @image-url("../icons/user.svg"),
            has-avatar: false,
            avatar-initials: "AL",
