            text: "SESSION";
            font-size: 10px;
            font-weight: 600;
            color: Theme.skel-ghost;
            letter-spacing: 0.8px;
        }

        Rectangle { height: 12px; }

        HorizontalLayout {
            spacing: 8px;
            height: 30px;

            Rectangle {
                width: 26px; height: 26px;
                border-radius: 6px;
                background: Theme.skel-element;
            }

            VerticalLayout {
                alignment: center;
                spacing: 5px;

                Rectangle { height: 9px; width: 80px; border-radius: 3px; background: Theme.skel-element; }
                Rectangle { height: 7px; width: 40px; border-radius: 3px; background: Theme.skel-element; }
            }
        }

        Rectangle { height: 8px; }

        HorizontalLayout {
            spacing: -7px;
            height: 18px;

            for c in [0, 1, 2]: Rectangle {
                width: 18px; height: 18px;
                border-radius: 4px;
                background: Theme.skel-element;
                border-width: 2px;
                border-color: Theme.card-bg-skel;
            }
        }

        Rectangle { height: 10px; }

        Rectangle { height: 6px; width: 100px; border-radius: 3px; background: Theme.skel-element; }
    }
}

