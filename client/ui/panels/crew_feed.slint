            can-watch: true,
        },
    ];
    property <[StreamCardData]> preview-host-stream-cards-1: [
        {
            host-id: "alice-id",
            session-id: "stream-session-1",
            streamer-name: "alice",
            subtitle: "Counter-Strike 2",
