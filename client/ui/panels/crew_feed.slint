import { Theme } from "../theme.slint";
import { CutShape, CutMask, CutButtonShape } from "../components/cut.slint";
import { UserAvatar, AvatarOverflow } from "../components/avatar.slint";
import { FeedCardData, FeedView, StreamCardData, YouStripData } from "../types.slint";
import { ActiveStreamsPanel, StreamCardSize } from "./active_streams_panel.slint";
import { SessionPreviewCard } from "./session_preview_card.slint";
import { GameClipCard } from "./game_clip_card.slint";
import { BeltHero, TitleChip, H2hHue } from "../components/head2head.slint";
import { QuestCard } from "../components/feed_quests.slint";
import { FeedBoard, PeopleZone, StageOwnBelts, MostInstalledCard, BoardDormantStrip, ZonesData, HistoryWeek, LockedTeaserTile, PlusStrip, BoardShell, Kicker } from "../components/feed_board.slint";
import { BeltSlot, SealedRecap, SealedUi, SealedFmt, Ease } from "../components/sealed.slint";
import { SealedStage } from "./sealed_stage.slint";
import { YouStrip } from "./you_strip.slint";
import { GameArt } from "../components/game_art.slint";
import { ClipPlayRing, DotWaveform } from "../components/clip_wave.slint";
import { RecapDur, RecapKicker } from "../components/recap_parts.slint";
import { StatValue } from "../components/stat.slint";
import { MediaChip, FootageWash } from "../components/stream_hero.slint";

component NewBadge inherits Rectangle {
    width: new-text.preferred-width + 12px;
    height: 16px;
    border-radius: 4px;
    background: Theme.live;

    new-text := Text {
        font-family: Theme.font-display;
        text: "NEW";
        font-size: 9px;
        font-weight: Theme.weight-display-bold;
        color: Theme.on-live;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Standard clip card (1x)
component ClipCard inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    in property <float> progress: 0.0;
    in property <string> position-text: "";
    in property <string> duration-text: "";
    in property <int> clip-duration-ms: 0;
    callback play-clicked(string);
    callback seek-ms(int);

    // Red is state. An unread clip wears it, a read one is grey (frame C).
    property <color> tone: card.is-new ? Theme.clip-amber : Theme.text-sub;

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        // A clip never wears a red border. Red is the live stream (and the tag).
        fill: is-playing || clip-hover.has-hover ? Theme.graphic-med : Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        inset: Theme.keyline;
        fill: clip-hover.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    }

    // Content touches must win over the card touch.
    clip-hover := TouchArea {
        accessible-role: button;
        accessible-label: card.title != "" ? card.title : card.actor-name + " clipped that";
        mouse-cursor: pointer;
        clicked => { play-clicked(card.clip-path); }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 12px;
        spacing: 8px;

        // Header
        Rectangle {
            height: 16px;
            vertical-stretch: 0;

            HorizontalLayout {
                if card.is-new: NewBadge {
                    horizontal-stretch: 0;
                }
                if card.is-new: Rectangle { width: 6px; horizontal-stretch: 0; }

                if !is-playing: HorizontalLayout {
                    spacing: 5px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: HorizontalLayout forces y:0 on children —
                    // center via the cross axis instead of per-child y.
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../icons/scissors.svg");
                        colorize: root.tone;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: "VOICE CLIP";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: root.tone;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                if is-playing: HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: y is silently forced to 0 in layouts — use
                    // the cross axis to center the icon with its label.
                    cross-axis-alignment: center;

                    if !is-paused: Image {
                        source: @image-url("../icons/speaker.svg");
                        colorize: root.tone;
                        width: 10px;
                        height: 10px;
                    }

                    if is-paused: Image {
                        source: @image-url("../icons/pause.svg");
                        colorize: root.tone;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: is-paused ? "PAUSED" : "PLAYING";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: root.tone;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    letter-spacing: Theme.track-label;
                    font-weight: Theme.weight-label;
                    text: is-playing ? position-text + " / " + duration-text : card.duration;
                    font-family: Theme.font-label;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

        }

        // Wave band with corner play ring (absorbs vertical slack)
        Rectangle {
            vertical-stretch: 1;
            min-height: 38px;

            DotWaveform {
                width: parent.width;
                height: parent.height;
                peaks: card.waveform;
                progress: root.progress;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                tone: root.tone;
                rows: 9;
                dot-size: 2px;
                row-pitch: 4px;
                duration-ms: root.is-playing ? root.clip-duration-ms : card.duration-ms;
                seek-ms(m) => { root.seek-ms(m); }
                play-at-ms(m) => {
                    root.play-clicked(card.clip-path);
                    root.seek-ms(m);
                }
            }

            ClipPlayRing {
                small: true;
                tone: root.tone;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                x: parent.width - self.width - 4px;
                y: 4px;
                ring-clicked => { root.play-clicked(card.clip-path); }
            }
        }

        // Body pinned at the bottom — title + meta, no dead gap
        VerticalLayout {
            spacing: 4px;
            vertical-stretch: 0;

            Text {
                font-family: Theme.font-display;
                text: card.title != "" ? card.title : card.actor-name + " clipped that";
                font-size: 13px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
                overflow: elide;
            }

            // Who was in the clip, as octagons and a count (frame C).
            if card.participant-count > 0: HorizontalLayout {
                height: 20px;
                spacing: 8px;
                cross-axis-alignment: center;
                HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    UserAvatar { initials: card.part0-initials; avatar: card.part0-avatar; has-avatar: card.part0-has-avatar; color-index: 1; size: 20px; }
                    if card.participant-count > 1: UserAvatar { initials: card.part1-initials; avatar: card.part1-avatar; has-avatar: card.part1-has-avatar; color-index: 0; size: 20px; }
                    if card.participant-count > 2: UserAvatar { initials: card.part2-initials; avatar: card.part2-avatar; has-avatar: card.part2-has-avatar; color-index: 2; size: 20px; }
                }
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.participant-count + " participants";
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                }
            }

            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.timestamp + (card.game-name != "" ? " · " + card.game-name : "");
                font-size: 11px;
                color: Theme.text-sub;
            }
        }
    }
}

component RecapHead inherits Rectangle {
    in property <FeedCardData> card;
    in property <float> count: 1;

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        HorizontalLayout {
            height: 16px;
            Text {
                font-family: Theme.font-label;
                text: "WEEKLY RECAP";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: Theme.text-dim;
                letter-spacing: Theme.track-label;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 4px; }

        // "Week 4" once the server counts the crew's weeks. Until then the
        // card says what it is.
        Text {
            font-family: Theme.font-display;
            text: card.recap-week != "" ? card.recap-week : "This week";
            font-size: 26px;
            font-weight: Theme.weight-display-bold;
            letter-spacing: -0.78px;
            color: Theme.text-primary;
        }

        // When the week was: "This week", "Last week", "3 weeks ago".
        if card.age-label != "": Text {
            font-family: Theme.font-body;
            font-weight: Theme.weight-sentence;
            text: card.age-label;
            font-size: 11px;
            color: Theme.text-sub;
            overflow: elide;
        }

        Rectangle { height: 6px; }

        Rectangle { height: 1px; background: Theme.card-border; }

        Rectangle { height: 6px; }

        // The numbers of the week, two by two (mockup .rc-nums).
        VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    horizontal-stretch: 2;
                    spacing: 2px;
                    RecapDur { size: 22px; minutes: Math.round(card.recap-hangout-min * root.count); }
                    RecapKicker { text: "HANGOUT"; }
                }
                VerticalLayout {
                    horizontal-stretch: 3;
                    spacing: 2px;
                    Text { text: "\{Math.round(card.recap-clips * root.count)}"; font-family: Theme.font-display; font-weight: Theme.weight-display-bold; font-size: 22px; letter-spacing: -0.5px; color: Theme.text-primary; }
                    RecapKicker { text: "CLIPS"; }
                }
            }

            if card.recap-longest-min > 0 || card.game-name != "": HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    horizontal-stretch: 2;
                    spacing: 2px;
                    if card.recap-longest-min > 0: RecapDur { size: 22px; minutes: Math.round(card.recap-longest-min * root.count); }
                    if card.recap-longest-min > 0: RecapKicker { text: "LONGEST"; }
                }
                VerticalLayout {
                    horizontal-stretch: 3;
                    spacing: 4px;
                    if card.game-name != "": HorizontalLayout {
                        height: 29px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        // In the centre the top game fades in while the numbers
                        // count (fx lab RecapFace).
                        opacity: root.count >= 1 ? 1 : Ease.span(root.count * 1s, 0.4s, 0.8s);
                        GameArt {
                            game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index;
                            icon: card.game-icon; has-icon: card.game-has-icon;
                            capsule: card.game-capsule; has-capsule: card.game-has-capsule;
                            size: 29px; art-width: 52px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: card.game-name;
                            font-family: Theme.font-display;
                            font-weight: Theme.weight-display;
                            font-size: 12px;
                            color: Theme.text-primary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    if card.game-name != "": RecapKicker { text: "TOP GAME"; }
                }
            }
        }

        Rectangle { height: 6px; }
    }
}

/// Most active and Most clipped, one line each: the label, an octagon, the name
/// and the value at the right (mockup .pm).
component RecapPeople inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;
    height: col.preferred-height;

    col := VerticalLayout {
        spacing: 0px;
        if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
        if root.rule: Rectangle { height: 6px; }

        if card.recap-active.name != "": HorizontalLayout {
            height: 17px;
            spacing: 8px;
            Text { width: 78px; text: "MOST ACTIVE"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 8.5px; letter-spacing: 1.36px; color: Theme.text-dim; vertical-alignment: center; }
            UserAvatar { size: 20px; initials: card.recap-active.initials; color-index: card.recap-active.hue; avatar: card.recap-active.avatar; has-avatar: card.recap-active.has-avatar; }
            Text { horizontal-stretch: 1; text: card.recap-active.name; overflow: elide; font-family: Theme.font-display; font-weight: Theme.weight-display; font-size: 13px; color: Theme.text-primary; vertical-alignment: center; }
            Text { text: SealedFmt.span(card.recap-active.count); font-family: Theme.font-display; font-weight: Theme.weight-display; font-size: 13px; color: Theme.text-body; vertical-alignment: center; }
        }
        if card.recap-active.name != "" && card.recap-clipped.name != "": Rectangle { height: 2px; }
        if card.recap-clipped.name != "": HorizontalLayout {
            height: 17px;
            spacing: 8px;
            Text { width: 78px; text: "MOST CLIPPED"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 8.5px; letter-spacing: 1.36px; color: Theme.text-dim; vertical-alignment: center; }
            UserAvatar { size: 20px; initials: card.recap-clipped.initials; color-index: card.recap-clipped.hue; avatar: card.recap-clipped.avatar; has-avatar: card.recap-clipped.has-avatar; }
            Text { horizontal-stretch: 1; text: card.recap-clipped.name; overflow: elide; font-family: Theme.font-display; font-weight: Theme.weight-display; font-size: 13px; color: Theme.text-primary; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                StatValue {
                    value: "\{card.recap-clipped.count}"; unit: card.recap-clipped.count == 1 ? "clip" : "clips";
                    value-size: 13px; unit-size: 11px;
                    hue: Theme.text-body;
                    gap: 6px;
                }
            }
        }
        Rectangle { height: 6px; }
    }
}

/// Games played: four small art tiles with the hours under each (mockup .gp).
/// The opened recap lists every game.
component RecapGamesStrip inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;
    /// Tiles in a row.
    property <int> tiles: 6;
    property <length> gap: 8px;
    // Tiles take the width of the section, four in a row, in the 460 by 215
    // proportion of a Steam header.
    property <length> tile-w: (root.width - (root.tiles - 1) * root.gap) / root.tiles;
    property <length> tile-h: root.tile-w * 215 / 460;
    height: col.preferred-height;

    col := VerticalLayout {
        spacing: 0px;
        if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
        if root.rule: Rectangle { height: 6px; }

        HorizontalLayout {
            height: 16px;
            Text {
                horizontal-stretch: 1;
                font-family: Theme.font-label;
                text: "GAMES PLAYED";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: Theme.text-dim;
                letter-spacing: Theme.track-label;
                vertical-alignment: center;
            }
            Text {
                text: SealedFmt.span(card.recap-games-min);
                font-family: Theme.font-label;
                font-size: 9px;
                font-weight: Theme.weight-label;
                letter-spacing: 1.2px;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 6px; }

        HorizontalLayout {
            spacing: root.gap;
            alignment: start;
            // The tiles alone, the week's games in order of time: the hours
            // stand in the header. Recent games has the names.
            for g[i] in card.recap-games: Rectangle {
                width: i < root.tiles ? root.tile-w : 0px;
                height: i < root.tiles ? root.tile-h : 0px;
                clip: true;
                GameArt {
                    game-id: g.game-id; monogram: g.monogram; hue-index: g.hue-index;
                    icon: g.icon; has-icon: g.has-icon;
                    capsule: g.capsule; has-capsule: g.has-capsule;
                    size: root.tile-h; art-width: root.tile-w; art-height: root.tile-h;
                }
            }
        }
        Rectangle { height: 0px; }
    }
}

        // MVP section with avatars
component RecapMvp inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;

            VerticalLayout {
                spacing: 0px;

                if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
                if root.rule: Rectangle { height: 8px; }

                Text {
                    font-family: Theme.font-label;
                    text: "MVP";
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    color: Theme.skel-text;
                    letter-spacing: Theme.track-label;
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 4px;

                    if card.mvp-count >= 1: HorizontalLayout {
                        spacing: 8px;
                        height: 22px;

                        UserAvatar { initials: card.mvp0-initials; color-index: 0; avatar: card.mvp0-avatar; has-avatar: card.mvp0-has-avatar; }
                        Text {
                            font-family: Theme.font-body;
                            text: card.mvp0-name;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: card.mvp0-stat;
                            font-size: 11px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }

                    // Single MVP keeps the recap card compact (spec 19 polish);
                    // mvp1/mvp2 data still arrives but is intentionally not shown.
                }
            }
        }

        // Belts moved (head2head): one row for each title that changed hands.
        // The previous holder is dimmed, the new holder wears the hue.
component RecapMoved inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;
    /// Rows of Belts moved the card shows. The tall card shows two and then
    /// "+N more".
    in property <int> max-belt-rows: 3;
            VerticalLayout {
                spacing: 0px;

                if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
                if root.rule: Rectangle { height: 6px; }

                HorizontalLayout {
                    height: 16px;
                    Text {
                        horizontal-stretch: 1;
                        font-family: Theme.font-label;
                        text: "BELTS MOVED";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.text-dim;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                    if card.belts-moved.length > root.max-belt-rows: Text {
                        text: "+\{card.belts-moved.length - root.max-belt-rows} MORE";
                        font-family: Theme.font-label;
                        font-weight: Theme.weight-label;
                        font-size: 9px;
                        letter-spacing: 1.44px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 0px;
                    // A row past the limit has no height. The 6px gap sits
                    // inside the row, so a hidden row leaves no gap either.
                    // No clip: the chip's tooltip stands above the row.
                    for b[i] in card.belts-moved: Rectangle {
                      height: i < root.max-belt-rows ? 34px : 0px;
                      visible: i < root.max-belt-rows;
                      HorizontalLayout {
                        spacing: 6px;
                        padding-bottom: 2px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 28px;
                            opacity: 0.4;
                            UserAvatar { size: 28px; initials: b.prev-initials; color-index: b.prev-hue; avatar: b.prev-avatar; has-avatar: b.prev-has-avatar; }
                        }
                        // Sealed: the new holder is a muted octagon with "?" until the
                        // belt is open.
                        UserAvatar {
                            size: 28px;
                            muted: SealedUi.hides(b.belt);
                            initials: SealedUi.hides(b.belt) ? "?" : b.holder-initials;
                            color-index: b.holder-hue;
                            avatar: b.holder-avatar;
                            has-avatar: !SealedUi.hides(b.belt) && b.holder-has-avatar;
                        }
                        BeltSlot {
                            horizontal-stretch: 1;
                            height: 32px;
                            tight: true;
                            belt: b.belt;
                            slot-id: "recap-" + i;
                            TitleChip {
                                width: parent.width;
                                compact: true;
                                dense: true;
                                hue: H2hHue.of(b.holder-hue);
                                icon: b.icon; title: b.title; value: b.value; unit: b.unit;
                                tip: SealedUi.hides(b.belt) ? "" : b.stat-line;
                            }
                        }
                      }
                    }
                }
                Rectangle { height: 4px; }
            }
        }

        // Belts held: who holds how many titles right now, most first.
component RecapHeld inherits Rectangle {
    in property <FeedCardData> card;
    in property <float> count: 1;
    in property <bool> rule: true;
    /// Members shown: as many as fit the column, each one an octagon and a
    /// count. The card works it out from its own width, not from the column,
    /// which would loop with the layout.
    in property <int> max-held: 5;
            VerticalLayout {
                spacing: 0px;

                if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
                if root.rule: Rectangle { height: 6px; }

                HorizontalLayout {
                    height: 16px;
                    Text {
                        font-family: Theme.font-label;
                        text: "BELTS HELD";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.text-dim;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 6px; }

                // One column for each member, an octagon over the count over
                // "BELTS" (mockup .held). As many as fit, five at most.
                HorizontalLayout {
                    spacing: 0px;
                    for h[i] in card.belts-held: Rectangle {
                        horizontal-stretch: i < root.max-held ? 1 : 0;
                        max-width: i < root.max-held ? 10000px : 0px;
                        min-width: 0px;
                        clip: true;
                        VerticalLayout {
                            alignment: start;
                            spacing: 1px;
                            HorizontalLayout {
                                alignment: center;
                                UserAvatar { size: 22px; initials: h.initials; color-index: h.hue; avatar: h.avatar; has-avatar: h.has-avatar; }
                            }
                            Text {
                                text: root.count >= 1 ? h.count : Math.round(h.count * Ease.span(root.count * 1s, 0.2s + i * 0.1s, 0.6s + i * 0.1s));
                                font-family: Theme.font-display;
                                font-size: 15px;
                                font-weight: Theme.weight-display-bold;
                                color: Theme.text-value;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "BELTS";
                                font-family: Theme.font-label;
                                font-weight: Theme.weight-label;
                                font-size: 8px;
                                letter-spacing: 1.6px;
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                Rectangle { height: 6px; }
            }
        }

        // This week in games (spec 19)
component RecapGames inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;
            VerticalLayout {
                spacing: 0px;

                if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
                if root.rule: Rectangle { height: 8px; }

                Text {
                    font-family: Theme.font-label;
                    text: "THIS WEEK IN GAMES";
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    color: Theme.skel-text;
                    letter-spacing: Theme.track-label;
                }

                if card.games-summary != "": Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.games-summary;
                    font-size: 11px;
                    color: Theme.text-sub;
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 4px;
                    for row in card.leaderboard: HorizontalLayout {
                        spacing: 8px;
                        height: 22px;
                        UserAvatar { initials: row.initials; color-index: row.color-index; avatar: row.avatar; has-avatar: row.has-avatar; }
                        Text {
                            font-family: Theme.font-body;
                            text: row.name;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: row.record;
                            font-size: 11px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }
                }

                if card.awards.length > 0: Rectangle { height: 8px; }

                VerticalLayout {
                    spacing: 4px;
                    for a in card.awards: HorizontalLayout {
                        spacing: 8px;
                        height: 18px;
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: a.title;
                            font-size: 11px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-family: Theme.font-body;
                            text: a.name;
                            font-size: 11px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: a.detail;
                            font-size: 10px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

// Weekly recap card. Two shapes, never one cell: the tall card of the side
// column (one column, two rows) and the wide card (two columns, one row).
component RecapCard inherits Rectangle {
    in property <FeedCardData> card;
    /// 0 to 1 while the numbers count up in the centre view. In the feed it is 1
    /// and the card shows the text of `card`.
    in property <float> count: 1;
    /// Two columns wide (the wide slot): the sections stand side by side.
    /// One column wide (the tall slot): they stack.
    // One grid row high and two columns wide. A recap that is two rows high (the
    // hero, a tall slot) stacks its sections even when it is wide.
    property <bool> wide: root.width >= 560px && root.height < 340px;
    /// A recap with belts needs three grid rows. A slot of two rows (a lone recap
    /// with no head2head beside it) drops Belts held and the games, so the
    /// control stays on the card.
    property <bool> has-belts: card.belts-moved.length > 0 || card.belts-held.length > 0;
    property <bool> short: root.height < 600px;
    /// Members of Belts held that fit one octagon column of 56 px.
    property <int> max-held: Math.min(5, Math.max(1, Math.floor((root.wide ? (root.width - 28px - 34px) * 0.4 : root.width - 32px) / 56px)));
    clip: true;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    // The tall card (mockup weekly-recap-card, frame 1): the label and the
    // week, the numbers two by two, the two members, the belts, the games and
    // the control in a row of its own at the foot.
    if !root.wide: VerticalLayout {
        padding: 10px;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        spacing: 0px;
        // Top-pack: each section uses its natural height and the slack
        // collects between the last section and the foot.
        alignment: start;

        RecapHead { card: root.card; count: root.count; }
        if card.recap-active.name != "" || card.recap-clipped.name != "": RecapPeople { card: root.card; }
        if card.belts-moved.length > 0: RecapMoved { card: root.card; max-belt-rows: 2; }
        if card.belts-held.length > 0: RecapHeld { card: root.card; count: root.count; max-held: root.max-held; }
        if card.recap-games.length > 0: RecapGamesStrip { card: root.card; }
    }

    // The wide card: the week, the belts that moved and who holds them, side
    // by side with a keyline between. The control stays at the foot.
    if root.wide: HorizontalLayout {
        padding: 14px;
        padding-top: 16px;
        spacing: 16px;

        RecapHead { horizontal-stretch: 3; card: root.card; count: root.count; }
        Rectangle { width: Theme.keyline; background: Theme.card-border; }
        VerticalLayout {
            horizontal-stretch: 3;
            alignment: start;
            if card.belts-moved.length > 0: RecapMoved { rule: false; card: root.card; }
            if card.belts-moved.length == 0 && card.belts-held.length > 0: RecapHeld { rule: false; card: root.card; count: root.count; max-held: root.max-held; }
            if card.belts-moved.length == 0 && card.belts-held.length == 0 && (card.leaderboard.length > 0 || card.awards.length > 0): RecapGames { rule: false; card: root.card; }
        }
        Rectangle { width: Theme.keyline; background: Theme.card-border; }
        VerticalLayout {
            horizontal-stretch: 4;
            alignment: start;
            if card.belts-moved.length > 0 && card.belts-held.length > 0: RecapHeld { rule: false; card: root.card; count: root.count; max-held: root.max-held; }
            if card.belts-moved.length == 0 && card.belts-held.length == 0 && card.mvp-count > 0: RecapMvp { rule: false; card: root.card; }
        }
    }

}

// Session card
// The stream session card, per designs/feed/session-cards-redesign.html
// (Option B: game first). Typed header, real avatars, humanized duration,
// peak stat: a card answers "who did what, for how long" at a glance. A voice
// session is a row of the day card, never a card (spec 19 section 3.5a).
component SessionCard inherits Rectangle {
    in property <FeedCardData> card;

    property <bool> is-stream: card.session-kind == "stream";
    property <color> kind-color: is-stream ? Theme.accent : Theme.id-blue;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        // Typed header: colored dot + STREAM.
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 6px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: kind-color;
                    y: (parent.height - self.height) / 2;
                }
            }
            Text {
                font-family: Theme.font-label;
                text: is-stream ? "STREAM" : "SESSION";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: kind-color;
                letter-spacing: Theme.track-label;
            }
        }

        // ── STREAM: game art leads, streamer avatar badged on its corner ──
        if is-stream: HorizontalLayout {
            spacing: 10px;
            height: 44px;

            Rectangle {
                width: 40px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    y: (parent.height - self.height) / 2;

                    GameArt { game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index; icon: card.game-icon; has-icon: card.game-has-icon; capsule: card.game-capsule; has-capsule: card.game-has-capsule; size: 40px; }
                    if card.actor-has-avatar || card.actor-initials != "": UserAvatar {
                        initials: card.actor-initials;
                        avatar: card.actor-avatar;
                        has-avatar: card.actor-has-avatar;
                        x: parent.width - self.width + 4px;
                        y: parent.height - self.height + 4px;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    font-family: Theme.font-display;
                    text: card.game-name != "" ? card.game-name : card.title;
                    font-size: 13px;
                    font-weight: Theme.weight-display;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.actor-name != "" ? "by " + card.actor-name
                            + (card.duration-human != "" ? " · " + card.duration-human : "")
                        : card.duration-human;
                    font-size: 11px;
                    color: Theme.text-sub;
                    overflow: elide;
                }
            }
        }

        if is-stream && card.peak-count > 0: Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: "\{card.peak-count} watched at peak";
            font-size: 11px;
            color: Theme.text-sub;
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: card.timestamp + (card.subtitle != "" ? " · " + card.subtitle : "");
            font-size: 11px;
            color: Theme.skel-text;
        }
    }
}

// Telemetry-backed W/L block for notable game sessions (spec 19 B2).
component GameSessionRecordPanel inherits VerticalLayout {
    in property <FeedCardData> card;
    in property <color> record-color;

    spacing: 0px;

    // Headline record. A win reads white and a loss reads red, the same
    // rule the you-strip pips follow. Colouring the whole record by the
    // streak painted the wins red on any session that ended down.
    HorizontalLayout {
        alignment: start;
        spacing: 0px;

        Text {
            font-family: Theme.font-display;
            text: card.game-wins + "W";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-primary;
        }
        Text {
            font-family: Theme.font-display;
            text: "–";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-tertiary;
        }
        Text {
            font-family: Theme.font-display;
            text: card.game-losses + "L";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.live;
        }
        if card.game-draws > 0: Text {
            font-family: Theme.font-display;
            text: "–";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-tertiary;
        }
        if card.game-draws > 0: Text {
            font-family: Theme.font-display;
            text: card.game-draws + "D";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-secondary;
        }
    }
    Text {
        font-weight: Theme.weight-sentence;
        font-family: Theme.font-body;
        text: "this session";
        font-size: 11px;
        color: Theme.text-sub;
    }

    Rectangle { height: 12px; }
    Rectangle { height: 1px; background: Theme.card-border; }
    Rectangle { height: 10px; }

    // Stat tiles: streak · win rate · matches
    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                font-family: Theme.font-display;
                text: card.game-streak-text;
                font-size: 16px;
                font-weight: Theme.weight-display-bold;
                color: card.game-streak-positive ? Theme.text-primary : Theme.live;
            }
            Text { font-weight: Theme.weight-sentence; font-family: Theme.font-body; text: "streak"; font-size: 10px; color: Theme.text-sub; }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                font-family: Theme.font-display;
                text: card.game-winrate;
                font-size: 16px;
                font-weight: Theme.weight-display-bold;
                color: Theme.text-primary;
            }
            Text { font-weight: Theme.weight-sentence; font-family: Theme.font-body; text: "win rate"; font-size: 10px; color: Theme.text-sub; }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                font-family: Theme.font-display;
                text: "\{card.game-matches}";
                font-size: 16px;
                font-weight: Theme.weight-display-bold;
                color: Theme.text-primary;
            }
            Text { font-weight: Theme.weight-sentence; font-family: Theme.font-body; text: "matches"; font-size: 10px; color: Theme.text-sub; }
        }
    }
}

// A game session without a match record (GAME-SURFACING C1), in the
// language of the stream card: the game's header art fills the card under the
// black washes. The top wash carries the PLAYED chip with the age; the bottom
// wash carries the game, the duration and who played. Without art: the tint
// and the game's monogram. Chrome over the art is black, not the graphite
// ramp. The card is not a control.
component PlayedSessionCard inherits Rectangle {
    in property <FeedCardData> card;

    property <string> game-text: card.game-name != "" ? card.game-name : card.title;
    property <string> players-text: card.participants-line != "" ? card.participants-line : card.actor-name;
    /// The 9 px kicker stands on the baseline of the 11 px age (StatValue rule).
    property <length> kicker-lift: max(0px, 11px * Theme.descent(Theme.font-body) - 9px * Theme.descent(Theme.font-label));

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }

    // The art sits inside the keyline.
    Rectangle {
        x: Theme.keyline;
        y: Theme.keyline;
        width: parent.width - 2 * Theme.keyline;
        height: parent.height - 2 * Theme.keyline;
        clip: true;
        background: Theme.raised;

        if root.card.game-has-capsule: Image {
            width: parent.width;
            height: parent.height;
            source: root.card.game-capsule;
            image-fit: cover;
        }
        if !root.card.game-has-capsule: Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(135deg, #2A2140 0%, Theme.card-bg-inset 100%);
            Text {
                text: root.card.game-monogram;
                font-family: Theme.font-display;
                font-weight: Theme.weight-display-bold;
                font-size: parent.height * 0.42;
                color: #FFFFFF12;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        FootageWash { width: parent.width; height: parent.height; }
    }

    // The art reaches the cut corner: paint the corner back and draw its
    // keyline, as the stream card does.
    CutMask {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.bg-app;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: Theme.card-border;
        stroke-width: 1px;
        commands: "M \{self.width / 1px} \{(self.height - Theme.notch) / 1px} L \{(self.width - Theme.notch) / 1px} \{self.height / 1px}";
    }

    // PLAYED | 4m ago
    MediaChip {
        x: 14px;
        y: 14px;
        row-align: CrossAxisAlignment.end;
        VerticalLayout {
            padding-bottom: root.kicker-lift;
            Text {
                text: "PLAYED";
                font-family: Theme.font-label;
                font-weight: Theme.weight-label;
                font-size: 9px;
                letter-spacing: 1.4px;
                color: Theme.text-primary;
            }
        }
        if root.card.timestamp != "": VerticalLayout {
            padding-bottom: 2px;
            Rectangle {
                width: 1px;
                height: 10px;
                background: #FFFFFF47;
            }
        }
        if root.card.timestamp != "": Text {
            text: root.card.timestamp;
            font-family: Theme.font-body;
            font-weight: Theme.weight-sentence;
            font-size: 11px;
            color: #C9C9CF;
        }
    }

    // The game, the duration, who played.
    VerticalLayout {
        x: 16px;
        y: parent.height - self.height - 14px;
        width: parent.width - 32px;
        height: self.preferred-height;
        spacing: 4px;

        Text {
            text: root.game-text;
            font-family: Theme.font-display;
            font-weight: Theme.weight-display;
            font-size: 17px;
            color: Theme.text-primary;
            overflow: elide;
        }
        if root.card.duration-value != "": StatValue {
            value: root.card.duration-value;
            unit: root.card.duration-unit;
            tail: root.card.duration-tail;
            value-size: 22px;
            unit-size: 13px;
            value-weight: Theme.weight-display-bold;
            hue: Theme.text-primary;
            unit-color: #C9C9CF;
        }
        HorizontalLayout {
            height: 22px;
            padding-top: 2px;
            spacing: 8px;
            cross-axis-alignment: center;

            HorizontalLayout {
                spacing: 4px;
                horizontal-stretch: 0;
                UserAvatar {
                    bg-color: #000000;
                    initials: root.card.part0-initials != "" ? root.card.part0-initials : root.card.actor-initials;
                    avatar: root.card.part0-has-avatar ? root.card.part0-avatar : root.card.actor-avatar;
                    has-avatar: root.card.part0-has-avatar || root.card.actor-has-avatar;
                    color-index: 0;
                    size: 20px;
                }
                if root.card.participant-count > 1: UserAvatar {
                    bg-color: #000000;
                    initials: root.card.part1-initials;
                    avatar: root.card.part1-avatar;
                    has-avatar: root.card.part1-has-avatar;
                    color-index: 1;
                    size: 20px;
                }
                if root.card.participant-count > 2: UserAvatar {
                    bg-color: #000000;
                    initials: root.card.part2-initials;
                    avatar: root.card.part2-avatar;
                    has-avatar: root.card.part2-has-avatar;
                    color-index: 2;
                    size: 20px;
                }
            }
            if root.players-text != "": Text {
                text: root.players-text;
                font-family: Theme.font-body;
                font-weight: Theme.weight-sentence;
                font-size: 13px;
                color: #C9C9CF;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 0px;
            }
        }
    }
}

// Rich game-session card for notable sessions (spec 19 B2): a session with a
// W/L record. A session without one is the PlayedSessionCard.
component GameSessionCard inherits Rectangle {
    in property <FeedCardData> card;

    property <bool> has-record: card.game-matches > 0;
    property <color> record-color: card.game-streak-positive ? Theme.text-primary : Theme.live;

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    if has-record: VerticalLayout {
        padding: 14px;
        spacing: 0px;

        // Header: game badge + name + actor / time
        HorizontalLayout {
            spacing: 10px;
            height: 40px;

            VerticalLayout {
                alignment: center;
                GameArt { game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index; icon: card.game-icon; has-icon: card.game-has-icon; capsule: card.game-capsule; has-capsule: card.game-has-capsule; size: 40px; }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    font-family: Theme.font-display;
                    text: card.game-name != "" ? card.game-name : "Game session";
                    font-size: 14px;
                    font-weight: Theme.weight-display;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    // The time only (mockup frames B to F). Who played is the footer.
                    text: card.timestamp;
                    font-size: 11px;
                    color: Theme.text-sub;
                    overflow: elide;
                }
            }

            // Server-verified result (Riot post-match API) — spec 18 §9.
            if card.game-verified: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: verified-label.preferred-width + 12px;
                    height: 18px;
                    border-radius: 4px;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.graphic-med;
                    verified-label := Text {
                        text: "VERIFIED";
                        font-family: Theme.font-label;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { height: 14px; }

        GameSessionRecordPanel {
            card: root.card;
            record-color: record-color;
        }

        Rectangle { vertical-stretch: 1; }

        // Footer: the octagons of who played, "Bob, solo" when one person did,
        // and the duration at the right (mockup frames B to F).
        HorizontalLayout {
            height: 20px;
            spacing: 6px;
            cross-axis-alignment: center;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                horizontal-stretch: 0;
                cross-axis-alignment: center;
                UserAvatar {
                    initials: card.part0-initials != "" ? card.part0-initials : card.actor-initials;
                    avatar: card.part0-has-avatar ? card.part0-avatar : card.actor-avatar;
                    has-avatar: card.part0-has-avatar || card.actor-has-avatar;
                    color-index: card.actor-hue-index;
                    size: 20px;
                }
                if card.participant-count > 1: UserAvatar {
                    initials: card.part1-initials;
                    avatar: card.part1-avatar;
                    has-avatar: card.part1-has-avatar;
                    color-index: 1;
                    size: 20px;
                }
                if card.participant-count > 2: UserAvatar {
                    initials: card.part2-initials;
                    avatar: card.part2-avatar;
                    has-avatar: card.part2-has-avatar;
                    color-index: 2;
                    size: 20px;
                }
            }

            if card.participant-count <= 1 && card.actor-name != "": Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.actor-name + ", solo";
                font-size: 11px;
                color: Theme.text-sub;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if card.participant-count > 1 || card.actor-name == "": Rectangle { horizontal-stretch: 1; }

            if card.duration-human != "": Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.duration-human;
                font-size: 11px;
                color: Theme.skel-text;
            }
        }
    }
}

// The player octagons of a live card, with "+N" past the last one.
component LivePlayers inherits HorizontalLayout {
    in property <FeedCardData> card;

    height: 20px;
    spacing: 4px;
    alignment: start;
    for p in card.live.players: UserAvatar {
        initials: p.initials;
        avatar: p.avatar;
        has-avatar: p.has-avatar;
        color-index: p.hue-index;
        size: 20px;
    }
    if card.live.more-players > 0: AvatarOverflow {
        count: card.live.more-players;
        size: 20px;
    }
}

component LiveSessionName inherits Text {
    in property <FeedCardData> card;

    text: card.game-name;
    font-family: Theme.font-display;
    font-size: 13px;
    font-weight: Theme.weight-display;
    color: Theme.text-primary;
    overflow: elide;
}

component LiveSinceText inherits Text {
    in property <FeedCardData> card;

    text: card.live.since-text;
    font-weight: Theme.weight-sentence;
    font-family: Theme.font-body;
    font-size: 12px;
    color: Theme.text-sub;
}

// The red dot of a live card. Red is only this.
component LivePip inherits Rectangle {
    width: 6px;
    Rectangle {
        width: 6px;
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: Theme.live;
    }
}

// Live session card: a game in progress (mockup cold-start frames 5 and 8).
// The shape of the session card: the fixed game tile at the left, then the
// name, the player octagons and "since N min". Red is only the pip of the
// label. With poster art in the wide slot the art fills the card instead.
component LiveSessionCard inherits Rectangle {
    in property <FeedCardData> card;

    // The wide slot is only given to a card with poster art. Without it the
    // card is a cell, whatever the width.
    property <bool> poster-mode: card.live.has-poster && root.width > 420px;

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    // Wide card with poster: the local Steam art keeps its colour. Chrome
    // sits on black washes, as on the stream hero card (mockup next-gen-feed,
    // stage D): the label on the top wash, the game and the players on the
    // bottom one.
    if root.poster-mode: Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;

        Image {
            source: root.card.live.poster;
            width: parent.width;
            height: parent.height;
            image-fit: cover;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(180deg,
                #00000099 0%, #00000000 26%, #00000000 40%, #000000E6 100%);
        }
        CutMask { width: parent.width; height: parent.height; n: Theme.notch; corner: "br"; fill: Theme.bg-app; }

        VerticalLayout {
            padding: 14px;
            spacing: 4px;

            HorizontalLayout {
                height: 16px;
                spacing: 6px;
                LivePip { }
                Text {
                    horizontal-stretch: 1;
                    text: "NOW PLAYING";
                    font-family: Theme.font-label;
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-label;
                    color: Theme.on-media;
                    vertical-alignment: center;
                }
            }

            Rectangle { vertical-stretch: 1; }

            LiveSessionName {
                card: root.card;
                font-size: 20px;
                color: Theme.on-media;
            }
            HorizontalLayout {
                spacing: 10px;
                height: 20px;
                LivePlayers { card: root.card; horizontal-stretch: 0; }
                Text {
                    horizontal-stretch: 1;
                    text: root.card.live.since-text;
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    font-size: 12px;
                    color: Theme.on-media;
                    vertical-alignment: center;
                }
            }
        }
    }

    if !root.poster-mode: VerticalLayout {
        padding: 14px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            height: 16px;
            spacing: 6px;
            LivePip { }
            Text {
                horizontal-stretch: 1;
                text: "NOW PLAYING";
                font-family: Theme.font-label;
                font-size: 10px;
                font-weight: Theme.weight-label;
                letter-spacing: Theme.track-label;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            height: 58px;

            Rectangle {
                width: 40px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    y: 0px;
                    GameArt { game-id: root.card.game-id; monogram: root.card.game-monogram; hue-index: root.card.game-hue-index; icon: root.card.game-icon; has-icon: root.card.game-has-icon; capsule: root.card.game-capsule; has-capsule: root.card.game-has-capsule; size: 40px; }
                }
            }

            VerticalLayout {
                alignment: start;
                spacing: 2px;
                horizontal-stretch: 1;
                LiveSessionName { card: root.card; }
                LivePlayers { card: root.card; }
                LiveSinceText { card: root.card; }
            }
        }

    }
}

// Dispatcher: renders the correct card based on card-type
// The weekly recap in its slot: sealed until opened, empty while its card is in
// the centre, then the recap card.
component RecapSlot inherits Rectangle {
    in property <FeedCardData> card;

    property <bool> mine: root.card.recap-seal.key != "" && SealedUi.active-key == root.card.recap-seal.key;
    // The model still says sealed until the card lands and Rust builds it again.
    property <bool> sealed-look: root.card.recap-seal.sealed && !root.mine;

    background: transparent;

    if root.mine: CutShape {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "bl";
        stroke: Theme.card-border;
        stroke-width: Theme.keyline;
    }

    if root.sealed-look: SealedRecap {
        width: parent.width; height: parent.height;
        seal: root.card.recap-seal;
        week: root.card.recap-week != "" ? root.card.recap-week : "This week";
        interactive: SealedUi.active-kind == "";
        clicked => {
            SealedUi.recap-card = root.card;
            SealedUi.launch("recap", "recap", root.card.recap-seal.key, {
                x: root.absolute-position.x,
                y: root.absolute-position.y,
                w: root.width,
                h: root.height,
            });
        }
    }

    if !root.sealed-look && (!root.mine || SealedUi.closing): RecapCard {
        width: parent.width; height: parent.height; card: root.card;
        opacity: root.mine ? SealedUi.landing : 1;
    }
}

component FeedSlot inherits Rectangle {
    // A card that outgrows its slot must be cut off at the slot edge, not
    // painted over the gap below it. This is `overflow: hidden` in the mockup.
    clip: true;

    in property <FeedCardData> card;
    in property <string> playing-path: "";
    in property <float> clip-progress: 0.0;
    in property <bool> clip-paused: false;
    in property <float> clip-anim-tick: 0.0;
    in property <string> clip-position-text: "";
    in property <string> clip-duration-text: "";
    in property <int> clip-duration-ms: 0;
    callback play-clicked(string);
    callback seek-clip-ms(int);
    callback session-seen(string);
    callback session-preview-request-frame(/* session_id */ string, /* index */ int);

    // Real cards
    if card.card-type == "clip" && card.clip-kind == "game": GameClipCard {
        width: parent.width; height: parent.height;
        card-id: card.id;
        is-hero: card.is-hero;
        is-new: card.is-new;
        poster: card.snapshot-poster;
        poster-ready: card.snapshot-poster-ready;
        poster-loading: card.snapshot-loading;
        uploading: card.clip-uploading;
        can-play: card.clip-can-play;
        clipper-name: card.actor-name;
        clipper-initials: card.actor-initials;
        clipper-hue-index: card.actor-hue-index;
        clipper-avatar: card.actor-avatar;
        clipper-has-avatar: card.actor-has-avatar;
        game-name: card.game-name;
        duration: card.duration;
        play-clicked => { root.play-clicked(card.clip-path); }
    }
    if card.card-type == "clip" && card.clip-kind != "game": ClipCard {
        width: parent.width; height: parent.height; card: root.card;
        is-playing: root.card.clip-path != "" && root.card.clip-path == root.playing-path;
        is-paused: root.clip-paused && root.card.clip-path != ""
            && root.card.clip-path == root.playing-path;
        progress: root.clip-progress;
        position-text: root.clip-position-text;
        duration-text: root.clip-duration-text;
        clip-duration-ms: root.clip-duration-ms;
        play-clicked(id) => { root.play-clicked(id); }
        seek-ms(m) => { root.seek-clip-ms(m); }
    }
    if card.card-type == "session-preview": SessionPreviewCard {
        width: parent.width; height: parent.height;
        session-id: card.id;
        snapshot-urls: card.snapshot-urls;
        title: card.title;
        game-name: card.game-name;
        streamer-username: card.actor-name;
        streamer-initials: card.actor-initials;
        streamer-hue-index: card.actor-hue-index;
        duration-min: card.duration-min;
        peak-viewers: card.participant-count;
        clip-count: card.clip-count;
        time-since-ended: card.timestamp;
        is-hero: card.is-hero;
        was-seen: card.was-seen;
        snapshot-loading: card.snapshot-loading;
        snapshot-poster: card.snapshot-poster;
        snapshot-poster-ready: card.snapshot-poster-ready;
        snapshot-error: card.snapshot-error;
        snapshot-playback-frame: card.snapshot-playback-frame;
        snapshot-playback-index: card.snapshot-playback-index;
        snapshot-playback-revision: card.snapshot-playback-revision;
        session-seen(id) => { root.session-seen(id); }
        session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
    }
    if card.card-type == "session": SessionCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    if card.card-type == "game-session" && card.game-matches == 0: PlayedSessionCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    if card.card-type == "game-session" && card.game-matches > 0: GameSessionCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    if card.card-type == "live-session": LiveSessionCard {
        width: parent.width; height: parent.height; card: root.card;
    }
    // The belt hero of the Stage (zones.stage "belt").
    if card.card-type == "head2head" && card.head2head.variant == "belt": BeltHero {
        width: parent.width; height: parent.height;
        belt: card.head2head.belt;
    }
}

/// A carousel arrow over the clips: a cut tile, a black wash, a chevron.
component CarouselArrow inherits Rectangle {
    in property <bool> left: false;
    callback clicked();
    width: 36px;
    height: 36px;
    accessible-role: button;
    accessible-label: root.left ? "Newer clips" : "Older clips";
    CutButtonShape { width: parent.width; height: parent.height; n: 7px; fill: ta.has-hover ? Theme.text-primary : Theme.over-media; }
    Image {
        source: root.left ? @image-url("../icons/chevron-left.svg") : @image-url("../icons/chevron-right.svg");
        colorize: ta.has-hover ? Theme.on-action : Theme.text-primary;
        width: 16px; height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// Clips as a paged carousel: `per-page` tiles in view, arrows at the ends,
/// newest first. `history-weeks` > 0 ends it with the Crew history tile.
component ClipCarousel inherits Rectangle {
    in property <[FeedCardData]> clips;
    in property <int> per-page: 2;
    in property <int> history-weeks: 0;
    in property <string> playing-path;
    in property <float> clip-progress;
    in property <bool> clip-paused;
    in property <float> clip-anim-tick;
    in property <string> clip-position-text;
    in property <string> clip-duration-text;
    in property <int> clip-duration-ms;
    callback play-clicked(string);
    callback seek-clip-ms(int);
    callback history-clicked();

    property <length> gap: 12px;
    property <int> tiles: root.clips.length + (root.history-weeks > 0 ? 1 : 0);
    property <int> pages: Math.max(1, Math.ceil(root.tiles / root.per-page));
    property <int> page: 0;
    property <length> tile-w: (self.width - (root.per-page - 1) * root.gap) / root.per-page;
    property <length> step: root.tile-w + root.gap;

    clip: true;

    Rectangle {
        x: -root.page * root.per-page * root.step;
        animate x { duration: 260ms; easing: ease-in-out; }
        width: root.tiles * root.step;
        height: parent.height;
        for c[i] in root.clips: FeedSlot {
            x: i * root.step;
            y: 0;
            width: root.tile-w;
            height: parent.height;
            card: c;
            playing-path: root.playing-path;
            clip-progress: root.clip-progress;
            clip-paused: root.clip-paused;
            clip-anim-tick: root.clip-anim-tick;
            clip-position-text: root.clip-position-text;
            clip-duration-text: root.clip-duration-text;
            clip-duration-ms: root.clip-duration-ms;
            play-clicked(path) => { root.play-clicked(path); }
            seek-clip-ms(m) => { root.seek-clip-ms(m); }
        }
        // The end of this week: the way into Crew history.
        if root.history-weeks > 0: Rectangle {
            x: root.clips.length * root.step;
            y: 0;
            width: root.tile-w;
            height: parent.height;
            accessible-role: button;
            accessible-label: "Crew history";
            BoardShell { width: parent.width; height: parent.height; corner: "tr"; }
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Image {
                    source: @image-url("../icons/chevron-down.svg");
                    colorize: Theme.text-body;
                    width: 20px; height: 20px;
                    x: (parent.width - self.width) / 2;
                }
                Kicker { text: "CREW HISTORY"; horizontal-alignment: center; color: Theme.text-primary; }
                Kicker { text: root.history-weeks + (root.history-weeks == 1 ? " WEEK" : " WEEKS"); horizontal-alignment: center; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.history-clicked(); } }
        }
    }

    if root.page > 0: CarouselArrow {
        left: true;
        x: 10px;
        y: (parent.height - self.height) / 2;
        clicked => { root.page = Math.max(0, root.page - 1); }
    }
    if root.page < root.pages - 1: CarouselArrow {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        clicked => { root.page = Math.min(root.pages - 1, root.page + 1); }
    }
}

/// One past week of Crew history: the week, then what happened in it. Open
/// with m3llo+ (the numbers and a clip carousel); sealed without it (the
/// sealed recap and locked teasers).
component HistoryRow inherits Rectangle {
    in property <HistoryWeek> week;
    in property <length> cw;
    in property <string> playing-path;
    in property <float> clip-progress;
    in property <bool> clip-paused;
    in property <float> clip-anim-tick;
    in property <string> clip-position-text;
    in property <string> clip-duration-text;
    in property <int> clip-duration-ms;
    callback play-clicked(string);
    callback seek-clip-ms(int);
    callback plus-clicked();

    HorizontalLayout {
        spacing: 12px;
        if root.week.locked: SealedRecap {
            width: root.cw;
            seal: root.week.seal;
            week: root.week.label;
            clicked => { root.plus-clicked(); }
        }
        if !root.week.locked: FeedBoard {
            width: root.cw;
            mode: "past";
            past-label: root.week.label.to-uppercase();
            past-age: root.week.age;
            big: root.week.big;
            stats: root.week.stats;
            has-top-game: root.week.has-top;
            top-game: root.week.top;
            show-titles: false;
        }
        if root.week.locked: HorizontalLayout {
            spacing: 12px;
            for t in root.week.teasers: LockedTeaserTile {
                horizontal-stretch: 1;
                item: t;
                clicked => { root.plus-clicked(); }
            }
            if root.week.more > 0: Rectangle {
                width: 80px;
                horizontal-stretch: 0;
                BoardShell { width: parent.width; height: parent.height; corner: "tr"; }
                Text {
                    text: "+" + root.week.more;
                    font-family: Theme.font-display;
                    font-weight: Theme.weight-display;
                    font-size: 16px;
                    color: Theme.text-body;
                }
            }
        }
        if !root.week.locked: ClipCarousel {
            clips: root.week.clips;
            per-page: 2;
            playing-path: root.playing-path;
            clip-progress: root.clip-progress;
            clip-paused: root.clip-paused;
            clip-anim-tick: root.clip-anim-tick;
            clip-position-text: root.clip-position-text;
            clip-duration-text: root.clip-duration-text;
            clip-duration-ms: root.clip-duration-ms;
            play-clicked(path) => { root.play-clicked(path); }
            seek-clip-ms(m) => { root.seek-clip-ms(m); }
        }
    }
}

component ZonePeople inherits PeopleZone {
    in property <ZonesData> zones;
    members: zones.members;
    open-seats: zones.open-seats;
    joined: zones.joined;
    joined-line: zones.joined-line;
    joined-sub: zones.joined-sub;
    say-hi-card: zones.say-hi-card;
    say-hi-name: zones.say-hi-name;
    said-hi: zones.said-hi;
    voice: zones.voice;
    channel: zones.channel;
    voice-line: zones.voice-line;
    voice-people: zones.voice-people;
    voice-more: zones.voice-more;
}

/// The People zone as cards. One card holds every part when they fit. The
/// first five (the seats and the red Invite) take a card of their own when
/// another part shows. Joined and voice share a card only at full width.
/// In the narrow column each part is a card.
global PeopleStack {
    out property <length> one-h: 120px;
    out property <length> part-h: 88px;

    pure public function parts(z: ZonesData) -> int {
        (z.open-seats > 0 ? 1 : 0) + (z.joined.length > 0 ? 1 : 0) + (z.voice != "" ? 1 : 0)
    }
    /// Every part in one card. Five seats, Invite and a call are wider than the feed.
    pure public function one(z: ZonesData, wide: bool) -> bool {
        self.parts(z) <= 1 || (self.parts(z) == 2 && z.open-seats == 0 && wide)
    }
    /// Joined and voice in one card under the seats card.
    pure public function joins-with-voice(z: ZonesData, wide: bool) -> bool {
        z.joined.length > 0 && z.voice != "" && wide
    }
    /// The height of the zone: one card, or the stack of cards.
    pure public function height(z: ZonesData, wide: bool) -> length {
        if self.one(z, wide) {
            return self.one-h;
        }
        let cards = self.joins-with-voice(z, wide) ? self.parts(z) - 1 : self.parts(z);
        cards * self.part-h + (cards - 1) * 12px
    }
}

component PeopleCards inherits VerticalLayout {
    in property <ZonesData> zones;
    /// The zone runs the full width of the feed, not the column beside the board.
    in property <bool> wide: true;
    callback invite();
    callback voice-clicked();

    property <bool> one: PeopleStack.one(zones, wide);
    property <bool> joins-with-voice: PeopleStack.joins-with-voice(zones, wide);
    property <length> one-h: PeopleStack.one-h;
    property <length> part-h: PeopleStack.part-h;
    property <bool> seats: zones.open-seats > 0;
    property <bool> joins: zones.joined.length > 0;
    property <bool> calls: zones.voice != "";

    spacing: 12px;

    if one: ZonePeople {
        height: root.one-h;
        zones: root.zones;
        invite => { root.invite(); }
        voice-clicked => { root.voice-clicked(); }
    }
    if !one && seats: ZonePeople {
        height: root.part-h;
        zones: root.zones;
        show-joined: false;
        show-voice: false;
        invite => { root.invite(); }
    }
    if !one && joins: ZonePeople {
        height: root.part-h;
        zones: root.zones;
        show-seats: false;
        show-voice: root.joins-with-voice;
        voice-clicked => { root.voice-clicked(); }
    }
    if !one && calls && !joins-with-voice: ZonePeople {
        height: root.part-h;
        zones: root.zones;
        show-seats: false;
        show-joined: false;
        voice-clicked => { root.voice-clicked(); }
    }
}

/// The crew feed in five zones and Crew history: Stage, Board, Clips, People,
/// Sessions. A zone with nothing to show collapses and the zones under it
/// move up. The cards are the feed cards (FeedSlot), so play, watch, the
/// sealed reveal and Say hi work on them.
export component CrewFeed inherits Rectangle {
    in property <ZonesData> zones;
    in property <YouStripData> you-strip;
    in property <[StreamCardData]> stream-cards: [];
    in property <int> clip-count: 0;
    in property <bool> is-hosting: false;
    in property <bool> is-watching: false;
    in property <string> active-streamer-id: "";
    in property <image> stream-frame;
    in property <float> stream-ui-render-fps: 0.0;
    in property <bool> stream-paused: false;
    in property <string> stream-paused-reason: "";
    in property <string> clip-playing-path: "";
    in property <float> clip-progress: 0.0;
    in property <bool> clip-paused: false;
    in property <float> clip-anim-tick: 0.0;
    in property <string> clip-position-text: "";
    in property <string> clip-duration-text: "";
    in property <int> clip-duration-ms: 0;

    callback card-clicked(string);
    callback invite-clicked();
    callback start-voice-clicked(string);
    /// The quest row of step 5 asks for the game activity setting.
    callback game-activity-settings-clicked();
    callback seek-clip-ms(int);
    callback watch-stream-clicked(string, string, int, int);
    callback stop-stream-clicked();
    callback stop-watching-clicked();
    callback session-seen(string);
    callback session-preview-request-frame(/* session_id */ string, /* index */ int);
    /// A locked week or the m3llo+ strip.
    callback plus-clicked();
    callback you-strip-clicked();
    /// The feed scrolled near the end and the server has more history.
    callback history-more();

    property <length> view-top: self.absolute-position.y;
    property <length> view-bottom: self.absolute-position.y + self.height;
    init => {
        FeedView.top = self.view-top;
        FeedView.bottom = self.view-bottom;
    }
    changed view-top => { FeedView.top = self.view-top; }
    changed view-bottom => { FeedView.bottom = self.view-bottom; }

    // The grid: three columns, rows of Theme.feed-row, 12 px gaps.
    property <length> inner-w: self.width - 40px;
    property <length> cw: (self.inner-w - 24px) / 3;
    property <length> two: self.cw * 2 + 12px;
    property <length> rh: Theme.feed-row;

    property <bool> has-stage: zones.stage != "";
    property <length> stage-w: has-board ? root.two : root.inner-w;
    // While you watch, the live stage grows to the watched card's height:
    // its picture is 16:9 at the card's width (ActiveStreamsPanel's
    // watch-height, one formula in StreamCardSize). In the wide slot the
    // card is shorter and sits at the top of the stage.
    property <length> stage-h: !has-stage ? 0px
        : zones.stage == "card" && zones.stage-short ? rh
        : zones.stage == "live" && root.is-watching
            ? max(rh * 2 + 12px, StreamCardSize.watch-height(root.stage-w, root.stream-cards.length))
        : rh * 2 + 12px;
    property <bool> has-board: zones.board != "";
    property <length> board-h: zones.board == "sealed" || zones.board == "past" || zones.board == "solo"
        ? rh * 2 + 12px : rh * 3 + 24px;
    property <bool> has-clips: zones.clips.length > 0;
    // The clip row stands beside the board while the left column is shorter.
    property <bool> clips-left: has-board && has-clips && stage-h + 12px + rh <= board-h;
    property <length> left-h: stage-h + (clips-left ? (has-stage ? 12px : 0px) + rh : 0px);
    property <bool> people-left: zones.people && has-board
        && left-h + (left-h > 0px ? 12px : 0px) + PeopleStack.height(zones, false) <= board-h;
    // Tab of the board: Week when today has nothing.
    property <int> tab-pick: -1;
    property <int> tab: tab-pick >= 0 ? tab-pick : (zones.today-empty ? 1 : 0);
    property <int> tile-gap: 12;

    background: transparent;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;
                alignment: start;
                Text {
                    font-family: Theme.font-display;
                    text: "Crew feed";
                    font-size: 15px;
                    font-weight: Theme.weight-display;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.card-border; }

        // Pinned personal stats (only the viewer sees it), as in CrewFeed.
        YouStrip {
            data: root.you-strip;
            clicked => { root.you-strip-clicked(); }
        }

        feed-flick := Flickable {
            vertical-stretch: 1;
            // Near the end with more history on the server: ask for a page.
            changed content-y => {
                if root.zones.history-more
                    && self.content-height + self.content-y - self.height < 600px {
                    root.history-more();
                }
            }

            VerticalLayout {
                padding: 16px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                alignment: start;

                if zones.dormant-line != "": BoardDormantStrip {
                    height: 60px;
                    line: zones.dormant-line;
                    age: zones.dormant-age;
                }

                // Top block: the left column, and the board beside it.
                if has-stage || has-board || clips-left || people-left: HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    VerticalLayout {
                        width: root.stage-w;
                        spacing: 12px;
                        alignment: start;

                        if zones.stage == "live": Rectangle {
                            height: root.stage-h;
                            ActiveStreamsPanel {
                                width: parent.width;
                                height: parent.height;
                                cards: root.stream-cards;
                                is-hosting: root.is-hosting;
                                is-watching: root.is-watching;
                                active-streamer-id: root.active-streamer-id;
                                stream-frame: root.stream-frame;
                                stream-ui-render-fps: root.stream-ui-render-fps;
                                stream-paused: root.stream-paused;
                                stream-paused-reason: root.stream-paused-reason;
                                viewport-abs-y: feed-flick.absolute-position.y / 1px;
                                viewport-height: feed-flick.height / 1px;
                                watch-stream-clicked(host-id, session-id, w, h) => { root.watch-stream-clicked(host-id, session-id, w, h); }
                                stop-stream-clicked => { root.stop-stream-clicked(); }
                                stop-watching-clicked => { root.stop-watching-clicked(); }
                            }
                        }
                        if zones.stage == "card": FeedSlot {
                            height: root.stage-h;
                            card: zones.stage-card;
                            playing-path: root.clip-playing-path;
                            clip-progress: root.clip-progress;
                            clip-paused: root.clip-paused;
                            clip-anim-tick: root.clip-anim-tick;
                            clip-position-text: root.clip-position-text;
                            clip-duration-text: root.clip-duration-text;
                            clip-duration-ms: root.clip-duration-ms;
                            play-clicked(path) => { root.card-clicked(path); }
                            seek-clip-ms(m) => { root.seek-clip-ms(m); }
                            session-seen(id) => { root.session-seen(id); }
                            session-preview-request-frame(sid, idx) => { root.session-preview-request-frame(sid, idx); }
                        }
                        if zones.stage == "quests": QuestCard {
                            height: root.stage-h;
                            count: zones.quest-count;
                            fill: zones.quest-fill;
                            gifts: zones.quest-gifts;
                            rows: zones.quest-rows;
                            invite => { root.invite-clicked(); }
                            voice => { root.start-voice-clicked(zones.channel-id); }
                            settings => { root.game-activity-settings-clicked(); }
                        }
                        if zones.stage == "own": StageOwnBelts {
                            height: root.stage-h;
                            you: zones.you;
                            chips: zones.own-chips;
                        }

                        if root.clips-left: ClipCarousel {
                            height: root.rh;
                            clips: zones.clips;
                            per-page: 2;
                            history-weeks: zones.history.length;
                            history-clicked => { root.to-history(); }
                            playing-path: root.clip-playing-path;
                            clip-progress: root.clip-progress;
                            clip-paused: root.clip-paused;
                            clip-anim-tick: root.clip-anim-tick;
                            clip-position-text: root.clip-position-text;
                            clip-duration-text: root.clip-duration-text;
                            clip-duration-ms: root.clip-duration-ms;
                            play-clicked(path) => { root.card-clicked(path); }
                            seek-clip-ms(m) => { root.seek-clip-ms(m); }
                        }

                        if root.people-left: PeopleCards {
                            zones: root.zones;
                            wide: false;
                            invite => { root.invite-clicked(); }
                            voice-clicked => { root.start-voice-clicked(zones.channel-id); }
                        }
                    }

                    if zones.board == "sealed": RecapSlot {
                        width: root.cw;
                        height: root.board-h;
                        card: zones.recap-card;
                    }
                    if has-board && zones.board != "sealed": FeedBoard {
                        width: root.cw;
                        height: root.board-h;
                        mode: zones.board == "solo" ? "past" : zones.board;
                        active-tab: root.tab;
                        today-empty: zones.today-empty;
                        big: root.tab == 0 && zones.board == "tabs" ? zones.today-big : zones.week-big;
                        stats: root.tab == 0 && zones.board == "tabs" ? zones.today-stats : zones.week-stats;
                        has-top-game: root.tab == 0 && zones.board == "tabs" ? zones.today-has-top : zones.week-has-top;
                        top-game: root.tab == 0 && zones.board == "tabs" ? zones.today-top : zones.week-top;
                        week-extra: (root.tab == 1 || zones.board == "past") && zones.most-active-value != "";
                        most-active: zones.most-active;
                        most-active-value: zones.most-active-value;
                        most-clipped: zones.most-clipped;
                        most-clipped-value: zones.most-clipped-value;
                        games-played: zones.games-played;
                        games-more: zones.games-more;
                        past-label: zones.board == "solo" ? "YOU" : zones.past-label;
                        past-age: zones.past-age;
                        quiet-line: zones.quiet-line;
                        quiet-sub: zones.quiet-sub;
                        titles: zones.titles;
                        title-count: zones.title-count;
                        more-label: zones.more-label;
                        show-titles: zones.board != "solo" && zones.titles.length > 0;
                        show-numbers: zones.board != "solo";
                        game-rows-label: "YOUR GAMES";
                        game-rows: zones.board == "solo" ? zones.solo-games : [];
                        own-chips: zones.board == "solo" && zones.stage == "quests" ? zones.own-chips : [];
                        tab-clicked(i) => { root.tab-pick = i; }
                    }
                }

                if has-clips && !root.clips-left: ClipCarousel {
                    height: root.rh;
                    clips: zones.clips;
                    per-page: 3;
                    history-weeks: zones.history.length;
                    history-clicked => { root.to-history(); }
                    playing-path: root.clip-playing-path;
                    clip-progress: root.clip-progress;
                    clip-paused: root.clip-paused;
                    clip-anim-tick: root.clip-anim-tick;
                    clip-position-text: root.clip-position-text;
                    clip-duration-text: root.clip-duration-text;
                    clip-duration-ms: root.clip-duration-ms;
                    play-clicked(path) => { root.card-clicked(path); }
                    seek-clip-ms(m) => { root.seek-clip-ms(m); }
                }

                if zones.people && !root.people-left: PeopleCards {
                    zones: root.zones;
                    invite => { root.invite-clicked(); }
                    voice-clicked => { root.start-voice-clicked(zones.channel-id); }
                }

                // Sessions: real session cards (now playing, game, voice,
                // stream), the carousel of the clips.
                if zones.sessions.length > 0: ClipCarousel {
                    height: root.rh;
                    clips: zones.sessions;
                    per-page: 3;
                    playing-path: root.clip-playing-path;
                    clip-progress: root.clip-progress;
                    clip-paused: root.clip-paused;
                    clip-anim-tick: root.clip-anim-tick;
                    clip-position-text: root.clip-position-text;
                    clip-duration-text: root.clip-duration-text;
                    clip-duration-ms: root.clip-duration-ms;
                    play-clicked(path) => { root.card-clicked(path); }
                    seek-clip-ms(m) => { root.seek-clip-ms(m); }
                }
                if zones.sessions.length == 0 && zones.installed.length > 0: MostInstalledCard {
                    height: 52px + 44px * zones.installed.length;
                    games: zones.installed;
                }

                // Crew history: every week before the last 7 days (m3llo+).
                hist := VerticalLayout {
                    spacing: 12px;
                    if zones.history.length > 0 && !zones.plus: PlusStrip {
                        height: 88px;
                        weeks: zones.history.length;
                        clicked => { root.plus-clicked(); }
                    }
                    for w in zones.history: HistoryRow {
                        height: root.rh;
                        week: w;
                        cw: root.cw;
                        playing-path: root.clip-playing-path;
                        clip-progress: root.clip-progress;
                        clip-paused: root.clip-paused;
                        clip-anim-tick: root.clip-anim-tick;
                        clip-position-text: root.clip-position-text;
                        clip-duration-text: root.clip-duration-text;
                        clip-duration-ms: root.clip-duration-ms;
                        play-clicked(path) => { root.card-clicked(path); }
                        seek-clip-ms(m) => { root.seek-clip-ms(m); }
                        plus-clicked => { root.plus-clicked(); }
                    }
                }
            }
        }
    }

    /// The Crew history tile at the end of the clips: scroll to the history.
    function to-history() {
        feed-flick.content-y = Math.max(-(feed-flick.content-height - feed-flick.height), -(hist.y + 16px));
    }

    // The sealed reveal: the card in the centre of the feed (SEALED-REVEAL.md).
    // Made when a card leaves its slot, gone when it is back. With no card the
    // view must not exist: its clock would stand at rest with an empty belt,
    // and its scrim would take every click on the feed.
    if SealedUi.active-kind != "": Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        clip: true;
        stage := SealedStage {
            width: parent.width;
            height: parent.height;
            page-x: root.absolute-position.x;
            page-y: root.absolute-position.y;
            if SealedUi.active-kind == "recap": RecapCard {
                width: 100%;
                height: 100%;
                card: SealedUi.recap-card;
                count: SealedUi.active-kind == "recap" ? stage.count : 1;
            }
        }
    }
}

// The whole zone matrix with real-looking data is in
// previews/feed_board_preview.slint (scripts/render-feed-zones.sh).
export component Preview inherits Rectangle {
    width: 865px;
    height: 640px;
    background: Theme.bg-app;
    CrewFeed {
        width: parent.width;
        height: parent.height;
        zones: {
            board: "quiet",
            quiet-line: "No crew time last week.",
            quiet-sub: "Sara and Max still played.",
            week-big: { value: "0", unit: "min", label: "HANGOUT" },
            people: true,
            members: [{ id: "u-you", name: "You", initials: "YO", hue-index: 1 }],
            open-seats: 3,
            voice: "idle",
            channel: "Lounge",
            voice-line: "Empty. Last call 6 November",
        };
    }
}
