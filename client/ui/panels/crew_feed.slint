component NewBadge inherits Rectangle {
    width: new-text.preferred-width + 12px;
    height: 16px;
    border-radius: 4px;
    background: Theme.live;

    new-text := Text {
        font-family: Theme.font-display;
        text: "NEW";
        font-size: 9px;
        font-weight: Theme.weight-display-bold;
        color: Theme.on-live;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Hero clip card (2x wide)
component HeroClipCard inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    in property <float> progress: 0.0;
    in property <string> position-text: "";
    in property <string> duration-text: "";
    in property <int> clip-duration-ms: 0;
    callback play-clicked(string);
    callback seek-ms(int);

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: card.is-new ? Theme.clip-amber :
                  is-playing ? Theme.clip-amber :
                  card-hover.has-hover ? Theme.graphic-med : Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: card-hover.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    }


    // Declared BEFORE the content so embedded touch areas (waveform scrub,
    // play ring) sit on top and receive their own pointer events — a full-card
    // touch declared after the content would swallow every click.
    card-hover := TouchArea {
        accessible-role: button;
        accessible-label: card.title != "" ? card.title : card.actor-name + " clipped that";
        mouse-cursor: pointer;
        clicked => { play-clicked(card.clip-path); }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;

        // Header: micro-label + timecode
        Rectangle {
            height: 16px;
            vertical-stretch: 0;

            HorizontalLayout {
                spacing: 0px;

                if card.is-new: NewBadge {
                    horizontal-stretch: 0;
                }
                if card.is-new: Rectangle { width: 6px; horizontal-stretch: 0; }

                if !is-playing: HorizontalLayout {
                    spacing: 5px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: HorizontalLayout forces y:0 on children —
                    // center via the cross axis instead of per-child y.
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../icons/scissors.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: "VOICE CLIP";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.clip-amber;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                if is-playing: HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: y is silently forced to 0 in layouts — use
                    // the cross axis to center the icon with its label.
                    cross-axis-alignment: center;

                    if !is-paused: Image {
                        source: @image-url("../icons/speaker.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    if is-paused: Image {
                        source: @image-url("../icons/pause.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: is-paused ? "PAUSED" : "PLAYING";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.clip-amber;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    letter-spacing: Theme.track-label;
                    font-weight: Theme.weight-label;
                    text: is-playing ? position-text + " / " + duration-text : card.duration;
                    font-family: Theme.font-label;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

        }

        // Wave row: play ring + dot-matrix band (absorbs vertical slack)
        Rectangle {
            vertical-stretch: 1;
            min-height: 78px;

            DotWaveform {
                x: play-ring.width + 12px;
                width: parent.width - play-ring.width - 12px;
                height: parent.height;
                peaks: card.waveform;
                progress: root.progress;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                rows: 15;
                dot-size: 3px;
                row-pitch: 5px;
                duration-ms: root.is-playing ? root.clip-duration-ms : card.duration-ms;
                seek-ms(m) => { root.seek-ms(m); }
                play-at-ms(m) => {
                    root.play-clicked(card.clip-path);
                    root.seek-ms(m);
                }
            }

            // x must be explicit: Slint horizontally centers children
            // narrower than their parent by default (CLAUDE.md fill-bar rule).
            play-ring := ClipPlayRing {
                x: 0;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                y: (parent.height - self.height) / 2;
                ring-clicked => { root.play-clicked(card.clip-path); }
            }
        }

        // Card body pinned below the wave band
        VerticalLayout {
            spacing: 6px;
            vertical-stretch: 0;

            Text {
                font-family: Theme.font-display;
                text: card.title != "" ? card.title : card.actor-name + " clipped that";
                font-size: 14px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
            }

            HorizontalLayout {
                spacing: 8px;
                height: 20px;

                if card.participant-count > 0: HorizontalLayout {
                    spacing: 4px;
                    width: self.preferred-width;

                    UserAvatar { initials: card.actor-initials; color-index: 0; }
                    if card.participant-count > 1: UserAvatar { initials: ""; color-index: 1; }
                    if card.participant-count > 2: UserAvatar { initials: ""; color-index: 2; }
                }

                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.timestamp;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                }

                if card.game-name != "": Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: "·";
                    font-size: 11px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                if card.game-name != "": Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.game-name;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Standard clip card (1x)
component ClipCard inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    in property <float> progress: 0.0;
    in property <string> position-text: "";
    in property <string> duration-text: "";
    in property <int> clip-duration-ms: 0;
    callback play-clicked(string);
    callback seek-ms(int);

    // Red is state. An unread clip wears it, a read one is grey (frame C).
    property <color> tone: card.is-new ? Theme.clip-amber : Theme.text-sub;

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        fill: card.is-new ? Theme.clip-amber :
                  is-playing ? Theme.clip-amber :
                  clip-hover.has-hover ? Theme.graphic-med : Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        inset: Theme.keyline;
        fill: clip-hover.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    }


    // Same ordering rule as HeroClipCard: content touches must win.
    clip-hover := TouchArea {
        accessible-role: button;
        accessible-label: card.title != "" ? card.title : card.actor-name + " clipped that";
        mouse-cursor: pointer;
        clicked => { play-clicked(card.clip-path); }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 12px;
        spacing: 8px;

        // Header
        Rectangle {
            height: 16px;
            vertical-stretch: 0;

            HorizontalLayout {
                if card.is-new: NewBadge {
                    horizontal-stretch: 0;
                }
                if card.is-new: Rectangle { width: 6px; horizontal-stretch: 0; }

                if !is-playing: HorizontalLayout {
                    spacing: 5px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: HorizontalLayout forces y:0 on children —
                    // center via the cross axis instead of per-child y.
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../icons/scissors.svg");
                        colorize: root.tone;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: "VOICE CLIP";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: root.tone;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                if is-playing: HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: y is silently forced to 0 in layouts — use
                    // the cross axis to center the icon with its label.
                    cross-axis-alignment: center;

                    if !is-paused: Image {
                        source: @image-url("../icons/speaker.svg");
                        colorize: root.tone;
                        width: 10px;
                        height: 10px;
                    }

                    if is-paused: Image {
                        source: @image-url("../icons/pause.svg");
                        colorize: root.tone;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        font-family: Theme.font-label;
                        text: is-paused ? "PAUSED" : "PLAYING";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: root.tone;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    letter-spacing: Theme.track-label;
                    font-weight: Theme.weight-label;
                    text: is-playing ? position-text + " / " + duration-text : card.duration;
                    font-family: Theme.font-label;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

        }

        // Wave band with corner play ring (absorbs vertical slack)
        Rectangle {
            vertical-stretch: 1;
            min-height: 38px;

            DotWaveform {
                width: parent.width;
                height: parent.height;
                peaks: card.waveform;
                progress: root.progress;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                tone: root.tone;
                rows: 9;
                dot-size: 2px;
                row-pitch: 4px;
                duration-ms: root.is-playing ? root.clip-duration-ms : card.duration-ms;
                seek-ms(m) => { root.seek-ms(m); }
                play-at-ms(m) => {
                    root.play-clicked(card.clip-path);
                    root.seek-ms(m);
                }
            }

            ClipPlayRing {
                small: true;
                tone: root.tone;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                x: parent.width - self.width - 4px;
                y: 4px;
                ring-clicked => { root.play-clicked(card.clip-path); }
            }
        }

        // Body pinned at the bottom — title + meta, no dead gap
        VerticalLayout {
            spacing: 4px;
            vertical-stretch: 0;

            Text {
                font-family: Theme.font-display;
                text: card.title != "" ? card.title : card.actor-name + " clipped that";
                font-size: 13px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
                overflow: elide;
            }

            // Who was in the clip, as octagons and a count (frame C).
            if card.participant-count > 0: HorizontalLayout {
                height: 20px;
                spacing: 8px;
                cross-axis-alignment: center;
                HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    UserAvatar { initials: card.part0-initials; avatar: card.part0-avatar; has-avatar: card.part0-has-avatar; color-index: 1; size: 20px; }
                    if card.participant-count > 1: UserAvatar { initials: card.part1-initials; avatar: card.part1-avatar; has-avatar: card.part1-has-avatar; color-index: 0; size: 20px; }
                    if card.participant-count > 2: UserAvatar { initials: card.part2-initials; avatar: card.part2-avatar; has-avatar: card.part2-has-avatar; color-index: 2; size: 20px; }
                }
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.participant-count + " participants";
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                }
            }

            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.timestamp + (card.game-name != "" ? " · " + card.game-name : "");
                font-size: 11px;
                color: Theme.text-sub;
            }
        }
    }
}

/// The recap that is open full screen. A card sets it, main.slint draws it.
/// A global, so the card does not pass a callback up through every feed slot.
export global RecapView {
    in-out property <bool> open: false;
    in-out property <FeedCardData> card;
}

component RecapHead inherits Rectangle {
    in property <FeedCardData> card;
    in property <float> count: 1;

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        HorizontalLayout {
            height: 16px;
            Text {
                font-family: Theme.font-label;
                text: "WEEKLY RECAP";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: Theme.text-dim;
                letter-spacing: Theme.track-label;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 6px; }

        // "Week 4" once the server counts the crew's weeks. Until then the
        // card says what it is.
        Text {
            font-family: Theme.font-display;
            text: card.recap-week != "" ? card.recap-week : "This week";
            font-size: 28px;
            font-weight: Theme.weight-display-bold;
            letter-spacing: -0.84px;
            color: Theme.text-primary;
        }

        Rectangle { height: 10px; }

        Rectangle { height: 1px; background: Theme.card-border; }

        Rectangle { height: 10px; }

        // The numbers of the week, two by two (mockup .rc-nums).
        VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    RecapDur { minutes: Math.round(card.recap-hangout-min * root.count); }
                    RecapKicker { text: "HANGOUT"; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: "\{Math.round(card.recap-clips * root.count)}"; font-family: Theme.font-display; font-weight: Theme.weight-display-bold; font-size: 24px; letter-spacing: -0.5px; color: Theme.text-primary; }
                    RecapKicker { text: "CLIPS"; }
                }
            }

            if card.recap-longest-min > 0 || card.game-name != "": HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    if card.recap-longest-min > 0: RecapDur { minutes: Math.round(card.recap-longest-min * root.count); }
                    if card.recap-longest-min > 0: RecapKicker { text: "LONGEST"; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    if card.game-name != "": HorizontalLayout {
                        height: 29px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        GameArt {
                            game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index;
                            icon: card.game-icon; has-icon: card.game-has-icon;
                            capsule: card.game-capsule; has-capsule: card.game-has-capsule;
                            size: 29px; art-width: 52px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: card.game-name;
                            font-family: Theme.font-display;
                            font-weight: Theme.weight-display;
                            font-size: 12px;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                    if card.game-name != "": RecapKicker { text: "TOP GAME"; }
                }
            }
        }

        Rectangle { height: 10px; }
    }
}

/// Most active and Most clipped, one line each: the label, an octagon, the name
/// and the value at the right (mockup .pm).
component RecapPeople inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;
    height: col.preferred-height;

    col := VerticalLayout {
        spacing: 0px;
        if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
        if root.rule: Rectangle { height: 8px; }

        if card.recap-active.name != "": HorizontalLayout {
            height: 24px;
            spacing: 8px;
            Text { width: 78px; text: "MOST ACTIVE"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 8.5px; letter-spacing: 1.36px; color: Theme.text-dim; vertical-alignment: center; }
            UserAvatar { size: 20px; initials: card.recap-active.initials; color-index: card.recap-active.hue; avatar: card.recap-active.avatar; has-avatar: card.recap-active.has-avatar; }
            Text { horizontal-stretch: 1; text: card.recap-active.name; overflow: elide; font-family: Theme.font-display; font-weight: Theme.weight-display; font-size: 13px; color: Theme.text-primary; vertical-alignment: center; }
            Text { text: SealedFmt.span(card.recap-active.count); font-family: Theme.font-display; font-weight: Theme.weight-display; font-size: 13px; color: Theme.text-body; vertical-alignment: center; }
        }
        if card.recap-active.name != "" && card.recap-clipped.name != "": Rectangle { height: 2px; }
        if card.recap-clipped.name != "": HorizontalLayout {
            height: 24px;
            spacing: 8px;
            Text { width: 78px; text: "MOST CLIPPED"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 8.5px; letter-spacing: 1.36px; color: Theme.text-dim; vertical-alignment: center; }
            UserAvatar { size: 20px; initials: card.recap-clipped.initials; color-index: card.recap-clipped.hue; avatar: card.recap-clipped.avatar; has-avatar: card.recap-clipped.has-avatar; }
            Text { horizontal-stretch: 1; text: card.recap-clipped.name; overflow: elide; font-family: Theme.font-display; font-weight: Theme.weight-display; font-size: 13px; color: Theme.text-primary; vertical-alignment: center; }
            Text { text: "\{card.recap-clipped.count}"; font-family: Theme.font-display; font-weight: Theme.weight-display; font-size: 13px; color: Theme.text-body; vertical-alignment: center; }
            Text { text: card.recap-clipped.count == 1 ? "clip" : "clips"; font-family: Theme.font-body; font-weight: Theme.weight-sentence; font-size: 11px; color: Theme.text-dim; vertical-alignment: center; }
        }
        Rectangle { height: 10px; }
    }
}

/// Games played: four small art tiles with the hours under each (mockup .gp).
/// The opened recap lists every game.
component RecapGamesStrip inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;
    /// Tiles in a row.
    property <int> tiles: 4;
    property <length> gap: 8px;
    // Tiles take the width of the section, four in a row, in the 460 by 215
    // proportion of a Steam header.
    property <length> tile-w: (root.width - (root.tiles - 1) * root.gap) / root.tiles;
    property <length> tile-h: root.tile-w * 215 / 460;
    height: col.preferred-height;

    col := VerticalLayout {
        spacing: 0px;
        if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
        if root.rule: Rectangle { height: 8px; }

        HorizontalLayout {
            height: 16px;
            Text {
                horizontal-stretch: 1;
                font-family: Theme.font-label;
                text: "GAMES PLAYED";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: Theme.text-dim;
                letter-spacing: Theme.track-label;
                vertical-alignment: center;
            }
            Text {
                text: SealedFmt.span(card.recap-games-min);
                font-family: Theme.font-label;
                font-size: 9px;
                font-weight: Theme.weight-label;
                letter-spacing: 1.2px;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 6px; }

        HorizontalLayout {
            spacing: root.gap;
            alignment: start;
            for g[i] in card.recap-games: Rectangle {
                width: i < root.tiles ? root.tile-w : 0px;
                height: i < root.tiles ? root.tile-h + 4px + 11px : 0px;
                clip: true;
                VerticalLayout {
                    spacing: 4px;
                    GameArt {
                        game-id: g.game-id; monogram: g.monogram; hue-index: g.hue-index;
                        icon: g.icon; has-icon: g.has-icon;
                        capsule: g.capsule; has-capsule: g.has-capsule;
                        size: root.tile-h; art-width: root.tile-w; art-height: root.tile-h;
                    }
                    Text {
                        height: 11px;
                        text: SealedFmt.span(g.minutes).to-uppercase();
                        font-family: Theme.font-label;
                        font-weight: Theme.weight-label;
                        font-size: 8.5px;
                        letter-spacing: 1.2px;
                        color: Theme.text-dim;
                        overflow: elide;
                    }
                }
            }
        }
        Rectangle { height: 10px; }
    }
}

        // MVP section with avatars
component RecapMvp inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;

            VerticalLayout {
                spacing: 0px;

                if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
                if root.rule: Rectangle { height: 8px; }

                Text {
                    font-family: Theme.font-label;
                    text: "MVP";
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    color: Theme.skel-text;
                    letter-spacing: Theme.track-label;
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 4px;

                    if card.mvp-count >= 1: HorizontalLayout {
                        spacing: 8px;
                        height: 22px;

                        UserAvatar { initials: card.mvp0-initials; color-index: 0; avatar: card.mvp0-avatar; has-avatar: card.mvp0-has-avatar; }
                        Text {
                            font-family: Theme.font-body;
                            text: card.mvp0-name;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: card.mvp0-stat;
                            font-size: 11px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }

                    // Single MVP keeps the recap card compact (spec 19 polish);
                    // mvp1/mvp2 data still arrives but is intentionally not shown.
                }
            }
        }

        // Belts moved (head2head): one row for each title that changed hands.
        // The previous holder is dimmed, the new holder wears the hue.
component RecapMoved inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;
    /// Rows of Belts moved the card shows. The tall card shows two and then
    /// "+N more".
    in property <int> max-belt-rows: 3;
            VerticalLayout {
                spacing: 0px;

                if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
                if root.rule: Rectangle { height: 8px; }

                HorizontalLayout {
                    height: 16px;
                    Text {
                        font-family: Theme.font-label;
                        text: "BELTS MOVED";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.text-dim;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 0px;
                    // A row past the limit has no height. The 6px gap sits
                    // inside the row, so a hidden row leaves no gap either.
                    for b[i] in card.belts-moved: Rectangle {
                      height: i < root.max-belt-rows ? 42px : 0px;
                      clip: true;
                      HorizontalLayout {
                        spacing: 6px;
                        padding-bottom: 6px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 28px;
                            opacity: 0.4;
                            UserAvatar { size: 28px; initials: b.prev-initials; color-index: b.prev-hue; avatar: b.prev-avatar; has-avatar: b.prev-has-avatar; }
                        }
                        // Sealed: the new holder is a muted octagon with "?" until the
                        // belt is open.
                        UserAvatar {
                            size: 28px;
                            muted: SealedUi.hides(b.belt);
                            initials: SealedUi.hides(b.belt) ? "?" : b.holder-initials;
                            color-index: b.holder-hue;
                            avatar: b.holder-avatar;
                            has-avatar: !SealedUi.hides(b.belt) && b.holder-has-avatar;
                        }
                        BeltSlot {
                            horizontal-stretch: 1;
                            height: 34px;
                            tight: true;
                            belt: b.belt;
                            slot-id: "recap-" + i;
                            TitleChip {
                                width: parent.width;
                                compact: true;
                                dense: true;
                                hue: H2hHue.of(b.holder-hue);
                                icon: b.icon; title: b.title; value: b.value; unit: b.unit;
                            }
                        }
                      }
                    }
                }
                if card.belts-moved.length > root.max-belt-rows: Text {
                    text: "+\{card.belts-moved.length - root.max-belt-rows} MORE";
                    font-family: Theme.font-label;
                    font-weight: Theme.weight-label;
                    font-size: 9px;
                    letter-spacing: 1.44px;
                    color: Theme.text-dim;
                }
                Rectangle { height: 10px; }
            }
        }

        // Belts held: who holds how many titles right now, most first.
component RecapHeld inherits Rectangle {
    in property <FeedCardData> card;
    in property <float> count: 1;
    in property <bool> rule: true;
    /// Members shown: as many as fit the column, each one an octagon and a
    /// count. The card works it out from its own width, not from the column,
    /// which would loop with the layout.
    in property <int> max-held: 5;
            VerticalLayout {
                spacing: 0px;

                if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
                if root.rule: Rectangle { height: 8px; }

                HorizontalLayout {
                    height: 16px;
                    Text {
                        font-family: Theme.font-label;
                        text: "BELTS HELD";
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        color: Theme.text-dim;
                        letter-spacing: Theme.track-label;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 6px; }

                // One column for each member, an octagon over the count over
                // "BELTS" (mockup .held). As many as fit, five at most.
                HorizontalLayout {
                    spacing: 0px;
                    for h[i] in card.belts-held: Rectangle {
                        horizontal-stretch: i < root.max-held ? 1 : 0;
                        max-width: i < root.max-held ? 10000px : 0px;
                        min-width: 0px;
                        clip: true;
                        VerticalLayout {
                            alignment: start;
                            spacing: 3px;
                            HorizontalLayout {
                                alignment: center;
                                UserAvatar { size: 28px; initials: h.initials; color-index: h.hue; avatar: h.avatar; has-avatar: h.has-avatar; }
                            }
                            Text {
                                text: root.count >= 1 ? h.count : Math.round(h.count * Ease.span(root.count * 1s, 0.2s + i * 0.1s, 0.6s + i * 0.1s));
                                font-family: Theme.font-display;
                                font-size: 22px;
                                font-weight: Theme.weight-display-bold;
                                color: Theme.text-value;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "BELTS";
                                font-family: Theme.font-label;
                                font-weight: Theme.weight-label;
                                font-size: 8px;
                                letter-spacing: 1.6px;
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                Rectangle { height: 10px; }
            }
        }

        // This week in games (spec 19)
component RecapGames inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> rule: true;
            VerticalLayout {
                spacing: 0px;

                if root.rule: Rectangle { height: 1px; background: Theme.card-border; }
                if root.rule: Rectangle { height: 8px; }

                Text {
                    font-family: Theme.font-label;
                    text: "THIS WEEK IN GAMES";
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    color: Theme.skel-text;
                    letter-spacing: Theme.track-label;
                }

                if card.games-summary != "": Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.games-summary;
                    font-size: 11px;
                    color: Theme.text-sub;
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 4px;
                    for row in card.leaderboard: HorizontalLayout {
                        spacing: 8px;
                        height: 22px;
                        UserAvatar { initials: row.initials; color-index: row.color-index; avatar: row.avatar; has-avatar: row.has-avatar; }
                        Text {
                            font-family: Theme.font-body;
                            text: row.name;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: row.record;
                            font-size: 11px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }
                }

                if card.awards.length > 0: Rectangle { height: 8px; }

                VerticalLayout {
                    spacing: 4px;
                    for a in card.awards: HorizontalLayout {
                        spacing: 8px;
                        height: 18px;
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: a.title;
                            font-size: 11px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-family: Theme.font-body;
                            text: a.name;
                            font-size: 11px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Text {
                            font-weight: Theme.weight-sentence;
                            font-family: Theme.font-body;
                            text: a.detail;
                            font-size: 10px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

/// The control of a recap card: opens the recap full screen (`RecapOpened`).
component RecapFoot inherits Rectangle {
    in property <FeedCardData> card;
    property <length> button-w: see-label.preferred-width + 24px;
    preferred-width: root.button-w;
    preferred-height: 40px;
    background: transparent;

    Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: root.button-w;
        height: 28px;
        accessible-role: button;
        accessible-label: "See the week";

        CutButtonShape {
            width: parent.width; height: parent.height;
            n: 6px;
            fill: see-ta.has-hover ? Theme.action : Theme.action-line;
        }
        CutButtonShape {
            width: parent.width; height: parent.height;
            n: 6px; inset: Theme.keyline;
            fill: Theme.card-bg;
        }
        see-label := Text {
            width: parent.width;
            height: parent.height;
            text: "SEE THE WEEK";
            font-family: Theme.font-label;
            font-size: 9px;
            font-weight: Theme.weight-label;
            letter-spacing: 1.44px;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        see-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                RecapView.card = root.card;
                RecapView.open = true;
            }
        }
    }
}

// Weekly recap card. Two shapes, never one cell: the tall card of the side
// column (one column, two rows) and the wide card (two columns, one row).
component RecapCard inherits Rectangle {
    in property <FeedCardData> card;
    /// 0 to 1 while the numbers count up in the centre view. In the feed it is 1
    /// and the card shows the text of `card`.
    in property <float> count: 1;
    /// Two columns wide (the wide slot): the sections stand side by side.
    /// One column wide (the tall slot): they stack.
    // One grid row high and two columns wide. A recap that is two rows high (the
    // hero, a tall slot) stacks its sections even when it is wide.
    property <bool> wide: root.width >= 560px && root.height < 340px;
    /// A recap with belts needs three grid rows. A slot of two rows (a lone recap
    /// with no head2head beside it) drops Belts held and the games, so the
    /// control stays on the card.
    property <bool> has-belts: card.belts-moved.length > 0 || card.belts-held.length > 0;
    property <bool> short: root.height < 600px;
    /// Members of Belts held that fit one octagon column of 56 px.
    property <int> max-held: Math.min(5, Math.max(1, Math.floor((root.wide ? (root.width - 28px - 34px) * 0.4 : root.width - 32px) / 56px)));
    clip: true;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }


    // The tall card (mockup weekly-recap-card, frame 1): the label and the
    // week, the numbers two by two, the two members, the belts, the games and
    // the control in a row of its own at the foot.
    if !root.wide: VerticalLayout {
        padding: 14px;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 16px;
        spacing: 0px;
        // Top-pack: each section uses its natural height and the slack
        // collects between the last section and the foot.
        alignment: start;

        RecapHead { card: root.card; count: root.count; }
        if card.recap-active.name != "" || card.recap-clipped.name != "": RecapPeople { card: root.card; }
        if card.belts-moved.length > 0: RecapMoved { card: root.card; max-belt-rows: 2; }
        if card.belts-held.length > 0 && !root.short: RecapHeld { card: root.card; count: root.count; max-held: root.max-held; }
        if card.recap-games.length > 0 && (!root.short || !root.has-belts): RecapGamesStrip { card: root.card; }
        Rectangle { vertical-stretch: 1; }
        RecapFoot { card: root.card; }
    }

    // The wide card: the week, the belts that moved and who holds them, side
    // by side with a keyline between. The control stays at the foot.
    if root.wide: HorizontalLayout {
        padding: 14px;
        padding-top: 16px;
        spacing: 16px;

        RecapHead { horizontal-stretch: 3; card: root.card; count: root.count; }
        Rectangle { width: Theme.keyline; background: Theme.card-border; }
        VerticalLayout {
            horizontal-stretch: 3;
            alignment: start;
            if card.belts-moved.length > 0: RecapMoved { rule: false; card: root.card; }
            if card.belts-moved.length == 0 && card.belts-held.length > 0: RecapHeld { rule: false; card: root.card; count: root.count; max-held: root.max-held; }
            if card.belts-moved.length == 0 && card.belts-held.length == 0 && (card.leaderboard.length > 0 || card.awards.length > 0): RecapGames { rule: false; card: root.card; }
        }
        Rectangle { width: Theme.keyline; background: Theme.card-border; }
        VerticalLayout {
            horizontal-stretch: 4;
            alignment: start;
            if card.belts-moved.length > 0 && card.belts-held.length > 0: RecapHeld { rule: false; card: root.card; count: root.count; max-held: root.max-held; }
            if card.belts-moved.length == 0 && card.belts-held.length == 0 && card.mvp-count > 0: RecapMvp { rule: false; card: root.card; }
        }
    }

    // The wide card keeps the control at the foot, at the right.
    if root.wide: RecapFoot {
        x: parent.width - self.width - 14px;
        y: parent.height - self.height - 12px;
        width: self.preferred-width;
        height: 28px;
        card: root.card;
    }
}

// Daily recap: a smaller RecapCard for one day (CLIPS 7.1). Same chrome, same
// type. The label, the day with the members who took part, a two by two of
// numbers (hangout, clips, sessions, top game) and up to two belts that moved
// that day, each with the holder.
component DailyRecapCard inherits Rectangle {
    in property <FeedCardData> card;
    /// Octagons that fit beside the day word, 4 px apart.
    property <int> max-people: Math.max(0, Math.min(6, Math.floor((root.width - 28px - day-word.preferred-width - 12px) / 26px)));

    clip: true;
    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "bl";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        padding: 14px;
        padding-top: 16px;
        spacing: 0px;
        alignment: start;

        Text {
            height: 16px;
            font-family: Theme.font-label;
            text: "DAILY RECAP";
            font-size: 10px;
            font-weight: Theme.weight-label;
            color: Theme.text-dim;
            letter-spacing: Theme.track-label;
            vertical-alignment: center;
        }

        Rectangle { height: 2px; }

        // The day, and the members who took part.
        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            cross-axis-alignment: center;
            day-word := Text {
                font-family: Theme.font-display;
                text: card.day-label;
                font-size: 22px;
                font-weight: Theme.weight-display-bold;
                letter-spacing: -0.66px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: 4px;
                for p[i] in card.day-members: Rectangle {
                    visible: i < root.max-people;
                    width: i < root.max-people ? 22px : 0px;
                    height: 22px;
                    UserAvatar { size: 22px; initials: p.initials; color-index: p.hue-index; avatar: p.avatar; has-avatar: p.has-avatar; }
                }
            }
        }

        Rectangle { height: 8px; }
        Rectangle { height: 1px; background: Theme.card-border; }
        Rectangle { height: 8px; }

        // The numbers of the day, two by two (the weekly recap's .rc-nums).
        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: card.title; font-family: Theme.font-display; font-weight: Theme.weight-display-bold; font-size: 22px; letter-spacing: -0.5px; color: Theme.text-primary; }
                    Text { text: "HANGOUT"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 9px; letter-spacing: 1.8px; color: Theme.text-dim; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: card.clip-count; font-family: Theme.font-display; font-weight: Theme.weight-display-bold; font-size: 22px; letter-spacing: -0.5px; color: Theme.text-primary; }
                    Text { text: "CLIPS"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 9px; letter-spacing: 1.8px; color: Theme.text-dim; }
                }
            }

            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: card.day-sessions; font-family: Theme.font-display; font-weight: Theme.weight-display-bold; font-size: 22px; letter-spacing: -0.5px; color: Theme.text-primary; }
                    Text { text: "SESSIONS"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 9px; letter-spacing: 1.8px; color: Theme.text-dim; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    if card.game-name != "": HorizontalLayout {
                        height: 29px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        GameArt {
                            game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index;
                            icon: card.game-icon; has-icon: card.game-has-icon;
                            capsule: card.game-capsule; has-capsule: card.game-has-capsule;
                            size: 29px; art-width: 52px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: card.game-name;
                            font-family: Theme.font-display;
                            font-weight: Theme.weight-display;
                            font-size: 12px;
                            color: Theme.text-primary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    if card.game-name != "": Text { text: "TOP GAME"; font-family: Theme.font-label; font-weight: Theme.weight-label; font-size: 9px; letter-spacing: 1.8px; color: Theme.text-dim; }
                }
            }
        }

        // Belts that moved that day: the holder and the title, side by side.
        if card.belts-moved.length > 0: Rectangle { height: 10px; }
        if card.belts-moved.length > 0: HorizontalLayout {
            spacing: 8px;
            height: 34px;
            for b[i] in card.belts-moved: HorizontalLayout {
                visible: i < 2;
                horizontal-stretch: i < 2 ? 1 : 0;
                max-width: i < 2 ? 10000px : 0px;
                spacing: 4px;
                cross-axis-alignment: center;
                UserAvatar {
                    size: 22px;
                    muted: SealedUi.hides(b.belt);
                    initials: SealedUi.hides(b.belt) ? "?" : b.holder-initials;
                    color-index: b.holder-hue;
                    avatar: b.holder-avatar;
                    has-avatar: !SealedUi.hides(b.belt) && b.holder-has-avatar;
                }
                BeltSlot {
                    horizontal-stretch: 1;
                    height: 34px;
                    tight: true;
                    belt: b.belt;
                    slot-id: "daily-" + i;
                    TitleChip {
                        width: parent.width;
                        compact: true;
                        dense: true;
                        hue: H2hHue.of(b.holder-hue);
                        icon: b.icon; title: b.title; value: b.value; unit: b.unit;
                    }
                }
            }
        }
    }
}

// Session card
// Voice/stream session card, redesigned per designs/feed/
// session-cards-redesign.html (Option B: game/channel-first). Typed header,
// real avatars, humanized duration, peak stat — a card must answer "who did
// what, for how long" at a glance.
component SessionCard inherits Rectangle {
    in property <FeedCardData> card;

    property <bool> is-stream: card.session-kind == "stream";
    property <color> kind-color: is-stream ? Theme.accent : Theme.id-blue;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }


    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        // Typed header: colored dot + STREAM / VOICE.
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 6px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: kind-color;
                    y: (parent.height - self.height) / 2;
                }
            }
            Text {
                font-family: Theme.font-label;
                text: is-stream ? "STREAM" : card.session-kind == "voice" ? "VOICE" : "SESSION";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: kind-color;
                letter-spacing: Theme.track-label;
            }
        }

        // ── STREAM: game art leads, streamer avatar badged on its corner ──
        if is-stream: HorizontalLayout {
            spacing: 10px;
            height: 44px;

            Rectangle {
                width: 40px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    y: (parent.height - self.height) / 2;

                    GameArt { game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index; icon: card.game-icon; has-icon: card.game-has-icon; capsule: card.game-capsule; has-capsule: card.game-has-capsule; size: 40px; }
                    if card.actor-has-avatar || card.actor-initials != "": UserAvatar {
                        initials: card.actor-initials;
                        avatar: card.actor-avatar;
                        has-avatar: card.actor-has-avatar;
                        x: parent.width - self.width + 4px;
                        y: parent.height - self.height + 4px;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    font-family: Theme.font-display;
                    text: card.game-name != "" ? card.game-name : card.title;
                    font-size: 13px;
                    font-weight: Theme.weight-display;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    text: card.actor-name != "" ? "by " + card.actor-name
                            + (card.duration-human != "" ? " · " + card.duration-human : "")
                        : card.duration-human;
                    font-size: 11px;
                    color: Theme.text-sub;
                    overflow: elide;
                }
            }
        }

        if is-stream && card.peak-count > 0: Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: "\{card.peak-count} watched at peak";
            font-size: 11px;
            color: Theme.text-sub;
        }

        // ── VOICE: the people are the content, so they get the space ──
        // Channel + meta as a compact heading, then a large avatar cluster
        // that fills the card instead of an empty stretch gap.
        if !is-stream: VerticalLayout {
            spacing: 2px;
            Text {
                font-family: Theme.font-display;
                text: card.channel-name != "" ? card.channel-name : card.title;
                font-size: 13px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.duration-human
                    + (card.peak-count > 0 ? " · \{card.peak-count} in call" : "");
                font-size: 11px;
                color: Theme.text-sub;
                overflow: elide;
            }
        }

        if !is-stream: Rectangle { height: 6px; }

        if !is-stream && card.participant-count > 0: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            height: 40px;

            UserAvatar {
                initials: card.part0-initials;
                avatar: card.part0-avatar;
                has-avatar: card.part0-has-avatar;
                color-index: 0;
                size: 40px;
            }
            if card.participant-count > 1: UserAvatar {
                initials: card.part1-initials;
                avatar: card.part1-avatar;
                has-avatar: card.part1-has-avatar;
                color-index: 1;
                size: 40px;
            }
            if card.participant-count > 2: UserAvatar {
                initials: card.part2-initials;
                avatar: card.part2-avatar;
                has-avatar: card.part2-has-avatar;
                color-index: 2;
                size: 40px;
            }
            // Overflow chip: the roster is wider than the three avatar slots.
            if card.participant-count > 3: AvatarOverflow {
                count: card.participant-count - 3;
                size: 40px;
            }
        }

        if !is-stream && card.participants-line != "": Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: card.participants-line;
            font-size: 11px;
            color: Theme.text-sub;
            overflow: elide;
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: card.timestamp + (card.subtitle != "" ? " · " + card.subtitle : "");
            font-size: 11px;
            color: Theme.skel-text;
        }
    }
}

// Telemetry-backed W/L block for notable game sessions (spec 19 B2).
component GameSessionRecordPanel inherits VerticalLayout {
    in property <FeedCardData> card;
    in property <color> record-color;

    spacing: 0px;

    // Headline record. A win reads white and a loss reads red, the same
    // rule the you-strip pips follow. Colouring the whole record by the
    // streak painted the wins red on any session that ended down.
    HorizontalLayout {
        alignment: start;
        spacing: 0px;

        Text {
            font-family: Theme.font-display;
            text: card.game-wins + "W";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-primary;
        }
        Text {
            font-family: Theme.font-display;
            text: "–";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-tertiary;
        }
        Text {
            font-family: Theme.font-display;
            text: card.game-losses + "L";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.live;
        }
        if card.game-draws > 0: Text {
            font-family: Theme.font-display;
            text: "–";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-tertiary;
        }
        if card.game-draws > 0: Text {
            font-family: Theme.font-display;
            text: card.game-draws + "D";
            font-size: 30px;
            font-weight: Theme.weight-display-bold;
            color: Theme.text-secondary;
        }
    }
    Text {
        font-weight: Theme.weight-sentence;
        font-family: Theme.font-body;
        text: "this session";
        font-size: 11px;
        color: Theme.text-sub;
    }

    Rectangle { height: 12px; }
    Rectangle { height: 1px; background: Theme.card-border; }
    Rectangle { height: 10px; }

    // Stat tiles: streak · win rate · matches
    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                font-family: Theme.font-display;
                text: card.game-streak-text;
                font-size: 16px;
                font-weight: Theme.weight-display-bold;
                color: card.game-streak-positive ? Theme.text-primary : Theme.live;
            }
            Text { font-weight: Theme.weight-sentence; font-family: Theme.font-body; text: "streak"; font-size: 10px; color: Theme.text-sub; }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                font-family: Theme.font-display;
                text: card.game-winrate;
                font-size: 16px;
                font-weight: Theme.weight-display-bold;
                color: Theme.text-primary;
            }
            Text { font-weight: Theme.weight-sentence; font-family: Theme.font-body; text: "win rate"; font-size: 10px; color: Theme.text-sub; }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                font-family: Theme.font-display;
                text: "\{card.game-matches}";
                font-size: 16px;
                font-weight: Theme.weight-display-bold;
                color: Theme.text-primary;
            }
            Text { font-weight: Theme.weight-sentence; font-family: Theme.font-body; text: "matches"; font-size: 10px; color: Theme.text-sub; }
        }
    }
}

// Zero-telemetry session: icon + "X played Y" + duration, no empty stat slots.
component GameSessionCompactBody inherits VerticalLayout {
    in property <FeedCardData> card;
    in property <color> game-accent;
    in property <bool> quiet: false;

    spacing: quiet ? 6px : 8px;
    alignment: start;

    HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;

        GameArt { game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index; icon: card.game-icon; has-icon: card.game-has-icon; capsule: card.game-capsule; has-capsule: card.game-has-capsule; size: quiet ? 32px : 36px; }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: start;

            Text {
                font-family: Theme.font-display;
                text: card.title != "" ? card.title : card.game-name;
                font-size: quiet ? 12px : 13px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
                overflow: elide;
            }
            if card.duration-human != "": Text {
                font-family: Theme.font-display;
                text: card.duration-human;
                font-size: quiet ? 16px : 20px;
                font-weight: Theme.weight-display-bold;
                color: Theme.text-primary;
            }
        }
    }

    if card.participant-count > 1: HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;
        height: 20px;

        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            horizontal-stretch: 0;
            UserAvatar {
                initials: card.part0-initials != "" ? card.part0-initials : card.actor-initials;
                avatar: card.part0-has-avatar ? card.part0-avatar : card.actor-avatar;
                has-avatar: card.part0-has-avatar || card.actor-has-avatar;
                color-index: 0;
                size: 20px;
            }
            if card.participant-count > 1: UserAvatar {
                initials: card.part1-initials;
                avatar: card.part1-avatar;
                has-avatar: card.part1-has-avatar;
                color-index: 1;
                size: 20px;
            }
            if card.participant-count > 2: UserAvatar {
                initials: card.part2-initials;
                avatar: card.part2-avatar;
                has-avatar: card.part2-has-avatar;
                color-index: 2;
                size: 20px;
            }
        }

        if card.participants-line != "": Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: card.participants-line;
            font-size: 11px;
            color: Theme.text-sub;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    Rectangle { vertical-stretch: 1; }

    Text {
        font-weight: Theme.weight-sentence;
        font-family: Theme.font-body;
        text: card.timestamp;
        font-size: 11px;
        color: Theme.skel-text;
    }
}

// Rich game-session card for notable sessions (spec 19 B2); compact T0 variant
// when the session has no W/L record (GAME-SURFACING C1).
component GameSessionCard inherits Rectangle {
    in property <FeedCardData> card;

    property <bool> has-record: card.game-matches > 0;
    property <bool> is-quiet: card.role == "quiet" || card.size == "sm";
    property <color> game-accent: card.game-has-color ? card.game-color : Theme.accent;
    property <color> record-color: card.game-streak-positive ? Theme.text-primary : Theme.live;

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }


    if !has-record: VerticalLayout {
        padding: is-quiet ? 10px : 12px;
        spacing: 0px;
        alignment: start;

        GameSessionCompactBody {
            card: root.card;
            game-accent: root.game-accent;
            quiet: is-quiet;
        }
    }

    if has-record: VerticalLayout {
        padding: 14px;
        spacing: 0px;

        // Header: game badge + name + actor / time
        HorizontalLayout {
            spacing: 10px;
            height: 40px;

            VerticalLayout {
                alignment: center;
                GameArt { game-id: card.game-id; monogram: card.game-monogram; hue-index: card.game-hue-index; icon: card.game-icon; has-icon: card.game-has-icon; capsule: card.game-capsule; has-capsule: card.game-has-capsule; size: 40px; }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    font-family: Theme.font-display;
                    text: card.game-name != "" ? card.game-name : "Game session";
                    font-size: 14px;
                    font-weight: Theme.weight-display;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    // The time only (mockup frames B to F). Who played is the footer.
                    text: card.timestamp;
                    font-size: 11px;
                    color: Theme.text-sub;
                    overflow: elide;
                }
            }

            // Server-verified result (Riot post-match API) — spec 18 §9.
            if card.game-verified: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: verified-label.preferred-width + 12px;
                    height: 18px;
                    border-radius: 4px;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.graphic-med;
                    verified-label := Text {
                        text: "VERIFIED";
                        font-family: Theme.font-label;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { height: 14px; }

        GameSessionRecordPanel {
            card: root.card;
            record-color: record-color;
        }

        Rectangle { vertical-stretch: 1; }

        // Footer: the octagons of who played, "Bob, solo" when one person did,
        // and the duration at the right (mockup frames B to F).
        HorizontalLayout {
            height: 20px;
            spacing: 6px;
            cross-axis-alignment: center;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                horizontal-stretch: 0;
                cross-axis-alignment: center;
                UserAvatar {
                    initials: card.part0-initials != "" ? card.part0-initials : card.actor-initials;
                    avatar: card.part0-has-avatar ? card.part0-avatar : card.actor-avatar;
                    has-avatar: card.part0-has-avatar || card.actor-has-avatar;
                    color-index: card.actor-hue-index;
                    size: 20px;
                }
                if card.participant-count > 1: UserAvatar {
                    initials: card.part1-initials;
                    avatar: card.part1-avatar;
                    has-avatar: card.part1-has-avatar;
                    color-index: 1;
                    size: 20px;
                }
                if card.participant-count > 2: UserAvatar {
                    initials: card.part2-initials;
                    avatar: card.part2-avatar;
                    has-avatar: card.part2-has-avatar;
                    color-index: 2;
                    size: 20px;
                }
            }

            if card.participant-count <= 1 && card.actor-name != "": Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.actor-name + ", solo";
                font-size: 11px;
                color: Theme.text-sub;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if card.participant-count > 1 || card.actor-name == "": Rectangle { horizontal-stretch: 1; }

            if card.duration-human != "": Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.duration-human;
                font-size: 11px;
                color: Theme.skel-text;
            }
        }
    }
}

// Recent games card (mockup frame A). One row per game: the art, the name in
// Oxanium with the hours under it, and "TRACKED" at the right when the game
// sensor knows the game. Art ladder: the runtime icon, the local Steam header,
// then a two-letter monogram in the game's hue. The art slot is 76 px wide, the
// shape of a Steam header (460 by 215), two corners cut.
component RecentGameTileCell inherits Rectangle {
    in property <RecentGameTile> tile;
    // TRACKED stands at the far right of a roomy row (frame B). In a narrow
    // row it moves to the hours line so the name keeps the whole row.
    property <bool> tracked-right: tile.tracked && root.width >= 300px;

    height: 36px;
    background: transparent;

    HorizontalLayout {
        spacing: 12px;
        cross-axis-alignment: center;

        GameArt {
            game-id: tile.game-id;
            monogram: tile.monogram;
            hue-index: tile.hue-index;
            icon: tile.game-icon;
            has-icon: tile.has-icon;
            capsule: tile.capsule;
            has-capsule: tile.has-capsule;
            size: 36px;
            art-width: 76px;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                font-family: Theme.font-display;
                font-weight: Theme.weight-display;
                text: tile.game-name;
                font-size: 13px;
                color: Theme.text-value;
                overflow: elide;
            }
            // TRACKED sits on the hours line, so the name has the whole row.
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if tile.hours != "" || tile.when != "": Text {
                    font-family: Theme.font-label;
                    font-weight: Theme.weight-label;
                    // From three PCs the line says when, not how long.
                    text: (tile.when != "" ? tile.when : tile.hours).to-uppercase();
                    font-size: 9px;
                    letter-spacing: Theme.track-label;
                    color: Theme.text-dim;
                    overflow: elide;
                }
                if tile.tracked && !root.tracked-right: Text {
                    text: "TRACKED";
                    font-family: Theme.font-label;
                    font-weight: Theme.weight-label;
                    font-size: 9px;
                    letter-spacing: Theme.track-label;
                    color: Theme.text-value;
                }
            }
        }

        // Who owns it, as small octagons at the right (frame E).
        if !root.tracked-right && tile.owners.length > 0: HorizontalLayout {
            spacing: 4px;
            alignment: end;
            cross-axis-alignment: center;
            for o in tile.owners: UserAvatar {
                initials: o.initials;
                avatar: o.avatar;
                has-avatar: o.has-avatar;
                color-index: o.hue-index;
                size: 16px;
            }
        }

        if root.tracked-right: Text {
            text: "TRACKED";
            font-family: Theme.font-label;
            font-weight: Theme.weight-label;
            font-size: 9px;
            letter-spacing: Theme.track-label;
            color: Theme.text-value;
            vertical-alignment: center;
        }
    }
}

// One poster of the recent games grid (mockup frame B2, .mrg): header art in
// the 460 by 215 shape with two corners cut, the game name in Oxanium under
// it, and the owners as small octagons under the name.
component RecentGamePoster inherits Rectangle {
    in property <RecentGameTile> tile;

    background: transparent;

    VerticalLayout {
        alignment: start;
        spacing: 0px;

        GameArt {
            game-id: tile.game-id;
            monogram: tile.monogram;
            hue-index: tile.hue-index;
            icon: tile.game-icon;
            has-icon: tile.has-icon;
            capsule: tile.capsule;
            has-capsule: tile.has-capsule;
            size: 36px;
            art-width: root.width;
            art-height: root.width * 215 / 460;
        }
        Text {
            font-family: Theme.font-display;
            font-weight: Theme.weight-display;
            text: tile.game-name;
            font-size: 12px;
            color: Theme.text-value;
            overflow: elide;
        }
        // Owners: the members who have it. Space above the name and the pips.
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            padding-top: 6px;
            for o in tile.owners: UserAvatar {
                initials: o.initials;
                avatar: o.avatar;
                has-avatar: o.has-avatar;
                color-index: o.hue-index;
                size: 16px;
            }
        }
        // When it was last played (frames C and D).
        if tile.when != "": Text {
            font-family: Theme.font-label;
            font-weight: Theme.weight-label;
            text: tile.when.to-uppercase();
            font-size: 9px;
            letter-spacing: Theme.track-label;
            color: Theme.text-dim;
            overflow: elide;
        }
    }
}

component RecentGamesCard inherits Rectangle {
    in property <FeedCardData> card;

    /// Poster grid when two or more members own games and the slot has two
    /// columns. A one-column slot, or a crew of one, keeps the list.
    property <bool> grid: root.card.recent-pc-count >= 2 && root.width >= 420px;
    property <int> grid-max: 5;
    property <length> grid-gap: 12px;
    // Three to five posters share the row: a week with fewer games gets larger
    // posters, not a gap (frame C).
    property <int> grid-n: Math.max(3, Math.min(card.recent-games.length, root.grid-max));
    property <length> poster-width: (root.width - 32px - (root.grid-n - 1) * root.grid-gap) / root.grid-n;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "tr";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "tr";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        padding: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: root.grid ? 10px : 12px;
        alignment: start;

        // Label left, the week's sessions line right ("14 sessions, 31 h this week").
        HorizontalLayout {
            height: 16px;
            spacing: 8px;
            Text {
                font-family: Theme.font-label;
                text: "RECENT GAMES";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: Theme.text-dim;
                letter-spacing: Theme.track-label;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.subtitle;
                font-size: 11px;
                color: Theme.text-dim;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if !root.grid: VerticalLayout {
            spacing: 12px;
            for tile[i] in card.recent-games: RecentGameTileCell {
                visible: i < 3;
                height: i < 3 ? 36px : 0px;
                tile: tile;
            }
        }

        // Five posters in one row, newest played first. The server sorts.
        if root.grid: HorizontalLayout {
            alignment: start;
            spacing: root.grid-gap;
            for tile[i] in card.recent-games: RecentGamePoster {
                visible: i < root.grid-max;
                width: i < root.grid-max ? root.poster-width : 0px;
                tile: tile;
            }
        }
    }
}


// The player octagons of a live card, with "+N" past the last one.
component LivePlayers inherits HorizontalLayout {
    in property <FeedCardData> card;

    height: 20px;
    spacing: 4px;
    alignment: start;
    for p in card.live.players: UserAvatar {
        initials: p.initials;
        avatar: p.avatar;
        has-avatar: p.has-avatar;
        color-index: p.hue-index;
        size: 20px;
    }
    if card.live.more-players > 0: AvatarOverflow {
        count: card.live.more-players;
        size: 20px;
    }
}

component LiveSessionName inherits Text {
    in property <FeedCardData> card;

    text: card.game-name;
    font-family: Theme.font-display;
    font-size: 13px;
    font-weight: Theme.weight-display;
    color: Theme.text-primary;
    overflow: elide;
}

component LiveSinceText inherits Text {
    in property <FeedCardData> card;

    text: card.live.since-text;
    font-weight: Theme.weight-sentence;
    font-family: Theme.font-body;
    font-size: 12px;
    color: Theme.text-sub;
}

// The red dot of a live card. Red is only this.
component LivePip inherits Rectangle {
    width: 6px;
    Rectangle {
        width: 6px;
        height: 6px;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: Theme.live;
    }
}

// Live session card: a game in progress (mockup cold-start frames 5 and 8).
// The shape of the session card: the fixed game tile at the left, then the
// name, the player octagons and "since N min". Red is only the pip of the
// label. With poster art in the wide slot the art fills the card instead.
component LiveSessionCard inherits Rectangle {
    in property <FeedCardData> card;

    // The wide slot is only given to a card with poster art. Without it the
    // card is a cell, whatever the width.
    property <bool> poster-mode: card.live.has-poster && root.width > 420px;

    background: transparent;
    border-width: 0px;
    clip: true;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    // Wide card with poster: the local Steam art keeps its colour. Chrome
    // sits on black washes, as on the stream hero card (mockup next-gen-feed,
    // stage D): the label on the top wash, the game and the players on the
    // bottom one.
    if root.poster-mode: Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;

        Image {
            source: root.card.live.poster;
            width: parent.width;
            height: parent.height;
            image-fit: cover;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(180deg,
                #00000099 0%, #00000000 26%, #00000000 40%, #000000E6 100%);
        }
        CutMask { width: parent.width; height: parent.height; n: Theme.notch; corner: "br"; fill: Theme.bg-app; }

        VerticalLayout {
            padding: 14px;
            spacing: 4px;

            HorizontalLayout {
                height: 16px;
                spacing: 6px;
                LivePip { }
                Text {
                    horizontal-stretch: 1;
                    text: "NOW PLAYING";
                    font-family: Theme.font-label;
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-label;
                    color: Theme.on-media;
                    vertical-alignment: center;
                }
            }

            Rectangle { vertical-stretch: 1; }

            LiveSessionName {
                card: root.card;
                font-size: 20px;
                color: Theme.on-media;
            }
            HorizontalLayout {
                spacing: 10px;
                height: 20px;
                LivePlayers { card: root.card; horizontal-stretch: 0; }
                Text {
                    horizontal-stretch: 1;
                    text: root.card.live.since-text;
                    font-weight: Theme.weight-sentence;
                    font-family: Theme.font-body;
                    font-size: 12px;
                    color: Theme.on-media;
                    vertical-alignment: center;
                }
            }
        }
    }

    if !root.poster-mode: VerticalLayout {
        padding: 14px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            height: 16px;
            spacing: 6px;
            LivePip { }
            Text {
                horizontal-stretch: 1;
                text: "NOW PLAYING";
                font-family: Theme.font-label;
                font-size: 10px;
                font-weight: Theme.weight-label;
                letter-spacing: Theme.track-label;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            height: 58px;

            Rectangle {
                width: 40px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    y: 0px;
                    GameArt { game-id: root.card.game-id; monogram: root.card.game-monogram; hue-index: root.card.game-hue-index; icon: root.card.game-icon; has-icon: root.card.game-has-icon; capsule: root.card.game-capsule; has-capsule: root.card.game-has-capsule; size: 40px; }
                }
            }

            VerticalLayout {
                alignment: start;
                spacing: 2px;
                horizontal-stretch: 1;
                LiveSessionName { card: root.card; }
                LivePlayers { card: root.card; }
                LiveSinceText { card: root.card; }
            }
        }

    }
}

// The dormant strip (frame F): a slim card across the top of the grid when
// nothing happened for 14 days. The label is grey and the age is at the right.
component DormantStrip inherits Rectangle {
    in property <FeedCardData> card;

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "br";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        padding: 14px;
        spacing: 6px;

        HorizontalLayout {
            height: 16px;
            Text {
                font-family: Theme.font-label;
                text: "QUIET";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: Theme.text-dim;
                letter-spacing: Theme.track-label;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: card.timestamp;
                font-size: 11px;
                color: Theme.text-dim;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        Text {
            font-weight: Theme.weight-display;
            font-family: Theme.font-display;
            text: card.title;
            font-size: 14px;
            color: Theme.text-value;
            wrap: word-wrap;
            vertical-stretch: 1;
        }
    }
}

// A member who joined in the last 24 hours. The smallest card the grid has is
// a standard cell, so this is one: the joiner's octagon large, the name in
// Oxanium, who invited and when in Barlow 300, and "Say hi", a white outline
// action that sends a greeting to the crew chat at once. Once said, the button
// reads "Said hi" and is off. The surface may already hold its one filled
// white button and the invite stays red, so this one is not filled.
component JoinedCard inherits Rectangle {
    in property <FeedCardData> card;

    background: transparent;

    CutShape {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "tr";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "tr"; inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 3px;

        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 72px;
                height: 72px;
                UserAvatar {
                    size: 72px;
                    initials: root.card.actor-initials;
                    avatar: root.card.actor-avatar;
                    has-avatar: root.card.actor-has-avatar;
                    color-index: root.card.actor-hue-index;
                }
            }
        }
        Rectangle { height: 9px; }
        Text {
            text: root.card.title;
            font-family: Theme.font-display;
            font-weight: Theme.weight-display-bold;
            font-size: 20px;
            color: Theme.text-value;
            overflow: elide;
        }
        if root.card.subtitle != "": Text {
            text: root.card.subtitle;
            font-family: Theme.font-body;
            font-weight: Theme.weight-sentence;
            font-size: 13px;
            color: Theme.text-body;
            overflow: elide;
        }
        Text {
            text: root.card.timestamp;
            font-family: Theme.font-body;
            font-weight: Theme.weight-sentence;
            font-size: 13px;
            color: Theme.text-dim;
            overflow: elide;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: hi-label.preferred-width + 36px;
                height: 30px;
                accessible-role: button;
                accessible-label: (root.card.said-hi ? "Said hi to " : "Say hi to ") + root.card.actor-name;
                accessible-enabled: !root.card.said-hi;
                CutButton {
                    width: parent.width; height: parent.height;
                    outlined: true;
                    line-color: root.card.said-hi ? Theme.card-border : hi-ta.has-hover ? Theme.action : Theme.action-line-hover;
                    surface-color: Theme.card-bg;
                }
                hi-label := Text {
                    text: root.card.said-hi ? "SAID HI" : "SAY HI";
                    font-family: Theme.font-label;
                    font-size: 10px;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-label;
                    color: root.card.said-hi ? Theme.text-dim : Theme.text-primary;
                    width: parent.width; height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                hi-ta := TouchArea {
                    enabled: !root.card.said-hi;
                    mouse-cursor: root.card.said-hi ? MouseCursor.default : MouseCursor.pointer;
                    clicked => { ChatFocus.say-hi(root.card.id); }
                }
            }
        }
    }
}

// The voice channel when nobody is in it (frame E): the channel, when the last
// call was, and the one filled white button of the quiet feed.
component VoiceIdleCard inherits Rectangle {
    in property <FeedCardData> card;
    callback start-voice-clicked(string);

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "br";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "br"; inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;
            height: 16px;
            cross-axis-alignment: center;
            Rectangle {
                width: 6px; height: 6px; border-radius: 3px;
                background: Theme.id-blue;
            }
            Text {
                font-family: Theme.font-label;
                text: "VOICE";
                font-size: 10px;
                font-weight: Theme.weight-label;
                color: Theme.id-blue;
                letter-spacing: Theme.track-label;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                font-family: Theme.font-display;
                text: card.channel-name;
                font-size: 13px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: "Empty";
                font-size: 11px;
                color: Theme.text-sub;
            }
        }

        Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: card.subtitle;
            font-size: 11px;
            color: Theme.skel-text;
        }

        Rectangle { vertical-stretch: 1; }

        // White is action. One filled white button on the surface.
        Rectangle {
            height: 32px;
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: start-label.preferred-width + 40px;
                    accessible-role: button;
                    accessible-label: "Start voice";
                    CutButton {
                        width: parent.width; height: parent.height;
                        fill-color: start-ta.pressed ? Theme.action-press : Theme.action;
                    }
                    start-label := Text {
                        text: "START VOICE";
                        font-family: Theme.font-label;
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: Theme.on-action;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    start-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.start-voice-clicked(root.card.channel-id); }
                    }
                }
            }
        }
    }
}

// The invite line under the skeleton trio (CLIPS 8). One line of copy and the
// one filled button, red because it commits.
component FeedInviteLine inherits Rectangle {
    callback invite-clicked();
    callback hide-clicked();

    height: 40px;
    background: transparent;

    HorizontalLayout {
        spacing: 14px;
        cross-axis-alignment: center;

        Text {
            horizontal-stretch: 1;
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: "Your crew is not here yet. Send them the link.";
            font-size: 13px;
            color: Theme.text-sub;
            overflow: elide;
            vertical-alignment: center;
        }

        CutButton {
            horizontal-stretch: 0;
            width: 150px;
            height: 36px;
            fill-color: invite-touch.has-hover ? Theme.confirm-press : Theme.live;

            Text {
                font-family: Theme.font-display;
                text: "Share invite link";
                font-size: 12px;
                font-weight: Theme.weight-display;
                color: Theme.on-live;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            invite-touch := TouchArea {
                accessible-role: button;
                accessible-label: "Share invite link";
                mouse-cursor: pointer;
                clicked => { root.invite-clicked(); }
            }
        }

        Rectangle {
            horizontal-stretch: 0;
            width: hide-text.preferred-width + 8px;

            hide-text := Text {
                font-weight: Theme.weight-sentence;
                font-family: Theme.font-body;
                text: "Hide";
                font-size: 11px;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }

            TouchArea {
                accessible-role: button;
                accessible-label: "Hide invite";
                mouse-cursor: pointer;
                clicked => { root.hide-clicked(); }
            }
        }
    }
}

// m3llo+ upsell card pinned at the end of the memory band. Server emits a
// "locked" entry; copy and visual stay client-side.
component LockedCard inherits Rectangle {

    background: transparent;
    border-width: 0px;

    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "tr";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "tr";
        inset: Theme.keyline;
        fill: Theme.card-bg;
    }

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 20px;

        Text {
            font-family: Theme.font-display;
            text: "Unlock your crew's full story";
            font-size: 14px;
            font-weight: Theme.weight-display;
            color: Theme.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            font-weight: Theme.weight-sentence;
            font-family: Theme.font-body;
            text: "Keep every clip and recap forever with m3llo+.";
