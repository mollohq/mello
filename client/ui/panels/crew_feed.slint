    property <[StreamCardData]> preview-stream-cards-3: [
        {
            host-id: "alice-id",
            session-id: "stream-session-1",
            streamer-name: "alice",
            subtitle: "Counter-Strike 2",
            avatar: @image-url("../icons/user.svg"),
            has-avatar: false,
            avatar-initials: "AL",
            avatar-color-index: 1,
            viewer-count: 1242,
            stream-width: 1920,
            stream-height: 1080,
            can-watch: true,
        },
        {
            host-id: "fail-id",
            session-id: "stream-session-2",
            streamer-name: "FaiL",
            subtitle: "Valorant",
            avatar: @image-url("../icons/user.svg"),
            has-avatar: false,
            avatar-initials: "Fa",
            avatar-color-index: 3,
            viewer-count: 853,
            stream-width: 1920,
