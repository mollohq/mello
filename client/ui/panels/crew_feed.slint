// Invite CTA card
component InviteCard inherits Rectangle {
    callback invite-clicked();
    callback hide-clicked();

    background: Theme.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 20px;

        Text {
            text: "Invite friends";
            font-size: 14px;
            font-weight: 600;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }

        Text {
            text: "The feed comes alive when your crew is here.";
            font-size: 11px;
            color: Theme.text-sub;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        // Primary CTA button — wrapped so VerticalLayout doesn't override x
        Rectangle {
            height: 36px;

            Rectangle {
                width: 140px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                border-radius: Theme.r-inner;
                background: invite-btn-touch.has-hover ? #FF1E56DD : Theme.accent;

                Text {
                    text: "Share invite link";
                    font-size: 12px;
                    font-weight: 600;
                    color: #FFFFFF;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                invite-btn-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { invite-clicked(); }
                }
            }
        }

        // Hide link — wrapped so VerticalLayout doesn't override x
        Rectangle {
            height: 16px;

            Text {
                text: "Hide";
                font-size: 11px;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
                width: parent.width;
                y: (parent.height - self.height) / 2;

                hide-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { hide-clicked(); }
                }
            }
        }
    }
}

// m3llo+ upsell card pinned at the end of the memory band. Server emits a
// "locked" entry; copy and visual stay client-side.
component LockedCard inherits Rectangle {
    background: Theme.card-bg;
