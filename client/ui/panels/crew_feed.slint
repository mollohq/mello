            {
                id: "2", card-type: "recap", is-hero: false, is-skeleton: false, recap-rows: 2, recap-hangout-min: 870, recap-clips: 12, recap-longest-min: 312,
                title: "14.5h",
                subtitle: "12",
                actor-name: "FaiL", actor-initials: "Fa",
                game-name: "Valorant",
