// The daily recap alone, at the width of a cell in a three column grid and in
// a narrow one. Today so far, with two belts that moved.
export component PreviewDailyRecap inherits Rectangle {
    width: 700px;
    height: 260px;
    background: Theme.bg-app;

    property <H2hPerson> bob: { id: "u1", name: "Bob", initials: "B", hue-index: 0 };
    property <H2hPerson> jonas: { id: "u2", name: "Jonas", initials: "J", hue-index: 1 };
    property <H2hPerson> sara: { id: "u3", name: "Sara", initials: "S", hue-index: 3 };
    property <H2hPerson> max: { id: "u4", name: "Max", initials: "M", hue-index: 2 };
    property <FeedCardData> day: {
        id: "daily", card-type: "daily-recap", role: "standard", size: "md",
        day-label: "Today so far", title: "2h 05m", clip-count: 1, day-sessions: 3,
        game-name: "Rocket League", game-monogram: "RL", game-hue-index: 1,
        game-has-capsule: true, game-capsule: @image-url("../previews/fixtures/capsule-sample-2.png"),
        day-members: [bob, jonas, max],
        belts-moved: [
            { title: "The Carry", icon: @image-url("../icons/h2h-carry.svg"), value: "4,201", unit: "", prev-name: "Bob", prev-initials: "B", prev-hue: 0, holder-name: "Jonas", holder-initials: "J", holder-hue: 1 },
            { title: "Night Owl", icon: @image-url("../icons/h2h-night-owl.svg"), value: "03:40", unit: "", prev-name: "Bob", prev-initials: "B", prev-hue: 0, holder-name: "Sara", holder-initials: "S", holder-hue: 3 },
        ],
    };
    DailyRecapCard { x: 20px; y: 10px; width: 378px; height: 232px; card: root.day; }
    DailyRecapCard { x: 420px; y: 10px; width: 260px; height: 232px; card: root.day; }
