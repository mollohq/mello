import { Theme } from "../theme.slint";
import { FeedCardData, StreamCardData, YouStripData } from "../types.slint";
import { ActiveStreamsPanel } from "./active_streams_panel.slint";
import { SessionPreviewCard } from "./session_preview_card.slint";
import { YouStrip } from "./you_strip.slint";
import { GameIcon } from "../components/game_icon.slint";

component AvatarDot inherits Rectangle {
    in property <string> initials;
    in property <int> color-index: 0;
    in property <length> size: 18px;

    width: size;
    height: size;
    border-radius: max(4px, size / 4.5);
    border-width: 2px;
    border-color: Theme.card-bg;
    background: color-index == 0 ? #EB4D5F :
                color-index == 1 ? #4a9eff :
                color-index == 2 ? #4ade80 :
                color-index == 3 ? #a78bfa : #f59e0b;

    Text {
        text: initials;
        font-size: 7px;
        font-weight: 600;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Shows a real avatar image when cached (spec 19), else the initials dot.
component RecapAvatar inherits Rectangle {
    in property <string> initials;
    in property <int> color-index: 0;
    in property <image> avatar;
    in property <bool> has-avatar: false;
    /// Default matches the recap rows; session cards scale this up so the
    /// people are the visual, not a footnote.
    in property <length> size: 18px;

    width: size;
    height: size;

    if !has-avatar: AvatarDot {
        initials: root.initials;
        color-index: root.color-index;
        size: root.size;
    }

    if has-avatar: Rectangle {
        width: root.size;
        height: root.size;
        border-radius: max(4px, root.size / 4.5);
        clip: true;
        border-width: root.size > 20px ? 2px : 0px;
        border-color: Theme.card-bg;
        Image {
            source: root.avatar;
            width: root.size;
            height: root.size;
            image-fit: cover;
        }
    }
}

// Play/pause ring for clip cards. Declared as a component so both hero and
// standard cards share geometry, hover fill, and click forwarding.
component ClipPlayRing inherits Rectangle {
    in property <bool> small: false;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;

    // Clicks on the ring must reach card-level play toggle: without this
    // forward the ring's own TouchArea would swallow the event silently.
    callback ring-clicked();

    width: small ? 24px : 44px;
    height: small ? 24px : 44px;
    border-radius: self.width / 2;
    border-width: 1.5px;
    border-color: Theme.clip-amber;
    background: ring-hover.has-hover ? #F59E0B1F : transparent;
    animate background { duration: 150ms; easing: ease-out; }

    if !is-playing || is-paused: Image {
        source: @image-url("../icons/play.svg");
        colorize: Theme.clip-amber;
        width: small ? 8px : 14px;
        height: small ? 8px : 14px;
        opacity: 1.0;
        animate opacity { duration: 150ms; easing: ease-out; }
        x: small ? 9px : 16px;
        y: (parent.height - self.height) / 2;
    }

    if is-playing && !is-paused: Image {
        source: @image-url("../icons/pause.svg");
        colorize: Theme.clip-amber;
        width: small ? 7px : 12px;
        height: small ? 7px : 12px;
        opacity: 1.0;
        animate opacity { duration: 150ms; easing: ease-out; }
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ring-hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.ring-clicked(); }
    }
}

component DotWaveform inherits Rectangle {
    in property <[float]> peaks: [];
    in property <float> progress: 0.0;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    in property <int> rows: 15;
    in property <length> dot-size: 3px;
    in property <length> row-pitch: 5px;
    in property <int> duration-ms: 30000;
    callback seek-ms(int);
    callback play-at-ms(int);

    property <int> cols: 64;
    property <bool> use-placeholder: peaks.length == 0;
    property <bool> scrubbing: touch.pressed;
    property <bool> hovering: touch.has-hover && !scrubbing;
    property <float> col-pitch-f: self.width / 1px / cols;
    property <int> scrub-col: Math.min(cols - 1, Math.max(0, Math.floor((touch.mouse-x / 1px) / col-pitch-f)));
    property <float> scrub-progress: scrub-col / (cols - 1);
    property <float> display-progress: scrubbing ? scrub-progress : progress;
    property <int> play-col: Math.min(cols - 1, Math.max(0, Math.round(display-progress * (cols - 1))));
    property <bool> show-two-tone: is-playing || is-paused || scrubbing;
    property <int> hover-col: Math.min(cols - 1, Math.max(0, Math.floor((touch.mouse-x / 1px) / col-pitch-f)));
    property <int> press-mode: 0;
    property <length> hairline-x: Math.floor(play-col * col-pitch-f + col-pitch-f / 2) * 1px;
    // Absolute ms for the released scrub position. Duration comes from the
    // component's duration-ms input (card metadata while idle, real duration
    // during playback) — NOT from the global clip-duration-ms, which is
    // zeroed on playback finish and would collapse every idle seek to 0ms.
    property <int> release-pos-ms: Math.round(root.scrub-col / (root.cols - 1) * root.duration-ms);
    property <length> ghost-x: Math.floor(hover-col * col-pitch-f + col-pitch-f / 2) * 1px;
    property <int> chip-col: scrubbing ? scrub-col : hover-col;
    property <length> chip-x: Math.min(self.width - 8px, Math.max(8px, Math.floor(chip-col * col-pitch-f + col-pitch-f / 2) * 1px));
    property <int> chip-ms: Math.round(chip-col / (cols - 1) * duration-ms);
    property <int> chip-secs: Math.max(0, chip-ms / 1000);
    property <int> chip-min-part: Math.floor(chip-secs / 60);
    property <int> chip-sec-part: Math.mod(chip-secs, 60);
    property <string> chip-sec-text: chip-sec-part < 10 ? "0" + chip-sec-part : chip-sec-part;
    property <string> chip-time: chip-min-part + ":" + chip-sec-text;

    property <[float]> placeholder-peaks: [
        0.02, 0.03, 0.01, 0.04, 0.02, 0.03, 0.01, 0.02,
        0.55, 0.72, 0.88, 0.95, 0.82, 0.76, 0.91, 0.68, 0.74, 0.85, 0.62, 0.58,
        0.04, 0.06, 0.03, 0.05, 0.02, 0.04,
        0.78, 0.92, 0.86, 0.71, 0.88, 0.94, 0.79, 0.83, 0.67, 0.75, 0.90, 0.84,
        0.03, 0.05, 0.02, 0.06,
        0.52, 0.61, 0.48,
        0.02, 0.04, 0.03,
        0.65, 0.80, 0.93, 0.87, 0.76, 0.91, 0.85, 0.70, 0.88, 0.96, 0.82,
        0.04, 0.03, 0.06,
        0.58, 0.71
    ];

    background: Theme.card-bg-inset;
    border-radius: 4px;
    clip: true;

    for col[c] in cols: Rectangle {
        property <float> peak-val: root.use-placeholder ? root.placeholder-peaks[c] : peaks[c];
        property <int> lit-count: 1 + Math.round(peak-val * (root.rows - 1));
        property <float> col-pitch-f: parent.width / 1px / root.cols;
        property <length> col-x: Math.min(
            Math.floor(c * col-pitch-f + (col-pitch-f - root.dot-size / 1px) / 2) * 1px,
            parent.width - root.dot-size);
        property <bool> col-remaining: root.show-two-tone && c >= root.play-col;
        property <bool> is-snap-col: root.show-two-tone && c == root.play-col;

        for row[r] in lit-count: Rectangle {
            property <int> row-from-base: lit-count - 1 - r;
            property <bool> silent-col: lit-count == 1;
            property <float> rest-opacity: silent-col && row-from-base == 0
                ? 0.25
                : 0.9 - (row-from-base / (root.rows - 1)) * 0.45;
            property <float> dot-opacity: root.use-placeholder
                ? 0.3 * rest-opacity
                : (col-remaining ? 0.45 : (is-snap-col ? 1.0 : rest-opacity));

            width: root.dot-size;
            height: root.dot-size;
            x: col-x;
            y: Math.floor((parent.height / 1px) - (root.row-pitch / 1px) - (root.dot-size / 1px) - row-from-base * (root.row-pitch / 1px)) * 1px;
            background: is-snap-col ? white : (col-remaining ? Theme.text-dim : Theme.clip-amber);
            opacity: dot-opacity;
            animate opacity { duration: 120ms; easing: ease-out; }
            animate background { duration: 120ms; easing: ease-out; }
        }
    }

  // Ghost hairline (hover preview at rest / paused)
    if hovering && !scrubbing && (!is-playing || is-paused): Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height;
        clip: true;

        Rectangle {
            x: ghost-x;
            width: 1px;
            height: parent.height;
            background: white;
            opacity: 0.3;
        }
    }

  // Playhead hairline
    if show-two-tone: Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height;
        clip: true;

        playhead-hairline := Rectangle {
            x: hairline-x;
            width: 1px;
            height: parent.height;
            background: white;
            opacity: 1.0;
            animate x {
                duration: scrubbing ? 0ms : (is-playing && !is-paused ? 80ms : 0ms);
                easing: linear;
            }
            states [
                breathing when is-paused && !scrubbing: {
                    opacity: 0.35;
                    in {
                        animate opacity {
                            duration: 700ms;
                            easing: ease-in-out;
                            iteration-count: -1;
                            direction: alternate;
                        }
                    }
                }
            ]
        }
    }

  // Hover / scrub time chip
    if scrubbing || (hovering && !is-playing && !is-paused): Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height;
        clip: true;

        chip-bg := Rectangle {
            x: chip-x - (chip-text.preferred-width + 10px) / 2;
            y: 2px;
            width: chip-text.preferred-width + 10px;
            height: chip-text.preferred-height + 4px;
            border-radius: 3px;
            background: #000000cc;

            chip-text := Text {
                text: chip-time;
                font-family: Theme.font-mono;
                font-size: 10px;
                color: Theme.clip-amber;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: crosshair;

        changed pressed => {
            if (self.pressed) {
                root.press-mode = root.is-playing && !root.is-paused ? 1 : (root.is-paused ? 2 : 0);
            } else {
                // Mode 0 (idle): play-at-ms plays then seeks — a bare seek
                // here would target the previously loaded clip.
                if (root.press-mode != 0) {
                    root.seek-ms(root.release-pos-ms);
                }
                if (root.press-mode == 0) {
                    root.play-at-ms(root.release-pos-ms);
                }
            }
        }

        clicked => { /* scrub release handles seek; block card-face toggle */ }
    }
}

component NewBadge inherits Rectangle {
    width: new-text.preferred-width + 16px;
    height: 22px;
    border-radius: 5px;
    background: Theme.clip-amber;

    new-text := Text {
        text: "NEW";
        font-size: 10px;
        font-weight: 700;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Hero clip card (2x wide)
component HeroClipCard inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    in property <float> progress: 0.0;
    in property <string> position-text: "";
    in property <string> duration-text: "";
    in property <int> clip-duration-ms: 0;
    callback play-clicked(string);
    callback seek-ms(int);

    background: card-hover.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: card.is-new ? Theme.clip-amber :
                  is-playing ? Theme.clip-amber :
                  card-hover.has-hover ? Theme.graphic-med : Theme.card-border;
    clip: true;

    // Declared BEFORE the content so embedded touch areas (waveform scrub,
    // play ring) sit on top and receive their own pointer events — a full-card
    // touch declared after the content would swallow every click.
    card-hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { play-clicked(card.clip-path); }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;

        // Header: micro-label + timecode
        Rectangle {
            height: 16px;
            vertical-stretch: 0;

            HorizontalLayout {
                spacing: 0px;

                if !is-playing: HorizontalLayout {
                    spacing: 5px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: HorizontalLayout forces y:0 on children —
                    // center via the cross axis instead of per-child y.
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../icons/scissors.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        text: "VOICE CLIP";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.clip-amber;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                }

                if is-playing: HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: y is silently forced to 0 in layouts — use
                    // the cross axis to center the icon with its label.
                    cross-axis-alignment: center;

                    if !is-paused: Image {
                        source: @image-url("../icons/speaker.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    if is-paused: Image {
                        source: @image-url("../icons/pause.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        text: is-paused ? "PAUSED" : "PLAYING";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.clip-amber;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: is-playing ? position-text + " / " + duration-text : card.duration;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

            if card.is-new: NewBadge {
                x: 0px;
                y: 0px;
            }
        }

        // Wave row: play ring + dot-matrix band (absorbs vertical slack)
        Rectangle {
            vertical-stretch: 1;
            min-height: 78px;

            DotWaveform {
                x: play-ring.width + 12px;
                width: parent.width - play-ring.width - 12px;
                height: parent.height;
                peaks: card.waveform;
                progress: root.progress;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                rows: 15;
                dot-size: 3px;
                row-pitch: 5px;
                duration-ms: root.is-playing ? root.clip-duration-ms : card.duration-ms;
                seek-ms(m) => { root.seek-ms(m); }
                play-at-ms(m) => {
                    root.play-clicked(card.clip-path);
                    root.seek-ms(m);
                }
            }

            // x must be explicit: Slint horizontally centers children
            // narrower than their parent by default (CLAUDE.md fill-bar rule).
            play-ring := ClipPlayRing {
                x: 0;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                y: (parent.height - self.height) / 2;
                ring-clicked => { root.play-clicked(card.clip-path); }
            }
        }

        // Card body pinned below the wave band
        VerticalLayout {
            spacing: 6px;
            vertical-stretch: 0;

            Text {
                text: card.title != "" ? card.title : card.actor-name + " clipped that";
                font-size: 14px;
                font-weight: 500;
                color: Theme.text-primary;
            }

            HorizontalLayout {
                spacing: 8px;
                height: 20px;

                if card.participant-count > 0: HorizontalLayout {
                    spacing: -7px;
                    width: self.preferred-width;

                    AvatarDot { initials: card.actor-initials; color-index: 0; }
                    if card.participant-count > 1: AvatarDot { initials: ""; color-index: 1; }
                    if card.participant-count > 2: AvatarDot { initials: ""; color-index: 2; }
                }

                Text {
                    text: card.timestamp;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                }

                if card.game-name != "": Text {
                    text: "·";
                    font-size: 11px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                if card.game-name != "": Text {
                    text: card.game-name;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                }
            }
        }
    }

}

// Standard clip card (1x)
component ClipCard inherits Rectangle {
    in property <FeedCardData> card;
    in property <bool> is-playing: false;
    in property <bool> is-paused: false;
    in property <float> progress: 0.0;
    in property <string> position-text: "";
    in property <string> duration-text: "";
    in property <int> clip-duration-ms: 0;
    callback play-clicked(string);
    callback seek-ms(int);

    background: clip-hover.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: card.is-new ? Theme.clip-amber :
                  is-playing ? Theme.clip-amber :
                  clip-hover.has-hover ? Theme.graphic-med : Theme.card-border;
    clip: true;

    // Same ordering rule as HeroClipCard: content touches must win.
    clip-hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { play-clicked(card.clip-path); }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 12px;
        spacing: 8px;

        // Header
        Rectangle {
            height: 16px;
            vertical-stretch: 0;

            HorizontalLayout {
                if !is-playing: HorizontalLayout {
                    spacing: 5px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: HorizontalLayout forces y:0 on children —
                    // center via the cross axis instead of per-child y.
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../icons/scissors.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        text: "VOICE CLIP";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.clip-amber;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                }

                if is-playing: HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    // CLAUDE.md: y is silently forced to 0 in layouts — use
                    // the cross axis to center the icon with its label.
                    cross-axis-alignment: center;

                    if !is-paused: Image {
                        source: @image-url("../icons/speaker.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    if is-paused: Image {
                        source: @image-url("../icons/pause.svg");
                        colorize: Theme.clip-amber;
                        width: 10px;
                        height: 10px;
                    }

                    Text {
                        text: is-paused ? "PAUSED" : "PLAYING";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.clip-amber;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: is-playing ? position-text + " / " + duration-text : card.duration;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    color: Theme.text-sub;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

            if card.is-new: NewBadge {
                x: 0px;
                y: 0px;
            }
        }

        // Wave band with corner play ring (absorbs vertical slack)
        Rectangle {
            vertical-stretch: 1;
            min-height: 38px;

            DotWaveform {
                width: parent.width;
                height: parent.height;
                peaks: card.waveform;
                progress: root.progress;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                rows: 9;
                dot-size: 2px;
                row-pitch: 4px;
                duration-ms: root.is-playing ? root.clip-duration-ms : card.duration-ms;
                seek-ms(m) => { root.seek-ms(m); }
                play-at-ms(m) => {
                    root.play-clicked(card.clip-path);
                    root.seek-ms(m);
                }
            }

            ClipPlayRing {
                small: true;
                is-playing: root.is-playing;
                is-paused: root.is-paused;
                x: parent.width - self.width - 4px;
                y: 4px;
                ring-clicked => { root.play-clicked(card.clip-path); }
            }
        }

        // Body pinned at the bottom — title + meta, no dead gap
        VerticalLayout {
            spacing: 4px;
            vertical-stretch: 0;

            Text {
                text: card.title != "" ? card.title : card.actor-name + " clipped that";
                font-size: 13px;
                font-weight: 500;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: card.timestamp + (card.game-name != "" ? " · " + card.game-name : "");
                font-size: 11px;
                color: Theme.text-sub;
            }
        }
    }

}

// Weekly recap card
component RecapCard inherits Rectangle {
    in property <FeedCardData> card;

    background: Theme.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;

    VerticalLayout {
        padding: 14px;
        padding-top: 16px;
        spacing: 0px;
        // Top-pack: each section uses its natural height and any slack collects
        // at the bottom, instead of stretching the MVP row away from its header.
        alignment: start;

        Text {
            text: "WEEKLY RECAP";
            font-size: 10px;
            font-weight: 700;
            color: Theme.accent;
            letter-spacing: 1.2px;
        }

        Rectangle { height: 8px; }

        Text {
            text: card.title;
            font-size: 28px;
            font-weight: 700;
            color: Theme.text-primary;
        }

        Text {
            text: "Total crew time";
            font-size: 11px;
            color: Theme.text-sub;
        }

        Rectangle { height: 10px; }

        Rectangle { height: 1px; background: Theme.card-border; }

        Rectangle { height: 8px; }

        // Stats rows
        VerticalLayout {
            spacing: 5px;

            if card.game-name != "": HorizontalLayout {
                Text { text: "Top game"; font-size: 11px; color: Theme.text-dim; horizontal-stretch: 1; }
                Text { text: card.game-name; font-size: 11px; color: Theme.text-value; }
            }

            if card.duration != "": HorizontalLayout {
                Text { text: "Longest sesh"; font-size: 11px; color: Theme.text-dim; horizontal-stretch: 1; }
                Text { text: card.duration; font-size: 11px; color: Theme.text-value; }
            }

            if card.subtitle != "": HorizontalLayout {
                Text { text: "Clips"; font-size: 11px; color: Theme.text-dim; horizontal-stretch: 1; }
                Text { text: card.subtitle; font-size: 11px; color: Theme.text-value; }
            }
        }

        Rectangle { height: 10px; }

        // MVP section with avatars
        if card.mvp-count > 0: Rectangle {

            VerticalLayout {
                spacing: 0px;

                Rectangle { height: 1px; background: Theme.card-border; }
                Rectangle { height: 8px; }

                Text {
                    text: "MVP";
                    font-size: 10px;
                    font-weight: 600;
                    color: Theme.skel-text;
                    letter-spacing: 0.8px;
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 4px;

                    if card.mvp-count >= 1: HorizontalLayout {
                        spacing: 8px;
                        height: 22px;

                        RecapAvatar { initials: card.mvp0-initials; color-index: 0; avatar: card.mvp0-avatar; has-avatar: card.mvp0-has-avatar; }
                        Text {
                            text: card.mvp0-name;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: card.mvp0-stat;
                            font-size: 11px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }

                    // Single MVP keeps the recap card compact (spec 19 polish);
                    // mvp1/mvp2 data still arrives but is intentionally not shown.
                }
            }
        }

        // This week in games (spec 19)
        if card.leaderboard.length > 0 || card.awards.length > 0: Rectangle {
            VerticalLayout {
                spacing: 0px;

                Rectangle { height: 1px; background: Theme.card-border; }
                Rectangle { height: 8px; }

                Text {
                    text: "THIS WEEK IN GAMES";
                    font-size: 10px;
                    font-weight: 600;
                    color: Theme.skel-text;
                    letter-spacing: 0.8px;
                }

                if card.games-summary != "": Text {
                    text: card.games-summary;
                    font-size: 11px;
                    color: Theme.text-sub;
                }

                Rectangle { height: 6px; }

                VerticalLayout {
                    spacing: 4px;
                    for row in card.leaderboard: HorizontalLayout {
                        spacing: 8px;
                        height: 22px;
                        RecapAvatar { initials: row.initials; color-index: row.color-index; avatar: row.avatar; has-avatar: row.has-avatar; }
                        Text {
                            text: row.name;
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: row.record;
                            font-size: 11px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }
                }

                if card.awards.length > 0: Rectangle { height: 8px; }

                VerticalLayout {
                    spacing: 4px;
                    for a in card.awards: HorizontalLayout {
                        spacing: 8px;
                        height: 18px;
                        Text {
                            text: a.title;
                            font-size: 11px;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: a.name;
                            font-size: 11px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: a.detail;
                            font-size: 10px;
                            color: Theme.text-sub;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Session card
// Voice/stream session card, redesigned per designs/feed/
// session-cards-redesign.html (Option B: game/channel-first). Typed header,
// real avatars, humanized duration, peak stat — a card must answer "who did
// what, for how long" at a glance.
component SessionCard inherits Rectangle {
    in property <FeedCardData> card;

    property <bool> is-stream: card.session-kind == "stream";
    property <color> kind-color: is-stream ? Theme.accent : #4a9eff;

    background: Theme.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        // Typed header: colored dot + STREAM / VOICE.
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 6px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: kind-color;
                    y: (parent.height - self.height) / 2;
                }
            }
            Text {
                text: is-stream ? "STREAM" : card.session-kind == "voice" ? "VOICE" : "SESSION";
                font-size: 10px;
                font-weight: 600;
                color: kind-color;
                letter-spacing: 0.8px;
            }
        }

        // ── STREAM: game art leads, streamer avatar badged on its corner ──
        if is-stream: HorizontalLayout {
            spacing: 10px;
            height: 44px;

            Rectangle {
                width: 40px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    y: (parent.height - self.height) / 2;

                    GameIcon {
                        game-id: card.game-id;
                        short-name: card.game-short-name != "" ? card.game-short-name :
                                    card.game-name != "" ? card.game-name : "GG";
                        badge-color: card.game-has-color ? card.game-color : Theme.accent;
                        runtime-icon: card.game-icon;
                        has-runtime-icon: card.game-has-icon;
                        size: 40px;
                    }
                    if card.actor-has-avatar || card.actor-initials != "": RecapAvatar {
                        initials: card.actor-initials;
                        avatar: card.actor-avatar;
                        has-avatar: card.actor-has-avatar;
                        x: parent.width - self.width + 4px;
                        y: parent.height - self.height + 4px;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: card.game-name != "" ? card.game-name : card.title;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: card.actor-name != "" ? "by " + card.actor-name
                            + (card.duration-human != "" ? " · " + card.duration-human : "")
                        : card.duration-human;
                    font-size: 11px;
                    color: Theme.text-sub;
                    overflow: elide;
                }
            }
        }

        if is-stream && card.peak-count > 0: Text {
            text: "\{card.peak-count} watched at peak";
            font-size: 11px;
            color: Theme.text-sub;
        }

        // ── VOICE: the people are the content, so they get the space ──
        // Channel + meta as a compact heading, then a large avatar cluster
        // that fills the card instead of an empty stretch gap.
        if !is-stream: VerticalLayout {
            spacing: 2px;
            Text {
                text: card.channel-name != "" ? card.channel-name : card.title;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                text: card.duration-human
                    + (card.peak-count > 0 ? " · \{card.peak-count} in call" : "");
                font-size: 11px;
                color: Theme.text-sub;
                overflow: elide;
            }
        }

        if !is-stream: Rectangle { height: 6px; }

        if !is-stream && card.participant-count > 0: HorizontalLayout {
            spacing: -10px;
            alignment: start;
            height: 40px;

            RecapAvatar {
                initials: card.part0-initials;
                avatar: card.part0-avatar;
                has-avatar: card.part0-has-avatar;
                color-index: 0;
                size: 40px;
            }
            if card.participant-count > 1: RecapAvatar {
                initials: card.part1-initials;
                avatar: card.part1-avatar;
                has-avatar: card.part1-has-avatar;
                color-index: 1;
                size: 40px;
            }
            if card.participant-count > 2: RecapAvatar {
                initials: card.part2-initials;
                avatar: card.part2-avatar;
                has-avatar: card.part2-has-avatar;
                color-index: 2;
                size: 40px;
            }
            // Overflow chip: the roster is wider than the three avatar slots.
            if card.participant-count > 3: Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 9px;
                border-width: 2px;
                border-color: Theme.card-bg;
                background: Theme.graphic-light;
                Text {
                    text: "+\{card.participant-count - 3}";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if !is-stream && card.participants-line != "": Text {
            text: card.participants-line;
            font-size: 11px;
            color: Theme.text-sub;
            overflow: elide;
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: card.timestamp + (card.subtitle != "" ? " · " + card.subtitle : "");
            font-size: 11px;
            color: Theme.skel-text;
        }
    }
}

// Telemetry-backed W/L block for notable game sessions (spec 19 B2).
component GameSessionRecordPanel inherits VerticalLayout {
    in property <FeedCardData> card;
    in property <color> record-color;

    spacing: 0px;

    // Headline record
    Text {
        text: card.game-record;
        font-size: 30px;
        font-weight: 700;
        color: record-color;
    }
    Text {
        text: "this session";
        font-size: 11px;
        color: Theme.text-sub;
    }

    Rectangle { height: 12px; }
    Rectangle { height: 1px; background: Theme.card-border; }
    Rectangle { height: 10px; }

    // Stat tiles: streak · win rate · matches
    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: card.game-streak-text;
                font-size: 16px;
                font-weight: 700;
                color: card.game-streak-positive ? #4ade80 : #f87171;
            }
            Text { text: "streak"; font-size: 10px; color: Theme.text-sub; }
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: card.game-winrate;
                font-size: 16px;
                font-weight: 700;
                color: Theme.text-primary;
            }
            Text { text: "win rate"; font-size: 10px; color: Theme.text-sub; }
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: "\{card.game-matches}";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text-primary;
            }
            Text { text: "matches"; font-size: 10px; color: Theme.text-sub; }
        }
    }
}

// Zero-telemetry session: icon + "X played Y" + duration, no empty stat slots.
component GameSessionCompactBody inherits VerticalLayout {
    in property <FeedCardData> card;
    in property <color> game-accent;
    in property <bool> quiet: false;

    spacing: quiet ? 6px : 8px;
    alignment: start;

    HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;

        GameIcon {
            game-id: card.game-id;
            short-name: card.game-short-name != "" ? card.game-short-name :
                        card.game-name != "" ? card.game-name : "GG";
            badge-color: game-accent;
            runtime-icon: card.game-icon;
            has-runtime-icon: card.game-has-icon;
            size: quiet ? 32px : 36px;
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: start;

            Text {
                text: card.title != "" ? card.title : card.game-name;
                font-size: quiet ? 12px : 13px;
                font-weight: 600;
                color: Theme.text-primary;
                overflow: elide;
            }
            if card.duration-human != "": Text {
                text: card.duration-human;
                font-size: quiet ? 16px : 20px;
                font-weight: 700;
                color: Theme.text-primary;
            }
        }
    }

    if card.participant-count > 1: HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;
        height: 20px;

        HorizontalLayout {
            spacing: -6px;
            alignment: start;
            RecapAvatar {
                initials: card.part0-initials != "" ? card.part0-initials : card.actor-initials;
                avatar: card.part0-has-avatar ? card.part0-avatar : card.actor-avatar;
                has-avatar: card.part0-has-avatar || card.actor-has-avatar;
                color-index: 0;
                size: 20px;
            }
            if card.participant-count > 1: RecapAvatar {
                initials: card.part1-initials;
                avatar: card.part1-avatar;
                has-avatar: card.part1-has-avatar;
                color-index: 1;
                size: 20px;
            }
            if card.participant-count > 2: RecapAvatar {
                initials: card.part2-initials;
                avatar: card.part2-avatar;
                has-avatar: card.part2-has-avatar;
                color-index: 2;
                size: 20px;
            }
        }

        if card.participants-line != "": Text {
            text: card.participants-line;
            font-size: 11px;
            color: Theme.text-sub;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    Rectangle { vertical-stretch: 1; }

    Text {
        text: card.timestamp;
        font-size: 11px;
        color: Theme.skel-text;
    }
}

// Rich game-session card for notable sessions (spec 19 B2); compact T0 variant
// when the session has no W/L record (GAME-SURFACING C1).
component GameSessionCard inherits Rectangle {
    in property <FeedCardData> card;

    property <bool> has-record: card.game-matches > 0;
    property <bool> is-quiet: card.role == "quiet" || card.size == "sm";
    property <color> game-accent: card.game-has-color ? card.game-color : Theme.accent;
    property <color> record-color: card.game-streak-positive ? #4ade80 : #f87171;

    background: Theme.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;

    if !has-record: VerticalLayout {
        padding: is-quiet ? 10px : 12px;
        spacing: 0px;
        alignment: start;

        GameSessionCompactBody {
            card: root.card;
            game-accent: root.game-accent;
            quiet: is-quiet;
        }
    }

    if has-record: VerticalLayout {
        padding: 14px;
        spacing: 0px;
        alignment: start;

        // Header: game badge + name + actor / time
        HorizontalLayout {
            spacing: 10px;
            height: 40px;

            VerticalLayout {
                alignment: center;
                GameIcon {
                    game-id: card.game-id;
                    short-name: card.game-short-name != "" ? card.game-short-name :
                                card.game-name != "" ? card.game-name : "GG";
                    badge-color: game-accent;
                    runtime-icon: card.game-icon;
                    has-runtime-icon: card.game-has-icon;
                    size: 40px;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: card.game-name != "" ? card.game-name : "Game session";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: card.actor-name != "" ? card.actor-name + " · " + card.timestamp : card.timestamp;
                    font-size: 11px;
                    color: Theme.text-sub;
                    overflow: elide;
                }
            }

            // Server-verified result (Riot post-match API) — spec 18 §9.
            if card.game-verified: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: verified-label.preferred-width + 12px;
                    height: 18px;
                    border-radius: 4px;
                    background: #1e2a1e;
                    border-width: 1px;
                    border-color: #2d4a2d;
                    verified-label := Text {
                        text: "✓ VERIFIED";
                        font-family: Theme.font-mono;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        color: #4ade80;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { height: 14px; }

        GameSessionRecordPanel {
            card: root.card;
            record-color: record-color;
        }

        Rectangle { vertical-stretch: 1; }

        // Footer: real participant avatars + humanized duration (matches the
        // voice/stream session cards; anonymous dots read as placeholders).
        HorizontalLayout {
            height: 20px;

            HorizontalLayout {
                spacing: -7px;
                horizontal-stretch: 1;
                alignment: start;
                RecapAvatar {
                    initials: card.part0-initials != "" ? card.part0-initials : card.actor-initials;
                    avatar: card.part0-has-avatar ? card.part0-avatar : card.actor-avatar;
                    has-avatar: card.part0-has-avatar || card.actor-has-avatar;
                    color-index: 0;
                }
                if card.participant-count > 1: RecapAvatar {
                    initials: card.part1-initials;
                    avatar: card.part1-avatar;
                    has-avatar: card.part1-has-avatar;
                    color-index: 1;
                }
                if card.participant-count > 2: RecapAvatar {
                    initials: card.part2-initials;
                    avatar: card.part2-avatar;
                    has-avatar: card.part2-has-avatar;
                    color-index: 2;
                }
            }

            if card.duration-human != "": Text {
                text: card.duration-human;
                font-size: 11px;
                color: Theme.skel-text;
                vertical-alignment: center;
            }
        }
    }
}

// Crew play rollup — routine sessions collapsed for loud crews (GAME-SURFACING B1).
component GameRollupLineRow inherits Rectangle {
    in property <string> line-text: "";

    height: 18px;

    Text {
        text: line-text;
        font-size: 12px;
        color: Theme.text-value;
        overflow: elide;
    }
}

component GameRollupCard inherits Rectangle {
    in property <FeedCardData> card;

    background: Theme.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        alignment: start;

        Text {
            text: "CREW PLAY";
            font-size: 10px;
            font-weight: 700;
            color: Theme.accent;
            letter-spacing: 1.2px;
        }

        Text {
            text: card.subtitle;
            font-size: 11px;
            color: Theme.text-sub;
        }

        Rectangle { height: 1px; background: Theme.card-border; }

        VerticalLayout {
            spacing: 6px;
            for line in card.rollup-lines: GameRollupLineRow {
                line-text: line.player-name + " · " + line.game-name + " · " + line.duration-human;
            }
        }
    }
}

// Catch-up card
component CatchupCard inherits Rectangle {
    in property <FeedCardData> card;

    background: Theme.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            text: "CATCH-UP";
            font-size: 10px;
            font-weight: 700;
            color: Theme.accent-green;
            letter-spacing: 1px;
        }

        Text {
            text: card.title;
            font-size: 13px;
            color: Theme.text-value;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        Text {
            text: card.timestamp;
            font-size: 11px;
            color: Theme.skel-text;
        }
    }
}

// Generic skeleton card
component SkeletonCard inherits Rectangle {
    in property <FeedCardData> card;

    background: Theme.card-bg-skel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 24px;
        padding-left: 16px;
        padding-right: 16px;

        Image {
            source: @image-url("../icons/scissors.svg");
            colorize: Theme.skel-text;
            width: 28px;
            height: 28px;
            opacity: 0.3;
            x: (parent.width - self.width) / 2;
        }

        Text {
            text: card.title != "" ? card.title : "Your crew's clips show up here";
            font-size: 13px;
            font-weight: 500;
            color: Theme.skel-text;
            horizontal-alignment: center;
        }

        Text {
            text: card.subtitle != "" ? card.subtitle : "Tap the scissors during a voice call to save the last 30 seconds";
            font-size: 11px;
            color: Theme.skel-hint;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Hero clip skeleton (2x, dashed play button)
component SkeletonHeroCard inherits Rectangle {
    background: Theme.card-bg-skel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;

    VerticalLayout {
        Rectangle {
            vertical-stretch: 3;
            min-height: 200px;
            background: Theme.card-bg-inset;

            Rectangle {
                x: 12px; y: 12px;
                width: badge-t.preferred-width + 20px;
                height: 22px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.skel-ghost;
                background: transparent;

                badge-t := Text {
                    text: "✂ CLIP";
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.skel-ghost;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    letter-spacing: 0.5px;
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 48px;
                height: 48px;
                border-radius: 24px;
                border-width: 1.5px;
                border-color: Theme.skel-ghost;
                background: transparent;

                Text {
                    text: "▶";
                    font-size: 16px;
                    color: Theme.skel-ghost;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                x: parent.width - self.width - 10px;
                y: parent.height - self.height - 10px;
                width: dur-sk.preferred-width + 16px;
                height: 22px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.skel-ghost;
                background: transparent;

                dur-sk := Text {
                    text: "0:30";
                    font-size: 11px;
                    color: Theme.skel-ghost;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            padding: 12px;
            padding-left: 14px;
            spacing: 5px;
            vertical-stretch: 0;

            Text {
                text: "Your first clip goes here";
                font-size: 14px;
                font-weight: 500;
                color: Theme.skel-text;
            }

            Text {
                text: "Tap ✂ during a voice call to save the last 30 seconds. Your crew's best clips show up right here.";
                font-size: 11px;
                color: Theme.skel-hint;
                wrap: word-wrap;
            }
        }
    }
}

// Recap skeleton (fake stat bars)
component SkeletonRecapCard inherits Rectangle {
    background: Theme.card-bg-skel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 16px;

        Rectangle {
            width: 40px; height: 40px;
            border-radius: 10px;
            background: Theme.skel-element;
            x: (parent.width - self.width) / 2;

            Image {
                source: @image-url("../icons/star.svg");
                colorize: Theme.skel-ghost;
                width: 18px; height: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                opacity: 0.25;
            }
        }

        Text {
            text: "Weekly recap";
            font-size: 13px;
            font-weight: 500;
            color: Theme.skel-text;
            horizontal-alignment: center;
        }

        Text {
            text: "Your crew's stats will appear after your first week together";
            font-size: 11px;
            color: Theme.skel-hint;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Rectangle { height: 4px; }

        VerticalLayout {
            spacing: 7px;

            for w in [55, 70, 40, 60]: HorizontalLayout {
                Rectangle { height: 7px; border-radius: 3px; background: Theme.skel-element; horizontal-stretch: 1; max-width: 1px * w; }
                Rectangle { horizontal-stretch: 1; }
                Rectangle { height: 7px; width: 30px; border-radius: 3px; background: Theme.skel-element; }
            }
        }
    }
}

// Voice clip skeleton (faint waveform)
component SkeletonClipCard inherits Rectangle {
    background: Theme.card-bg-skel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;

    VerticalLayout {
        Rectangle {
            min-height: 72px;
            vertical-stretch: 1;
            background: Theme.card-bg-inset;

            HorizontalLayout {
                alignment: center;
                spacing: 3px;
                padding-left: 20px;
                padding-right: 20px;

                for h in [0.35, 0.7, 1.0, 0.5, 0.9, 0.4, 0.8, 0.25, 0.65, 1.0, 0.45, 0.75, 0.3, 0.85, 0.55, 0.95, 0.35, 0.7]: Rectangle {
                    width: 3px;

                    Rectangle {
                        width: parent.width;
                        height: 40px * h;
                        y: (parent.height - self.height) / 2;
                        border-radius: 2px;
                        background: Theme.clip-amber;
                        opacity: 0.06;
                    }
                }
            }
        }

        VerticalLayout {
            padding: 10px;
            padding-left: 12px;
            spacing: 4px;
            vertical-stretch: 0;

            Text {
                text: "✂ VOICE CLIP · 0:30";
                font-size: 10px;
                font-weight: 700;
                color: Theme.skel-ghost;
            }

            Text {
                text: "Voice clips land here";
                font-size: 12px;
                font-weight: 500;
                color: Theme.skel-text;
            }

            Text {
                text: "Funny moment in voice? Clip it.";
                font-size: 11px;
                color: Theme.skel-hint;
            }
        }
    }
}

// Session skeleton
component SkeletonSessionCard inherits Rectangle {
