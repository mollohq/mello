import { Theme, MelloTextInput } from "../theme.slint";
import { CutButtonShape, CutButton } from "../components/cut.slint";

component InputField inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder;
    /// Accessible label. Defaults to the placeholder, which is the only caption most fields show.
    in property <string> label: root.placeholder;
    in property <bool> is-password: false;

    height: 52px;
    background: Theme.surface;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.graphic-med : Theme.graphic-light;

    ti := MelloTextInput {
        accessible-label: root.label;
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        font-family: Theme.font-mono;
        font-size: 14px;
        color: Theme.text-primary;
        horizontal-alignment: left;
        vertical-alignment: center;
        input-type: is-password ? InputType.password : InputType.text;
    }

    if ti.text == "": Text {
        letter-spacing: Theme.track-label;
        font-weight: Theme.weight-label;
        x: 16px;
        color: Theme.text-tertiary;
        font-family: Theme.font-label;
        font-size: 14px;
        vertical-alignment: center;
        text: placeholder;
    }
}

component AccentButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 52px;
    background: transparent;

    CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: Theme.cut;
        fill: root.enabled ? Theme.confirm : Theme.graphic-med;
    }

    btn-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            letter-spacing: Theme.track-label;
            text: label;
            font-family: Theme.font-label;
            font-size: 14px;
            font-weight: 600;
            color: root.enabled ? Theme.on-confirm : Theme.text-tertiary;
            vertical-alignment: center;
        }

        Image {
            source: @image-url("../icons/arrow-right.svg");
            width: 14px;
            height: 14px;
            colorize: root.enabled ? Theme.on-confirm : Theme.text-tertiary;
            y: (parent.height - self.height) / 2;
        }
    }
}

component AuthButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked();

    height: 56px;
    preferred-width: 0px;
    background: transparent;

    CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: Theme.cut;
        fill: auth-touch.has-hover ? Theme.graphic-med : Theme.graphic-light;
    }
    CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: Theme.cut;
        inset: Theme.keyline;
        fill: auth-touch.has-hover ? Theme.surface-hover : Theme.bg-app;
    }

    auth-touch := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        spacing: 16px;
        alignment: start;

        if has-icon: Image {
            source: icon;
            width: 20px;
            height: 20px;
            colorize: Theme.text-primary;
            y: (parent.height - self.height) / 2;
            opacity: 0.8;
        }

        Text {
            letter-spacing: Theme.track-label;
            font-weight: Theme.weight-label;
            text: label;
            font-family: Theme.font-label;
            font-size: 13px;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component SignInPanel inherits Rectangle {
    in property <string> error: "";
    /// The last sign-in found no account. The panel says so and offers
    /// "Start as a new player" instead of the raw server text (#67).
    in property <bool> account-missing: false;
    in property <bool> loading: false;

    property <string> si-email;
    property <string> si-password;

    callback back();
    /// Leave the panel for onboarding step 1, as a new player.
    callback start-new-player();
    callback signin-steam();
    callback signin-google();
    callback signin-twitch();
    callback signin-discord();
    callback signin-apple();
    callback signin-email(string, string);

    background: Theme.bg-app;

    VerticalLayout {
        padding-top: 80px;
        padding-left: 120px;
        padding-right: 120px;
        padding-bottom: 40px;
        spacing: 0px;

        // Back link
        HorizontalLayout {
            alignment: start;
            height: 32px;

            Rectangle {
                width: back-text.preferred-width + 16px;
                height: 32px;

                back-text := Text {
                    letter-spacing: Theme.track-label;
                    font-weight: Theme.weight-label;
                    text: "Back";
                    font-family: Theme.font-label;
                    font-size: 13px;
                    color: back-touch.has-hover ? Theme.text-secondary : Theme.text-tertiary;
                    vertical-alignment: center;
                }

                back-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Back";
                    clicked => {
                        root.back();
                    }
                }
            }
        }

        Rectangle {
            height: 32px;
        }

        // Header
        VerticalLayout {
            spacing: 8px;

            Text {
                font-family: Theme.font-display;
                text: "Sign In";
                font-size: 48px;
                font-weight: Theme.weight-display;
                color: Theme.text-primary;
                letter-spacing: -1.5px;
                horizontal-alignment: left;
            }

            Text {
                letter-spacing: Theme.track-label;
                font-weight: Theme.weight-label;
                text: "Sign in with an existing account.";
                font-size: 14px;
                color: Theme.text-secondary;
                font-family: Theme.font-label;
                horizontal-alignment: left;
            }
        }

        Rectangle {
            height: 48px;
        }

        // Auth grid (matches step 3 layout)
        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                width: 576px;
                spacing: 16px;

                // Row 1: Steam | Twitch
                HorizontalLayout {
                    spacing: 16px;

                    AuthButton {
                        horizontal-stretch: 1;
                        label: "Steam";
                        icon: @image-url("../icons/brands/steam.svg");
                        has-icon: true;
                        clicked => { root.signin-steam(); }
                    }

                    AuthButton {
                        horizontal-stretch: 1;
                        label: "Twitch";
                        icon: @image-url("../icons/brands/twitch.svg");
                        has-icon: true;
                        clicked => { root.signin-twitch(); }
                    }
                }

                // Row 2: Google | Apple
                HorizontalLayout {
                    spacing: 16px;

                    AuthButton {
                        horizontal-stretch: 1;
                        label: "Google";
                        icon: @image-url("../icons/brands/google.svg");
                        has-icon: true;
                        clicked => { root.signin-google(); }
                    }

                    AuthButton {
                        horizontal-stretch: 1;
                        label: "Apple";
                        icon: @image-url("../icons/brands/apple.svg");
                        has-icon: true;
                        clicked => { root.signin-apple(); }
                    }
                }

                // Row 3: Discord | Email+password (toggles form)
                HorizontalLayout {
                    spacing: 16px;

                    AuthButton {
                        horizontal-stretch: 1;
                        label: "Discord";
                        icon: @image-url("../icons/brands/discord.svg");
                        has-icon: true;
                        clicked => { root.signin-discord(); }
                    }

                    AuthButton {
                        horizontal-stretch: 1;
                        label: "Email + password";
                        icon: @image-url("../icons/mail.svg");
                        has-icon: true;
                        clicked => { show-email-form = true; }
                    }
                }

                // Divider + email form (only when toggled)
                if show-email-form: HorizontalLayout {
                    height: 32px;
                    spacing: 16px;
                    alignment: center;

                    Rectangle {
                        vertical-stretch: 0;
                        height: 1px;
                        horizontal-stretch: 1;
                        background: Theme.graphic-light;
                        y: parent.height / 2;
                    }

                    Text {
                        letter-spacing: Theme.track-label;
                        font-weight: Theme.weight-label;
                        text: "or";
                        font-family: Theme.font-label;
                        font-size: 12px;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        vertical-stretch: 0;
                        height: 1px;
                        horizontal-stretch: 1;
                        background: Theme.graphic-light;
                        y: parent.height / 2;
                    }
                }

                if show-email-form: InputField {
                    text <=> root.si-email;
                    placeholder: "Email";
                }

                if show-email-form: InputField {
                    text <=> root.si-password;
                    placeholder: "Password";
                    is-password: true;
                }

                if show-email-form: AccentButton {
                    label: loading ? "SIGNING IN…" : "SIGN IN";
                    enabled: !loading;
                    clicked => {
                        root.signin-email(root.si-email, root.si-password);
                    }
                }

                // A failed sign-in, by email or by a provider. Outside the
                // email form, so a provider failure shows too.
                if error != "" && !account-missing: Text {
                    font-weight: Theme.weight-display;
                    font-family: Theme.font-display;
                    text: error;
                    color: Theme.accent;
                    font-size: 13px;
                }

                if account-missing: HorizontalLayout {
                    spacing: 16px;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        Text {
                            font-weight: Theme.weight-display;
                            font-family: Theme.font-display;
                            text: error;
                            color: Theme.accent;
                            font-size: 15px;
                        }

                        Text {
                            letter-spacing: Theme.track-label;
                            font-weight: Theme.weight-label;
                            font-family: Theme.font-label;
                            text: "Start as a new player to make one.";
                            color: Theme.text-secondary;
                            font-size: 13px;
                        }
                    }

                    CutButton {
                        horizontal-stretch: 0;
                        width: new-player-text.preferred-width + 40px;
                        height: 44px;
                        outlined: true;
                        line-color: new-player-touch.has-hover ? Theme.action : Theme.action-line;
                        surface-color: Theme.bg-app;

                        new-player-text := Text {
                            letter-spacing: Theme.track-label;
                            font-weight: 600;
                            font-family: Theme.font-label;
                            text: "Start as a new player";
                            color: Theme.action;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        new-player-touch := TouchArea {
                            accessible-role: button;
                            accessible-label: "Start as a new player";
                            clicked => {
                                root.start-new-player();
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }

    property <bool> show-email-form: false;
}
