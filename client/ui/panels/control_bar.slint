import { Theme, MelloTextInput } from "../theme.slint";
import { UserAvatar } from "../components/avatar.slint";
import { GameIcon } from "../components/game_icon.slint";
import { CutShape, CutButtonShape, OctAvatar, OctMask } from "../components/cut.slint";

/// Control-bar icon button. `on` = a live toggle, so it wears a white
/// keyline. `danger` = leave call, the one red fill in the bar.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> on: false;
    in property <bool> alert: false;
    in property <bool> danger: false;
    callback clicked();
    width: 38px;
    height: 38px;

    CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: 9px;
        fill: danger ? Theme.live
            : on ? (ib-hover.has-hover ? Theme.action : Theme.action-line)
            : alert ? Theme.live
            : (ib-hover.has-hover ? Theme.raised-hover : Theme.raised);
    }
    // `on` and `alert` are outlines, not fills: only leave is a solid colour
    if on || alert: CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: 9px;
        inset: Theme.keyline;
        fill: ib-hover.has-hover
            ? (alert ? Theme.live-bg : Theme.raised-hover)
            : Theme.surface;
    }

    Image {
        source: icon;
        width: 19px;
        height: 19px;
        colorize: danger ? Theme.on-live
            : on ? Theme.action
            : alert ? Theme.live
            : (ib-hover.has-hover ? Theme.text-primary : Theme.text-secondary);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ib-hover := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ReactionButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color;
    in property <color> bg;
    in property <color> border-clr;
    callback clicked();
    width: 42px;
    height: 42px;
    border-radius: Theme.r-inner;
    background: react-hover.has-hover ? border-clr : bg;
    border-width: 1px;
    border-color: border-clr;
    Image {
        source: icon;
        width: 22px;
        height: 22px;
        colorize: icon-color;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    react-hover := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <color> dot-color: transparent;
    in property <bool> has-dot: false;
    in property <bool> checked: false;
    in property <bool> destructive: false;
    callback clicked();
    height: 34px;
    border-radius: Theme.r-inner;
    background: item-hover.has-hover ? Theme.hover-overlay : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;
        if has-dot: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: dot-color;
        }
        Text {
            text: label;
            font-family: Theme.font-body;
            font-size: Theme.font-md;
            font-weight: checked ? 600 : 300;
            color: destructive ? Theme.live : Theme.text-primary;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        if checked: Image {
            source: @image-url("../icons/checkmark.svg");
            width: 13px;
            height: 13px;
            colorize: Theme.action;
        }
    }

    item-hover := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component MenuSeparator inherits Rectangle {
    height: 1px;
    background: Theme.graphic-light;
}

export component ControlBar inherits Rectangle {
    in property <string> user-name: "";
    in property <string> user-initials: "";
    in property <image> user-avatar;
    in property <bool> has-user-avatar: false;
    in property <string> user-tag: "";
    in-out property <bool> mic-muted: false;
    in-out property <bool> deafened: false;
    in-out property <bool> in-voice: false;
    in property <bool> mic-permission-granted: true;
    in property <bool> mic-permission-denied: false;
    // 0=online, 1=idle, 2=dnd, 3=invisible
    in-out property <int> presence-status: 0;

    // Game sensing
    in property <bool> game-active: false;
    in property <string> game-id: "";
    in property <string> game-name: "";
    in property <string> game-short-name: "";
    in property <color> game-color: #2a2a30;
    in property <image> game-runtime-icon;
    in property <bool> game-has-runtime-icon: false;
    // Pre-filled post-game record from telemetry (e.g. "5W–3L · 2-win streak").
    // Empty when no telemetry result; the card falls back to "How'd it go?".
    in property <string> game-summary: "";
    in property <string> telemetry-hint: "";
    in property <bool> can-stream: false;
    in property <bool> is-hosting: false;
    in property <bool> is-watching: false;
    // 0=idle, 1=now-playing, 2=post-game, 3=moment-input, 4=confirmed
    in-out property <int> bar-state: 0;
    callback mic-toggled();
    callback deafen-toggled();
    callback voice-toggled();
    callback logout-clicked();
    callback presence-changed(int);
    callback settings-clicked();
    callback debug-toggled();
    callback request-mic-permission();
    callback open-mic-settings();
    callback go-live-clicked();

    // Game callbacks
    callback stream-requested();
    callback reaction-tapped(string);
    callback moment-submitted(string);
    callback moment-dismissed();
    // One-time "connect Riot account" CTA on the post-game card.
    in property <bool> riot-cta-visible: false;
    callback riot-cta-clicked();
    callback riot-cta-dismissed();

    // Clip
    callback clip-captured();
    in property <string> voice-channel-name: "";
    background: Theme.surface;
    border-width: 0px;
    border-radius: 0px;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.card-border;
    }

    // ============================================================
    //  LEFT  · you: avatar, name, channel, mic, headset | leave
    //  CENTRE· what you would stream: source pill + STREAM + caret
    //  RIGHT · capture: CLIP 30s, settings
    //  Left and right both stretch, so the centre is true centre.
    // ============================================================
    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;

        // ===================== LEFT =====================
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;

            // --- avatar: a person, so four corners are cut ---
            Rectangle {
                width: 40px;
                height: 40px;

                UserAvatar {
                    initials: user-initials != "" ? user-initials : "?";
                    avatar: user-avatar;
                    has-avatar: has-user-avatar;
                    muted: true;
                    size: 40px;
                    bg-color: Theme.surface;
                }

                // presence dot
                Rectangle {
                    x: parent.width - 13px;
                    y: parent.height - 13px;
                    width: 13px;
                    height: 13px;
                    border-radius: 7px;
                    background: Theme.surface;
                    Rectangle {
                        x: 2.5px;
                        y: 2.5px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: in-voice ? Theme.action
                            : (presence-status == 0 ? Theme.action
                            : (presence-status == 1 ? Theme.text-secondary
                            : (presence-status == 2 ? Theme.live : Theme.graphic-med)));
                    }
                }

                avatar-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        user-menu.show();
                    }
                }

                user-menu := PopupWindow {
                    x: 0;
                    y: -300px;
                    width: 220px;
                    Rectangle {
                        background: Theme.surface;
                        border-radius: Theme.r-outer;
                        border-width: 1px;
                        border-color: Theme.graphic-light;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #00000080;
                        drop-shadow-offset-y: 4px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;
                            Text {
                                text: "PRESENCE";
                                font-family: Theme.font-label;
                                font-size: 9.5px;
                                font-weight: Theme.weight-label;
                                letter-spacing: Theme.track-kicker;
                                color: Theme.text-tertiary;
                                height: 28px;
                                vertical-alignment: center;
                                x: 12px;
                            }

                            MenuItem {
                                label: "Online";
                                has-dot: true;
                                dot-color: Theme.action;
                                checked: presence-status == 0;
                                clicked => {
                                    presence-status = 0;
                                    presence-changed(0);
                                }
                            }

                            MenuItem {
                                label: "Idle";
                                has-dot: true;
                                dot-color: Theme.text-secondary;
                                checked: presence-status == 1;
                                clicked => {
                                    presence-status = 1;
                                    presence-changed(1);
                                }
                            }

                            MenuItem {
                                label: "Do Not Disturb";
                                has-dot: true;
                                dot-color: Theme.live;
                                checked: presence-status == 2;
                                clicked => {
                                    presence-status = 2;
                                    presence-changed(2);
                                }
                            }

                            MenuItem {
                                label: "Invisible";
                                has-dot: true;
                                dot-color: Theme.graphic-med;
                                checked: presence-status == 3;
                                clicked => {
                                    presence-status = 3;
                                    presence-changed(3);
                                }
                            }

                            MenuSeparator { }

                            MenuItem {
                                label: "Debug Audio";
                                clicked => {
                                    debug-toggled();
                                }
                            }

                            MenuSeparator { }

                            MenuItem {
                                label: "Log Out";
                                destructive: true;
                                clicked => {
                                    logout-clicked();
                                }
                            }
                        }
                    }
                }
            }

            // --- name + where you are ---
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: user-name != "" ? user-name : "Not connected";
                    font-family: Theme.font-display;
                    font-weight: Theme.weight-display;
                    font-size: 13px;
                    letter-spacing: -0.1px;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                if !in-voice && user-tag != "": Text {
                    text: user-tag;
                    font-family: Theme.font-label;
                    font-size: 9.5px;
                    font-weight: Theme.weight-label;
                    letter-spacing: Theme.track-label;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
                // The channel you are in is where you are: white, not red.
                if in-voice: HorizontalLayout {
                    spacing: 5px;
                    alignment: start;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 5px;
                        height: 5px;
                        border-radius: 3px;
                        background: Theme.action;
                    }

                    Text {
                        text: voice-channel-name != "" ? voice-channel-name : "VOICE";
                        font-family: Theme.font-label;
                        font-size: 9.5px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: Theme.action;
                        vertical-alignment: center;
                    }
                }
            }

            // --- mic + headset, then a divider, then leave ---
            if mic-permission-granted: IconButton {
                icon: mic-muted ? @image-url("../icons/mic-off.svg") : @image-url("../icons/mic.svg");
                on: in-voice && !mic-muted;
                alert: in-voice && mic-muted;
                clicked => {
                    mic-toggled();
                }
            }
            if mic-permission-granted: IconButton {
                icon: deafened ? @image-url("../icons/headphone-off.svg") : @image-url("../icons/headphones.svg");
                on: in-voice && !deafened;
                alert: in-voice && deafened;
                clicked => {
                    deafen-toggled();
                }
            }

            // Leave sits behind a divider so it is not adjacent to the toggles.
            if in-voice: Rectangle {
                width: 9px;
                Rectangle {
                    width: 1px;
                    height: 26px;
                    background: Theme.graphic-light;
                    x: 4px;
                    y: (parent.height - self.height) / 2;
                }
            }
            if in-voice: IconButton {
                icon: @image-url("../icons/phone-off.svg");
                danger: true;
                clicked => {
                    voice-toggled();
                }
            }
        }

        // ===================== CENTRE =====================

        // Idle or now playing: what you would stream, then how to start.
        if bar-state == 0 || bar-state == 1: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            alignment: center;
            cross-axis-alignment: center;

            // source pill — names the source before you press anything
            if game-active: Rectangle {
                width: source-row.preferred-width + 20px;
                height: 44px;

                CutShape {
                    width: parent.width;
                    height: parent.height;
                    n: 9px;
                    corner: "tr";
                    fill: Theme.raised;
                }

                source-row := HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 14px;
                    spacing: 9px;
                    cross-axis-alignment: center;

                    GameIcon {
                        game-id: game-id;
                        short-name: game-short-name;
                        badge-color: game-color;
                        runtime-icon: game-runtime-icon;
                        has-runtime-icon: game-has-runtime-icon;
                        size: 32px;
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: start;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.action;
                            }

                            Text {
                                text: "NOW PLAYING";
                                font-family: Theme.font-label;
                                font-size: 8.5px;
                                font-weight: Theme.weight-label;
                                letter-spacing: Theme.track-label;
                                color: Theme.text-secondary;
                            }
                        }

                        Text {
                            text: game-name;
                            font-family: Theme.font-display;
                            font-size: 12.5px;
                            font-weight: Theme.weight-display;
                            color: Theme.text-primary;
                        }

                        // One-time telemetry setup step (e.g. a launch option)
                        if telemetry-hint != "": Text {
                            text: telemetry-hint;
                            font-family: Theme.font-body;
                            font-size: 10px;
                            font-weight: Theme.weight-sentence;
                            color: Theme.text-tertiary;
                        }
                    }
                }
            }

            // STREAM + caret are one control, so they touch.
            HorizontalLayout {
                spacing: 0px;
                cross-axis-alignment: center;
                // STREAM — white, because white is the action colour
                Rectangle {
                    width: stream-label.preferred-width + 40px;
                    height: 40px;

                    CutShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        corner: "tl";
                        fill: can-stream
                            ? (stream-ta.has-hover ? Theme.action-press : Theme.action)
                            : Theme.raised;
                    }

                    stream-label := Text {
                        text: is-hosting ? "LIVE" : "STREAM";
                        font-family: Theme.font-label;
                        font-size: 10px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: can-stream ? Theme.on-action : Theme.text-tertiary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    stream-ta := TouchArea {
                        mouse-cursor: can-stream ? pointer : default;
                        clicked => {
                            if (can-stream) {
                                stream-requested();
                            }
                        }
                    }
                }

                // caret — the same shape continues: stream something else
                Rectangle {
                    width: 30px;
                    height: 40px;

                    CutShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        corner: "br";
                        fill: caret-ta.has-hover ? Theme.action-press : Theme.action;
                    }
                    // hairline between the button and the caret
                    Rectangle {
                        x: 0;
                        width: 1px;
                        height: parent.height;
                        background: #12121447;
                    }

                    Image {
                        source: @image-url("../icons/chevron-down.svg");
                        width: 14px;
                        height: 14px;
                        colorize: Theme.on-action;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    caret-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            go-live-clicked();
                        }
                    }
                }
            }

        }

        // State 2: Post-game prompt
        if bar-state == 2: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            HorizontalLayout {
                spacing: 16px;
                cross-axis-alignment: center;
                GameIcon {
                    game-id: game-id;
                    short-name: game-short-name;
                    badge-color: game-color;
                    runtime-icon: game-runtime-icon;
                    has-runtime-icon: game-has-runtime-icon;
                    size: 32px;
                }

                Text {
                    text: game-summary != "" ? game-summary : "How'd it go?";
                    font-family: Theme.font-body;
                    font-weight: Theme.weight-sentence;
                    font-size: 13px;
                    color: game-summary != "" ? Theme.text-primary : Theme.text-body;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 10px;
                    ReactionButton {
                        icon: @image-url("../icons/trophy.svg");
                        icon-color: Theme.text-primary;
                        bg: Theme.raised;
                        border-clr: Theme.graphic-med;
                        clicked => {
                            reaction-tapped("win");
                        }
                    }

                    ReactionButton {
                        icon: @image-url("../icons/sad-face.svg");
                        icon-color: Theme.text-secondary;
                        bg: Theme.raised;
                        border-clr: Theme.graphic-med;
                        clicked => {
                            reaction-tapped("loss");
                        }
                    }

                    ReactionButton {
                        icon: @image-url("../icons/star.svg");
                        icon-color: Theme.text-secondary;
                        bg: Theme.raised;
                        border-clr: Theme.graphic-med;
                        clicked => {
                            reaction-tapped("highlight");
                        }
                    }
                }

                if riot-cta-visible: Rectangle {
                    width: 1px;
                    height: 24px;
                    background: Theme.graphic-light;
                }
                if riot-cta-visible: Rectangle {
                    width: riot-cta-label.preferred-width + 28px;
                    height: 34px;

                    CutShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        corner: "tl";
                        fill: Theme.action;
                    }
                    CutShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        corner: "tl";
                        inset: Theme.keyline;
                        fill: riot-cta-ta.has-hover ? Theme.raised-hover : Theme.surface;
                    }

                    riot-cta-label := Text {
                        text: "GET VERIFIED STATS";
                        font-family: Theme.font-label;
                        font-size: 9.5px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: Theme.action;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    riot-cta-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            riot-cta-clicked();
                        }
                    }
                }
                if riot-cta-visible: Rectangle {
                    width: 24px;
                    height: 32px;

                    Image {
                        source: @image-url("../icons/x.svg");
                        width: 12px;
                        height: 12px;
                        colorize: riot-cta-x-ta.has-hover ? Theme.text-primary : Theme.text-tertiary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    riot-cta-x-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            riot-cta-dismissed();
                        }
                    }
                }
            }
        }

        // State 3: Moment text input
        if bar-state == 3: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: moment-input.has-focus ? Theme.action : Theme.graphic-light;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: start;
                        Image {
                            source: @image-url("../icons/star.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }

                        moment-input := MelloTextInput {
                            font-family: Theme.font-body;
                            font-weight: Theme.weight-sentence;
                            font-size: 13px;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            accepted => {
                                if self.text != "" {
                                    moment-submitted(self.text);
                                    self.text = "";
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 38px;
                    height: 38px;

                    CutShape {
                        width: parent.width;
                        height: parent.height;
                        n: Theme.cut;
                        corner: "tl";
                        fill: send-ta.has-hover ? Theme.action-press : Theme.action;
                    }

                    Image {
                        source: @image-url("../icons/arrow-right.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.on-action;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    send-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if moment-input.text != "" {
                                moment-submitted(moment-input.text);
                                moment-input.text = "";
                            }
                        }
                    }
                }
            }
        }

        // State 4: Confirmed
        if bar-state == 4: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;
                Image {
                    source: @image-url("../icons/checkmark.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.action;
                }

                Text {
                    text: "Moment shared with crew";
                    font-family: Theme.font-body;
                    font-weight: Theme.weight-sentence;
                    font-size: 13px;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }
        }

        // ===================== RIGHT =====================
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            alignment: end;
            cross-axis-alignment: center;

            // CLIP wears red: pressing it starts a recording.
            if mic-permission-granted && in-voice: Rectangle {
                width: clip-row.preferred-width + 28px;
                height: 38px;

                CutButtonShape {
                    width: parent.width;
                    height: parent.height;
                    n: 9px;
                    fill: Theme.live;
                }
                CutButtonShape {
                    width: parent.width;
                    height: parent.height;
                    n: 9px;
                    inset: Theme.keyline;
                    fill: clip-hover.has-hover ? Theme.live-bg : Theme.surface;
                }

                clip-row := HorizontalLayout {
                    spacing: 7px;
                    alignment: center;
                    cross-axis-alignment: center;
                    Image {
                        source: @image-url("../icons/scissors-line-dashed.svg");
                        colorize: Theme.live;
                        width: 15px;
                        height: 15px;
                    }

                    Text {
                        text: "CLIP 30S";
                        font-family: Theme.font-label;
                        font-size: 9.5px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: Theme.live;
                        vertical-alignment: center;
                    }
                }

                clip-hover := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        clip-captured();
                    }
                }
            }

            if mic-permission-granted: IconButton {
                icon: @image-url("../icons/settings.svg");
                clicked => {
                    settings-clicked();
                }
            }

            // --- mic permission CTA (when no mic access) ---
            if !mic-permission-granted: Text {
                text: mic-permission-denied ? "Microphone access denied — enable it in System Settings" : "Microphone access is needed for voice chat";
                font-family: Theme.font-body;
                font-weight: Theme.weight-sentence;
                font-size: 12px;
                color: Theme.text-body;
                vertical-alignment: center;
            }
            if !mic-permission-granted: Rectangle {
                width: mic-cta-row.preferred-width + 32px;
                height: 38px;

                CutButtonShape {
                    width: parent.width;
                    height: parent.height;
                    n: Theme.cut;
                    fill: mic-btn-touch.has-hover ? Theme.action-press : Theme.action;
                }

                mic-cta-row := HorizontalLayout {
                    alignment: center;
                    cross-axis-alignment: center;
                    spacing: 8px;
                    Text {
                        text: mic-permission-denied ? "OPEN SETTINGS" : "ALLOW MICROPHONE";
                        font-family: Theme.font-label;
                        font-size: 9.5px;
                        font-weight: Theme.weight-label;
                        letter-spacing: Theme.track-label;
                        color: Theme.on-action;
                        vertical-alignment: center;
                    }
                }

                mic-btn-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.mic-permission-denied) {
                            root.open-mic-settings();
                        } else {
                            root.request-mic-permission();
                        }
                    }
                }
            }
        }
    }
}

export component Preview inherits Rectangle {
    width: 900px;
    height: Theme.control-bar-height;
    background: #111114;
    ControlBar {
        width: parent.width;
        height: parent.height;
        user-name: "Navigator";
        user-initials: "N";
        user-tag: "#001";
        in-voice: true;
        voice-channel-name: "GENERAL";
        mic-muted: false;
        presence-status: 0;
        game-active: true;
        game-id: "counter-strike-2";
        game-name: "Counter-Strike 2";
        game-short-name: "CS2";
        game-color: #DE9B35;
        can-stream: true;
        bar-state: 1;
    }
}
