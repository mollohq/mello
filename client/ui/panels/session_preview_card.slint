import { Theme } from "../theme.slint";
import { CutShape } from "../components/cut.slint";
import { UserAvatar } from "../components/avatar.slint";
import { StreamTag, PlayRing, FootageWash } from "../components/stream_hero.slint";
import { CutMask, CutButtonShape } from "../components/cut.slint";


export component SessionPreviewCard inherits Rectangle {
    in property <[string]> snapshot-urls;
    in property <string> session-id;
    in property <string> title;
    in property <string> game-name;
    in property <string> streamer-username;
    in property <string> streamer-initials;
    in property <int> streamer-hue-index: 0;
    in property <int> duration-min;
    in property <int> peak-viewers;
    in property <int> clip-count;
    in property <string> time-since-ended;
    in property <bool> is-hero;
    in property <bool> was-seen: false;

    in property <bool> snapshot-loading: false;
    in property <image> snapshot-poster;
    in property <bool> snapshot-poster-ready: false;
    in property <bool> snapshot-error: false;
    in property <image> snapshot-playback-frame;
    in property <int> snapshot-playback-index: 0;
    in property <int> snapshot-playback-revision: 0;

    callback session-seen(/* session_id */ string);
    callback session-preview-request-frame(/* session_id */ string, /* index */ int);

    property <int> frame-index: 0;
    property <bool> fading: false;
    property <bool> playing: false;
    property <bool> paused: false;
    property <bool> finished: false;
    property <int> frames-shown: 0;
    property <bool> seen-fired: false;
    property <int> last-playback-revision: 0;

    property <int> image-count: snapshot-urls.length;
    property <bool> has-urls: image-count > 0;
    property <bool> show-placeholder: !has-urls || snapshot-error;
    property <bool> show-loading: has-urls && snapshot-loading && !snapshot-poster-ready && !snapshot-error;
    property <bool> show-thumbnail: has-urls && !snapshot-error && !show-loading;
    property <bool> can-cycle: image-count > 1;

    property <int> duration-hours: duration-min / 60;
    property <int> duration-remaining-mins: Math.mod(duration-min, 60);
    property <string> duration-text: duration-hours > 0
        ? duration-hours + "h " + duration-remaining-mins + "m"
        : duration-min + "m";

    // "1 h 12 min", as the hero chip reads (frame C).
    property <string> duration-hero-text: duration-hours > 0
        ? duration-hours + " h " + (duration-remaining-mins < 10 ? "0" : "") + duration-remaining-mins + " min"
        : duration-min + " min";

    property <int> seen-threshold: image-count * 7 / 10;

    property <image> current-image;
    property <image> next-image;
    property <bool> has-current: false;

    property <int> next-index: image-count > 0 ? Math.mod((frame-index + 1), image-count) : 0;

    background: transparent;
    border-width: 0px;
    clip: true;

    // A content card cuts at the bottom: the snapshot fills the top edge
    // and must not be cropped.
    // The hero is footage edge to edge and cuts at the top right (frames C
    // and D). A standard card keeps the bottom cut under its strip.
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: root.is-hero ? "tr" : "br";
        fill: card-hover.has-hover ? Theme.graphic-med : Theme.card-border;
    }
    CutShape {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: root.is-hero ? "tr" : "br";
        inset: Theme.keyline;
        fill: card-hover.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    }

    changed snapshot-poster-ready => {
        if snapshot-poster-ready && !playing {
            root.current-image = snapshot-poster;
            root.has-current = true;
        }
    }

    changed snapshot-playback-revision => {
        if playing && snapshot-playback-revision != last-playback-revision {
            last-playback-revision = snapshot-playback-revision;
            if snapshot-playback-index == next-index {
                next-image = snapshot-playback-frame;
                fading = true;
            }
        }
    }

    VerticalLayout {
        padding: root.is-hero ? Theme.keyline : 0px;

        Rectangle {
            vertical-stretch: 3;
            min-height: is-hero ? 200px : 110px;
            clip: true;

            // Loading skeleton
            if show-loading: Rectangle {
                background: Theme.card-bg-skel;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: is-hero ? 48px : 36px;
                    height: is-hero ? 48px : 36px;
                    border-radius: is-hero ? 24px : 18px;
                    border-width: 1.5px;
                    border-color: Theme.skel-ghost;
                    background: transparent;

                    Image {
                        source: @image-url("../icons/monitor.svg");
                        colorize: Theme.skel-ghost;
                        width: is-hero ? 22px : 16px;
                        height: is-hero ? 22px : 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Poster / playback
            if show-thumbnail: Rectangle {
                background: Theme.media-ground;

                Image {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    source: root.next-image;
                    image-fit: cover;
                }

                Image {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    source: playing ? root.current-image : root.snapshot-poster;
                    image-fit: cover;
                    opacity: fading ? 0.0 : 1.0;
                    animate opacity { duration: 300ms; easing: ease-in-out; }
                }

                if !root.is-hero: Rectangle {
                    x: 0;
                    y: parent.height - 40px;
                    width: parent.width;
                    height: 40px;
                    background: @linear-gradient(0deg, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0) 100%);
                }
                if root.is-hero: FootageWash {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                }

                if clip-count > 0: Rectangle {
                    x: is-hero ? parent.width - self.width - 18px : 8px;
                    y: is-hero ? 12px : 8px;
                    width: clip-txt.preferred-width + (is-hero ? 28px : 22px);
                    height: is-hero ? 22px : 20px;
                    border-radius: is-hero ? 5px : 4px;
                    background: Theme.clip-amber;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 3px;

                        Image {
                            source: @image-url("../icons/scissors.svg");
                            colorize: Theme.on-media;
                            width: is-hero ? 10px : 9px;
                            height: is-hero ? 10px : 9px;
                            y: (parent.height - self.height) / 2;
                        }

                        clip-txt := Text {
                            text: clip-count > 1 ? clip-count + " clips" : "1 clip";
                            font-size: is-hero ? 10px : 9px;
                            font-weight: 700;
                            color: Theme.on-media;
                            vertical-alignment: center;
                        }
                    }
                }

                if (!root.playing || root.finished || root.paused) && !root.is-hero: Rectangle {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    background: Theme.over-media-soft;
                }

                // The hero plays from a ring at 46% of its height (frame C).
                if root.is-hero && snapshot-poster-ready && (!root.playing || root.finished): PlayRing {
                    x: (parent.width - self.width) / 2;
                    y: parent.height * 0.46 - self.height / 2;
                    size: 56px;
                }

                if !root.is-hero && snapshot-poster-ready && (!root.playing || root.finished): Rectangle {
                    property <int> btn-size: is-hero ? 52 : 32;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1px * btn-size;
                    height: 1px * btn-size;
                    border-radius: 1px * btn-size / 2;
                    background: Theme.over-media;

                    Image {
                        source: @image-url("../icons/play.svg");
                        width: is-hero ? 18px : 12px;
                        height: is-hero ? 18px : 12px;
                        colorize: Theme.on-media;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                if (!root.playing || root.finished || root.paused) && !root.is-hero: Rectangle {
                    x: parent.width - self.width - (is-hero ? 10px : 8px);
                    y: parent.height - self.height - (is-hero ? 10px : 8px);
                    width: dur-text.preferred-width + 16px;
                    height: is-hero ? 22px : 20px;
                    border-radius: 4px;
                    background: Theme.over-media;

                    dur-text := Text {
                        text: root.duration-text;
                        font-size: 11px;
                        color: Theme.on-media;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // The hero's label and text sit on the footage (frame C).
                if root.is-hero: StreamTag {
                    x: 18px;
                    y: 14px;
                    label: "STREAM";
                }
                if root.is-hero && (!root.playing || root.finished || root.paused): VerticalLayout {
                    x: 18px;
                    y: 0px;
                    width: parent.width - 36px;
                    height: parent.height - 18px;
                    alignment: end;
                    spacing: 0px;

                    Text {
                        height: 14px;
                        text: root.time-since-ended.to-uppercase();
                        font-family: Theme.font-label;
                        font-weight: Theme.weight-label;
                        font-size: 9.5px;
                        letter-spacing: 1.9px;
                        color: #A2A2A8;
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;
                            Text {
                                text: root.title;
                                font-family: Theme.font-display;
                                font-weight: Theme.weight-display-bold;
                                font-size: 28px;
                                letter-spacing: -0.84px;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                height: 28px;
                                cross-axis-alignment: center;
                                UserAvatar {
                                    bg-color: #000000;
                                    initials: root.streamer-initials;
                                    color-index: root.streamer-hue-index;
                                    size: 28px;
                                }
                                Text {
                                    text: root.streamer-username;
                                    font-family: Theme.font-display;
                                    font-weight: Theme.weight-display;
                                    font-size: 15px;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.game-name;
                                    font-family: Theme.font-body;
                                    font-weight: Theme.weight-sentence;
                                    font-size: 13px;
                                    color: #A2A2A8;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.peak-viewers > 0: Text {
                                    text: root.peak-viewers + " watched";
                                    font-family: Theme.font-body;
                                    font-weight: Theme.weight-sentence;
                                    font-size: 13px;
                                    color: #A2A2A8;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        // The length of the stream: a black chip, cut at two corners.
                        Rectangle {
                            width: dur-hero.preferred-width + 24px;
                            height: 34px;
                            y: parent.height - self.height;
                            CutButtonShape {
                                width: parent.width; height: parent.height;
                                n: 5px;
                                fill: #000000A8;
                            }
                            dur-hero := Text {
                                x: 12px;
                                text: root.duration-hero-text;
                                font-family: Theme.font-display;
                                font-weight: Theme.weight-display-bold;
                                font-size: 20px;
                                letter-spacing: -0.4px;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                height: parent.height;
                            }
                        }
                    }
                }

                if root.playing && !root.finished: Rectangle {
                    x: 0;
                    y: parent.height - 22px;
                    width: parent.width;
                    height: 22px;
                    background: Theme.over-media-bar;

                    Rectangle {
                        x: 4px;
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 3px;

                        Image {
                            source: root.paused
                                ? @image-url("../icons/play.svg")
                                : @image-url("../icons/pause.svg");
                            width: 9px;
                            height: 9px;
                            colorize: Theme.on-media;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        TouchArea {
                            accessible-role: button;
                            accessible-label: root.paused ? "Play" : "Pause";
                            mouse-cursor: pointer;
                            clicked => { root.paused = !root.paused; }
                        }
                    }

                    Rectangle {
                        x: 26px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 34px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.over-media-line;

                        Rectangle {
                            x: 0; y: 0;
                            width: root.image-count > 1
                                ? parent.width * (root.frame-index * 1000 / (root.image-count - 1)) / 1000
                                : parent.width;
                            height: parent.height;
                            border-radius: 1.5px;
                            background: Theme.on-media;
                            animate width { duration: 300ms; easing: ease-out; }
                        }
                    }
                }
            }

            // No snapshots fallback
            if show-placeholder: Rectangle {
                // Graphite. The old hero placeholder was a purple gradient,
                // which is colour on chrome — and there is no footage here
                // to justify it.
                background: is-hero
                    ? @linear-gradient(135deg, Theme.card-bg 0%, Theme.card-bg-inset 100%)
                    : Theme.card-bg-inset;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: is-hero ? 48px : 36px;
                    height: is-hero ? 48px : 36px;
                    border-radius: is-hero ? 24px : 18px;
                    border-width: 1.5px;
                    border-color: Theme.skel-ghost;
                    background: transparent;

                    Image {
                        source: @image-url("../icons/monitor.svg");
                        colorize: Theme.skel-ghost;
                        width: is-hero ? 22px : 16px;
                        height: is-hero ? 22px : 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Advance slideshow (manual play only)
            Timer {
                interval: 1000ms;
                running: root.playing && !root.paused && root.can-cycle && root.visible && !root.finished && root.has-current && !root.fading;
                triggered => {
                    root.session-preview-request-frame(root.session-id, root.next-index);
                }
            }

            Timer {
                interval: 300ms;
                running: root.fading && root.visible;
                triggered => {
                    root.frames-shown += 1;

                    if !root.seen-fired && root.frames-shown >= root.seen-threshold && root.session-id != "" {
                        root.seen-fired = true;
                        root.session-seen(root.session-id);
                    }

                    if root.next-index == 0 {
                        root.current-image = root.next-image;
                        root.frame-index = root.image-count - 1;
                        root.fading = false;
                        root.finished = true;
                        root.playing = false;
                        root.next-image = root.snapshot-poster;
                    } else {
                        root.current-image = root.next-image;
                        root.frame-index = root.next-index;
                        root.fading = false;
                    }
                }
            }
        }

        if !is-hero: VerticalLayout {
            padding: 10px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 4px;
            vertical-stretch: 0;

            HorizontalLayout {
                spacing: 4px;
                height: 14px;

                Image {
                    source: @image-url("../icons/monitor.svg");
                    colorize: Theme.accent;
                    width: 10px;
                    height: 10px;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "SESSION · " + root.duration-text;
                    font-size: 10px;
                    font-weight: 700;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 500;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: root.time-since-ended;
                font-size: 11px;
                color: Theme.text-sub;
            }
        }
    }

    // The footage is a rectangle: put the cut corner back, with its keyline.
    if root.is-hero: CutMask {
        width: parent.width;
        height: parent.height;
        n: Theme.notch;
        corner: "tr";
        fill: Theme.bg-app;
    }
    if root.is-hero: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: card-hover.has-hover ? Theme.graphic-med : Theme.card-border;
        stroke-width: 1px;
        commands: "M \{(self.width - Theme.notch) / 1px} 0 L \{self.width / 1px} \{Theme.notch / 1px}";
    }

    card-hover := TouchArea {
        accessible-role: button;
        accessible-label: root.title;
        mouse-cursor: pointer;
        clicked => {
            if root.playing && !root.finished {
                root.paused = !root.paused;
            } else if snapshot-poster-ready && root.can-cycle {
                root.frame-index = 0;
                root.frames-shown = 0;
                root.finished = false;
                root.fading = false;
                root.paused = false;
                root.current-image = root.snapshot-poster;
                root.has-current = true;
                root.playing = true;
                root.session-preview-request-frame(root.session-id, root.next-index);
            }
        }
    }
}

// Headless preview:
//   slint-viewer --screenshot out.png --component Preview \
//     client/ui/panels/session_preview_card.slint
export component Preview inherits Rectangle {
    width: 900px;
    height: 380px;
    background: Theme.bg-app;

    HorizontalLayout {
        padding: 20px;
        spacing: 16px;

        // hero, no snapshots: the placeholder path
        SessionPreviewCard {
            horizontal-stretch: 2;
            is-hero: true;
            title: "b0bben streamed Counter-Strike 2";
            game-name: "Counter-Strike 2";
            streamer-username: "b0bben";
            streamer-initials: "b0";
            duration-min: 22;
            peak-viewers: 3;
            clip-count: 2;
            time-since-ended: "Tuesday";
        }

        // standard, still loading
        SessionPreviewCard {
            horizontal-stretch: 1;
            title: "alice streamed Valorant";
            game-name: "Valorant";
            streamer-username: "alice";
            streamer-initials: "al";
            duration-min: 74;
            peak-viewers: 5;
            time-since-ended: "Yesterday";
            snapshot-loading: true;
        }
    }
}

