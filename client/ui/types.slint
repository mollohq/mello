export struct CrewData {
    id: string,
    name: string,
    // Two letters for the crew tile. The full name never fits a 32px tile.
    initials: string,
    description: string,
    member-count: int,
    // Capacity, so the UI can tell a full crew from a joinable one. Dropping
    // this is how onboarding let a user pick a full crew and only discover it
    // at finalize, with "Group is full" — after their account already existed.
    max-members: int,
    online-count: int,

    avatar: image,
    has-avatar: bool,

    has-stream: bool,
    stream-name: string,

    voice-count: int,
    v0-initials: string, v0-name: string, v0-speaking: bool,
    v1-initials: string, v1-name: string, v1-speaking: bool,
    v2-initials: string, v2-name: string, v2-speaking: bool,
    v3-initials: string, v3-name: string, v3-speaking: bool,

    msg-count: int,
    m0-author: string, m0-text: string,
    m1-author: string, m1-text: string,

    unread-count: int,
    unread-mention: bool,

    sfu-enabled: bool,

    catchup-text: string,
    has-catchup: bool,
    catchup-count: int,
    catchup-loaded: bool,

    game-count: int,
    g0-name: string, g0-initial: string, g0-count: int,
    g1-name: string, g1-initial: string, g1-count: int,
    g2-name: string, g2-initial: string, g2-count: int,
    g3-name: string, g3-initial: string, g3-count: int,
    g4-name: string, g4-initial: string, g4-count: int,

    clip-count: int,
}

// Recap "this week in games" rows (spec 19). Avatars resolve client-side from
// the cache by user-id; fall back to the initials dot when not cached.
export struct RecapLbRow {
    name: string,
    initials: string,
    record: string,      // "12W 5L"
    color-index: int,
    avatar: image,
    has-avatar: bool,
}

export struct RecapAwardRow {
    kind: string,        // "grinder" | "heater" | "skid"
    title: string,
    name: string,
    detail: string,
}

// A crew member shown as an octagon (the invite card).
export struct H2hPerson {
    id: string,
    name: string,
    initials: string,
    hue-index: int,
    avatar: image,
    has-avatar: bool,
}

// A belt that moved, as the sealed chip and the centre view draw it (plan
// SEALED-REVEAL.md). One move has one `key` and one `seed`, so the code is the
// same in every slot. `code` is the Path commands of the 15 by 6 cells, 4 units
// square on a pitch of 5. `cells` holds the same cells, for the charge.
// `kind` is how the value counts up: 0 count, 1 hours and minutes, 2 clock.
export struct BeltReveal {
    /// "title_id:moved_at_ms". Empty: this chip is not a belt move.
    key: string,
    sealed: bool,
    seed: int,
    code: string,
    cells: [bool],
    title: string,
    icon: image,
    /// Identity hue of the new holder.
    hue-index: int,
    kind: int,
    amount: float,
    decimals: int,
    unit: string,
    stat: string,
    holder: H2hPerson,
    prev: H2hPerson,
    /// The viewer's own value on a new crew (day 0). `holder` is the viewer,
    /// the face says "You" and has no `prev`. The key is `own:<title_id>:<crew_id>`.
    own: bool,
}

// The sealed state of a weekly recap. `bright` and `dim` are Path commands of
// the field, in a box of 160 by 248 units.
export struct RecapSeal {
    key: string,
    sealed: bool,
    seed: int,
    bright: string,
    dim: string,
    /// The level of each of the 13 by 20 cells: 0 none, 1 dim, 2 bright. The
    /// centre view draws these cell by cell while the field clears.
    levels: [int],
}

// A head2head title that changed hands in the recap week. Value and unit are
// split as on TitleChip. Hues are identity hue indexes of the two members.
export struct RecapBeltMovedRow {
    title: string,
    icon: image,
    value: string,
    unit: string,
    prev-name: string,
    prev-initials: string,
    prev-hue: int,
    prev-avatar: image,
    prev-has-avatar: bool,
    holder-name: string,
    holder-initials: string,
    holder-hue: int,
    holder-avatar: image,
    holder-has-avatar: bool,
    belt: BeltReveal,
}

// One title a member holds, for the full-screen recap.
export struct RecapHeldTitle {
    title: string,
    icon: image,
}

// A member and the number of titles they hold when the recap was written.
export struct RecapBeltHeldRow {
    /// 1 for the most belts. Members with the same count share a rank, so the
    /// next one skips: 1, 2, 3, 4, 4, 4.
    rank: int,
    name: string,
    initials: string,
    hue: int,
    avatar: image,
    has-avatar: bool,
    count: int,
    titles: [RecapHeldTitle],
}

// A member in a weekly recap: the most active and the most clipped, and the
// members of the clip of the week. `count` is minutes for the most active and
// clips for the most clipped.
export struct RecapPerson {
    name: string,
    initials: string,
    hue: int,
    avatar: image,
    has-avatar: bool,
    count: int,
}

// One game of the weekly recap with the time the crew spent in it. The art
// ladder is the recent games tile's.
export struct RecapGameRow {
    game-id: string,
    name: string,
    monogram: string,
    hue-index: int,
    icon: image,
    has-icon: bool,
    capsule: image,
    has-capsule: bool,
    minutes: int,
}

// The longest clip of the recap week. `clip-path` is "" when the week had no
// clip, and the opened recap shows no section then.
export struct RecapClip {
    clip-path: string,
    title: string,
    duration: string,
    duration-ms: int,
    game-name: string,
    when: string,
    waveform: [float],
    people: [RecapPerson],
    names: string,
}

// One game tile on the recent games card (CLIPS 7, 22 section 3.4). Keyed by
// game id. Art ladder: the runtime icon (server or crew), else the local
// Steam header (`capsule`), else the two-letter `monogram` in the game's hue.
// `hours` is "4,167 H", or the launcher ("EPIC") when the hours are unknown.
export struct RecentGameTile {
    game-id: string,
    game-name: string,
    monogram: string,
    hue-index: int,
    game-icon: image,
    has-icon: bool,
    capsule: image,
    has-capsule: bool,
    hours: string,
    tracked: bool,
    // The members who have the game installed or played it, as small
    // octagons under the tile of the poster grid. Empty when the server
    // does not say.
    owners: [H2hPerson],
    // When it was last played: "Yesterday", "2 days ago". "" when unknown.
    when: string,
    // The list row's caption on one line: when it was last played, then the
    // hours, "2 days ago, 4 h". Either part is left out when unknown.
    caption: string,
}

// One head2head title and who holds it. Display strings are pre-formatted in
// Rust (src/head2head.rs). `hue-index` is the holder's identity colour, the
// same index `UserAvatar` takes.
export struct TitleHeld {
    id: string,
    icon: image,
    title: string,
    value: string,
    unit: string,
    hue-index: int,
    holder-id: string,
    held-days: int,
    /// "held 9 days", "held 1 day", or "" under one day. Built in Rust.
    held-label: string,
    moved-recent: bool,
    /// The move behind the chip. `belt.key` is empty for a title that never
    /// changed hands, or when the chip shows a member who does not hold it.
    belt: BeltReveal,
}

// One row of the head2head cell: the viewer against one member.
export struct H2hPairRow {
    /// User id of the other member, so a late avatar finds the row.
    id: string,
    name: string,
    initials: string,
    hue-index: int,
    avatar: image,
    has-avatar: bool,
    you-initials: string,
    you-hue-index: int,
    you-avatar: image,
    you-has-avatar: bool,
    you-count: int,
    them-count: int,
    has-chip: bool,
    /// Every contested title of the pair ties: the chip is drawn without the
    /// holder's hue.
    chip-ties: bool,
    chip: TitleHeld,
    /// A belt of this pair moved in the last 24 h and the viewer has not
    /// opened the feed since. Draws the red dot before the label.
    moved-recent: bool,
}

// The head2head feed entry as the UI draws it. `variant` is the placement:
// "wide" (crew of one), "versus" (a belt moved), "cell" (two to four
// members, with seats) or "cell-full" (five or more, no seats).
// The belt that moved, as the hero of a quiet feed (mockup frame E): who held
// it, who holds it now, and the line that says so. All text is built in Rust.
export struct BeltHeroData {
    title-id: string,
    title: string,
    icon: image,
    // The new holder's identity hue, for the chip and the number.
    hue-index: int,
    prev: H2hPerson,
    prev-value: string,
    holder: H2hPerson,
    holder-value: string,
    // "2 days ago".
    age: string,
    // "Sara took Night Owl from Bob".
    headline: string,
    // "03:40 beats 03:14." Empty when a value is not known.
    detail: string,
}

export struct Head2headData {
    variant: string,
    member-count: int,
    open-seats: int,
    belt-moved-recent: bool,
    // Every contested title.
    titles: [TitleHeld],
    // The titles drawn as chips: the viewer's (wide) or four led by the
    // moved title (versus).
    chips: [TitleHeld],
    pairs: [H2hPairRow],
    // Wide: the viewer is `left`. Versus: `left` is the viewer, `right` the
    // other member.
    left-id: string, left-name: string, left-initials: string, left-hue-index: int,
    left-avatar: image, left-has-avatar: bool,
    right-id: string, right-name: string, right-initials: string, right-hue-index: int,
    right-avatar: image, right-has-avatar: bool,
    // Every pair of the viewer, and how many the cell does not draw.
    pairs-total: int,
    more-pairs: int,
    left-score: int, right-score: int,
    // Invite card: the first members, and how many more there are.
    members: [H2hPerson],
    more-members: int,
    // Belt hero (variant "belt").
    belt: BeltHeroData,
}

// A game in progress (card-type "live-session"): the crewmates who play it
// now. The game itself rides on the FeedCardData game fields.
export struct LiveSessionData {
    // Whole minutes since the earliest start of the group.
    since-min: int,
    since-text: string,
    // "Bob and Jonas", "Bob, Jonas +1".
    names-line: string,
    // Every player, for the state port and a screen reader.
    member-names: [string],
    players: [H2hPerson],
    more-players: int,
    // Local poster art for the wide slot. A card without it is a cell.
    poster: image,
    has-poster: bool,
}

export struct FeedCardData {
    id: string,
    card-type: string,
    role: string,
    size: string,
    title: string,
    subtitle: string,
    timestamp: string,
    duration: string,
    duration-min: int,
    actor-name: string,
    actor-initials: string,
    // Identity hue of the actor's octagon (the streamer, the session owner).
    actor-hue-index: int,
    game-name: string,
    game-id: string,       // games.json / custom id; resolved from name when absent
    game-short-name: string, // badge text from the DB/custom entry; "" when unknown
    game-color: color,       // badge color from the DB entry
    game-has-color: bool,
    // Runtime icon (exe-extracted / crew-shared) for games w/o bundled art.
    game-icon: image,
    game-has-icon: bool,
    // The rest of the art ladder of a game tile: the local Steam header, then a
    // two-letter monogram in the game's hue (same as the recent games card).
    game-capsule: image,
    game-has-capsule: bool,
    game-monogram: string,
    game-hue-index: int,
    // Session card redesign (voice/stream): typed content, pre-formatted.
    session-kind: string,     // "stream" | "voice" | "" (non-session cards)
    duration-human: string,   // "3m" / "9h 7m"
    peak-count: int,          // stream: peak viewers; voice: peak participants
    channel-name: string,     // voice channel display name
    channel-id: string,       // voice channel id (the idle voice card joins it)
    participants-line: string, // "Ostkatt, b0bben +1"
    actor-avatar: image,      // streamer avatar (badge on the game icon)
    actor-has-avatar: bool,
    /// A joined card: the viewer already said hi to this member.
    said-hi: bool,
    part0-initials: string, part0-avatar: image, part0-has-avatar: bool,
    part1-initials: string, part1-avatar: image, part1-has-avatar: bool,
    part2-initials: string, part2-avatar: image, part2-has-avatar: bool,
    participant-count: int,
    clip-count: int,
    clip-path: string,
  // Normalized 0.0–1.0 peak buckets (64 entries); empty when unknown.
    waveform: [float],
    duration-ms: int,
    is-hero: bool,
    is-skeleton: bool,
    snapshot-urls: [string],
    mvp-count: int,
    mvp0-name: string, mvp0-initials: string, mvp0-stat: string,
    mvp1-name: string, mvp1-initials: string, mvp1-stat: string,
    mvp2-name: string, mvp2-initials: string, mvp2-stat: string,
    // Real avatars for the MVP rows (spec 19); fall back to the initials dot.
    mvp0-avatar: image, mvp0-has-avatar: bool,
    mvp1-avatar: image, mvp1-has-avatar: bool,
    mvp2-avatar: image, mvp2-has-avatar: bool,
    // "This week in games" section (spec 19).
    games-summary: string,
    leaderboard: [RecapLbRow],
    awards: [RecapAwardRow],
    // Head2head belts of the recap (HEAD2HEAD 6). Empty for a week with none.
    belts-moved: [RecapBeltMovedRow],
    belts-held: [RecapBeltHeldRow],
    is-new: bool,
    was-seen: bool,
    snapshot-loading: bool,
    snapshot-poster: image,
    snapshot-poster-ready: bool,
    snapshot-error: bool,
    snapshot-playback-frame: image,
    snapshot-playback-index: int,
    snapshot-playback-revision: int,

    // Weekly recap: "Week 4" once the server counts the crew's weeks, and when
    // the recap came out: "Monday", "3 weeks ago". Built in Rust.
    recap-week: string,
    age-label: string,
    /// The weekly recap seal. `recap-seal.key` is empty on any other card.
    recap-seal: RecapSeal,
    /// The numbers of the weekly recap that count up in the centre view.
    recap-hangout-min: int,
    recap-clips: int,
    recap-longest-min: int,

    // Daily recap (card-type "daily-recap"): the day ("Today so far",
    // "Yesterday", "Tuesday"), the sessions of the day, and the members who
    // took part, most active first. The hangout time is `title`, the clips are
    // `clip-count`, the top game is `game-*` and the belts that moved are
    // `belts-moved`. Built in Rust.
    day-label: string,
    day-sessions: int,
    day-members: [H2hPerson],

    // Rich game-session card (spec 19 B2). Pre-formatted in Rust.
    game-record: string,        // "5W–3L" (with draws: "5W–3L–1D")
    // The parts, so a card can colour a win and a loss differently.
    // The joined string above stays for anything wanting one label.
    game-wins: int,
    game-losses: int,
    game-draws: int,
    game-streak-text: string,   // "W4" / "L2" / "—"
    game-streak-positive: bool,
    game-winrate: string,       // "62%" / "—"
    game-matches: int,
    // Result confirmed server-side against an official post-match API
    // (Riot match-v5/TFT) rather than client-reported telemetry.
    game-verified: bool,

    // Recent games card: the tiles. The header line is `subtitle`.
    recent-games: [RecentGameTile],
    // The PCs behind the tiles: members who own or played a listed game. Two
    // or more make the card a poster grid in a two-column slot; one is the
    // list. 0 when the server does not say.
    recent-pc-count: int,

    // Weekly recap (card-type "recap"): the grid rows the tall card takes. 3
    // with belts, 2 without, 0 for a recap with nothing to show (a cell is
    // never drawn). Set in Rust (`recap_rows`).
    recap-rows: int,
    // Crew history only: the cell of the card in a three-column grid. `mem-span`
    // is the rows it takes (a recap takes 2 or 3). Set in Rust (`place_memory`).
    mem-col: int,
    mem-row: int,
    mem-span: int,
    // Weekly recap (card-type "recap"): the most active member (`count` is
    // minutes) and the most clipped (`count` is clips); "" in `name` when the
    // week has none.
    recap-active: RecapPerson,
    recap-clipped: RecapPerson,
    // Every game of the week, the most hours first, and the minutes of all of
    // them. The card shows four, the opened recap shows them all.
    recap-games: [RecapGameRow],
    recap-games-min: int,
    // The longest clip of the week.
    recap-clip: RecapClip,
    // "12 to 18 October".
    recap-range: string,

    // Head2head card and invite card (card-type "head2head" / "invite").
    head2head: Head2headData,

    // Live session card (card-type "live-session").
    live: LiveSessionData,
}

// One stream of the two-stream hero (mockup frame D): a member who streams
// now. The poster is the last frame the client holds. The client holds one
// remote streamer today, so nothing fills this yet (CLIPS 7.2).
export struct HeroStreamData {
    host-id: string,
    session-id: string,
    streamer-name: string,
    streamer-initials: string,
    hue-index: int,
    avatar: image,
    has-avatar: bool,
    game-name: string,
    poster: image,
    has-poster: bool,
}

// One row of the quiet row of the crew feed (CLIPS 7, frames E and F): a line
// and a time, formatted in Rust (`quiet_row.rs`). A join is a feed card.
export struct JoinedRowData {
    user-id: string,
    line: string,
    when: string,
}

// One per-game card in the personal stats profile (spec 19 A2).
// Display strings are pre-formatted in Rust.
export struct GameStatsCardData {
    game-id: string,          // games.json id, for the bundled icon lookup
    game-name: string,
    short-name: string,
    game-color: color,
    // Square art, icon slot: the exe or crew icon, else the Worker icon.
    icon: image,
    has-icon: bool,
    record-text: string,      // "12W 5L" / "12W 5L 2D"
    win-rate-text: string,    // "62%" / "—"
    streak-text: string,      // "W4" / "L2" / "—"
    streak-positive: bool,
    best-streak-text: string, // "W7 best · L3 worst" ("" when no history)
    recent-form: [string],    // each "W" | "L" | "D", newest last (≤10)
    last-played-text: string, // "2h ago" / "3d ago" / ""
}

// Personal stats for the "You strip" pinned atop the crew feed (spec 19).
// Only the viewer sees it; display strings are pre-formatted in Rust.
export struct YouStripData {
    has-stats: bool,        // false → strip hidden (no games tracked yet)
    game-id: string,        // games.json id, for the bundled icon lookup
    game-name: string,
    short-name: string,
    game-color: color,
    // Square art, icon slot: the exe or crew icon, else the Worker icon.
    icon: image,
    has-icon: bool,
    has-record: bool,       // true → W/L stats; false → weekly hours only
    streak-text: string,    // "W4" / "L2" / "—"
    streak-positive: bool,
    record-text: string,    // "12W 5L"
    win-rate-text: string,  // "62%"
    weekly-time-text: string, // "4h 12m this week" (pre-formatted in Rust)
    recent-form: [string],  // each "W" | "L" | "D", newest last
}

export struct StreamCardData {
    host-id: string,
    session-id: string,
    streamer-name: string,
    subtitle: string,
    avatar: image,
    has-avatar: bool,
    avatar-initials: string,
    avatar-color-index: int,
    viewer-count: int,
    stream-width: int,
    stream-height: int,
    can-watch: bool,
    // stage 6 (streaming-quality): "" or "live", "starting",
    // "reconnecting"; "ended" and "failed" for a notice card, which shows
    // `title` and the reason in `subtitle` for a few seconds.
    state: string,
    title: string,
}

export struct MemberData {
    id: string,
    name: string,
    initials: string,
    avatar: image,
    has-avatar: bool,
    online: bool,
    speaking: bool,
    role: int,
    game-line: string,
}

export struct ChatLinkData {
    url: string,
    label: string,
}

export struct ChatMessageData {
    message-id: string,
    sender-id: string,
    sender-name: string,
    sender-initials: string,
    sender-avatar: image,
    has-sender-avatar: bool,
    text: string,
    display-text: string,
    display-styled: styled-text,
    links: [ChatLinkData],
    timestamp: string,
    display-time: string,
    is-group-start: bool,
    is-continuation: bool,
    is-system: bool,
    is-unread-divider: bool,
    is-gif: bool,
    gif-image: image,
    has-gif-image: bool,
    gif-preview-url: string,
    gif-width: int,
    gif-height: int,
    is-clip: bool,
    clip-duration: string,
    clip-id: string,
    mentions-self: bool,
    reply-to-id: string,
    reply-to-name: string,
    reply-preview-text: string,
    is-edited: bool,
    is-deleted: bool,
}

export struct EmojiItemData {
    emoji: string,
    name: string,
}

export struct MentionMemberData {
    user-id: string,
    display-name: string,
    initials: string,
}

export struct GifItemData {
    gif-id: string,
    url: string,
    preview-url: string,
    width: int,
    height: int,
    preview: image,
    has-preview: bool,
}

export struct VoiceChannelMember {
    id: string,
    name: string,
    initials: string,
    avatar: image,
    has-avatar: bool,
    speaking: bool,
    muted: bool,
    deafened: bool,
    joined_at: int,
    game-line: string,
    // Playback volume of this member for the local user, 0 to 200 (%).
    // Rust sets 100 for a member with no entry; a struct literal must set
    // it too, because the default of an int is 0.
    volume: int,
    // The local user muted this member for themselves only. It is not the
    // member's own mic mute (`muted`).
    local-muted: bool,
}

export struct VoiceChannelData {
    id: string,
    name: string,
    member-count: int,
    is-default: bool,
    expanded: bool,
    active: bool,
    members: [VoiceChannelMember],
}

export struct AudioDeviceData {
    id: string,
    name: string,
    is-default: bool,
}

export struct GameIntegrationData {
    game-id: string,
    name: string,
    // Badge styling (games.json), the fallback of the icon.
    short-name: string,
    color: color,
    // Square art, icon slot: the exe or crew icon, else the Worker icon.
    icon: image,
    has-icon: bool,
    // "found" | "not-found" | "" (unknown)
    install-status: string,
    // Enabling writes a config file for the game to pick up.
    writes-files: bool,
    note: string,
    enabled: bool,
    // Game supports linking a Riot account for verified stats.
    has-account-link: bool,
}

// One installed game in the "Hidden from crew" list (Games settings tab).
export struct InstalledGameData {
    game-id: string,
    name: string,
    short-name: string,
    // Square art, icon slot: the exe or crew icon, else the Worker icon.
    icon: image,
    has-icon: bool,
    // Hidden from the crew: by the user, or in Steam.
    hidden: bool,
    // Hidden in Steam. The user cannot change it here.
    locked: bool,
}

export struct CaptureSourceData {
    id: string,
    name: string,
    mode: string,
    pid: int,
    exe: string,
    // Catalogue identity of this pid, 0 when unknown. The hook policy key.
    igdb-id: int,
    is-fullscreen: bool,
    resolution: string,
    thumbnail: image,
    has-thumbnail: bool,
}

/// A person shown with an invite: the inviter, or a member preview.
/// An empty `name` means no person.
export struct InvitePersonData {
    name: string,
    initials: string,
    /// The identity colour, 0..4, as `UserAvatar` maps it.
    color-index: int,
}

export struct DiscoverCrewData {
    id: string,
    name: string,
    /// Two letters for the tile. The full name does not fit a 48px box.
    initials: string,
    description: string,
    member-count: int,
    max-members: int,
    online-count: int,
    open: bool,
    avatar: image,
    has-avatar: bool,
}

export struct SearchUserData {
    id: string,
    display-name: string,
    is-friend: bool,
}

export global VideoRect {
    // Pushed by StreamCard's changed handlers every time absolute-position,
    // width, or height changes (scroll, resize, layout reflow).
    // Args: canvas_x, canvas_y, canvas_w, canvas_h, viewport_y, viewport_h
    // All in logical pixels; Rust multiplies by scale_factor.
    callback geometry-changed(float, float, float, float, float, float);
}

// --- stage 9 (streaming-quality): the stream card's controls ---

/// The watched stream's receive values, once a second
/// (`StreamViewerTimeline`), for the stats strip on the card.
/// Each value is formatted by Rust ("118 ms", "+8 ms").
export struct StreamStatsData {
    target-delay: string,
    jitter: string,
    decode: string,
    frames-late: string,
    audio-delay: string,
    av-offset: string,
}

/// The state behind the stream card's three buttons and their popovers. A
/// global, so the card (inside the feed) and the popovers (over the window)
/// share it. Rust owns the values; the card reads them and calls back. The
/// previews set them, so they are in-out.
export global StreamCardUi {
    // Game-audio volume of the watched stream, for this user only: 0..200 %.
    // The mute keeps the volume.
    in-out property <int> volume: 100;
    in-out property <bool> muted: false;
    // The open popover: "" (none), "volume" or "settings". The button that
    // opens one sets it, with the anchor: the right and bottom edges of
    // that button, in window coordinates.
    in-out property <string> popover: "";
    in-out property <length> anchor-right;
    in-out property <length> anchor-bottom;
    // The right edge of the card: in the expanded view the popovers open
    // beside the card, over the chat column, not over the picture.
    in-out property <length> anchor-card-right;
    // The viewer's stats strip on the card.
    in-out property <bool> stats-shown: false;
    in-out property <StreamStatsData> stats;
    // "720p60": the watched picture's height from the SPS and the frame
    // rate of the host's rung. Empty until known.
    in-out property <string> format-label: "";
    // The watch started and no frame is shown yet.
    in-out property <bool> viewer-starting: false;
    // The watched card takes over the feed area (the expanded view).
    in-out property <bool> expanded: false;
    // The watched stream plays in its own window (the pop-out).
    in-out property <bool> popped-out: false;
    // The watchable card, for the expanded view.
    in-out property <StreamCardData> watched-card;
    // The hosted stream: its quality preset and what it sends.
    in-out property <string> host-quality: "";
    in-out property <string> host-sending: "";

    callback volume-changed(int);
    callback mute-changed(bool);
    callback stats-toggled(bool);
    // true: expand (or open the pop-out); false: back to the card.
    callback expand-requested(bool);
    callback popout-requested(bool);
}

// --- end stage 9 ---

/// The crew chat, as the feed cards reach it. A joined card's "Say hi" sends a
/// message at once: the click is the intent, there is no draft.
export global ChatFocus {
    /// "Say hi" on a joined card. The argument is the card id (`joined-<user id>`).
    callback say-hi(/* card id */ string);
    /// The chat input has the cursor. The chat panel keeps it up to date.
    in-out property <bool> input-focused: false;
}

// One tester on the About tab. `avatar` is the Steam avatar when it is on
// disk; without it the tile shows the monogram in an identity hue.
export struct TesterData {
    name: string,
    initials: string,
    // The Steam profile the tile opens in the browser.
    url: string,
    color-index: int,
    has-avatar: bool,
    avatar: image,
}

// One record of the Third-party notices view. Dependencies that share a
// licence text share a record.
export struct NoticeEntryData {
    // One "name version" pair per line.
    names: string,
    license: string,
    text: string,
}
