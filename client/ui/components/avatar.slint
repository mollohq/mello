import { Theme } from "../theme.slint";
import { OctShape, OctMask } from "./cut.slint";

// ============================================================
//  The user avatar. There is one of these, and every surface uses it.
//
//  A person is an octagon. A crew or a game is a two-corner tile
//  (`CutTile` in cut.slint). The shape tells you which one you look at.
//
//  Slint cannot clip to a path, so an image avatar is a clipped rectangle
//  with its four corners painted back. `bg-color` must be what is really
//  behind the avatar, or those corners show as light triangles.
// ============================================================

export component UserAvatar inherits Rectangle {
    in property <string> initials;
    in property <image> avatar;
    in property <bool> has-avatar: false;
    /// Identity colour of the initials fallback. Ignored when `muted`.
    in property <int> color-index: 0;
    /// Graphite fill instead of an identity colour, for a person with no
    /// place in a coloured list (a chat author, an unknown member).
    in property <bool> muted: false;
    in property <length> size: 18px;
    /// What is behind the avatar. The corners are painted with it.
    in property <color> bg-color: Theme.card-bg;
    /// Separating ring for a row that overlaps its avatars. 0px means none.
    in property <length> ring: 0px;
    in property <color> ring-color: Theme.card-bg;
    /// Speaking or active. Draws the ring in `active-color`.
    in property <bool> active: false;
    in property <color> active-color: Theme.action;

    /// The cut keeps its proportion, so an 18px dot and a 40px avatar read
    /// as the same shape. 0.22 is the mockup's 4px on 18px.
    property <length> cut: max(3px, root.size * 0.22);
    property <length> ring-w: root.active ? max(2px, root.ring) : root.ring;

    width: size;
    height: size;
    background: transparent;

    if root.ring-w > 0px: OctShape {
        x: -root.ring-w;
        y: -root.ring-w;
        width: root.size + root.ring-w * 2;
        height: root.size + root.ring-w * 2;
        n: root.cut + root.ring-w;
        fill: root.active ? root.active-color : root.ring-color;
    }

    OctShape {
        width: root.size;
        height: root.size;
        n: root.cut;
        fill: root.muted ? Theme.raised
            : root.color-index == 0 ? Theme.id-blue
            : root.color-index == 1 ? Theme.id-purple
            : root.color-index == 2 ? Theme.id-teal
            : root.color-index == 3 ? Theme.id-amber : Theme.id-pink;
    }

    if root.has-avatar: Rectangle {
        width: root.size;
        height: root.size;
        clip: true;

        // Overdraw by a pixel on every side, and let the parent clip it.
        //
        // The octagon plate sits under the image, and the image was landing
        // a fraction short of the box: the last row rounded to the plate
        // instead of the picture, so every avatar with a photo wore a light
        // line along one edge. Covering past the edge removes the rounding
        // from the question. The plate stays, so an avatar with
        // transparency still has graphite behind it.
        Image {
            source: root.avatar;
            x: -1px;
            y: -1px;
            width: root.size + 2px;
            height: root.size + 2px;
            image-fit: cover;
        }

        // Slint cannot clip to a path, so the corners are painted back.
        OctMask {
            width: root.size;
            height: root.size;
            n: root.cut;
            fill: root.bg-color;
        }
    }

    if !root.has-avatar: Text {
        text: root.initials;
        font-family: Theme.font-display;
        font-size: max(7px, root.size * 0.38);
        font-weight: Theme.weight-display-bold;
        color: root.muted ? Theme.text-secondary : Theme.on-action;
        width: root.size;
        height: root.size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// The "+3" chip that closes an overlapped avatar row. Same silhouette as
/// a person, because it stands for people.
export component AvatarOverflow inherits Rectangle {
    in property <int> count: 0;
    in property <length> size: 18px;
    in property <length> ring: 0px;
    in property <color> ring-color: Theme.card-bg;

    property <length> cut: max(3px, root.size * 0.22);

    width: size;
    height: size;
    background: transparent;

    if root.ring > 0px: OctShape {
        x: -root.ring;
        y: -root.ring;
        width: root.size + root.ring * 2;
        height: root.size + root.ring * 2;
        n: root.cut + root.ring;
        fill: root.ring-color;
    }

    OctShape {
        width: root.size;
        height: root.size;
        n: root.cut;
        fill: Theme.raised;
    }

    Text {
        text: "+" + root.count;
        font-family: Theme.font-display;
        font-size: max(7px, root.size * 0.32);
        font-weight: Theme.weight-display;
        color: Theme.text-secondary;
        width: root.size;
        height: root.size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Headless preview:
//   slint-viewer --screenshot out.png --component Preview \
//     client/ui/components/avatar.slint
export component Preview inherits Rectangle {
    width: 420px;
    height: 200px;
    background: Theme.surface;

    HorizontalLayout {
        padding: 30px;
        spacing: 30px;
        alignment: start;
        cross-axis-alignment: center;

        // initials, muted
        UserAvatar {
            initials: "b0";
            muted: true;
            size: 80px;
            bg-color: Theme.surface;
        }

        // a picture
        UserAvatar {
            avatar: @image-url("../icons/brands/steam.svg");
            has-avatar: true;
            muted: true;
            size: 80px;
            bg-color: Theme.surface;
        }

        // identity colour
        UserAvatar {
            initials: "os";
            color-index: 2;
            size: 80px;
            bg-color: Theme.surface;
        }
    }
}
