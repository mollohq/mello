import { Theme } from "../theme.slint";
import { StatValue } from "stat.slint";

/// A span of minutes in big numerals with a small "h" between hours and
/// minutes: "19 h 40" (mockup .num). Under an hour it is the minutes and "min".
/// The unit rides the numerals' baseline (StatValue).
export component RecapDur inherits StatValue {
    in property <int> minutes;
    in property <length> size: 24px;
    in property <color> color: Theme.text-primary;
    property <bool> hours: root.minutes >= 60;

    value: root.hours ? "\{Math.floor(root.minutes / 60)}" : "\{root.minutes}";
    unit: root.hours ? "h" : "min";
    tail: !root.hours ? "" : Math.mod(root.minutes, 60) < 10 ? "0\{Math.mod(root.minutes, 60)}" : "\{Math.mod(root.minutes, 60)}";
    value-size: root.size;
    unit-size: 13px;
    value-weight: Theme.weight-display-bold;
    value-spacing: -0.5px;
    unit-font: Theme.font-display;
    unit-weight: Theme.weight-display-bold;
    hue: root.color;
    unit-color: Theme.text-body;
}

export component RecapKicker inherits Text {
    font-family: Theme.font-label;
    font-weight: Theme.weight-label;
    font-size: 9px;
    letter-spacing: 1.8px;
    color: Theme.text-dim;
}
