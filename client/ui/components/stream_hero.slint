import { Theme } from "../theme.slint";
import { CutButtonShape, CutShape, CutMask } from "cut.slint";
import { UserAvatar } from "avatar.slint";
import { StatValue } from "stat.slint";
import { HeroStreamData } from "../types.slint";

// ============================================================
//  Pieces of the stream hero (mockup frames C and D): the label chip, the
//  play ring and the wash over footage. Chrome laid over game footage uses
//  black washes, not the graphite ramp.
// ============================================================

/// The dark chip over footage, top-left and bottom-right cut (`.tag`).
export component MediaChip inherits Rectangle {
    in property <length> n: 4px;
    in property <length> pad-x: 10px;
    in property <length> pad-y: 4px;
    /// The space under the row. The top pad by default; a chip whose row
    /// ends in a deep descender box gives back a little.
    in property <length> pad-bottom: root.pad-y;
    /// How the row's items meet on the cross axis. A chip that mixes two
    /// type sizes sets `end` and lifts the smaller one to the baseline.
    in property <CrossAxisAlignment> row-align: center;

    width: chip-row.preferred-width + 2 * root.pad-x;
    height: chip-row.preferred-height + root.pad-y + root.pad-bottom;
    background: transparent;

    CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: root.n;
        fill: #000000A8;
    }
    chip-row := HorizontalLayout {
        x: root.pad-x;
        y: root.pad-y;
        // The row is its content, not the chip: a row that fills the chip
        // centres its items on a box that is `pad-y` too tall.
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 8px;
        cross-axis-alignment: root.row-align;
        @children
    }
}

/// "STREAM" with a white dot, or "LIVE" with a red dot and "2 STREAMING".
///
/// Two type sizes share the chip: the 9 px label and the 12 px Oxanium
/// number. Box-aligned they sit on two baselines (the bigger face has the
/// deeper box). The row aligns at the bottom and lifts the label by the
/// difference of the two descents, the StatValue rule, so LIVE, the number
/// and its word stand on one baseline. The dot rides the label's x-height.
export component StreamTag inherits MediaChip {
    in property <string> label: "STREAM";
    in property <bool> live: false;
    /// "2 STREAMING": the number, in Oxanium, then the word. Both empty on a
    /// hero that holds one stream.
    in property <string> count: "";
    in property <string> count-label: "STREAMING";

    property <length> label-size: 9px;
    property <length> number-size: 12px;
    /// The lift of the 9 px label to the baseline of the 12 px number.
    /// Nothing to lift on a chip with the label alone.
    property <length> lift: root.count == "" ? 0px : max(0px,
        root.number-size * Theme.descent(Theme.font-display)
        - root.label-size * Theme.descent(Theme.font-label));

    row-align: root.count == "" ? CrossAxisAlignment.center : CrossAxisAlignment.end;
    // The number's box keeps its descent under the baseline: the chip gives
    // two pixels back below, so the text stands in its middle.
    pad-bottom: root.count == "" ? root.pad-y : root.pad-y - 2px;

    VerticalLayout {
        // The dot sits on the middle of the label's x-height: above the
        // baseline (the label's descent) by half an x-height, less half
        // the dot.
        padding-bottom: root.lift + (root.count == "" ? 0px : 1px);
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.live ? Theme.live : Theme.text-primary;
        }
    }
    VerticalLayout {
        padding-bottom: root.lift;
        Text {
            text: root.label;
            font-family: Theme.font-label;
            font-weight: Theme.weight-label;
            font-size: root.label-size;
            letter-spacing: 1.4px;
            color: root.live ? Theme.live : Theme.text-primary;
        }
    }
    if root.count != "": VerticalLayout {
        // The keyline stands on the number's box, one pixel up from its
        // bottom, so it is centred on the number's height.
        padding-bottom: 1px;
        Rectangle {
            width: 1px;
            height: 12px;
            background: #FFFFFF47;
        }
    }
    if root.count != "": StatValue {
        value: root.count; unit: root.count-label;
        value-size: root.number-size; unit-size: root.label-size;
        value-weight: Theme.weight-display-bold;
        unit-font: Theme.font-label;
        unit-weight: Theme.weight-label;
        unit-spacing: 1.4px;
        hue: Theme.text-primary;
        unit-color: Theme.text-primary;
        gap: 5px;
    }
}

/// The play button over footage: a cut tile (top left and bottom right, as
/// every m3llo button), a black wash with a white keyline, and the play
/// triangle with its back corners cut. Hover fills it white: white is action.
export component PlayButton inherits Rectangle {
    in property <length> size: 56px;
    in property <bool> hover: false;

    width: root.size;
    height: root.size;

    CutButtonShape {
        width: parent.width;
        height: parent.height;
        n: root.size * 0.2;
        inset: 1px;
        fill: root.hover ? Theme.text-primary : #000000AA;
        stroke: Theme.text-primary;
        stroke-width: 2px;
    }
    Image {
        source: @image-url("../icons/play-cut.svg");
        colorize: root.hover ? #000000 : Theme.text-primary;
        width: root.size * 0.38;
        height: root.size * 0.38;
        x: (parent.width - self.width) / 2 + root.size * 0.03;
        y: (parent.height - self.height) / 2;
    }
}

/// The black wash over footage: dark at the top for the tag, clear in the
/// middle for the picture, dark at the bottom for the text.
export component FootageWash inherits Rectangle {
    background: @linear-gradient(180deg, #00000099 0%, #00000000 26%, #00000000 40%, #000000E6 100%);
}

/// Two streams share the hero (mockup frame D): two strips, one above the
/// other, each with its own play ring, streamer octagon and game. One tag for
/// the card says LIVE and how many stream. The strips are footage, so the
/// cut corner is painted back over the top one.
export component TwoStreamHero inherits Rectangle {
    in property <[HeroStreamData]> streams;
    /// Plays the stream of this host.
    callback watch-clicked(/* host_id */ string);

    background: transparent;

    CutShape {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "tr";
        fill: Theme.card-border;
    }
    CutShape {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "tr"; inset: Theme.keyline;
        fill: #000000;
    }

    VerticalLayout {
        padding: Theme.keyline;
        spacing: 2px;

        for s[i] in root.streams: Rectangle {
            clip: true;
            background: Theme.raised;

            if s.has-poster: Image {
                width: parent.width; height: parent.height;
                source: s.poster;
                image-fit: cover;
            }
            FootageWash { width: parent.width; height: parent.height; }

            PlayButton {
                x: (parent.width - self.width) / 2;
                y: parent.height * 0.44 - self.height / 2;
                size: 56px;
                hover: watch-touch.has-hover;
            }

            HorizontalLayout {
                x: 18px;
                y: parent.height - self.height - 16px;
                height: 40px;
                spacing: 12px;
                cross-axis-alignment: center;
                UserAvatar {
                    bg-color: #000000;
                    initials: s.streamer-initials;
                    avatar: s.avatar;
                    has-avatar: s.has-avatar;
                    color-index: s.hue-index;
                    size: 40px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: s.streamer-name;
                        font-family: Theme.font-display;
                        font-weight: Theme.weight-display;
                        font-size: 17px;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: s.game-name;
                        font-family: Theme.font-body;
                        font-weight: Theme.weight-sentence;
                        font-size: 13px;
                        color: #A2A2A8;
                    }
                }
            }

            watch-touch := TouchArea {
                accessible-role: button;
                accessible-label: "Watch " + s.streamer-name;
                mouse-cursor: pointer;
                clicked => { root.watch-clicked(s.host-id); }
            }
        }
    }

    CutMask {
        width: parent.width; height: parent.height;
        n: Theme.notch; corner: "tr";
        fill: Theme.bg-app;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: Theme.card-border;
        stroke-width: 1px;
        commands: "M \{(self.width - Theme.notch) / 1px} 0 L \{self.width / 1px} \{Theme.notch / 1px}";
    }

    StreamTag {
        x: 18px;
        y: 14px;
        label: "LIVE";
        live: true;
        count: root.streams.length;
    }
}
