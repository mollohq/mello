import "./fonts/Inter-Regular.ttf";
import "./fonts/Inter-Medium.ttf";
import "./fonts/Inter-SemiBold.ttf";
import "./fonts/Inter-Bold.ttf";
import "./fonts/JetBrainsMono-Regular.ttf";
import "./fonts/JetBrainsMono-Medium.ttf";

// ============================================================
//  m3llo design system v3.3 · GRAPHITE
//  Source of truth: mello-wip/m3llo-design-system.html
//
//  Two rules the whole theme hangs on:
//    RED  (#FF453A) is STATE   — the 3 in the mark, live, recording, unread.
//    WHITE           is ACTION — the thing you press, where you are, focus.
//  Everything else is graphite. Game footage is the only colour on screen.
//
//  Dark only. `dark` is kept as a constant so the ~44 existing
//  `Theme.dark ? a : b` call sites keep compiling; both arms now
//  resolve to the same graphite value.
// ============================================================

export global Theme {
    // Constant. Light mode was dropped with the graphite system.
    in property <bool> dark: true;

    // --- Ground ---------------------------------------------------------
    out property <color> bg-app:     #121214;   // window + feed ground
    out property <color> surface:    #17171A;   // sidebars, header, control bar
    out property <color> titlebar:   #0F0F11;

    // --- Text -----------------------------------------------------------
    out property <color> text-primary:   #F3F3F4;
    out property <color> text-secondary: #6F6F76;
    out property <color> text-tertiary:  #4B4B52;
    out property <color> text-body:      #A2A2A8;   // sentences

    // --- Graphic / border -----------------------------------------------
    out property <color> graphic-light: #2F2F35;   // keyline
    out property <color> graphic-med:   #42424A;   // keyline, hover
    out property <color> graphic-dark:  #F3F3F4;

    // --- ACTION (white) --------------------------------------------------
    out property <color> action:       #FFFFFF;
    out property <color> action-press: #D2D2D6;
    out property <color> action-dim:   #FFFFFF1A;  // tint of the active row
    out property <color> action-line:  #FFFFFF57;  // keyline of the active crew
    out property <color> on-action:    #121214;    // text on a white fill
    out property <color> action-quiet: #8A8A92;

    // --- STATE (m3llo red) -----------------------------------------------
    //  the 3 in the mark · live · recording · clip · unread · leave
    out property <color> live:      #FF453A;
    out property <color> live-bg:   #FF453A24;
    out property <color> on-live:   #FFFFFF;

    // --- Identity — people, crews, games. Never chrome. -------------------
    out property <color> id-blue:   #6E8FB8;
    out property <color> id-purple: #8E7FB0;
    out property <color> id-teal:   #5FA396;
    out property <color> id-amber:  #B39158;
    out property <color> id-pink:   #B07793;

    // --- Cards / Feed ----------------------------------------------------
    out property <color> card-bg:        #1C1C20;
    out property <color> card-bg-hover:  #212127;
    out property <color> card-border:    #2F2F35;
    out property <color> card-bg-inset:  #0F0F11;
    out property <color> card-bg-skel:   #17171A;
    out property <color> skel-element:   #26262B;
    out property <color> skel-text:      #4B4B52;
    out property <color> skel-hint:      #3A3A41;
    out property <color> skel-ghost:     #33333A;
    out property <color> text-sub:       #6F6F76;
    out property <color> text-dim:       #6F6F76;
    out property <color> text-value:     #F3F3F4;
    out property <color> wave-off:       #3A3A41;   // unplayed waveform
    out property <color> wave-bg:        #0F0F11;

    // --- Text selection --------------------------------------------------
    out property <color> selection-bg: #FFFFFF3D;
    out property <color> selection-fg: text-primary;

    // --- Compatibility aliases -------------------------------------------
    //  `accent` used to mean both "press this" and "something is happening".
    //  The system splits those. Until every call site is triaged (Step B of
    //  plans/GRAPHITE-UI-MIGRATION.md) `accent` resolves to ACTION, which is
    //  the more common of the two readings.
    out property <color> accent:       action;
    out property <color> accent-bg:    action-dim;
    out property <color> accent-red:   live;
    out property <color> accent-green: id-teal;      // presence, muted
    out property <color> voice-active:    id-teal;
    out property <color> voice-active-bg: #5FA39626;
    out property <color> clip-amber:    live;        // clips are recordings → red
    out property <color> clip-amber-bg: live-bg;
    out property <color> bg-primary:   surface;
    out property <color> bg-secondary: bg-app;
    out property <color> bg-tertiary:  graphic-light;
    out property <color> bg-dark:      #F3F3F4;
    out property <color> text-muted:   text-secondary;
    out property <color> border-light: graphic-light;
    out property <color> hover-overlay: #FFFFFF0D;
    out property <color> surface-hover: #26262B;
    out property <color> raised:        #26262B;
    out property <color> raised-hover:  #2E2E34;

    // --- Shape -----------------------------------------------------------
    //  The cut corner is the signature. `cut` is for things you act on,
    //  `notch` for cards. Radii survive only for dots, discs and inputs.
    out property <length> cut:   10px;   // buttons, icon buttons, tiles
    out property <length> notch: 16px;   // cards
    out property <length> notch-hero: 20px;
    out property <length> notch-sm: 12px;   // sidebar cards
    out property <length> keyline: 1px;

    out property <length> r-outer: 10px;
    out property <length> r-inner: 6px;
    out property <length> r-pill:  20px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: r-outer;
    out property <length> radius-lg: 16px;

    // --- Spacing ---------------------------------------------------------
    out property <length> gap: 12px;
    out property <length> pad: 24px;
    out property <length> control-bar-height: 81px;
    out property <length> feed-row: 232px;      // fixed feed grid row

    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 16px;
    out property <length> spacing-lg: 24px;
    out property <length> spacing-xl: 32px;

    // --- Type ------------------------------------------------------------
    //  Oxanium  — names it, or it is big.
    //  Barlow   — everything else, in two registers:
    //             sentence (300) and label (600 + tracking).
    //  Font files land in Step A2; the families below fall back to the
    //  currently embedded faces until then.
    out property <string> font-display: "Oxanium";
    out property <string> font-body:    "Barlow";
    out property <string> font-label:   "Barlow";
    // backward compat: 217 call sites still say font-mono for labels
    out property <string> font-mono: font-label;
    out property <string> font-sans: font-body;

    out property <int>    weight-display: 600;   // titles, names
    out property <int>    weight-display-bold: 700;
    out property <int>    weight-sentence: 300;
    out property <int>    weight-label: 600;
    //  Slint letter-spacing is absolute, not em-relative: these are the
    //  .16em / .20em of the design system resolved at label sizes.
    out property <length> track-label:  1.5px;   // 9.5px label
    out property <length> track-kicker: 1.9px;   // 9.5px kicker, wider

    // --- Font sizes ------------------------------------------------------
    out property <length> font-xs:  10px;   // label
    out property <length> font-sm:  11px;   // meta
    out property <length> font-md:  13px;   // sentence
    out property <length> font-lg:  14px;   // card title
    out property <length> font-xl:  20px;
    out property <length> font-xxl: 32px;
}

/// TextInput with Mello selection colors (not platform default blue).
export component MelloTextInput inherits TextInput {
    selection-background-color: Theme.selection-bg;
    selection-foreground-color: Theme.selection-fg;
}

/// Bordered single-line (or multiline) field — full-height input for reliable mouse selection.
export component MelloInputField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";
    in property <bool> single-line: true;
    in property <bool> read-only: false;
    in property <length> pad-x: 14px;
    in property <length> pad-y: 0px;
    in property <length> field-height: 44px;
    in property <length> font-size: 14px;
    callback accepted();

    height: field-height;
    background: Theme.bg-app;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.action : Theme.graphic-light;

    input := MelloTextInput {
        x: pad-x;
        y: pad-y;
        width: parent.width - 2 * pad-x;
        height: parent.height - 2 * pad-y;
        font-size: root.font-size;
        color: Theme.text-primary;
        horizontal-alignment: left;
        vertical-alignment: single-line ? center : top;
        single-line: root.single-line;
        wrap: single-line ? no-wrap : word-wrap;
        read-only: root.read-only;
        accepted => { root.accepted(); }
    }

    if placeholder != "" && input.text == "" && !read-only: Text {
        x: pad-x;
        y: pad-y;
        width: parent.width - 2 * pad-x;
        height: parent.height - 2 * pad-y;
        text: placeholder;
        font-size: root.font-size;
        color: Theme.text-tertiary;
        vertical-alignment: single-line ? center : top;
    }
}

/// Wheel-scroll container without Flickable — TextInput double/triple-click selection breaks inside Flickable (slint#6514).
export component MelloScrollArea inherits Rectangle {
    in-out property <length> scroll-y: 0;
    in property <length> content-height: 0;
    property <length> max-y: max(0px, content-height - self.height);

    clip: true;

    changed content-height => {
        scroll-y = min(scroll-y, max-y);
    }

    wheel := TouchArea {
        width: parent.width;
        height: parent.height;
        scroll-event(e) => {
            scroll-y = min(max-y, max(0px, scroll-y - e.delta-y));
            accept
        }
    }

    content := Rectangle {
        y: -scroll-y;
        width: parent.width;
        height: content-height;
        @children
    }
}
