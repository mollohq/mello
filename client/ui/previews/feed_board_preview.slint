/// The feed panel at 1x with the control bar, as in the app.
component Panel inherits Rectangle {
    in property <ZonesData> zones;
    width: 865px;
    height: 865px;
    background: Theme.bg-app;
    VerticalLayout {
        CrewFeedZones { vertical-stretch: 1; zones: root.zones; }
        ControlBar {
            height: Theme.control-bar-height;
            user-name: "b0bben";
            user-initials: "B0";
            user-avatar: Crew.bob.avatar;
            has-user-avatar: true;
            can-stream: true;
        }
    }
}

global Base {
    out property <[BoardStat]> today: Data.today;
    out property <BoardStat> today-big: { value: "6", unit: "h", tail: "40", label: "HANGOUT" };
    out property <BoardStat> week-big: { value: "43", unit: "h", tail: "12", label: "HANGOUT" };
    out property <[BoardStat]> week-stats: [
        { value: "31", label: "CLIPS" }, { value: "3", unit: "h", tail: "58", label: "LONGEST" }, { value: "5", label: "GAMES" },
    ];
    out property <BoardGame> cs2: { name: "Counter-Strike 2", art: Crew.cs2 };
}

/// 1 · A crew of one, day 0: own belts, the solo board, the first five.
export component PreviewFeedDay0 inherits Panel {
    zones: {
        you: Crew.bob,
        stage: "own", own-belts: [Own.carry, Own.owl, Own.collector, Own.locked],
        board: "solo",
        solo-games: [
            { name: "Counter-Strike 2", art: Crew.cs2, count: "4,167 h" },
            { name: "Rocket League", art: Crew.rl, count: "812 h" },
            { name: "Deep Rock Galactic", art: Crew.drg, count: "96 h" },
        ],
        people: true, members: [Crew.bob], open-seats: 4,
    };
}

/// 2 · Three members, a little activity: Max's clip on stage, the board with
/// a sealed belt, People moves up, one session.
export component PreviewFeedSmall inherits Panel {
    zones: {
        you: Crew.bob,
        stage: "card", stage-card: Hist.hero-max,
        board: "tabs",
        today-big: { value: "1", unit: "h", tail: "10", label: "HANGOUT" },
        today-stats: [{ value: "1", label: "CLIPS" }, { value: "2", label: "SESSIONS" }, { value: "3", label: "ON" }],
        today-has-top: true, today-top: Base.cs2,
        week-big: Base.week-big, week-stats: Base.week-stats,
        titles: Data.titles-monday, title-count: 13, more-label: "+8 MORE",
        people: true, members: [Crew.bob, Crew.jonas, Crew.max], open-seats: 2,
        sessions: [Hist.s-cs, Hist.s-rl],
    };
}

