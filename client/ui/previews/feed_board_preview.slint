// ============================================================
//  The zone matrix. Five fixed zones: Stage (two columns, two rows),
//  Board (the side column), Clips (one row), People (one row), Games (a
//  list). A zone with nothing to show collapses and the zones under it move
//  up. Six crews, one preview each.
// ============================================================

global Z {
    // Left column under the board is two columns wide; after the board, three.
    out property <length> people-h: 120px;
}

global Own {
    out property <BeltReveal> carry: { key: "own:the_carry:c1", sealed: true, seed: 11, code: SealedFixtures.carry-code, cells: SealedFixtures.carry-cells, title: "The Carry", icon: Crew.i-carry, hue-index: 1, holder: Crew.you };
    out property <BeltReveal> owl: { key: "own:night_owl:c1", sealed: true, seed: 12, code: SealedFixtures.owl-code, cells: SealedFixtures.owl-cells, title: "Night Owl", icon: Crew.i-owl, hue-index: 1, holder: Crew.you };
    out property <BeltReveal> collector: { key: "own:the_collector:c1", sealed: true, seed: 13, code: SealedFixtures.marathon-code, cells: SealedFixtures.marathon-cells, title: "The Collector", icon: Crew.i-collector, hue-index: 1, holder: Crew.you };
    out property <BeltReveal> locked: { key: "own:locked_in:c1", sealed: true, seed: 14, code: SealedFixtures.owl-code, cells: SealedFixtures.owl-cells, title: "Locked In", icon: Crew.i-locked, hue-index: 1, holder: Crew.you };
    out property <BeltReveal> owl-moved: {
        key: "night_owl:3301", sealed: true, seed: 3301, code: SealedFixtures.owl-code, cells: SealedFixtures.owl-cells,
        title: "Night Owl", icon: Crew.i-owl, hue-index: Crew.jonas.hue-index, holder: Crew.jonas, prev: Crew.you,
    };
}

/// 1 · A crew of one, day 0. Nothing to watch: the stage is your own belts,
/// sealed. The board is you this week. People is the first five: you, four
/// open seats, the red Invite. No clips, no games, no skeletons.
export component PreviewZonesDay0 inherits FeedFrame {
    StageOwnBelts {
        x: G.x0; y: G.y0; width: G.w2; height: G.h2;
        you: Crew.bob;
        belts: [Own.carry, Own.owl, Own.collector, Own.locked];
    }
    FeedBoard {
        x: G.x2; y: G.y0; width: G.w1; height: G.h2;
        mode: "past";
        past-label: "YOU, THIS WEEK";
        big: { value: "6", unit: "h", tail: "00", label: "PLAYED" };
        stats: [
            { value: "3", label: "GAMES" },
            { value: "4", label: "SESSIONS" },
            { value: "03:14", label: "LATEST" },
        ];
        show-titles: false;
        game-rows-label: "YOUR GAMES";
        game-rows: [
            { name: "Counter-Strike 2", art: Crew.cs2, count: "4,167 h" },
            { name: "Rocket League", art: Crew.rl, count: "812 h" },
            { name: "Deep Rock Galactic", art: Crew.drg, count: "96 h" },
            { name: "Helldivers 2", art: Crew.hd2, count: "41 h" },
        ];
    }
    PeopleZone {
        x: G.x0; y: G.y2; width: G.w3; height: Z.people-h;
        members: [Crew.bob];
        open-seats: 4;
    }
}

