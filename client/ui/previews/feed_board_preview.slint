/// Grid positions of the feed panel.
global G {
    out property <length> x0: 20px;
    out property <length> x2: 578px;
    out property <length> y0: 16px;
    out property <length> y1: 260px;
    out property <length> y2: 504px;
    out property <length> y3: 748px;
    out property <length> w1: 267px;
    out property <length> w2: 546px;
    out property <length> w3: 825px;
    out property <length> h1: 232px;
    out property <length> h2: 476px;
    out property <length> h3: 720px;
}

/// The feed panel: header, the grid, the control bar.
component FeedFrame inherits Rectangle {
    in property <string> badge;
    /// Tall: the feed scrolled out, no control bar, a line at the first screen.
    in property <bool> tall: false;
    width: 865px;
    height: 865px;
    background: Theme.bg-app;

    VerticalLayout {
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 24px;
                spacing: 12px;
                alignment: start;
                cross-axis-alignment: center;
                Text { text: "Crew feed"; font-family: Theme.font-display; font-weight: Theme.weight-display; font-size: 17px; color: Theme.text-primary; }
                if root.badge != "": Rectangle {
                    width: badge-text.preferred-width + 18px;
                    height: 22px;
                    CutButtonShape { width: parent.width; height: parent.height; n: 4px; fill: Theme.raised; }
                    badge-text := Text {
                        text: root.badge;
                        font-family: Theme.font-label; font-weight: Theme.weight-label;
                        font-size: 9px; letter-spacing: Theme.track-label;
                        color: Theme.text-dim;
                    }
                }
            }
            Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.card-border; }
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            @children
        }
        if !root.tall: ControlBar {
            height: Theme.control-bar-height;
            user-name: "b0bben";
            user-initials: "B0";
            user-avatar: Crew.bob.avatar;
            has-user-avatar: true;
            can-stream: true;
        }
    }
    // Preview only: where the first screen ends above the control bar.
    if root.tall: Rectangle {
        x: 0; y: 865px - Theme.control-bar-height;
        width: parent.width; height: 1px;
        background: Theme.text-tertiary;
    }
    if root.tall: Rectangle {
        x: parent.width - fold-text.preferred-width - 20px;
        y: 865px - Theme.control-bar-height - 8px;
        width: fold-text.preferred-width + 12px; height: 16px;
        background: Theme.bg-app;
        fold-text := Text {
            text: "FIRST SCREEN";
            font-family: Theme.font-label; font-weight: Theme.weight-label;
            font-size: 9px; letter-spacing: Theme.track-label;
            color: Theme.text-body;
        }
    }
}


global Data {
    out property <BeltReveal> marathon-sealed: {
        key: "marathon:911", sealed: true, seed: 911,
        code: SealedFixtures.marathon-code, cells: SealedFixtures.marathon-cells,
        title: "Marathon", icon: Crew.i-marathon, hue-index: Crew.sara.hue-index, kind: 1, amount: 232,
        stat: "Longest single game session.", holder: Crew.sara, prev: Crew.leo,
    };
    out property <BeltReveal> carry-sealed: {
        key: "the_carry:1307", sealed: true, seed: 1307,
        code: SealedFixtures.carry-code, cells: SealedFixtures.carry-cells,
        title: "The Carry", icon: Crew.i-carry, hue-index: Crew.leo.hue-index, kind: 0, amount: 412, unit: "h",
        stat: "Most hours in the top shared game.", holder: Crew.leo, prev: Crew.max,
    };
    out property <RecapSeal> week-seal: {
        key: "recap:45", sealed: true, seed: 4421,
        bright: SealedFixtures.recap-bright, dim: SealedFixtures.recap-dim,
    };

    out property <[BoardStat]> today: [
        { value: "14", label: "CLIPS" },
        { value: "9", label: "SESSIONS" },
        { value: "17", label: "ON" },
    ];
    /// Today: Marathon moved last night and is still sealed.
    out property <[BoardTitle]> titles-today: [
        { person: Crew.sara, title: "MARATHON", icon: Crew.i-marathon, value: "3", unit: "h", tail: "52", unread: true, belt: Data.marathon-sealed },
        { person: Crew.oskar, title: "CLIPPER", icon: Crew.i-clipper, value: "41", unit: "clips", unread: true },
        { person: Crew.leo, title: "THE CARRY", icon: Crew.i-carry, value: "412", unit: "h" },
        { person: Crew.you, title: "NIGHT OWL", icon: Crew.i-owl, value: "03:14" },
        { person: Crew.max, title: "THE COLLECTOR", icon: Crew.i-collector, value: "37", unit: "installed" },
        { person: Crew.jonas, title: "LOCKED IN", icon: Crew.i-locked, value: "21", unit: "h" },
        { person: Crew.ida, title: "MOUTH", icon: Crew.i-mouth, value: "1,140", unit: "min" },
    ];
    /// Monday: two belts moved in the week and are still sealed.
    out property <[BoardTitle]> titles-monday: [
        { person: Crew.sara, title: "MARATHON", icon: Crew.i-marathon, value: "3", unit: "h", tail: "52", belt: Data.marathon-sealed },
        { person: Crew.leo, title: "THE CARRY", icon: Crew.i-carry, value: "412", unit: "h", belt: Data.carry-sealed },
        { person: Crew.oskar, title: "CLIPPER", icon: Crew.i-clipper, value: "41", unit: "clips" },
        { person: Crew.you, title: "NIGHT OWL", icon: Crew.i-owl, value: "03:14" },
        { person: Crew.max, title: "THE COLLECTOR", icon: Crew.i-collector, value: "37", unit: "installed" },
    ];
    /// Monday, the week opened: the belts are open, the moves show the dot.
    out property <[BoardTitle]> titles-opened: [
        { person: Crew.sara, title: "MARATHON", icon: Crew.i-marathon, value: "3", unit: "h", tail: "52", unread: true },
        { person: Crew.leo, title: "THE CARRY", icon: Crew.i-carry, value: "412", unit: "h", unread: true },
        { person: Crew.oskar, title: "CLIPPER", icon: Crew.i-clipper, value: "41", unit: "clips" },
        { person: Crew.you, title: "NIGHT OWL", icon: Crew.i-owl, value: "03:14" },
    ];

    out property <MixedClip> c-sara-game: { kind: "game", person: Crew.sara, game: "Counter-Strike 2", duration: "0:31", poster: @image-url("fixtures/stream-sample-3.png"), unread: true };
    out property <MixedClip> c-jonas-voice: { kind: "voice", person: Crew.jonas, game: "Counter-Strike 2", duration: "0:30", peaks: Crew.wave-b, unread: true };
    out property <MixedClip> c-hugo-game: { kind: "game", person: Crew.hugo, game: "Helldivers 2", duration: "0:30", poster: @image-url("fixtures/stream-sample-1.png") };
    out property <MixedClip> c-ida-voice: { kind: "voice", person: Crew.ida, game: "Deep Rock Galactic", duration: "0:18", peaks: Crew.wave-c };
    out property <MixedClip> c-max-game: { kind: "game", person: Crew.max, game: "Rocket League", duration: "0:22", poster: @image-url("fixtures/stream-sample-2.png") };
    out property <MixedClip> c-leo-voice: { kind: "voice", person: Crew.leo, game: "", duration: "0:30", peaks: Crew.wave-d };

    out property <[BoardSession]> sessions: [
        { art: Crew.cs2, game: "Counter-Strike 2", result: "3W 0L", players: "Jonas, Leo and 9 more", length: "9 h 20" },
        { art: Crew.drg, game: "Deep Rock Galactic", players: "Nils, Alva and Hugo", length: "2 h 05" },
        { art: Crew.rl, game: "Rocket League", result: "1W 2L", players: "Max and Theo", length: "48 min" },
    ];
}

component TodayBoard inherits FeedBoard {
    mode: "tabs";
    active-tab: 0;
    big: { value: "6", unit: "h", tail: "40", label: "HANGOUT" };
    stats: Data.today;
    has-top-game: true;
    top-game: { name: "Counter-Strike 2", art: Crew.cs2 };
    titles: Data.titles-today;
    more-label: "+6 MORE, YOU VS 39";
}

// ------------------------------------------------------------
//  Clips mixed. Wednesday 22:40. Max is live. One clip row, game and voice
//  together, ranked: game footage first, unread first. The board carries
//  Marathon sealed (it moved last night). Tall: the feed scrolled out.
// ------------------------------------------------------------
export component PreviewMixLive inherits FeedFrame {
    badge: "14 CLIPS TODAY";
    tall: true;
    height: 1056px;

    BoardHero {
        x: G.x0; y: G.y0; width: G.w2; height: G.h2;
        footage: @image-url("fixtures/stream-sample-2.png");
        live: true;
        when: "NOW";
        host: Crew.max;
        game: "Counter-Strike 2";
        watchers: "6 watching";
        length: "42 min";
    }
    TodayBoard { x: G.x2; y: G.y0; width: G.w1; height: G.h3; }
    ClipRow {
        x: G.x0; y: G.y2; width: G.w2; height: G.h1;
        more: 12;
        clips: [Data.c-sara-game, Data.c-jonas-voice];
    }
    SessionsCard { x: G.x0; y: G.y3; width: G.w3; height: G.h1; count: 9; sessions: Data.sessions; more-label: "+6 MORE"; }
}

/// Nobody live: the best game clip leads, the clip row goes on mixed.
export component PreviewMixClipHero inherits FeedFrame {
    badge: "14 CLIPS TODAY";

    GameClipCard {
        x: G.x0; y: G.y0; width: G.w2; height: G.h2;
        is-hero: true;
        is-new: true;
        poster: @image-url("fixtures/stream-sample-3.png");
        poster-ready: true;
        can-play: true;
        clipper-name: Crew.sara.name;
        clipper-initials: Crew.sara.initials;
        clipper-hue-index: Crew.sara.hue-index;
        clipper-avatar: Crew.sara.avatar;
        clipper-has-avatar: true;
        game-name: "Counter-Strike 2";
        duration: "0:31";
    }
    TodayBoard { x: G.x2; y: G.y0; width: G.w1; height: G.h3; }
    ClipRow {
        x: G.x0; y: G.y2; width: G.w2; height: G.h1;
        more: 11;
        clips: [Data.c-jonas-voice, Data.c-hugo-game];
    }
}

