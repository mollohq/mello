import { Theme } from "../theme.slint";
import { H2hPerson, BeltReveal, RecapSeal, FeedCardData } from "../types.slint";
import { SealedFixtures } from "./sealed_fixtures.slint";
import { CrewFeedZones } from "../panels/crew_feed.slint";
import { ControlBar } from "../panels/control_bar.slint";
import { BoardStat, BoardGame, BoardTitle, ZonesData, HistoryWeek } from "../components/feed_board.slint";

// ============================================================
//  The zone feed matrix: the real CrewFeedZones panel with test data, one
//  Preview for each crew case. The review gate for every feed change.
//
//  Members are fake. Avatars are DiceBear output from the approved styles
//  (AVATAR-SYSTEM.md 2.1). Art is the abstract preview fixtures.
//
//  Render every case to one page: scripts/render-feed-zones.sh
//  One case:
//    slint-viewer --component PreviewFeedBig --screenshot out.png \
//      client/ui/previews/feed_board_preview.slint
// ============================================================

global Crew {
    out property <H2hPerson> bob: { id: "u-bob", name: "b0bben", initials: "B0", hue-index: 1, avatar: @image-url("fixtures/avatars/b0bben.svg"), has-avatar: true };
