// ============================================================
//  The zone feed panel itself (CrewFeedZones) with the clips carousel and
//  Crew history. Free is the last 7 days; every week before it is m3llo+.
// ============================================================

global Hist {
    out property <FeedCardData> g1: { id: "g1", card-type: "clip", clip-kind: "game", clip-path: "g1", clip-can-play: true,
        snapshot-poster: @image-url("fixtures/stream-sample-2.png"), snapshot-poster-ready: true,
        actor-name: "Max", actor-initials: "MA", actor-avatar: Crew.max.avatar, actor-has-avatar: true, game-name: "Counter-Strike 2", duration: "0:30", is-new: true };
    out property <FeedCardData> v1: { id: "v1", card-type: "clip", clip-kind: "voice", clip-path: "v1",
        actor-name: "Jonas", actor-initials: "JO", actor-avatar: Crew.jonas.avatar, actor-has-avatar: true, game-name: "Counter-Strike 2", duration: "0:24", waveform: Crew.wave-b };
    out property <FeedCardData> g2: { id: "g2", card-type: "clip", clip-kind: "game", clip-path: "g2", clip-can-play: true,
        snapshot-poster: @image-url("fixtures/stream-sample-1.png"), snapshot-poster-ready: true,
        actor-name: "Hugo", actor-initials: "HU", actor-avatar: Crew.hugo.avatar, actor-has-avatar: true, game-name: "Rocket League", duration: "0:22" };
    out property <FeedCardData> v2: { id: "v2", card-type: "clip", clip-kind: "voice", clip-path: "v2",
        actor-name: "Sara", actor-initials: "SA", actor-avatar: Crew.sara.avatar, actor-has-avatar: true, duration: "0:30", waveform: Crew.wave-c };
    out property <FeedCardData> g3: { id: "g3", card-type: "clip", clip-kind: "game", clip-path: "g3", clip-can-play: true,
        snapshot-poster: @image-url("fixtures/stream-sample-3.png"), snapshot-poster-ready: true,
        actor-name: "Leo", actor-initials: "LE", actor-avatar: Crew.leo.avatar, actor-has-avatar: true, game-name: "Fall Guys", duration: "0:18" };

    out property <[HistoryWeek]> locked: [
        { label: "Week 44", age: "Last week", locked: true, seal: Data.week-seal, more: 9,
          teasers: [
            { person: Crew.leo, kind: "CLIP", duration: "0:30", code: SealedFixtures.carry-code },
            { person: Crew.ida, kind: "STREAM", duration: "1 h 12 min", code: SealedFixtures.owl-code },
          ] },
        { label: "Week 43", age: "2 weeks ago", locked: true, seal: { key: "plus:43", sealed: true, seed: 911, bright: SealedFixtures.recap-bright, dim: SealedFixtures.recap-dim }, more: 4,
          teasers: [
            { person: Crew.sara, kind: "VOICE", duration: "0:24", code: SealedFixtures.marathon-code },
            { person: Crew.max, kind: "CLIP", duration: "0:28", code: SealedFixtures.owl-code },
          ] },
    ];
    out property <[HistoryWeek]> open: [
        { label: "Week 44", age: "Last week", locked: false,
          big: { value: "38", unit: "h", tail: "05", label: "HANGOUT" },
          stats: [ { value: "22", label: "CLIPS" }, { value: "3", unit: "h", tail: "58", label: "LONGEST" }, { value: "5", label: "GAMES" } ],
          has-top: true, top: { name: "Counter-Strike 2", art: Crew.cs2 },
          clips: [Hist.g3, Hist.v2, Hist.g2] },
        { label: "Week 43", age: "2 weeks ago", locked: false,
          big: { value: "29", unit: "h", tail: "40", label: "HANGOUT" },
          stats: [ { value: "17", label: "CLIPS" }, { value: "2", unit: "h", tail: "10", label: "LONGEST" }, { value: "4", label: "GAMES" } ],
          has-top: true, top: { name: "Rocket League", art: Crew.rl },
          clips: [Hist.g2, Hist.v1] },
    ];
}

component ZonesPanel inherits Rectangle {
    in property <bool> plus: false;
    width: 865px;
    height: 1830px;
    background: Theme.bg-app;
    CrewFeedZones {
        width: parent.width;
        height: parent.height;
        zones: {
            stage: "card",
            stage-card: { id: "hero", card-type: "clip", clip-kind: "game", clip-path: "hero", clip-can-play: true, is-hero: true,
                snapshot-poster: @image-url("fixtures/stream-sample-3.png"), snapshot-poster-ready: true,
                actor-name: "Sara", actor-initials: "SA", actor-avatar: Crew.sara.avatar, actor-has-avatar: true, game-name: "Counter-Strike 2", duration: "0:31", is-new: true },
            board: "tabs",
            today-big: { value: "6", unit: "h", tail: "40", label: "HANGOUT" },
            today-stats: Data.today,
            today-has-top: true,
            today-top: { name: "Counter-Strike 2", art: Crew.cs2 },
            titles: Data.titles-today,
            title-count: 13,
            more-label: "+6 MORE",
            clips: [Hist.g1, Hist.v1, Hist.g2, Hist.v2, Hist.g3],
            people: true,
            joined: [Crew.elin],
            joined-line: "Elin joined",
            joined-sub: "invited by Max, 20:46",
            say-hi-card: "j1",
            voice: "call",
            channel: "Lounge",
            voice-line: "3 in the call",
            voice-people: [Crew.jonas, Crew.max, Crew.sara],
            sessions: Data.sessions,
            sessions-count: 9,
            sessions-more: "+6 MORE",
            history: root.plus ? Hist.open : Hist.locked,
            plus: root.plus,
        };
    }
}

/// Free: the carousel ends in the Crew history tile; Crew history is sealed weeks.
export component PreviewZonesHistoryFree inherits ZonesPanel { plus: false; }
/// m3llo+: every past week is open, with its numbers and its clips.
export component PreviewZonesHistoryPlus inherits ZonesPanel { plus: true; }
