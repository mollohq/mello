    badge: "3 CLIPS TODAY";

    GameClipCard {
        x: G.x0; y: G.y0; width: G.w2; height: G.h2;
        is-hero: true;
        is-new: true;
        poster: @image-url("fixtures/stream-sample-1.png");
        poster-ready: true;
        can-play: true;
        clipper-name: Crew.hugo.name;
        clipper-initials: Crew.hugo.initials;
        clipper-hue-index: Crew.hugo.hue-index;
        clipper-avatar: Crew.hugo.avatar;
        clipper-has-avatar: true;
        game-name: "Helldivers 2";
        duration: "0:30";
    }
    SealedRecap {
        x: G.x2; y: G.y0; width: G.w1; height: G.h2;
        seal: Data.week-seal;
        week: "Week 45";
    }
    ClipRow {
        x: G.x0; y: G.y2; width: G.w3; height: G.h1;
        clips: [Data.c-ida-voice, Data.c-max-game, Data.c-leo-voice];
    }
}

