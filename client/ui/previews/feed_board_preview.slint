// ============================================================
//  The board layout of the crew feed for a crew of 40.
//
//  One screen of the feed panel at 1x (865 by 865) with the header and
//  the control bar. Grid: three columns of 267 px, 12 px gap, 20 px side
//  padding, rows of Theme.feed-row (232 px).
//
//  Members are fake. Avatars are DiceBear output from the approved
//  styles (AVATAR-SYSTEM.md 2.1). Art is the abstract preview fixtures.
//
//    slint-viewer --component PreviewMixLive --screenshot out.png \
//      client/ui/previews/feed_board_preview.slint
// ============================================================

global Crew {
    out property <H2hPerson> bob: { id: "u-bob", name: "b0bben", initials: "B0", hue-index: 1, avatar: @image-url("fixtures/avatars/b0bben.svg"), has-avatar: true };
