        actor-name: "Hugo", actor-initials: "HU", actor-avatar: Crew.hugo.avatar, actor-has-avatar: true, game-name: "Rocket League", duration: "0:30" };
    out property <FeedCardData> hero-old: { id: "hero-old", card-type: "clip", clip-kind: "game", clip-path: "hero-old", clip-can-play: true, is-hero: true,
